        <bool name="NeedsPivotMigration">false</bool>
        <bool name="RequiresHandle">false</bool>
        <string name="ToolTip">Assemble and cast spell cards</string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="76">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="77">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="78">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client bootstrap: enables projectile visual rendering, receives chunk/global
	time-scale replication, and starts the client-side dilation systems
	(movement, chunk overlay, and the personal time-ratio panel). Also starts
	ToolManager, which swaps in each equipped tool's controller module (see
	ToolManager.luau and ToolControllers/) -- e.g. firing input only listens
	while a registered weapon (TimeBlaster, Railgun, ...) is equipped, driven
	entirely by that tool's ToolControllers/<Name>.luau.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local ChunkManager = require(Shared.ChunkManager)
local ProjectileClient = require(Shared.ProjectileClient)
local Entity = require(Shared.Entity)

-- Client-local systems (sibling ModuleScripts of this LocalScript).
local MovementController = require(script.MovementController)
local ChunkVisualizer = require(script.ChunkVisualizer)
local TimeControlGui = require(script.TimeControlGui)
local ToolManager = require(script.ToolManager)
-- These two self-register their VisualOffload listeners at require time
-- (no .start()) -- see AmmoState.luau (ammo cache for a future HUD) and
-- WeaponEffects.luau (server-broadcast one-shot weapon VFX like the
-- muzzle blast).
local _AmmoState = require(script.AmmoState)
local _WeaponEffects = require(script.WeaponEffects)
local _SpellEffects = require(script.SpellEffects) -- spell Beam visuals
local _DummyEffects = require(script.DummyEffects) -- test dummy damage flashes

ChunkManager.EnableReplication()
ProjectileClient.EnableClientRendering()
Entity.EnableHurtboxRendering() -- draws hurtboxes when Entity.ShowHurtboxes is true
Entity.EnableHurtboxHistoryRendering() -- draws the history trail when Entity.ShowHurtboxHistory is true

MovementController.start()
ChunkVisualizer.start()
TimeControlGui.start()
ToolManager.start()

-- Optional: custom impact VFX for offloaded projectiles.
-- ProjectileClient.SetImpactHandler(function(position, normal, model)
-- 	local effect = ReplicatedStorage.Effects.Impact:Clone()
-- 	effect.Position = position
-- 	effect.Parent = workspace
-- 	task.delay(1, effect.Destroy, effect)
-- end)

print("[Relativity] client render systems online")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">AmmoState</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	AmmoState (client)
	Caches the latest ammo/reload state the server pushes over the "AmmoSync"
	VisualOffload channel (see Shooter.server.luau's pushAmmoSync -- fired on
	equip, every shot, and every reload transition) and re-exposes it as a
	Signal so a future HUD can just connect and render, without needing to
	know anything about VisualOffload/remotes itself. Purely a cache -- no
	input, no authority; a weapon with no Magazine (e.g. TimeBlaster) simply
	never gets an entry here.

	API:
	 AmmoState.Get(toolName: string) -> { Magazine: number, Reserve: number, Reloading: boolean }?
	 AmmoState.Changed:Connect(fn(toolName: string, state)) -- fires on every sync
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualOffload = require(Shared.VisualOffload)
local Signal = require(Shared.Signal)

local AmmoState = {}

AmmoState.Changed = Signal.new()

local state: { [string]: { Magazine: number, Reserve: number, Reloading: boolean } } = {}

function AmmoState.Get(toolName: string)
	local entry = state[toolName]
	if not entry then
		return nil
	end
	return table.clone(entry)
end

VisualOffload.On("AmmoSync", function(data)
	if typeof(data) ~= "table" or typeof(data.ToolName) ~= "string" then
		return
	end
	local entry = { Magazine = data.Magazine, Reserve = data.Reserve, Reloading = data.Reloading == true }
	state[data.ToolName] = entry
	AmmoState.Changed:Fire(data.ToolName, table.clone(entry))
end)

return AmmoState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">ChunkVisualizer</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	ChunkVisualizer.luau  (client)
	Draws a translucent box over every chunk whose TimeScale differs from 1, so
	you can see the dilation field at a glance. Colour encodes the local time
	rate: blue = slow (< 1x), red/orange = fast (> 1x). A floating label shows
	the exact multiplier.

	Chunk scales arrive on the client via ChunkManager.EnableReplication(), so
	this just reconciles a pool of parts against ChunkManager.GetAllChunks()
	each refresh. Toggle with the V key (or ChunkVisualizer.setEnabled).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChunkManager = require(Shared.ChunkManager)

local ChunkVisualizer = {}

local REFRESH_INTERVAL = 0.25
local BOX_HEIGHT = 64 -- visual height for 2D (XZ) chunking
local started = false
local enabled = true

local folder: Folder? = nil
local parts: { [Vector3]: BasePart } = {} -- keyed by chunk.Key

-- Slow (0x) -> cyan, normal (1x) -> green-ish, fast (>1x) -> red.
local function colorForScale(scale: number): Color3
	if scale < 1 then
		-- 0 -> deep blue, 1 -> teal
		return Color3.fromRGB(40, 120, 255):Lerp(Color3.fromRGB(60, 220, 200), math.clamp(scale, 0, 1))
	else
		-- 1 -> amber, >=2 -> red
		return Color3.fromRGB(255, 200, 60):Lerp(Color3.fromRGB(255, 70, 60), math.clamp(scale - 1, 0, 1))
	end
end

local function makeBox(key: Vector3): BasePart
	local size = ChunkManager.ChunkSize
	local box = Instance.new("Part")
	box.Name = `Chunk_{key.X}_{key.Y}_{key.Z}`
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.CastShadow = false
	box.Material = Enum.Material.ForceField
	box.Transparency = 0.7
	box.Size = Vector3.new(size, ChunkManager.UseY and size or BOX_HEIGHT, size)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Label"
	billboard.Size = UDim2.fromOffset(80, 24)
	billboard.AlwaysOnTop = true
	billboard.Parent = box
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextStrokeTransparency = 0.4
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = billboard

	box.Parent = folder
	return box
end

local function positionFor(key: Vector3): Vector3
	local size = ChunkManager.ChunkSize
	local origin = key * size
	local halfHeight = (ChunkManager.UseY and size or BOX_HEIGHT) / 2
	return Vector3.new(origin.X + size / 2, ChunkManager.UseY and origin.Y + size / 2 or halfHeight, origin.Z + size / 2)
end

local function clearAll()
	for _, box in parts do
		box:Destroy()
	end
	table.clear(parts)
end

local function refresh()
	if not enabled then
		return
	end

	local seen: { [Vector3]: boolean } = {}
	for _, chunk in ChunkManager.GetAllChunks() do
		if chunk.TimeScale ~= 1 then
			seen[chunk.Key] = true
			local box = parts[chunk.Key]
			if not box then
				box = makeBox(chunk.Key)
				box.Position = positionFor(chunk.Key)
				parts[chunk.Key] = box
			end
			local color = colorForScale(chunk.TimeScale)
			box.Color = color
			local label = box:FindFirstChild("Label")
			local text = label and label:FindFirstChildWhichIsA("TextLabel")
			if text then
				text.Text = string.format("x%.2f", chunk.TimeScale)
			end
		end
	end

	-- drop boxes for chunks that returned to normal or vanished
	for key, box in parts do
		if not seen[key] then
			box:Destroy()
			parts[key] = nil
		end
	end
end

function ChunkVisualizer.setEnabled(value: boolean)
	enabled = value
	if folder then
		folder.Parent = value and workspace or nil
	end
	if not value then
		clearAll()
	end
end

function ChunkVisualizer.toggle()
	ChunkVisualizer.setEnabled(not enabled)
end

function ChunkVisualizer.start()
	if started then
		return
	end
	started = true

	folder = Instance.new("Folder")
	folder.Name = "ChunkVisualizer"
	folder.Parent = workspace

	-- Refresh on a real-time loop (NOT the dilated Heartbeat) so the overlay
	-- stays responsive even when the world is frozen (global scale 0).
	task.spawn(function()
		while started do
			refresh()
			task.wait(REFRESH_INTERVAL)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.V then
			ChunkVisualizer.toggle()
		end
	end)
end

return ChunkVisualizer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">DilationBubbleGui</string>
            <string name="Source"><![CDATA[--!optimize 2
-- Studio-only configuration panel for the DilationBubble test tool.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VisualOffload = require(ReplicatedStorage:WaitForChild("Shared").VisualOffload)

local DilationBubbleGui = {}

local fields = {
	{ Key = "Scale", Label = "Time scale", Min = 0, Max = 3, Value = 0.25 },
	{ Key = "Radius", Label = "Radius", Min = 8, Max = 256, Value = 64 },
	{ Key = "Duration", Label = "Duration (s)", Min = 0.25, Max = 30, Value = 8 },
}

local started = false
local screenGui: ScreenGui? = nil

function DilationBubbleGui.GetConfig()
	local result = {}
	for _, field in fields do
		result[field.Key] = field.Value
	end
	return result
end

function DilationBubbleGui.SetVisible(visible: boolean)
	if screenGui then
		screenGui.Enabled = visible
	end
end

local function build()
	local screen = Instance.new("ScreenGui")
	screen.Name = "DilationBubbleGui"
	screen.ResetOnSpawn = false
	screen.Enabled = false
	screen.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	screenGui = screen

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0, 0.5)
	panel.Position = UDim2.new(0, 12, 0.5, 0)
	panel.Size = UDim2.fromOffset(250, 210)
	panel.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
	panel.BackgroundTransparency = 0.08
	panel.BorderSizePixel = 0
	panel.Parent = screen
	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 10)
	panelCorner.Parent = panel

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(14, 9)
	title.Size = UDim2.new(1, -28, 0, 22)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 15
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.fromRGB(235, 240, 255)
	title.Text = "Dilation Bubble (Studio)"
	title.Parent = panel

	local help = Instance.new("TextLabel")
	help.BackgroundTransparency = 1
	help.Position = UDim2.fromOffset(14, 31)
	help.Size = UDim2.new(1, -28, 0, 28)
	help.Font = Enum.Font.Gotham
	help.TextSize = 12
	help.TextWrapped = true
	help.TextXAlignment = Enum.TextXAlignment.Left
	help.TextColor3 = Color3.fromRGB(165, 175, 195)
	help.Text = "Equip, then click the world to place a zone."
	help.Parent = panel

	for index, field in fields do
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Position = UDim2.fromOffset(14, 62 + (index - 1) * 32)
		row.Size = UDim2.new(1, -28, 0, 26)
		row.Parent = panel

		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(0.55, 0, 1, 0)
		label.Font = Enum.Font.Gotham
		label.TextSize = 13
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = Color3.fromRGB(210, 216, 230)
		label.Text = field.Label
		label.Parent = row

		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(1, 0.5)
		box.Position = UDim2.new(1, 0, 0.5, 0)
		box.Size = UDim2.new(0.4, 0, 0, 23)
		box.BackgroundColor3 = Color3.fromRGB(38, 42, 56)
		box.BorderSizePixel = 0
		box.ClearTextOnFocus = false
		box.Font = Enum.Font.GothamMedium
		box.TextSize = 13
		box.TextColor3 = Color3.fromRGB(235, 240, 255)
		box.Text = tostring(field.Value)
		box.Parent = row
		local boxCorner = Instance.new("UICorner")
		boxCorner.CornerRadius = UDim.new(0, 5)
		boxCorner.Parent = box

		box.FocusLost:Connect(function()
			local value = tonumber(box.Text)
			if value and value == value then
				field.Value = math.clamp(value, field.Min, field.Max)
			end
			box.Text = tostring(field.Value)
		end)
	end

	local clear = Instance.new("TextButton")
	clear.Position = UDim2.fromOffset(14, 166)
	clear.Size = UDim2.new(1, -28, 0, 30)
	clear.BackgroundColor3 = Color3.fromRGB(116, 54, 74)
	clear.BorderSizePixel = 0
	clear.Font = Enum.Font.GothamBold
	clear.TextSize = 13
	clear.TextColor3 = Color3.fromRGB(255, 235, 240)
	clear.Text = "Clear My Bubbles"
	clear.Parent = panel
	local clearCorner = Instance.new("UICorner")
	clearCorner.CornerRadius = UDim.new(0, 6)
	clearCorner.Parent = clear
	clear.Activated:Connect(function()
		VisualOffload.Fire("DilationBubbleTest", { Action = "Clear" })
	end)
end

function DilationBubbleGui.Start()
	if started or not RunService:IsStudio() then
		return
	end
	started = true
	build()
end

return DilationBubbleGui
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">DummyEffects</string>
            <string name="Source"><![CDATA[--!strict
-- Damage feedback is local presentation; the server replicates a monotonic
-- pulse counter, letting repeated hits restart one tween per dummy.
local TweenService = game:GetService("TweenService")
local watched: { [Model]: boolean } = {}

local function watch(instance: Instance)
	if not instance:IsA("Model") or watched[instance] then return end
	watched[instance] = true
	local tween: Tween? = nil
	local pulseConnection: RBXScriptConnection? = nil
	local function flash()
		local pulse = instance:GetAttribute("DamagePulse")
		if typeof(pulse) ~= "number" or pulse <= 0 then return end
		local outline = instance:FindFirstChild("TestDummyOutline")
		if not outline or not outline:IsA("Highlight") then return end
		if tween then tween:Cancel(); tween:Destroy() end
		outline.FillColor = Color3.fromRGB(255, 40, 40)
		outline.FillTransparency = 0
		tween = TweenService:Create(outline, TweenInfo.new(0.15, Enum.EasingStyle.Linear), { FillTransparency = 1 })
		tween:Play()
	end
	pulseConnection = instance:GetAttributeChangedSignal("DamagePulse"):Connect(flash)
	instance.Destroying:Once(function()
		if pulseConnection then pulseConnection:Disconnect() end
		if tween then tween:Cancel(); tween:Destroy() end
		watched[instance] = nil
	end)
end

local function attach(folder: Instance)
	folder.ChildAdded:Connect(watch)
	for _, instance in folder:GetChildren() do watch(instance) end
end

local folder = workspace:FindFirstChild("SpawnedTestDummies")
if folder then
	attach(folder)
else
	local added: RBXScriptConnection? = nil
	added = workspace.ChildAdded:Connect(function(instance)
		if instance.Name == "SpawnedTestDummies" then
			if added then added:Disconnect() end
			attach(instance)
		end
	end)
end

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="83">
          <Properties>
            <string name="Name">MapGenToggleDebug</string>
            <string name="Source"><![CDATA[--[[
	MapGenToggleDebug.client.luau
	Press G to show/hide the MapGen debug overlay (tinted regions, room size
	labels) against the real built geometry from MapGen.Builder. Fires a
	RemoteEvent so the server -- which owns the Visualizer instance -- can
	reparent the shared debug folder for everyone.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local event = ReplicatedStorage:WaitForChild("MapGenToggleDebug")

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.G then
		event:FireServer()
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">MovementController</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	MovementController.luau  (client)
	Makes the local character move in dilated time. Roblox's own character
	physics run in real time, so on their own WalkSpeed/JumpPower would ignore
	chunk time scales and the player's own personal time ratio. This controller
	re-derives the character's motion from the same clock every other system
	uses:

	    effScale = worldScale * chunk scale under the character * personalScale

	worldScale is the true Heartbeat global time scale (a dev/world-level knob,
	1 unless something explicitly changes it) and personalScale is this
	player's own ratio, set via SetPersonalTimeScale -- TimeControlGui calls
	that directly for instant feedback and it's the only thing the slider
	actually drives. Because only the *local* character is touched here (each
	client owns/predicts its own, per Roblox's network ownership model),
	personalScale only ever affects this player's own movement on every
	client's screen -- other players see it via ordinary Humanoid property
	replication, but their own movement is driven by their own client's own
	personalScale, so one player's dial can never affect anyone else's.

	Each frame it:
	  • scales WalkSpeed by effScale            (walking slows with time)
	  • scales the jump impulse by effScale      (jumps launch slower)
	  • applies a custom-gravity VectorForce so the character's *net* downward
	    acceleration becomes g₀ · effScale²      (falls float in slow time)

	The effScale² on gravity is the physically correct scaling: with jump
	velocity scaled by effScale and gravity by effScale², jump height is
	preserved but the whole arc plays out in dilated time. At effScale = 0 the
	upward force exactly cancels gravity, so the character freezes in place.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Heartbeat = require(Shared.Heartbeat)
local ChunkManager = require(Shared.ChunkManager)

local MovementController = {}

local player = Players.LocalPlayer
local started = false
local personalScale = 1

type CharacterState = {
	humanoid: Humanoid,
	root: BasePart,
	force: VectorForce,
	baseWalkSpeed: number,
	baseJumpPower: number?,
	baseJumpHeight: number?,
}

local state: CharacterState? = nil

local function teardown()
	if state and state.force then
		state.force:Destroy()
	end
	state = nil
end

local function setup(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not humanoid or not root then
		return
	end

	-- A VectorForce (in world space, at the center of mass) supplies the
	-- gravity *correction*: real gravity always pulls with g₀; we add an
	-- upward force so the remainder matches g₀ · effScale².
	local attachment = root:FindFirstChild("MovementGravityAttachment") :: Attachment?
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "MovementGravityAttachment"
		attachment.Parent = root
	end

	local force = Instance.new("VectorForce")
	force.Name = "MovementGravityForce"
	force.Attachment0 = attachment
	force.ApplyAtCenterOfMass = true
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.Force = Vector3.zero
	force.Parent = root

	state = {
		humanoid = humanoid,
		root = root,
		force = force,
		baseWalkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16,
		baseJumpPower = humanoid.UseJumpPower and humanoid.JumpPower or nil,
		baseJumpHeight = (not humanoid.UseJumpPower) and humanoid.JumpHeight or nil,
	}
end

local function step()
	local current = state
	if not current then
		return
	end
	local humanoid, root = current.humanoid, current.root
	if humanoid.Health <= 0 or not root.Parent then
		return
	end

	local effScale = Heartbeat.GetGlobalTimeScale() * ChunkManager.GetTimeScaleAt(root.Position) * personalScale

	-- Horizontal movement dilation.
	humanoid.WalkSpeed = current.baseWalkSpeed * effScale

	-- Jump impulse dilation (velocity scales with effScale).
	if current.baseJumpPower then
		humanoid.JumpPower = current.baseJumpPower * effScale
	elseif current.baseJumpHeight then
		humanoid.JumpHeight = current.baseJumpHeight * effScale * effScale
	end

	-- Custom gravity: net downward accel should be g₀ · effScale².
	-- Roblox already applies g₀, so add upward (mass · g₀ · (1 − effScale²)).
	local g0 = workspace.Gravity
	local mass = root.AssemblyMass
	current.force.Force = Vector3.new(0, mass * g0 * (1 - effScale * effScale), 0)
end

-- This player's own time ratio (see TimeControlGui.luau), independent of the
-- shared Heartbeat global scale -- see the module doc comment.
function MovementController.SetPersonalTimeScale(scale: number)
	personalScale = math.max(scale, 0)
end

function MovementController.GetPersonalTimeScale(): number
	return personalScale
end

function MovementController.start()
	if started then
		return
	end
	started = true

	local function onCharacter(character)
		teardown()
		task.defer(setup, character)
	end

	if player.Character then
		onCharacter(player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)
	player.CharacterRemoving:Connect(teardown)

	Heartbeat.Connect(step, { Name = "MovementController", Priority = 20 })
end

return MovementController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">ShooterConfigGui</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	ShooterConfigGui (client)
	A Studio-only debug side panel to tune the bullets ShooterController
	fires: speed, damage, gravity, bounces, pierces, homing, etc. It just
	holds a config table; ShooterController reads getConfig() when firing
	and sends it to the server ONLY while RunService:IsStudio() is true (see
	Shooter.server.luau's applyStudioDebugOverrides) -- a live client's
	config is never read at all. Every weapon's REAL stats live server-side
	in its own Weapons/<Name>.luau module (see src/server/Weapons/); this
	panel is purely a live-iteration convenience layered on top of that
	while testing in Studio, not a source of truth.

	getConfig() ONLY returns fields you've actually edited (see `touched`
	below), never the full field set with its baked-in defaults -- every
	field here defaults to a plausible-looking number (e.g. Speed = 220),
	and if those were always sent/applied regardless of whether you touched
	them, firing ANY weapon in Studio would silently clobber that weapon's
	real Stats with this panel's unrelated defaults (this happened: Railgun
	fired at this panel's default Speed instead of its own). Untouched
	fields fall through entirely, so a weapon you've never opened this panel
	for behaves exactly as its own module declares.

	The panel is built once but stays hidden until setVisible(true) is called
	-- any shooting weapon's ToolControllers/<Name>.luau (via the shared
	_ShootingWeapon.luau) calls that from its Equip/Unequip (see
	ToolManager.luau), so the menu only comes up while one of those tools is
	actually equipped.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ShooterConfigGui = {}

-- Field spec: order + metadata drives both the UI and the defaults.
-- kind "number" -> TextBox (clamped to min/max), "bool" -> toggle button.
local FIELDS = {
	{ key = "Speed", label = "Speed", kind = "number", min = 10, max = math.huge, default = 220 },
	{ key = "Acceleration", label = "Acceleration", kind = "number", min = -math.huge, max = math.huge, default = 0 },
	{ key = "MinSpeed", label = "Min speed", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "MaxSpeed", label = "Max speed", kind = "number", min = 0, max = math.huge, default = 1000 },
	{ key = "Damage", label = "Damage", kind = "number", min = 0, max = math.huge, default = 20 },
	{ key = "Lifetime", label = "Lifetime (s)", kind = "number", min = 0.1, max = math.huge, default = 4 },
	{ key = "Gravity", label = "Gravity", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "Radius", label = "Radius (sphere)", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "Bounces", label = "Bounces", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "Restitution", label = "Restitution", kind = "number", min = 0, max = math.huge, default = 0.5 },
	{ key = "Penetration", label = "Penetration (studs)", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "Pierces", label = "Pierces", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "PierceFalloff", label = "Pierce falloff", kind = "number", min = 0, max = math.huge, default = 0.2 },
	{ key = "Homing", label = "Homing", kind = "bool", default = false },
	{ key = "Permalock", label = "Permalock", kind = "bool", default = false },
	{ key = "TurnRate", label = "Turn rate (deg)", kind = "number", min = 0, max = math.huge, default = 140 },
	{ key = "AcquireRadius", label = "Acquire radius", kind = "number", min = 0, max = math.huge, default = 60 },
}

local config = {}
for _, field in FIELDS do
	config[field.key] = field.default
end

-- Which fields the dev has actually edited in THIS session -- see the
-- module doc comment. Set true only from a field's own edit handler below.
local touched: { [string]: boolean } = {}

local started = false
local screenGui: ScreenGui? = nil

function ShooterConfigGui.getConfig()
	local result = {}
	for key in touched do
		result[key] = config[key]
	end
	return result
end

-- Shown only while a shooting weapon tool is equipped (see ToolManager.luau
-- / ToolControllers/_ShootingWeapon.luau). No-ops if the panel hasn't been
-- built yet.
function ShooterConfigGui.setVisible(visible: boolean)
	if screenGui then
		screenGui.Enabled = visible
	end
end

local function makeRow(parent: Instance, field, layoutOrder: number)
	local row = Instance.new("Frame")
	row.Name = field.key
	row.Size = UDim2.new(1, 0, 0, 26)
	row.BackgroundTransparency = 1
	row.LayoutOrder = layoutOrder
	row.Parent = parent

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(0.58, 0, 1, 0)
	label.Font = Enum.Font.Gotham
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = Color3.fromRGB(210, 216, 230)
	label.Text = field.label
	label.Parent = row

	if field.kind == "number" then
		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(1, 0.5)
		box.Position = UDim2.new(1, 0, 0.5, 0)
		box.Size = UDim2.new(0.4, 0, 0, 22)
		box.BackgroundColor3 = Color3.fromRGB(38, 42, 56)
		box.BorderSizePixel = 0
		box.Font = Enum.Font.GothamMedium
		box.TextSize = 13
		box.TextColor3 = Color3.fromRGB(235, 240, 255)
		box.ClearTextOnFocus = false
		box.Text = tostring(config[field.key])
		box.Parent = row
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = box

		box.FocusLost:Connect(function()
			local n = tonumber(box.Text)
			if n then
				n = math.clamp(n, field.min, field.max)
				config[field.key] = n
				touched[field.key] = true
			end
			box.Text = tostring(config[field.key])
		end)
	else -- bool
		local toggle = Instance.new("TextButton")
		toggle.AnchorPoint = Vector2.new(1, 0.5)
		toggle.Position = UDim2.new(1, 0, 0.5, 0)
		toggle.Size = UDim2.new(0.4, 0, 0, 22)
		toggle.BorderSizePixel = 0
		toggle.Font = Enum.Font.GothamMedium
		toggle.TextSize = 13
		toggle.Parent = row
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = toggle

		local function render()
			local on = config[field.key] == true
			toggle.Text = on and "ON" or "OFF"
			toggle.BackgroundColor3 = on and Color3.fromRGB(70, 170, 90) or Color3.fromRGB(60, 64, 78)
			toggle.TextColor3 = Color3.fromRGB(240, 245, 255)
		end
		render()
		toggle.Activated:Connect(function()
			config[field.key] = not config[field.key]
			touched[field.key] = true
			render()
		end)
	end
end

local function build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local screen = Instance.new("ScreenGui")
	screen.Name = "ShooterConfigGui"
	screen.ResetOnSpawn = false
	screen.Enabled = false -- hidden until a shooting weapon tool is equipped
	screen.Parent = playerGui
	screenGui = screen

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(1, 0.5)
	panel.Position = UDim2.new(1, -12, 0.5, 0)
	panel.Size = UDim2.fromOffset(240, 400)
	panel.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
	panel.BackgroundTransparency = 0.1
	panel.BorderSizePixel = 0
	panel.Parent = screen
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = panel

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(14, 8)
	title.Size = UDim2.new(1, -28, 0, 22)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 15
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.fromRGB(235, 240, 255)
	title.Text = "Shooter Settings (Studio only)"
	title.Parent = panel

	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromOffset(12, 36)
	list.Size = UDim2.new(1, -24, 1, -48)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 4
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	for i, field in FIELDS do
		makeRow(list, field, i)
	end
end

-- Never builds outside Studio: the server ignores a live client's Config
-- entirely (see Shooter.server.luau), so showing this panel to real players
-- in a published game would just be confusing clutter with zero effect.
function ShooterConfigGui.start()
	if started or not RunService:IsStudio() then
		return
	end
	started = true
	build()
end

return ShooterConfigGui
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">ShooterController</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	ShooterController (client)
	Click to fire. Sends where the player is AIMING (a world point found via a
	camera ray through the cursor) to the server, which spawns the actual
	bullet via the Projectile system. Purely an input forwarder — no
	authority here. Where the shot actually SPAWNS from (a weapon's "Tip"
	Attachment if it has one, else the character's Head) is resolved entirely
	server-side (see Shooter.server.luau's resolveMuzzleOrigin) — the client
	never sends an origin at all, only the aimed-at point, so the server can
	converge the shot exactly where the player clicked regardless of which
	origin it ends up using.

	start()/stop() are called by any shooting weapon's ToolControllers/
	<Name>.luau Equip/Unequip (see _ShootingWeapon.luau) -- this only
	listens for input while one of those tools is actually equipped. The
	server enforces this independently for FireBullet/ReloadWeapon/
	StressTestFire (see Shooter.server.luau, which validates against the
	Weapons registry), so this is about not listening for input at all
	while no shooting tool is equipped, not about security. Every weapon's
	REAL numbers live server-side in its own Weapons/<Name>.luau module;
	tuning them means editing that file, not this panel. In Studio only,
	ShooterConfigGui's live-tunable overrides are also sent along (see
	Shooter.server.luau's applyStudioDebugOverrides) -- a live client never
	sends or has this read at all.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualOffload = require(Shared.VisualOffload)
local ShooterConfigGui = require(script.Parent.ShooterConfigGui)

local ShooterController = {}

local player = Players.LocalPlayer
local COOLDOWN = 0.1 -- matches Shooter.server.luau's MIN_FIRE_INTERVAL floor; the server enforces its own copy regardless
local lastFire = 0
local debugRays = false -- matches the server default; toggle with B
local debugSync = false -- prints ProjSpawn/ProjSync/ProjHit + a ProjMove rate summary server-side; toggle with V
local inputConnection: RBXScriptConnection? = nil

local AIM_RANGE = 5000

local function fire()
	local character = player.Character
	local camera = workspace.CurrentCamera
	if not character or not camera then
		return
	end

	-- find the WORLD POINT under the cursor (camera ray -> first surface).
	local screenPos = UserInputService:GetMouseLocation()
	local camRay = camera:ViewportPointToRay(screenPos.X, screenPos.Y)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true
	local hit = workspace:Raycast(camRay.Origin, camRay.Direction * AIM_RANGE, params)
	local targetPoint = hit and hit.Position or (camRay.Origin + camRay.Direction * AIM_RANGE)

	-- Every gameplay number (Model/Speed/Damage/etc.) AND the spawn origin
	-- itself come from the server (see Shooter.server.luau) -- this only
	-- ever sends the aimed-at world point, plus (Studio only) the debug
	-- panel's overrides, which a live server never even looks at.
	local payload = { TargetPoint = targetPoint }
	if RunService:IsStudio() then
		payload.Config = ShooterConfigGui.getConfig()
	end
	VisualOffload.Fire("FireBullet", payload)
end

local function reload()
	VisualOffload.Fire("ReloadWeapon", {})
end

-- Load-testing the projectile system means spawning many projectiles AT ONCE, not
-- firing many separate player shots -- Shooter.server.luau's MIN_FIRE_INTERVAL floor
-- (10/sec) exists to rate-limit real clicking and would silently drop almost all of a tight
-- client-side firing loop. This sends ONE request asking the server to spawn N
-- projectiles directly, bypassing that per-click gate entirely (see StressTestFire
-- in Shooter.server.luau). Press N to fire a stress-test batch.
local STRESS_TEST_COUNT = 10000

local function stressTest()
	VisualOffload.Fire("StressTestFire", { Count = STRESS_TEST_COUNT })
end

function ShooterController.start()
	if inputConnection then
		return
	end

	inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return -- click was consumed by the GUI (e.g. the time slider)
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local now = os.clock()
			if now - lastFire >= COOLDOWN then
				lastFire = now
				fire()
			end
		elseif input.KeyCode == Enum.KeyCode.B then
			-- toggle raycast hit-detection visualization (server owns the flag)
			debugRays = not debugRays
			VisualOffload.Fire("SetProjectileDebug", debugRays)
		elseif input.KeyCode == Enum.KeyCode.N then
			stressTest()
		elseif input.KeyCode == Enum.KeyCode.R then
			reload()
		elseif input.KeyCode == Enum.KeyCode.V then
			-- toggle ProjSpawn/ProjSync/ProjHit + ProjMove-rate server console logging
			debugSync = not debugSync
			VisualOffload.Fire("SetProjectileSyncDebug", debugSync)
		end
	end)
end

function ShooterController.stop()
	if inputConnection then
		inputConnection:Disconnect()
		inputConnection = nil
	end
end

return ShooterController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">SpellAssemblerGui</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Spell circle editor: a full-screen whiteboard for building spell cards,
	plus the compact HUD shown while the SpellAssembler tool is held.
	Public API (used by ToolControllers/SpellAssembler): Open, Close, Toggle,
	Cast, Equip, Unequip.

	Layout: top bar (name, card slots, save/equip) over a row of
	[Toolbox | Board | Inspector]. Both side panels resize by dragging their
	inner edge and collapse from the top bar. The pieces live in SpellEditor/:
	Document (graph + undo), Board (whiteboard), Panels (toolbox, inspector,
	problems).

	While the editor is open its root frame is Active, so mouse input never
	reaches the camera, and movement keys are sunk through
	ContextActionService.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local HttpService = game:GetService("HttpService")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local SpellCompiler = require(Shared:WaitForChild("SpellCompiler"))
local SpellRunes = require(Shared:WaitForChild("SpellRunes"))
local remotes = ReplicatedStorage:WaitForChild("SpellRemotes")
local command = remotes:WaitForChild("SpellCommand") :: RemoteFunction
local castRemote = remotes:WaitForChild("SpellCast") :: RemoteEvent
local aimRemote = remotes:WaitForChild("SpellAim") :: UnreliableRemoteEvent
local channelRemote = remotes:WaitForChild("SpellChannel") :: RemoteEvent
local holdingCast = false

local EditorFolder = script.Parent:WaitForChild("SpellEditor")
local Theme = require(EditorFolder:WaitForChild("Theme"))
local Document = require(EditorFolder:WaitForChild("Document"))
local Board = require(EditorFolder:WaitForChild("Board"))
local Panels = require(EditorFolder:WaitForChild("Panels"))

local Colors = Theme.Colors
local SpellAssemblerGui = {}

local SLOT_COUNT = 5
local TOP_BAR = 52
local HANDLE = 6
local LEFT_RANGE = Vector2.new(200, 480)
local RIGHT_RANGE = Vector2.new(240, 520)
local SINK_ACTION = "SpellEditorSinkMovement"
local AIM_SEND_INTERVAL = 0.05 -- live cursor for Stream/Sustain re-aiming
local SINK_KEYS = {
	Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Space,
	Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right,
}

local equippedTool: Tool? = nil
local gui: ScreenGui? = nil
local root: Frame? = nil
local hud: Frame? = nil
local activeLabel: TextLabel? = nil
local toast: TextLabel? = nil
local nameBox: TextBox? = nil
local saveButton: TextButton? = nil
local zoomLabel: TextLabel? = nil
local ghost: TextLabel? = nil
local slotButtons: { TextButton } = {}
local toolboxFrame: Frame? = nil
local inspectorFrame: Frame? = nil
local viewport: Frame? = nil
local leftHandle: TextButton? = nil
local rightHandle: TextButton? = nil

local doc = Document.new(SpellCompiler.CreateDefaultGraph())
local board: any = nil
local toolbox: any = nil
local inspector: any = nil
local problems: any = nil

local serverState: any = { slots = {}, activeSlot = nil }
local selectedSlot = 1
local savedSignature: string? = nil
local savingCard = false
local hasLoadedCards = false
local errors: { any } = {}
local analysis: any = nil
local compiledOk = false
local visible = false
local needsFrame = true
local placing: any = nil
local resizing: any = nil
local armedZone: string? = nil
local toastToken = 0
local panelState = { left = 280, right = 330, leftOpen = true, rightOpen = true }

--------------------------------------------------------------------------------
-- State helpers
--------------------------------------------------------------------------------

local function slotRecord(slot: number): any?
	local slots = serverState.slots
	return slots and (slots[tostring(slot)] or slots[slot])
end

local function currentName(): string
	return if nameBox and nameBox.Text ~= "" then nameBox.Text else doc.graph.name
end

local function signature(): string
	doc.graph.name = currentName()
	return HttpService:JSONEncode(doc.graph)
end

local function setStatus(message: string, good: boolean?, sticky: boolean?)
	if not toast then return end
	toastToken += 1
	local token = toastToken
	toast.Text = message
	toast.TextColor3 = if good == true then Colors.good elseif good == false then Colors.bad else Colors.text
	toast.Visible = message ~= ""
	if not sticky then
		task.delay(4, function()
			if toastToken == token and toast then
				toast.Visible = false
				if armedZone then
					setStatus(`Drawing a {armedZone} zone: drag on the board (Shift keeps the pen, Esc cancels)`, nil, true)
				end
			end
		end)
	end
end

local function context()
	return {
		selection = board and board.selection,
		errors = errors,
		estimates = analysis and analysis.estimates,
		analysis = analysis,
	}
end

local function updateTopBar()
	local dirty = savedSignature ~= signature()
	for slot, button in slotButtons do
		local record = slotRecord(slot)
		local active = serverState.activeSlot == slot
		button.Text = `{slot}  {if record then record.name else "Empty"}{if active then "  ◆" else ""}`
		button.BackgroundColor3 = if selectedSlot == slot then Colors.accent:Lerp(Colors.panel, 0.45) else Colors.panel2
		button.TextColor3 = if record then Colors.text else Colors.muted
	end
	if saveButton then
		local available = serverState.available == true
		saveButton.Text = if savingCard then "Saving…" elseif not available then "Save unavailable" elseif dirty then `Save to {selectedSlot} •` else "Saved"
		saveButton.BackgroundColor3 = if compiledOk and dirty and available and not savingCard then Color3.fromRGB(58, 128, 86) else Colors.panel3
		saveButton.AutoButtonColor = compiledOk and available and not savingCard
	end
	local active = serverState.activeSlot and slotRecord(serverState.activeSlot)
	if activeLabel then
		activeLabel.Text = `Active spell: {if active then active.name else "None"}`
	end
end

local function refresh()
	if not board then return end
	doc.graph.name = currentName()
	local compiled, compileErrors, _, compileAnalysis = SpellCompiler.Compile(doc.graph)
	compiledOk = compiled ~= nil
	errors = compileErrors
	analysis = compileAnalysis
	local byRune = {}
	for _, problem in errors do
		if problem.rune then byRune[problem.rune] = true end
	end
	board:setAnnotations(byRune, if analysis then analysis.estimates else {})
	board:render()
	inspector:show(context())
	local summary = if analysis then `Valid · {analysis.manaCost} mana per cast` else "Valid"
	problems:show(errors, summary)
	updateTopBar()
end

--------------------------------------------------------------------------------
-- Commands
--------------------------------------------------------------------------------

local function invoke(action: string, payload: any?): any
	local ok, result = pcall(command.InvokeServer, command, action, payload)
	if not ok or typeof(result) ~= "table" then
		return { ok = false, message = "The spell service did not respond." }
	end
	return result
end

local function applyServerResult(result: any)
	if result.state then serverState = result.state end
	local message = result.message or ""
	if not result.ok and result.errors and result.errors[1] then
		message = result.errors[1].message or message
	end
	setStatus(message, result.ok)
	updateTopBar()
end

-- The server rate-limits spell commands (COMMAND_INTERVAL = 0.15s), so
-- chained commands wait this long between calls.
local COMMAND_GAP = 0.2

local function equipSlot(slot: number)
	setStatus("Equipping…", nil, true)
	local result = invoke("SetActive", { slot = slot })
	if result.ok then
		result.message = `Equipped "{(slotRecord(slot) or {}).name or "spell"}". Close the editor [E] and click to cast.`
	end
	applyServerResult(result)
end

-- Saves the circle to the selected slot. The first saved spell is equipped
-- automatically, so a fresh card is castable right after saving.
local function saveCard(): boolean
	if savingCard then return false end
	if serverState.available ~= true then
		setStatus(serverState.error or "Spell storage is unavailable.", false, true)
		return false
	end
	if not compiledOk then
		local first = errors[1]
		setStatus(if first then `Can't save yet: {first.message}` else "Fix the problems on the board before saving.", false)
		return false
	end
	setStatus("Saving…", nil, true)
	savingCard = true
	updateTopBar()
	local result = invoke("SaveCard", { slot = selectedSlot, name = currentName(), graph = doc.graph })
	savingCard = false
	-- Apply the authoritative state BEFORE reading the saved record. Loading
	-- its normalized graph/name avoids marking an older local copy as Saved.
	if result.state then serverState = result.state end
	if result.ok then
		local record = slotRecord(selectedSlot)
		if record and record.graph then doc:load(record.graph) end
		if record and nameBox then nameBox.Text = record.name end
		savedSignature = signature()
	end
	applyServerResult(result)
	refresh()
	if result.ok and not serverState.activeSlot then
		task.wait(COMMAND_GAP)
		equipSlot(selectedSlot)
	end
	return result.ok == true
end

-- Makes the next/previous saved slot the active spell (HUD arrows).
local function cycleActive(direction: number)
	local current = serverState.activeSlot or selectedSlot
	for step = 1, SLOT_COUNT do
		local slot = (current - 1 + direction * step) % SLOT_COUNT + 1
		if slotRecord(slot) then
			if slot ~= serverState.activeSlot then
				equipSlot(slot)
			end
			return
		end
	end
end

local function loadSlot(slot: number)
	selectedSlot = slot
	local record = slotRecord(slot)
	if record and record.invalid then
		savedSignature = nil
		setStatus(record.error or "This older card cannot be compiled; its saved data has been preserved.", false, true)
		updateTopBar()
		return
	end
	if record and record.graph then
		doc:load(record.graph)
		if nameBox then nameBox.Text = record.name end
		if board then
			board.selection = nil
			board:frameAll()
		end
		savedSignature = signature()
		setStatus(`Loaded "{record.name}".`)
	else
		savedSignature = nil
		setStatus(`Slot {slot} is empty: saving will put this circle there.`)
	end
	refresh()
end

local function newSpell()
	doc:load(SpellCompiler.CreateDefaultGraph())
	if nameBox then nameBox.Text = doc.graph.name end
	savedSignature = nil
	if board then
		board.selection = nil
		board:frameAll()
	end
	refresh()
end

local function deleteSelection()
	local selection = board and board.selection
	if not selection then return end
	doc:record()
	if selection.kind == "rune" then
		doc:removeRune(selection.id)
	elseif selection.kind == "zone" then
		doc:removeZone(selection.id)
	else
		doc:removeWire(selection.wire)
	end
	board.selection = nil
	refresh()
end

local function duplicateSelection()
	local selection = board and board.selection
	if not selection or selection.kind ~= "rune" then return end
	local source = doc:rune(selection.id)
	if not source then return end
	doc:record()
	local ax, ay = SpellCompiler.RuneAnchor(source)
	local copy = doc:addRune(source.rune, ax + 30, ay + 30)
	if copy then
		copy.params = Document.deepCopy(source.params)
		board.selection = { kind = "rune", id = copy.id }
	end
	refresh()
end

local function toggleLock()
	local selection = board and board.selection
	local target = selection and (if selection.kind == "rune" then doc:rune(selection.id)
		elseif selection.kind == "zone" then doc:zone(selection.id) else nil)
	if not target then return end
	doc:record()
	target.locked = if target.locked then nil else true
	setStatus(if target.locked then "Locked in place." else "Unlocked.")
	refresh()
end

local function armZone(kind: string?)
	armedZone = kind
	if board then board.armedZone = kind end
	if toolbox then toolbox:setArmed(kind) end
	if kind then
		setStatus(`Drawing a {kind} zone: drag on the board (Shift keeps the pen, Esc cancels)`, nil, true)
	else
		setStatus("")
	end
end

local function focusProblem(problem: any)
	if not problem.rune then return end
	local rune = doc:rune(problem.rune)
	if not rune then return end
	board.selection = { kind = "rune", id = rune.id }
	local ax, ay = SpellCompiler.RuneAnchor(rune)
	board:centerOn(Vector2.new(ax, ay + 40))
	refresh()
end

--------------------------------------------------------------------------------
-- Layout
--------------------------------------------------------------------------------

local function relayout()
	if not toolboxFrame or not inspectorFrame or not viewport or not leftHandle or not rightHandle then return end
	local left = if panelState.leftOpen then panelState.left else 0
	local right = if panelState.rightOpen then panelState.right else 0
	local leftSpace = if panelState.leftOpen then left + HANDLE else 0
	local rightSpace = if panelState.rightOpen then right + HANDLE else 0
	toolboxFrame.Visible = panelState.leftOpen
	toolboxFrame.Size = UDim2.new(0, left, 1, 0)
	leftHandle.Visible = panelState.leftOpen
	leftHandle.Position = UDim2.new(0, left, 0, 0)
	inspectorFrame.Visible = panelState.rightOpen
	inspectorFrame.Position = UDim2.new(1, -right, 0, 0)
	inspectorFrame.Size = UDim2.new(0, right, 1, 0)
	rightHandle.Visible = panelState.rightOpen
	rightHandle.Position = UDim2.new(1, -rightSpace, 0, 0)
	viewport.Position = UDim2.new(0, leftSpace, 0, 0)
	viewport.Size = UDim2.new(1, -(leftSpace + rightSpace), 1, 0)
end

local function makeHandle(parent: Frame, side: string): TextButton
	local handle = Theme.make("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(0, HANDLE, 1, 0),
		BackgroundColor3 = Colors.line,
		BackgroundTransparency = 0.7,
		BorderSizePixel = 0,
		ZIndex = 5,
	}, parent)
	handle.MouseEnter:Connect(function() handle.BackgroundTransparency = 0.2 end)
	handle.MouseLeave:Connect(function() if not resizing then handle.BackgroundTransparency = 0.7 end end)
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = { side = side, start = Board.pointer(input).X, width = panelState[side], handle = handle }
		end
	end)
	return handle
end

--------------------------------------------------------------------------------
-- Build
--------------------------------------------------------------------------------

local function buildTopBar(parent: Frame)
	local bar = Theme.make("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, TOP_BAR),
		BackgroundColor3 = Colors.panel,
		BorderSizePixel = 0,
	}, parent)
	Theme.make("Frame", { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Colors.line, BackgroundTransparency = 0.5, BorderSizePixel = 0 }, bar)

	-- Everything left of the panel toggles. The slot tabs share whatever width
	-- the fixed controls leave (see fitTopBar), so Equip/Delete can never be
	-- pushed off the edge on narrower screens.
	local leftGroup = Theme.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -260, 1, 0), ClipsDescendants = true }, bar)
	local leftList = Theme.list(leftGroup, 8, true)
	leftList.VerticalAlignment = Enum.VerticalAlignment.Center
	Theme.make("UIPadding", { PaddingLeft = UDim.new(0, 14) }, leftGroup)

	Theme.label(leftGroup, "SPELL CIRCLE", 15, { Font = Theme.FontBold, Size = UDim2.fromOffset(118, 32), TextColor3 = Colors.accent, LayoutOrder = 1 })
	local box = Theme.make("TextBox", {
		Size = UDim2.fromOffset(170, 34),
		BackgroundColor3 = Colors.panel2,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Theme.FontMedium,
		PlaceholderText = "Spell name",
		PlaceholderColor3 = Colors.muted,
		Text = doc.graph.name,
		TextColor3 = Colors.text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 2,
	}, leftGroup)
	Theme.corner(box, 6)
	Theme.make("UIPadding", { PaddingLeft = UDim.new(0, 10) }, box)
	box.FocusLost:Connect(function() updateTopBar() end)
	nameBox = box

	for slot = 1, SLOT_COUNT do
		local button = Theme.button(leftGroup, tostring(slot), {
			Size = UDim2.fromOffset(122, 34),
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = 10 + slot,
		})
		button.Activated:Connect(function() loadSlot(slot) end)
		slotButtons[slot] = button
	end
	local newButton = Theme.button(leftGroup, "New", { Size = UDim2.fromOffset(56, 34), LayoutOrder = 3 })
	newButton.Activated:Connect(newSpell)
	local save = Theme.button(leftGroup, "Save", { Size = UDim2.fromOffset(104, 34), LayoutOrder = 4 })
	save.Activated:Connect(saveCard)
	saveButton = save
	local equip = Theme.button(leftGroup, "Equip", { Size = UDim2.fromOffset(64, 34), LayoutOrder = 5, BackgroundColor3 = Color3.fromRGB(60, 96, 130) })
	equip.Activated:Connect(function()
		-- Equipping unsaved edits would cast the old version: save first.
		if savedSignature ~= signature() then
			if not saveCard() then return end
			task.wait(COMMAND_GAP)
		end
		equipSlot(selectedSlot)
	end)
	local delete = Theme.button(leftGroup, "Delete", { Size = UDim2.fromOffset(64, 34), LayoutOrder = 6, BackgroundColor3 = Color3.fromRGB(100, 40, 56) })
	delete.Activated:Connect(function()
		applyServerResult(invoke("DeleteCard", { slot = selectedSlot }))
	end)

	-- Fixed-width controls above: title 118 + name 170 + New 56 + Save 104 +
	-- Equip 64 + Delete 64, plus 10 gaps of 8 and 14 left padding.
	local FIXED_WIDTH = 118 + 170 + 56 + 104 + 64 + 64 + 10 * 8 + 14
	local function fitTopBar()
		local slotWidth = math.clamp(math.floor((leftGroup.AbsoluteSize.X - FIXED_WIDTH) / SLOT_COUNT), 44, 130)
		for _, button in slotButtons do
			button.Size = UDim2.fromOffset(slotWidth, 34)
		end
	end
	leftGroup:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitTopBar)
	fitTopBar()

	local rightGroup = Theme.make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 0), Size = UDim2.new(0, 250, 1, 0), BackgroundTransparency = 1 }, bar)
	local rightList = Theme.list(rightGroup, 8, true)
	rightList.VerticalAlignment = Enum.VerticalAlignment.Center
	rightList.HorizontalAlignment = Enum.HorizontalAlignment.Right
	local toolsToggle = Theme.button(rightGroup, "Toolbox", { Size = UDim2.fromOffset(74, 34), LayoutOrder = 1 })
	toolsToggle.Activated:Connect(function()
		panelState.leftOpen = not panelState.leftOpen
		relayout()
	end)
	local inspectToggle = Theme.button(rightGroup, "Inspector", { Size = UDim2.fromOffset(80, 34), LayoutOrder = 2 })
	inspectToggle.Activated:Connect(function()
		panelState.rightOpen = not panelState.rightOpen
		relayout()
	end)
	local close = Theme.button(rightGroup, "Close [E]", { Size = UDim2.fromOffset(76, 34), LayoutOrder = 3 })
	close.Activated:Connect(function() SpellAssemblerGui.Close() end)
end

local function buildBoardOverlays(view: Frame)
	local label = Theme.label(view, "", 13, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Colors.panel,
		BackgroundTransparency = 0.1,
		Font = Theme.FontMedium,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		ZIndex = 20,
	})
	Theme.corner(label, 8)
	Theme.make("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }, label)
	toast = label

	local zoom = Theme.make("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.fromOffset(212, 36),
		BackgroundColor3 = Colors.panel,
		BorderSizePixel = 0,
		Active = true,
		ZIndex = 10,
	}, view)
	Theme.corner(zoom, 8)
	Theme.padding(zoom, 4)
	Theme.list(zoom, 4, true)
	local function zoomButton(text: string, width: number, order: number, callback: () -> ())
		local button = Theme.button(zoom, text, { Size = UDim2.fromOffset(width, 28), LayoutOrder = order, ZIndex = 11 })
		button.Activated:Connect(callback)
	end
	zoomButton("−", 32, 1, function() board:zoomBy(1 / 1.25) end)
	zoomLabel = Theme.label(zoom, "100%", 12, { Size = UDim2.fromOffset(52, 28), TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2, ZIndex = 11 })
	zoomButton("+", 32, 3, function() board:zoomBy(1.25) end)
	zoomButton("Fit [F]", 72, 4, function() board:frameAll() end)
	board:addOverlay(zoom)

	problems = Panels.Problems.new(view, { onFocus = focusProblem })
	board:addOverlay(problems.frame)
end

local function buildGui()
	if gui then return end
	local screen = Theme.make("ScreenGui", {
		Name = "SpellCircleEditor",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 80,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Enabled = false,
	}, player:WaitForChild("PlayerGui"))
	gui = screen

	local editor = Theme.make("Frame", {
		Name = "Editor",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.background,
		BorderSizePixel = 0,
		Active = true, -- keeps clicks/wheel away from the camera
		Visible = false,
	}, screen)
	Theme.make("UIPadding", { PaddingTop = UDim.new(0, GuiService:GetGuiInset().Y) }, editor)
	root = editor
	buildTopBar(editor)

	local row = Theme.make("Frame", { Name = "Body", Position = UDim2.fromOffset(0, TOP_BAR), Size = UDim2.new(1, 0, 1, -TOP_BAR), BackgroundTransparency = 1 }, editor)
	toolboxFrame = Theme.make("Frame", { Name = "Toolbox", BackgroundColor3 = Colors.panel, BorderSizePixel = 0 }, row)
	inspectorFrame = Theme.make("Frame", { Name = "Inspector", BackgroundColor3 = Colors.panel, BorderSizePixel = 0 }, row)
	viewport = Theme.make("Frame", { Name = "Board", BorderSizePixel = 0 }, row)
	leftHandle = makeHandle(row, "left")
	rightHandle = makeHandle(row, "right")

	board = Board.new(viewport :: Frame, doc, {
		onChanged = refresh,
		onSelect = function() if inspector then inspector:show(context()) end end,
		onArm = function(kind: string?) armZone(kind) end,
		onView = function(zoom: number) if zoomLabel then zoomLabel.Text = `{math.floor(zoom * 100 + 0.5)}%` end end,
		onMessage = function(text: string) setStatus(text, false) end,
	})
	toolbox = Panels.Toolbox.new(toolboxFrame :: Frame, {
		onArmZone = armZone,
		onRunePress = function(runeId: string)
			placing = { runeId = runeId, start = Board.pointer(), moved = false }
			if ghost then ghost.Text = "＋ " .. SpellRunes.Runes[runeId].Name end
		end,
	})
	inspector = Panels.Inspector.new(inspectorFrame :: Frame, {
		edit = function(fn)
			doc:record()
			fn()
			refresh()
		end,
		liveEdit = function(fn)
			fn()
			refresh()
		end,
		beginLive = function() doc:record() end,
		delete = deleteSelection,
		doc = function() return doc end,
	})
	buildBoardOverlays(viewport :: Frame)
	relayout()

	ghost = Theme.label(screen, "", 13, {
		Font = Theme.FontBold,
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Colors.accent,
		BackgroundTransparency = 0.15,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		ZIndex = 50,
	})
	Theme.corner(ghost :: TextLabel, 6)
	Theme.make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, ghost)

	-- Compact HUD while the tool is held and the editor is closed.
	local compact = Theme.make("Frame", {
		Name = "Compact",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -18),
		Size = UDim2.fromOffset(400, 54),
		BackgroundColor3 = Colors.panel,
		BorderSizePixel = 0,
		Visible = false,
	}, screen)
	Theme.corner(compact, 10)
	Theme.stroke(compact)
	hud = compact
	local previous = Theme.button(compact, "◀", { Position = UDim2.fromOffset(8, 9), Size = UDim2.fromOffset(30, 36) })
	previous.Activated:Connect(function() cycleActive(-1) end)
	activeLabel = Theme.label(compact, "Active spell: None", 13, {
		Position = UDim2.fromOffset(44, 0),
		Size = UDim2.new(1, -224, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local nextButton = Theme.button(compact, "▶", { Position = UDim2.new(1, -172, 0, 9), Size = UDim2.fromOffset(30, 36) })
	nextButton.Activated:Connect(function() cycleActive(1) end)
	local edit = Theme.button(compact, "Edit [E]", { Position = UDim2.new(1, -134, 0, 9), Size = UDim2.fromOffset(70, 36) })
	edit.Activated:Connect(function() SpellAssemblerGui.Open() end)
	local castButton = Theme.button(compact, "Cast", { Position = UDim2.new(1, -58, 0, 9), Size = UDim2.fromOffset(48, 36), BackgroundColor3 = Color3.fromRGB(128, 58, 44) })
	castButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then SpellAssemblerGui.Cast() end
	end)
	castButton.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then SpellAssemblerGui.StopCast() end
	end)

	--------------------------------------------------------------------------
	-- Input routing. Mouse input goes to the board whenever it's over the
	-- viewport, regardless of gameProcessed (the Active root marks it
	-- processed on purpose); keys respect gameProcessed so typing in a
	-- TextBox never triggers shortcuts.
	--------------------------------------------------------------------------
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.E and not processed and equippedTool then
			SpellAssemblerGui.Toggle()
			return
		end
		if not visible then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			if not placing and not resizing then board:inputBegan(input) end
			return
		end
		if processed then return end
		local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		local key = input.KeyCode
		if key == Enum.KeyCode.Delete or key == Enum.KeyCode.Backspace then
			deleteSelection()
		elseif ctrl and (key == Enum.KeyCode.Y or (key == Enum.KeyCode.Z and shift)) then
			if doc:redo() then refresh() end
		elseif ctrl and key == Enum.KeyCode.Z then
			if doc:undo() then refresh() end
		elseif ctrl and key == Enum.KeyCode.D then
			duplicateSelection()
		elseif ctrl and key == Enum.KeyCode.S then
			saveCard()
		elseif key == Enum.KeyCode.L then
			toggleLock()
		elseif key == Enum.KeyCode.F then
			board:frameAll()
		elseif key == Enum.KeyCode.Escape then
			if board:cancel() then return end
			if armedZone then armZone(nil) else board:select(nil) end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not visible then return end
		local movement = input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
		if resizing and movement then
			local dx = Board.pointer(input).X - resizing.start
			if resizing.side == "left" then
				panelState.left = math.clamp(resizing.width + dx, LEFT_RANGE.X, LEFT_RANGE.Y)
			else
				panelState.right = math.clamp(resizing.width - dx, RIGHT_RANGE.X, RIGHT_RANGE.Y)
			end
			relayout()
		elseif placing and movement then
			local p = Board.pointer(input)
			if (p - placing.start).Magnitude > 4 then placing.moved = true end
			if placing.moved and ghost then
				ghost.Visible = true
				ghost.Position = UDim2.fromOffset(p.X + 14, p.Y + 10 + GuiService:GetGuiInset().Y)
			end
		else
			board:inputChanged(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then SpellAssemblerGui.StopCast() end
		if not visible then return end
		local release = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
		if resizing and release then
			resizing.handle.BackgroundTransparency = 0.7
			resizing = nil
		elseif placing and release then
			local p = Board.pointer(input)
			local job = placing
			placing = nil
			if ghost then ghost.Visible = false end
			if job.moved then
				if board:accepts(p) then board:placeRune(job.runeId, p) end
			else
				board:placeRune(job.runeId, nil)
			end
		else
			board:inputEnded(input)
		end
	end)

	refresh()
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------

local function sinkMovement(): Enum.ContextActionResult
	return Enum.ContextActionResult.Sink
end

function SpellAssemblerGui.Open()
	SpellAssemblerGui.StopCast()
	buildGui()
	visible = true;
	(gui :: ScreenGui).Enabled = true;
	(root :: Frame).Visible = true;
	(hud :: Frame).Visible = false
	ContextActionService:BindActionAtPriority(SINK_ACTION, sinkMovement, false, Enum.ContextActionPriority.High.Value + 100, table.unpack(SINK_KEYS))
	refresh()
	if needsFrame then
		needsFrame = false
		task.defer(function() board:frameAll() end)
	end
end

function SpellAssemblerGui.Close()
	if not gui then return end
	visible = false
	placing, resizing = nil, nil
	if ghost then ghost.Visible = false end
	if board then board:setCursor("") end
	ContextActionService:UnbindAction(SINK_ACTION);
	(root :: Frame).Visible = false;
	(hud :: Frame).Visible = equippedTool ~= nil
	updateTopBar()
end

function SpellAssemblerGui.Toggle()
	if visible then SpellAssemblerGui.Close() else SpellAssemblerGui.Open() end
end

function SpellAssemblerGui.Cast()
	if not equippedTool or visible or holdingCast then return end
	if not serverState.activeSlot then
		if activeLabel then
			activeLabel.Text = "No spell equipped: press E, then Save"
			activeLabel.TextColor3 = Colors.bad
			task.delay(2.5, function()
				if activeLabel then activeLabel.TextColor3 = Colors.text end
				updateTopBar()
			end)
		end
		return
	end
	local mouse = player:GetMouse()
	holdingCast = true
	castRemote:FireServer(mouse.Hit.Position)
end

function SpellAssemblerGui.StopCast()
	if not holdingCast then return end
	holdingCast = false
	channelRemote:FireServer("Stop")
end

local aimConnection: RBXScriptConnection? = nil

local function startAimStream()
	if aimConnection then return end
	local mouse = player:GetMouse()
	local elapsed, last, sinceSend = 0, nil, 0
	aimConnection = game:GetService("RunService").Heartbeat:Connect(function(dt)
		elapsed += dt
		sinceSend += dt
		if elapsed < AIM_SEND_INTERVAL or visible then return end
		elapsed = 0
		local position = mouse.Hit.Position
		if not last or (position - last).Magnitude > 0.1 or sinceSend >= 0.2 then
			last = position
			sinceSend = 0
			aimRemote:FireServer(position)
			if holdingCast then channelRemote:FireServer("KeepAlive") end
		end
	end)
end

local function stopAimStream()
	if aimConnection then
		aimConnection:Disconnect()
		aimConnection = nil
	end
end

function SpellAssemblerGui.Equip(tool: Tool)
	equippedTool = tool
	startAimStream()
	buildGui()
	setStatus("Loading spell cards…", nil, true)
	local result = invoke("GetState")
	if result.state then serverState = result.state end
	if result.ok and serverState.available and not hasLoadedCards then
		hasLoadedCards = true
		local initialSlot = serverState.activeSlot
		if not initialSlot then
			for slot = 1, SLOT_COUNT do if slotRecord(slot) then initialSlot = slot; break end end
		end
		if initialSlot then loadSlot(initialSlot) end
	end
	if result.state and result.state.error then
		setStatus(result.state.error, result.state.sessionOnly)
	else
		setStatus(result.message or "Cards loaded.", result.ok)
	end
	updateTopBar()
	SpellAssemblerGui.Open()
end

function SpellAssemblerGui.Unequip(tool: Tool)
	if equippedTool ~= tool then return end
	SpellAssemblerGui.StopCast()
	equippedTool = nil
	stopAimStream()
	if visible then SpellAssemblerGui.Close() end
	if gui then gui.Enabled = false end
end

return SpellAssemblerGui
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="88">
          <Properties>
            <string name="Name">SpellEditor</string>
          </Properties>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">Board</string>
              <string name="Source"><![CDATA[--!strict
--[[
	The whiteboard: an infinite, pannable, zoomable board holding zones, runes
	and wires.

	Rendering: a World frame is offset by `pan` and scaled by a UIScale of
	`zoom`, so everything inside is laid out in board units. Wires are routed
	with right angles only -- ClipsDescendants doesn't clip rotated
	GuiObjects, so angled segments would bleed over the side panels.

	Input: every board element is a plain non-Active Frame/TextLabel, and the
	controller forwards UserInputService events here. The board hit-tests in
	board space itself (ports > runes > wires > zone edges > zone headers >
	zone bodies > empty) instead of relying on GUI event bubbling, which keeps
	drag behaviour predictable.

	Mouse: right-drag (or middle-drag) pans the view over anything; wheel
	zooms around the cursor. Left-drag a rune to move it. Double-click a
	zone's tab to pick the zone up: hold and drag, or let go and it follows
	the cursor until the next click (Esc puts it back). Drag a zone's
	edge/corner to resize -- the band reaches 20px outside the border (30px at
	corners) and 8px inside, never into the tab. Drag a port to wire.
	Locked runes/zones never move or resize.

	Coordinates: AbsolutePosition space starts BELOW the Roblox top bar even
	in an IgnoreGuiInset ScreenGui, so the pointer is GetMouseLocation()
	minus the inset (verified in a playtest with GuiState hover probing).
]]

local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SpellCompiler = require(Shared:WaitForChild("SpellCompiler"))
local SpellRunes = require(Shared:WaitForChild("SpellRunes"))
local Theme = require(script.Parent.Theme)

local Board = {}
Board.__index = Board

local LAYOUT = SpellCompiler.Layout
local ZONE_HEADER = 32
local MIN_ZONE_W, MIN_ZONE_H = 160, 100
local DEFAULT_ZONE_W, DEFAULT_ZONE_H = 320, 220
local MIN_ZOOM, MAX_ZOOM = 0.25, 2
local PORT_RADIUS = 7
local GRID = 40
local SNAP = 10
local DRAG_THRESHOLD = 4 -- screen px before a press counts as a drag
local EDGE_OUT = 20 -- screen px outside a zone border that still resizes
local EDGE_IN = 8 -- ...and inside it (never into the tab)
local CORNER_OUT = 30 -- corners get bigger targets: they're the usual grab
local CORNER_IN = 16
local TAB_MIN = 28 -- the tab is at least this many screen px tall at any zoom
local DOUBLE_CLICK = 0.4 -- seconds between tab presses that start a zone move
local WIRE_REACH = 7 -- screen px

local CURSORS = {
	move = "rbxasset://SystemCursors/SizeAll",
	grab = "rbxasset://SystemCursors/ClosedHand",
	hand = "rbxasset://SystemCursors/PointingHand",
	cross = "rbxasset://SystemCursors/Cross",
	ew = "rbxasset://SystemCursors/SizeEW",
	ns = "rbxasset://SystemCursors/SizeNS",
	nwse = "rbxasset://SystemCursors/SizeNWSE",
	nesw = "rbxasset://SystemCursors/SizeNESW",
}

local WHITE = Color3.new(1, 1, 1)

local function snap(value: number): number
	return math.floor(value / SNAP + 0.5) * SNAP
end

local function isPress(input: InputObject): boolean
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

-- Pointer in AbsolutePosition space. That space starts below the Roblox top
-- bar even inside an IgnoreGuiInset ScreenGui, while GetMouseLocation()
-- starts at the very top of the window, so the inset must be subtracted.
-- (Touch InputObject positions are already in the right space.)
function Board.pointer(input: InputObject?): Vector2
	if input and input.UserInputType == Enum.UserInputType.Touch then
		return Vector2.new(input.Position.X, input.Position.Y)
	end
	return UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
end

function Board.categoryColor(def: any): Color3
	return SpellRunes.Zones[def.Zones[1]].Color
end

function Board.portPosition(rune: any, side: string, index: number): Vector2
	local y = rune.y + LAYOUT.Header + (index - 0.5) * LAYOUT.Row
	return Vector2.new(if side == "in" then rune.x else rune.x + LAYOUT.RuneWidth, y)
end

local function portIndex(ports: { any }, name: string): number?
	for index, port in ports do
		if port.Name == name then return index end
	end
	return nil
end

local function formatNumber(value: number): string
	if value % 1 == 0 then return tostring(value) end
	return string.format("%.1f", value)
end

-- One-line parameter summary shown in each rune's footer.
function Board.summary(rune: any): string
	local def = SpellRunes.Runes[rune.rune]
	local params = rune.params
	if def.Id == "Compare" or def.Id == "Math" then
		return `A {params.Op} B`
	end
	local parts = {}
	for _, param in def.Params do
		local value = params[param.Name]
		if param.Type == "bool" then
			if value then table.insert(parts, param.Label) end
		elseif param.Type == "number" then
			if param.Name == "Level" then
				table.insert(parts, `Lv {value}`)
			else
				table.insert(parts, formatNumber(value) .. (param.Suffix or ""))
			end
		else
			table.insert(parts, tostring(value))
		end
	end
	if #parts == 0 then
		return def.Category
	end
	return table.concat(parts, "  ·  ")
end

-- Right-angle route from an output port (a) to an input port (b).
local function route(a: Vector2, b: Vector2): { Vector2 }
	if b.X >= a.X + 30 then
		local mid = math.floor((a.X + b.X) / 2)
		return { a, Vector2.new(mid, a.Y), Vector2.new(mid, b.Y), b }
	end
	local out, back = a.X + 20, b.X - 20
	local lane = if math.abs(a.Y - b.Y) < 60 then math.max(a.Y, b.Y) + 70 else (a.Y + b.Y) / 2
	return { a, Vector2.new(out, a.Y), Vector2.new(out, lane), Vector2.new(back, lane), Vector2.new(back, b.Y), b }
end

local function distanceToSegment(p: Vector2, a: Vector2, b: Vector2): number
	local ab = b - a
	local lengthSq = ab:Dot(ab)
	local t = if lengthSq > 0 then math.clamp((p - a):Dot(ab) / lengthSq, 0, 1) else 0
	return (p - (a + ab * t)).Magnitude
end

function Board.new(viewport: Frame, doc: any, hooks: any)
	local self = setmetatable({}, Board)
	self.viewport = viewport
	self.doc = doc
	self.hooks = hooks
	self.pan = Vector2.new(60, 60)
	self.zoom = 1
	self.selection = nil :: any
	self.errors = {} :: { [string]: boolean }
	self.estimates = {} :: { [string]: any }
	self.overlays = {} :: { GuiObject }
	self.armedZone = nil :: string?
	self.drag = nil :: any
	self.zoneFrames = {} :: { [string]: Frame }
	self.zoneStrokes = {} :: { [string]: any }
	self.hoverZone = nil :: string?
	self.cursor = ""
	self.lastTabPress = nil :: any
	self.carry = nil :: any -- a double-clicked zone following the cursor
	self.runeFrames = {} :: { [string]: Frame }
	self.segments = {} :: { Frame }
	self.gridLines = {} :: { Frame }

	viewport.ClipsDescendants = true
	viewport.BackgroundColor3 = Theme.Colors.board
	self.gridLayer = Theme.make("Frame", { Name = "Grid", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1 }, viewport)
	self.world = Theme.make("Frame", { Name = "World", BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), ZIndex = 2 }, viewport)
	self.scale = Theme.make("UIScale", {}, self.world)
	local function layer(name: string, z: number): Frame
		return Theme.make("Frame", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), ZIndex = z }, self.world)
	end
	self.zoneLayer = layer("Zones", 1)
	self.wireLayer = layer("Wires", 2)
	self.runeLayer = layer("Runes", 3)
	self.previewLayer = layer("Preview", 4)
	self.drawPreview = Theme.make("Frame", { Visible = false, BackgroundTransparency = 0.85, BorderSizePixel = 0 }, self.previewLayer)
	Theme.corner(self.drawPreview, 10)
	self.drawStroke = Theme.stroke(self.drawPreview, WHITE, 2, 0)

	viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:renderGrid()
	end)
	self:applyTransform()
	return self
end

--------------------------------------------------------------------------------
-- View
--------------------------------------------------------------------------------

function Board:toWorld(p: Vector2): Vector2
	return (p - self.viewport.AbsolutePosition - self.pan) / self.zoom
end

function Board:applyTransform()
	self.world.Position = UDim2.fromOffset(self.pan.X, self.pan.Y)
	self.scale.Scale = self.zoom
	self:renderGrid()
	if self.hooks.onView then
		self.hooks.onView(self.zoom)
	end
end

function Board:zoomAt(screen: Vector2, zoom: number)
	zoom = math.clamp(zoom, MIN_ZOOM, MAX_ZOOM)
	local world = self:toWorld(screen)
	self.zoom = zoom
	self.pan = screen - self.viewport.AbsolutePosition - world * zoom
	self:applyTransform()
	self:render() -- zone handles are sized in screen pixels
end

function Board:zoomBy(factor: number)
	local center = self.viewport.AbsolutePosition + self.viewport.AbsoluteSize / 2
	self:zoomAt(center, self.zoom * factor)
end

function Board:centerOn(point: Vector2)
	self.pan = self.viewport.AbsoluteSize / 2 - point * self.zoom
	self:applyTransform()
end

-- Screen-centre in board units (where click-to-place drops runes).
function Board:viewCenter(): Vector2
	return self:toWorld(self.viewport.AbsolutePosition + self.viewport.AbsoluteSize / 2)
end

function Board:frameAll()
	local graph = self.doc.graph
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	local function include(x: number, y: number, w: number, h: number)
		minX, minY = math.min(minX, x), math.min(minY, y)
		maxX, maxY = math.max(maxX, x + w), math.max(maxY, y + h)
	end
	for _, zone in graph.zones do include(zone.x, zone.y, zone.w, zone.h) end
	for _, rune in graph.runes do include(rune.x, rune.y, LAYOUT.RuneWidth, SpellCompiler.RuneHeight(rune.rune)) end
	if minX == math.huge then
		self.zoom = 1
		self.pan = Vector2.new(60, 60)
	else
		local size = self.viewport.AbsoluteSize
		local margin = 60
		local zoom = math.min((size.X - margin * 2) / math.max(maxX - minX, 1), (size.Y - margin * 2) / math.max(maxY - minY, 1))
		self.zoom = math.clamp(zoom, MIN_ZOOM, 1.25)
		self.pan = size / 2 - Vector2.new(minX + maxX, minY + maxY) / 2 * self.zoom
	end
	self:applyTransform()
	self:render()
end

function Board:renderGrid()
	local size = self.viewport.AbsoluteSize
	local spacing = GRID
	while spacing * self.zoom < 18 do spacing *= 2 end
	local step = spacing * self.zoom
	local used = 0
	local function line(vertical: boolean, offset: number)
		used += 1
		local frame = self.gridLines[used]
		if not frame then
			frame = Theme.make("Frame", { BorderSizePixel = 0, BackgroundColor3 = Theme.Colors.grid }, self.gridLayer)
			self.gridLines[used] = frame
		end
		frame.Visible = true
		if vertical then
			frame.Position = UDim2.fromOffset(offset, 0)
			frame.Size = UDim2.new(0, 1, 1, 0)
		else
			frame.Position = UDim2.fromOffset(0, offset)
			frame.Size = UDim2.new(1, 0, 0, 1)
		end
	end
	local x = self.pan.X % step
	while x < size.X do line(true, math.floor(x)); x += step end
	local y = self.pan.Y % step
	while y < size.Y do line(false, math.floor(y)); y += step end
	for index = used + 1, #self.gridLines do
		self.gridLines[index].Visible = false
	end
end

--------------------------------------------------------------------------------
-- Rendering
--------------------------------------------------------------------------------

function Board:setAnnotations(errors: { [string]: boolean }, estimates: { [string]: any })
	self.errors = errors
	self.estimates = estimates
end

function Board:isSelected(kind: string, value: any): boolean
	local selection = self.selection
	if not selection or selection.kind ~= kind then return false end
	return if kind == "wire" then selection.wire == value else selection.id == value
end

function Board:select(selection: any)
	self.selection = selection
	self:render()
	if self.hooks.onSelect then self.hooks.onSelect(selection) end
end

-- Drops a selection whose target no longer exists (after undo, delete...).
function Board:validateSelection()
	local selection = self.selection
	if not selection then return end
	local graph = self.doc.graph
	local exists = if selection.kind == "rune" then self.doc:rune(selection.id) ~= nil
		elseif selection.kind == "zone" then self.doc:zone(selection.id) ~= nil
		else table.find(graph.wires, selection.wire) ~= nil
	if not exists then
		self.selection = nil
		if self.hooks.onSelect then self.hooks.onSelect(nil) end
	end
end

function Board:tabHeight(): number
	return math.max(ZONE_HEADER, TAB_MIN / self.zoom)
end

-- Zones in draw order. The selected zone is drawn (and hit-tested) last so
-- its handles are never buried under a neighbour.
function Board:orderedZones(): { any }
	local zones = self.doc.graph.zones
	local selection = self.selection
	if not selection or selection.kind ~= "zone" then
		return zones
	end
	local ordered, top = {}, nil
	for _, zone in zones do
		if zone.id == selection.id then top = zone else table.insert(ordered, zone) end
	end
	if top then table.insert(ordered, top) end
	return ordered
end

function Board:buildZone(zone: any)
	local kind = SpellRunes.Zones[zone.kind]
	local selected = self:isSelected("zone", zone.id)
	local frame = Theme.make("Frame", {
		Name = zone.id,
		Position = UDim2.fromOffset(zone.x, zone.y),
		Size = UDim2.fromOffset(zone.w, zone.h),
		BackgroundColor3 = kind.Color,
		BackgroundTransparency = if selected then 0.86 else 0.91,
		BorderSizePixel = 0,
	}, self.zoneLayer)
	Theme.corner(frame, 12)
	local stroke = Theme.stroke(frame, if selected then WHITE else kind.Color, if selected then 2.5 else 1.5, if selected then 0.1 else 0.35)
	self.zoneStrokes[zone.id] = { stroke = stroke, color = stroke.Color, thickness = stroke.Thickness, transparency = stroke.Transparency }
	local header = Theme.make("Frame", {
		Size = UDim2.new(1, 0, 0, self:tabHeight()),
		BackgroundColor3 = kind.Color,
		BackgroundTransparency = 0.72,
		BorderSizePixel = 0,
	}, frame)
	Theme.corner(header, 12)
	local title = (if zone.locked then "🔒 " else "") .. string.upper(zone.kind)
		.. if zone.label and zone.label ~= "" then `  ·  {zone.label}` else ""
	Theme.label(header, title, 14, {
		Font = Theme.FontBold,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		TextColor3 = kind.Color:Lerp(WHITE, 0.55),
	})
	if selected and not zone.locked then
		Theme.label(header, "double-click to move", 11, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 0),
			Size = UDim2.new(0.5, 0, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = kind.Color:Lerp(WHITE, 0.3),
			ZIndex = 2,
		})
	end
	-- Grips are sized in screen pixels so they stay grabbable at any zoom.
	-- Every unlocked zone shows its corners; the selected one also shows edge
	-- midpoints. Locked zones show none because they can't be resized.
	local size = (if selected then 14 else 10) / self.zoom
	local spots = if zone.locked then {} else { Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1) }
	if selected and not zone.locked then
		for _, spot in { Vector2.new(0.5, 0), Vector2.new(0, 0.5), Vector2.new(1, 0.5), Vector2.new(0.5, 1) } do
			table.insert(spots, spot)
		end
	end
	for _, spot in spots do
		local handle = Theme.make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(spot.X, spot.Y),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = if selected then WHITE else kind.Color,
			BackgroundTransparency = if selected then 0 else 0.25,
			BorderSizePixel = 0,
			ZIndex = 3,
		}, frame)
		Theme.corner(handle, 3)
	end
	self.zoneFrames[zone.id] = frame
end

function Board:estimateText(rune: any): string
	local estimate = self.estimates[rune.id]
	if not estimate then return "" end
	if estimate.damage then
		local text = `{math.floor(estimate.damage + 0.5)} dmg`
		return if estimate.count and estimate.count > 1 then `{text} ×{estimate.count}` else text
	end
	if estimate.energy then
		return `⚡{math.floor(estimate.energy + 0.5)}`
	end
	return ""
end

function Board:buildRune(rune: any)
	local def = SpellRunes.Runes[rune.rune]
	local color = Board.categoryColor(def)
	local selected = self:isSelected("rune", rune.id)
	local invalid = self.errors[rune.id] == true
	local height = SpellCompiler.RuneHeight(rune.rune)
	local width = LAYOUT.RuneWidth

	local card = Theme.make("Frame", {
		Name = rune.id,
		Position = UDim2.fromOffset(rune.x, rune.y),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = Theme.Colors.panel2,
		BorderSizePixel = 0,
	}, self.runeLayer)
	Theme.corner(card, 8)
	Theme.stroke(card, if invalid then Theme.Colors.bad elseif selected then WHITE else color, if selected or invalid then 2.5 else 1.5, 0.05)

	local header = Theme.make("Frame", {
		Size = UDim2.new(1, 0, 0, LAYOUT.Header),
		BackgroundColor3 = color:Lerp(Theme.Colors.panel2, 0.5),
		BorderSizePixel = 0,
	}, card)
	Theme.corner(header, 8)
	-- square off the header's bottom corners
	Theme.make("Frame", {
		Position = UDim2.new(0, 0, 1, -8),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = header.BackgroundColor3,
		BorderSizePixel = 0,
	}, header)
	Theme.label(header, (if rune.locked then "🔒 " else "") .. def.Name, 14, { Font = Theme.FontBold, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -86, 1, 0), ZIndex = 2 })
	Theme.label(header, self:estimateText(rune), 12, {
		Font = Theme.FontMedium,
		Position = UDim2.new(1, -80, 0, 0),
		Size = UDim2.new(0, 72, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = SpellRunes.PortColors.flow,
		ZIndex = 2,
	})

	local function port(side: string, index: number, portDef: any)
		local y = LAYOUT.Header + (index - 1) * LAYOUT.Row
		local isInput = side == "in"
		Theme.label(card, portDef.Label, 12, {
			Position = UDim2.fromOffset(if isInput then 14 else width / 2, y),
			Size = UDim2.fromOffset(width / 2 - 14, LAYOUT.Row),
			TextXAlignment = if isInput then Enum.TextXAlignment.Left else Enum.TextXAlignment.Right,
			TextColor3 = if portDef.Optional then Theme.Colors.muted else Theme.Colors.text,
		})
		local dot = Theme.make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(if isInput then 0 else width, y + LAYOUT.Row / 2),
			Size = UDim2.fromOffset(PORT_RADIUS * 2, PORT_RADIUS * 2),
			BackgroundColor3 = SpellRunes.PortColors[portDef.Type],
			BorderSizePixel = 0,
			ZIndex = 3,
		}, card)
		Theme.corner(dot, if portDef.Multi then 3 else PORT_RADIUS)
		Theme.stroke(dot, Theme.Colors.background, 2, 0)
	end
	for index, portDef in def.Inputs do port("in", index, portDef) end
	for index, portDef in def.Outputs do port("out", index, portDef) end

	Theme.label(card, Board.summary(rune), 12, {
		Position = UDim2.new(0, 10, 1, -LAYOUT.Footer),
		Size = UDim2.new(1, -20, 0, LAYOUT.Footer - 4),
		TextColor3 = Theme.Colors.muted,
	})
	self.runeFrames[rune.id] = card
end

function Board:render()
	self:validateSelection()
	for _, child in self.zoneLayer:GetChildren() do child:Destroy() end
	for _, child in self.runeLayer:GetChildren() do child:Destroy() end
	table.clear(self.zoneFrames)
	table.clear(self.zoneStrokes)
	table.clear(self.runeFrames)
	self.hoverZone = nil
	for _, zone in self:orderedZones() do self:buildZone(zone) end
	for _, rune in self.doc.graph.runes do self:buildRune(rune) end
	self:renderWires()
end

function Board:wireRoute(wire: any): ({ Vector2 }?, Color3?)
	local fromRune, toRune = self.doc:rune(wire.from), self.doc:rune(wire.to)
	if not fromRune or not toRune then return nil, nil end
	local fromDef, toDef = SpellRunes.Runes[fromRune.rune], SpellRunes.Runes[toRune.rune]
	local outIndex, inIndex = portIndex(fromDef.Outputs, wire.fromPort), portIndex(toDef.Inputs, wire.toPort)
	if not outIndex or not inIndex then return nil, nil end
	local a = Board.portPosition(fromRune, "out", outIndex)
	local b = Board.portPosition(toRune, "in", inIndex)
	return route(a, b), SpellRunes.PortColors[fromDef.Outputs[outIndex].Type]
end

function Board:renderWires()
	local used = 0
	local function draw(points: { Vector2 }, color: Color3, thickness: number)
		for index = 1, #points - 1 do
			local a, b = points[index], points[index + 1]
			used += 1
			local segment = self.segments[used]
			if not segment then
				segment = Theme.make("Frame", { BorderSizePixel = 0 }, self.wireLayer)
				self.segments[used] = segment
			end
			segment.Visible = true
			segment.BackgroundColor3 = color
			segment.Position = UDim2.fromOffset(math.min(a.X, b.X) - thickness / 2, math.min(a.Y, b.Y) - thickness / 2)
			segment.Size = UDim2.fromOffset(math.abs(b.X - a.X) + thickness, math.abs(b.Y - a.Y) + thickness)
		end
	end
	for _, wire in self.doc.graph.wires do
		local points, color = self:wireRoute(wire)
		if points and color then
			local selected = self:isSelected("wire", wire)
			draw(points, if selected then WHITE else color, if selected then 5 else 3)
		end
	end
	local drag = self.drag
	if drag and drag.kind == "wire" and drag.current then
		local anchorIndex = portIndex(if drag.side == "out" then SpellRunes.Runes[drag.rune.rune].Outputs else SpellRunes.Runes[drag.rune.rune].Inputs, drag.port.Name) :: number
		local anchor = Board.portPosition(drag.rune, drag.side, anchorIndex)
		local points = if drag.side == "out" then route(anchor, drag.current) else route(drag.current, anchor)
		draw(points, SpellRunes.PortColors[drag.port.Type]:Lerp(WHITE, 0.3), 3)
	end
	for index = used + 1, #self.segments do
		self.segments[index].Visible = false
	end
end

--------------------------------------------------------------------------------
-- Hit testing
--------------------------------------------------------------------------------

-- Resize hit for one zone, using signed distances from each border
-- (positive = inside). `outside`/`inside` are how far the band reaches past
-- and into the border; corners use cornerOut/cornerIn. The top border never
-- reaches inside because that's the tab. When both sides of an axis are in
-- reach (a zone that's tiny on screen) the nearer side wins.
local function zoneEdgeAt(zone: any, w: Vector2, outside: number, inside: number, cornerOut: number, cornerIn: number): any?
	local dl, dr = w.X - zone.x, zone.x + zone.w - w.X
	local dt, db = w.Y - zone.y, zone.y + zone.h - w.Y
	if math.min(dl, dr, dt, db) < -math.max(outside, cornerOut) then
		return nil
	end
	local function band(a: number, b: number, out: number, intoA: number, intoB: number): (boolean, boolean)
		local nearA = a >= -out and a <= intoA
		local nearB = b >= -out and b <= intoB
		if nearA and nearB then
			return a <= b, a > b
		end
		return nearA, nearB
	end
	local function result(left: boolean, right: boolean, top: boolean, bottom: boolean)
		return { kind = "zone-edge", zone = zone, left = left, right = right, top = top, bottom = bottom }
	end
	if math.min(dl, dr, dt, db) >= -cornerOut then
		local left, right = band(dl, dr, cornerOut, cornerIn, cornerIn)
		local top, bottom = band(dt, db, cornerOut, 0, cornerIn)
		if (left or right) and (top or bottom) then
			return result(left, right, top, bottom)
		end
	end
	if math.min(dl, dr, dt, db) < -outside then
		return nil
	end
	local left, right = band(dl, dr, outside, inside, inside)
	local top, bottom = band(dt, db, outside, 0, inside)
	if left or right or top or bottom then
		return result(left, right, top, bottom)
	end
	return nil
end

local function zoneContains(zone: any, w: Vector2): boolean
	return w.X >= zone.x and w.X <= zone.x + zone.w and w.Y >= zone.y and w.Y <= zone.y + zone.h
end

-- What a press at board point w would grab, respecting what's drawn on top:
--  1. ports (small, exact targets)
--  2. resize bands OUTSIDE a zone's border -- nothing of the zone is drawn
--     there, so this is pure leniency; skipped where a zone drawn above
--     covers the point
--  3. runes
--  4. wires
--  5. the topmost zone under the point: inner resize band, tab, or interior
function Board:hitTest(w: Vector2): any
	local graph = self.doc.graph
	local zones = self:orderedZones()
	local zoom = self.zoom

	local portReach = math.max(PORT_RADIUS + 3, 8 / zoom)
	for index = #graph.runes, 1, -1 do
		local rune = graph.runes[index]
		local def = SpellRunes.Runes[rune.rune]
		for portIndexValue, portDef in def.Inputs do
			if (Board.portPosition(rune, "in", portIndexValue) - w).Magnitude <= portReach then
				return { kind = "port", rune = rune, side = "in", port = portDef }
			end
		end
		for portIndexValue, portDef in def.Outputs do
			if (Board.portPosition(rune, "out", portIndexValue) - w).Magnitude <= portReach then
				return { kind = "port", rune = rune, side = "out", port = portDef }
			end
		end
	end

	for index = #zones, 1, -1 do
		local zone = zones[index]
		if not zone.locked and not zoneContains(zone, w) then
			local covered = false
			for above = index + 1, #zones do
				if zoneContains(zones[above], w) then covered = true break end
			end
			if not covered then
				local edge = zoneEdgeAt(zone, w, EDGE_OUT / zoom, 0, CORNER_OUT / zoom, 0)
				if edge then return edge end
			end
		end
	end

	for index = #graph.runes, 1, -1 do
		local rune = graph.runes[index]
		if w.X >= rune.x and w.X <= rune.x + LAYOUT.RuneWidth and w.Y >= rune.y and w.Y <= rune.y + SpellCompiler.RuneHeight(rune.rune) then
			return { kind = "rune", rune = rune }
		end
	end

	local wireReach = WIRE_REACH / zoom
	for _, wire in graph.wires do
		local points = self:wireRoute(wire)
		if points then
			for index = 1, #points - 1 do
				if distanceToSegment(w, points[index], points[index + 1]) <= wireReach then
					return { kind = "wire", wire = wire }
				end
			end
		end
	end

	for index = #zones, 1, -1 do
		local zone = zones[index]
		if zoneContains(zone, w) then
			if not zone.locked then
				local edge = zoneEdgeAt(zone, w, 0, EDGE_IN / zoom, 0, CORNER_IN / zoom)
				if edge then return edge end
			end
			return { kind = if w.Y <= zone.y + self:tabHeight() then "zone-tab" else "zone", zone = zone }
		end
	end
	return { kind = "empty" }
end

-- Nearest port on the opposite side of a wire drag that could accept it.
function Board:findDropPort(w: Vector2, drag: any): any?
	local reach = math.max(PORT_RADIUS * 2.5, 20 / self.zoom)
	local best, bestDistance = nil, reach
	local wantSide = if drag.side == "out" then "in" else "out"
	for _, rune in self.doc.graph.runes do
		if rune ~= drag.rune then
			local def = SpellRunes.Runes[rune.rune]
			for index, portDef in (if wantSide == "in" then def.Inputs else def.Outputs) do
				local compatible = if wantSide == "in" then SpellRunes.Compatible(drag.port.Type, portDef.Type)
					else SpellRunes.Compatible(portDef.Type, drag.port.Type)
				local distance = (Board.portPosition(rune, wantSide, index) - w).Magnitude
				if compatible and distance < bestDistance then
					best, bestDistance = { rune = rune, port = portDef }, distance
				end
			end
		end
	end
	return best
end

--------------------------------------------------------------------------------
-- Input (forwarded by the controller)
--------------------------------------------------------------------------------

function Board:addOverlay(frame: GuiObject)
	table.insert(self.overlays, frame)
end

-- Is this screen point on the board itself (inside the viewport, not over a
-- HUD overlay like the zoom buttons or problem list)?
function Board:accepts(p: Vector2): boolean
	local function inside(object: GuiObject): boolean
		local position, size = object.AbsolutePosition, object.AbsoluteSize
		return p.X >= position.X and p.Y >= position.Y and p.X <= position.X + size.X and p.Y <= position.Y + size.Y
	end
	if not self.viewport.Visible or not inside(self.viewport) then return false end
	for _, overlay in self.overlays do
		if overlay.Visible and inside(overlay) then return false end
	end
	return true
end

function Board:armZone(kind: string?)
	self.armedZone = kind
	if self.hooks.onArm then self.hooks.onArm(kind) end
end

function Board:changed()
	if self.hooks.onChanged then self.hooks.onChanged() end
end

-- Records undo exactly once per drag, on its first real movement.
local function recordOnce(self: any, drag: any)
	if not drag.recorded then
		drag.recorded = true
		self.doc:record()
	end
end

local function edgeCursor(hit: any): string
	local horizontal, vertical = hit.left or hit.right, hit.top or hit.bottom
	if horizontal and vertical then
		return if (hit.left and hit.top) or (hit.right and hit.bottom) then CURSORS.nwse else CURSORS.nesw
	end
	return if horizontal then CURSORS.ew else CURSORS.ns
end

function Board:setCursor(icon: string)
	if self.cursor ~= icon then
		self.cursor = icon
		UserInputService.MouseIcon = icon
	end
end

function Board:setHoverZone(id: string?)
	if self.hoverZone == id then return end
	local previous = self.hoverZone and self.zoneStrokes[self.hoverZone]
	if previous then
		previous.stroke.Color = previous.color
		previous.stroke.Thickness = previous.thickness
		previous.stroke.Transparency = previous.transparency
	end
	self.hoverZone = id
	local current = id and self.zoneStrokes[id]
	if current then
		current.stroke.Color = WHITE
		current.stroke.Thickness = 3
		current.stroke.Transparency = 0
	end
end

-- Previews what a press at p would do: cursor shape plus zone outline.
function Board:hover(p: Vector2)
	if not self:accepts(p) then
		self:setCursor("")
		self:setHoverZone(nil)
		return
	end
	if self.carry then
		self:setCursor(CURSORS.move)
		return
	end
	if self.armedZone then
		self:setCursor(CURSORS.cross)
		self:setHoverZone(nil)
		return
	end
	local hit = self:hitTest(self:toWorld(p))
	local zoneHit = hit.kind == "zone-edge" or hit.kind == "zone-tab"
	self:setHoverZone(if zoneHit then hit.zone.id else nil)
	if hit.kind == "zone-edge" then
		self:setCursor(edgeCursor(hit))
	elseif hit.kind == "zone-tab" then
		self:setCursor(if hit.zone.locked then "" else CURSORS.move)
	elseif hit.kind == "rune" then
		self:setCursor(if hit.rune.locked then "" else CURSORS.move)
	elseif hit.kind == "port" or hit.kind == "wire" then
		self:setCursor(CURSORS.hand)
	else
		self:setCursor("")
	end
end

local function message(self: any, text: string)
	if self.hooks.onMessage then self.hooks.onMessage(text) end
end

-- Moves a picked-up zone (and its unlocked runes) so the grab point follows w.
function Board:moveZone(drag: any, w: Vector2)
	recordOnce(self, drag)
	local delta = Vector2.new(snap(w.X - drag.start.X), snap(w.Y - drag.start.Y))
	local zone = drag.zone
	zone.x, zone.y = drag.origin.X + delta.X, drag.origin.Y + delta.Y
	local frame = self.zoneFrames[zone.id]
	if frame then frame.Position = UDim2.fromOffset(zone.x, zone.y) end
	for _, member in drag.members do
		member.rune.x, member.rune.y = member.x + delta.X, member.y + delta.Y
		local runeFrame = self.runeFrames[member.rune.id]
		if runeFrame then runeFrame.Position = UDim2.fromOffset(member.rune.x, member.rune.y) end
	end
	self:renderWires()
end

function Board:pickUpZone(zone: any, w: Vector2, p: Vector2)
	-- Locked runes are pinned to the board and stay put.
	local members = {}
	for _, rune in self.doc:runesInZone(zone) do
		if not rune.locked then
			table.insert(members, { rune = rune, x = rune.x, y = rune.y })
		end
	end
	self.drag = { kind = "zone", zone = zone, start = w, origin = Vector2.new(zone.x, zone.y), members = members, startScreen = p }
	self:setCursor(CURSORS.move)
end

-- Esc while carrying a zone puts it back. Returns true if it handled Esc.
function Board:cancel(): boolean
	local carry = self.carry
	if not carry then return false end
	self.carry = nil
	carry.zone.x, carry.zone.y = carry.origin.X, carry.origin.Y
	for _, member in carry.members do
		member.rune.x, member.rune.y = member.x, member.y
	end
	if carry.recorded then
		table.remove(self.doc.undoStack) -- nothing changed; drop its undo step
	end
	self:changed()
	return true
end

function Board:inputBegan(input: InputObject): boolean
	local t = input.UserInputType
	local p = Board.pointer(input)
	if not self:accepts(p) then return false end
	local w = self:toWorld(p)

	-- Right (or middle) drag always pans the view, whatever is under it.
	if t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
		self.drag = { kind = "pan", button = t, start = p, startPan = self.pan }
		self:setCursor(CURSORS.grab)
		return true
	end
	if not isPress(input) then return false end

	if self.carry then
		-- A click drops the zone being carried.
		self.carry = nil
		self:changed()
		return true
	end

	if self.armedZone then
		self.drag = { kind = "draw", zoneKind = self.armedZone, start = w, current = w, startScreen = p }
		return true
	end

	local hit = self:hitTest(w)
	if hit.kind == "port" then
		if hit.side == "in" and not hit.port.Multi then
			local existing = self.doc:wiresInto(hit.rune.id, hit.port.Name)[1]
			if existing then
				-- Pick the wire back up from its source.
				local source = self.doc:rune(existing.from)
				local sourceDef = SpellRunes.Runes[source.rune]
				self.doc:record()
				self.doc:removeWire(existing)
				self.drag = { kind = "wire", rune = source, side = "out", port = SpellRunes.FindPort(sourceDef.Outputs, existing.fromPort), current = w, recorded = true }
				self:changed()
				return true
			end
		end
		self.drag = { kind = "wire", rune = hit.rune, side = hit.side, port = hit.port, current = w }
		self:renderWires()
	elseif hit.kind == "rune" then
		self:select({ kind = "rune", id = hit.rune.id })
		if hit.rune.locked then
			message(self, "This rune is locked. Press L to unlock it.")
		else
			self.drag = { kind = "rune", rune = hit.rune, grab = w - Vector2.new(hit.rune.x, hit.rune.y), startScreen = p }
		end
	elseif hit.kind == "wire" then
		self:select({ kind = "wire", wire = hit.wire })
	elseif hit.kind == "zone-edge" then
		local zone = hit.zone
		if not self:isSelected("zone", zone.id) then self:select({ kind = "zone", id = zone.id }) end
		self.drag = { kind = "resize", zone = zone, hit = hit, start = w, rect = { zone.x, zone.y, zone.w, zone.h }, startScreen = p }
		self:setCursor(edgeCursor(hit))
	elseif hit.kind == "zone-tab" or hit.kind == "zone" then
		local zone = hit.zone
		if not self:isSelected("zone", zone.id) then self:select({ kind = "zone", id = zone.id }) end
		if hit.kind == "zone-tab" then
			local now = os.clock()
			local last = self.lastTabPress
			if last and last.id == zone.id and now - last.time <= DOUBLE_CLICK then
				self.lastTabPress = nil
				if zone.locked then
					message(self, "This zone is locked. Press L to unlock it.")
				else
					self:pickUpZone(zone, w, p)
				end
			else
				self.lastTabPress = { id = zone.id, time = now }
			end
		end
	elseif t == Enum.UserInputType.Touch then
		-- No right button on touch: dragging empty board pans.
		if self.selection then self:select(nil) end
		self.drag = { kind = "pan", button = t, start = p, startPan = self.pan }
	else
		if self.selection then self:select(nil) end
	end
	return true
end

function Board:inputChanged(input: InputObject): boolean
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseWheel then
		local p = Board.pointer(input)
		if not self:accepts(p) then return false end
		self:zoomAt(p, self.zoom * (1.12 ^ input.Position.Z))
		return true
	end
	if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then return false end
	local drag = self.drag
	if not drag then
		if self.carry then
			self:moveZone(self.carry, self:toWorld(Board.pointer(input)))
			return true
		end
		if t == Enum.UserInputType.MouseMovement then self:hover(Board.pointer(input)) end
		return false
	end
	local p = Board.pointer(input)
	local w = self:toWorld(p)
	if drag.startScreen and not drag.moved then
		if (p - drag.startScreen).Magnitude < DRAG_THRESHOLD then return true end
		drag.moved = true
	end

	if drag.kind == "pan" then
		self.pan = drag.startPan + (p - drag.start)
		self:applyTransform()
	elseif drag.kind == "rune" then
		recordOnce(self, drag)
		local rune = drag.rune
		rune.x, rune.y = snap(w.X - drag.grab.X), snap(w.Y - drag.grab.Y)
		local frame = self.runeFrames[rune.id]
		if frame then frame.Position = UDim2.fromOffset(rune.x, rune.y) end
		self:renderWires()
	elseif drag.kind == "zone" then
		self:moveZone(drag, w)
	elseif drag.kind == "resize" then
		recordOnce(self, drag)
		local zone, hit = drag.zone, drag.hit
		local x, y, width, height = drag.rect[1], drag.rect[2], drag.rect[3], drag.rect[4]
		local dx, dy = snap(w.X - drag.start.X), snap(w.Y - drag.start.Y)
		if hit.left then
			local newX = math.min(x + dx, x + width - MIN_ZONE_W)
			width, x = width + (x - newX), newX
		elseif hit.right then
			width = math.max(width + dx, MIN_ZONE_W)
		end
		if hit.top then
			local newY = math.min(y + dy, y + height - MIN_ZONE_H)
			height, y = height + (y - newY), newY
		elseif hit.bottom then
			height = math.max(height + dy, MIN_ZONE_H)
		end
		zone.x, zone.y, zone.w, zone.h = x, y, width, height
		local frame = self.zoneFrames[zone.id]
		if frame then
			frame.Position = UDim2.fromOffset(x, y)
			frame.Size = UDim2.fromOffset(width, height)
		end
	elseif drag.kind == "draw" then
		drag.current = w
		local minPoint = Vector2.new(math.min(drag.start.X, w.X), math.min(drag.start.Y, w.Y))
		local size = Vector2.new(math.abs(w.X - drag.start.X), math.abs(w.Y - drag.start.Y))
		local color = SpellRunes.Zones[drag.zoneKind].Color
		self.drawPreview.Visible = true
		self.drawPreview.BackgroundColor3 = color
		self.drawStroke.Color = color
		self.drawPreview.Position = UDim2.fromOffset(minPoint.X, minPoint.Y)
		self.drawPreview.Size = UDim2.fromOffset(size.X, size.Y)
	elseif drag.kind == "wire" then
		drag.current = w
		self:renderWires()
	end
	return true
end

function Board:inputEnded(input: InputObject): boolean
	local t = input.UserInputType
	local drag = self.drag
	if not drag then return false end
	local ends = if drag.kind == "pan" then t == drag.button else isPress(input)
	if not ends then return false end
	self.drag = nil
	task.defer(function() self:hover(Board.pointer()) end) -- after the change re-renders

	if drag.kind == "zone" and not drag.moved then
		-- Double-click without dragging: carry the zone until the next click.
		drag.start = self:toWorld(Board.pointer(input))
		self.carry = drag
		message(self, "Moving zone: click to drop it, Esc to put it back.")
		return true
	end
	if drag.kind == "wire" then
		local target = drag.current and self:findDropPort(drag.current, drag)
		if target then
			if not drag.recorded then self.doc:record() end
			local ok, reason
			if drag.side == "out" then
				ok, reason = self.doc:connect(drag.rune.id, drag.port.Name, target.rune.id, target.port.Name)
			else
				ok, reason = self.doc:connect(target.rune.id, target.port.Name, drag.rune.id, drag.port.Name)
			end
			if not ok and reason then message(self, reason) end
			self:changed()
		elseif drag.recorded then
			self:changed() -- a picked-up wire was dropped on nothing: it stays removed
		else
			self:renderWires()
		end
	elseif drag.kind == "draw" then
		self.drawPreview.Visible = false
		local a, b = drag.start, drag.current
		local minPoint = Vector2.new(math.min(a.X, b.X), math.min(a.Y, b.Y))
		local size = Vector2.new(math.abs(b.X - a.X), math.abs(b.Y - a.Y))
		if size.X < 40 and size.Y < 40 then
			-- A click (not a drag) drops a default-sized zone there.
			minPoint, size = a - Vector2.new(DEFAULT_ZONE_W, DEFAULT_ZONE_H) / 2, Vector2.new(DEFAULT_ZONE_W, DEFAULT_ZONE_H)
		end
		self.doc:record()
		local zone = self.doc:addZone(drag.zoneKind, snap(minPoint.X), snap(minPoint.Y), math.max(snap(size.X), MIN_ZONE_W), math.max(snap(size.Y), MIN_ZONE_H))
		if not UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			self:armZone(nil) -- hold Shift to keep drawing the same kind
		end
		self.selection = if zone then { kind = "zone", id = zone.id } else nil
		if self.hooks.onSelect then self.hooks.onSelect(self.selection) end
		self:changed()
	elseif (drag.kind == "rune" or drag.kind == "zone" or drag.kind == "resize") and drag.recorded then
		self:changed()
	end
	return true
end

-- Palette drop: anchor the new rune's header at the screen point.
function Board:placeRune(runeId: string, screen: Vector2?): any?
	local w = if screen then self:toWorld(screen) else self:viewCenter()
	self.doc:record()
	local rune = self.doc:addRune(runeId, snap(w.X), snap(w.Y))
	if rune then
		self.selection = { kind = "rune", id = rune.id }
		if self.hooks.onSelect then self.hooks.onSelect(self.selection) end
	end
	self:changed()
	return rune
end

return Board
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">Document</string>
              <string name="Source"><![CDATA[--!strict
--[[
	The spell graph being edited, its mutations and undo/redo. Every user
	action calls doc:record() once BEFORE changing anything (drags record on
	their first movement), so each undo step is one whole action.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local SpellCompiler = require(Shared:WaitForChild("SpellCompiler"))
local SpellRunes = require(Shared:WaitForChild("SpellRunes"))

local Document = {}
Document.__index = Document

local HISTORY_LIMIT = 80

local function deepCopy(value: any): any
	if typeof(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in value do
		result[key] = deepCopy(child)
	end
	return result
end
Document.deepCopy = deepCopy

function Document.new(graph: any)
	local self = setmetatable({}, Document)
	self.graph = deepCopy(graph)
	self.undoStack = {}
	self.redoStack = {}
	return self
end

-- Replaces the whole graph (loading a card / New). Clears history.
function Document:load(graph: any)
	self.graph = deepCopy(graph)
	table.clear(self.undoStack)
	table.clear(self.redoStack)
end

function Document:record()
	table.insert(self.undoStack, deepCopy(self.graph))
	if #self.undoStack > HISTORY_LIMIT then
		table.remove(self.undoStack, 1)
	end
	table.clear(self.redoStack)
end

function Document:undo(): boolean
	local previous = table.remove(self.undoStack)
	if not previous then return false end
	table.insert(self.redoStack, self.graph)
	self.graph = previous
	return true
end

function Document:redo(): boolean
	local nextGraph = table.remove(self.redoStack)
	if not nextGraph then return false end
	table.insert(self.undoStack, self.graph)
	self.graph = nextGraph
	return true
end

function Document:newId(prefix: string): string
	local used = {}
	for _, zone in self.graph.zones do used[zone.id] = true end
	for _, rune in self.graph.runes do used[rune.id] = true end
	local base = string.lower(string.gsub(prefix, "[^%w]", ""))
	local index = 1
	while used[`{base}{index}`] do index += 1 end
	return `{base}{index}`
end

function Document:rune(id: string): any?
	for _, rune in self.graph.runes do
		if rune.id == id then return rune end
	end
	return nil
end

function Document:zone(id: string): any?
	for _, zone in self.graph.zones do
		if zone.id == id then return zone end
	end
	return nil
end

-- x, y is where the rune's anchor (header centre) should land.
function Document:addRune(runeId: string, x: number, y: number): any?
	if #self.graph.runes >= SpellCompiler.MaxRunes then return nil end
	local layout = SpellCompiler.Layout
	local rune = {
		id = self:newId(runeId),
		rune = runeId,
		x = math.floor(x - layout.RuneWidth / 2),
		y = math.floor(y - layout.Header / 2),
		params = SpellRunes.DefaultParams(runeId),
	}
	table.insert(self.graph.runes, rune)
	return rune
end

function Document:removeRune(id: string)
	for index = #self.graph.runes, 1, -1 do
		if self.graph.runes[index].id == id then table.remove(self.graph.runes, index) end
	end
	for index = #self.graph.wires, 1, -1 do
		local wire = self.graph.wires[index]
		if wire.from == id or wire.to == id then table.remove(self.graph.wires, index) end
	end
end

function Document:addZone(kind: string, x: number, y: number, w: number, h: number): any?
	if #self.graph.zones >= SpellCompiler.MaxZones then return nil end
	local zone = { id = self:newId("zone"), kind = kind, x = math.floor(x), y = math.floor(y), w = math.floor(w), h = math.floor(h) }
	table.insert(self.graph.zones, zone)
	return zone
end

function Document:removeZone(id: string)
	for index = #self.graph.zones, 1, -1 do
		if self.graph.zones[index].id == id then table.remove(self.graph.zones, index) end
	end
end

function Document:runesInZone(zone: any): { any }
	local result = {}
	for _, rune in self.graph.runes do
		local ax, ay = SpellCompiler.RuneAnchor(rune)
		if ax >= zone.x and ay >= zone.y and ax <= zone.x + zone.w and ay <= zone.y + zone.h then
			table.insert(result, rune)
		end
	end
	return result
end

function Document:wiresInto(runeId: string, port: string): { any }
	local result = {}
	for _, wire in self.graph.wires do
		if wire.to == runeId and wire.toPort == port then table.insert(result, wire) end
	end
	return result
end

-- Connects out-port -> in-port, enforcing the same rules as the compiler so a
-- wire can't be drawn that the circle would reject: compatible types, one
-- wire into single inputs (the new wire replaces the old), one wire out of
-- flow/mod outputs (likewise replaced). Returns false + reason otherwise.
function Document:connect(fromId: string, fromPort: string, toId: string, toPort: string): (boolean, string?)
	if fromId == toId then return false, "A rune can't feed itself." end
	local fromRune, toRune = self:rune(fromId), self:rune(toId)
	if not fromRune or not toRune then return false, "Missing rune." end
	local outPort = SpellRunes.FindPort(SpellRunes.Runes[fromRune.rune].Outputs, fromPort)
	local inPort = SpellRunes.FindPort(SpellRunes.Runes[toRune.rune].Inputs, toPort)
	if not outPort or not inPort then return false, "Missing port." end
	if not SpellRunes.Compatible(outPort.Type, inPort.Type) then
		return false, `{outPort.Type} can't connect to {inPort.Type}.`
	end
	if #self.graph.wires >= SpellCompiler.MaxWires then return false, "Too many wires." end
	local wires = self.graph.wires
	for index = #wires, 1, -1 do
		local wire = wires[index]
		local sameInput = wire.to == toId and wire.toPort == toPort
		if sameInput and wire.from == fromId and wire.fromPort == fromPort then
			return false, nil -- already connected
		end
		local replacesInput = sameInput and not inPort.Multi
		local replacesOutput = wire.from == fromId and wire.fromPort == fromPort
			and (outPort.Type == "flow" or outPort.Type == "mod")
		if replacesInput or replacesOutput then
			table.remove(wires, index)
		end
	end
	table.insert(wires, { from = fromId, fromPort = fromPort, to = toId, toPort = toPort })
	return true, nil
end

function Document:removeWire(wire: any)
	local index = table.find(self.graph.wires, wire)
	if index then table.remove(self.graph.wires, index) end
end

return Document
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Side panels for the spell editor:
	 Toolbox   -- zone pens and the searchable rune palette (left)
	 Inspector -- whatever is selected: rune params, zone kind/label, wire,
	              or the spell overview when nothing is (right)
	 Problems  -- collapsible compile-error list floating over the board
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SpellRunes = require(Shared:WaitForChild("SpellRunes"))
local Theme = require(script.Parent.Theme)
local Board = require(script.Parent.Board)

local Colors = Theme.Colors
local Panels = {}

local function scroller(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local scroll = Theme.make("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Colors.line,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, parent)
	if props then
		for key, value in props do (scroll :: any)[key] = value end
	end
	return scroll
end

local function sectionTitle(parent: Instance, text: string, order: number, color: Color3?): TextLabel
	return Theme.label(parent, string.upper(text), 11, {
		Font = Theme.FontBold,
		TextColor3 = color or Colors.muted,
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = order,
	})
end

--------------------------------------------------------------------------------
-- Toolbox
--------------------------------------------------------------------------------

local Toolbox = {}
Toolbox.__index = Toolbox
Panels.Toolbox = Toolbox

-- hooks: onArmZone(kind?), onRunePress(runeId)
function Toolbox.new(parent: Frame, hooks: any)
	local self = setmetatable({}, Toolbox)
	self.hooks = hooks
	self.zoneChips = {} :: { [string]: TextButton }
	self.items = {} :: { { frame: GuiObject, text: string, category: string } }
	self.headers = {} :: { [string]: TextLabel }

	local search = Theme.make("TextBox", {
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(1, -20, 0, 32),
		BackgroundColor3 = Colors.panel2,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Theme.Font,
		PlaceholderText = "Search runes…",
		PlaceholderColor3 = Colors.muted,
		Text = "",
		TextColor3 = Colors.text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
	Theme.corner(search, 6)
	Theme.make("UIPadding", { PaddingLeft = UDim.new(0, 10) }, search)
	search:GetPropertyChangedSignal("Text"):Connect(function()
		self:filter(search.Text)
	end)

	local scroll = scroller(parent, { Position = UDim2.fromOffset(10, 50), Size = UDim2.new(1, -14, 1, -58) })
	Theme.list(scroll, 6)
	Theme.make("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10) }, scroll)

	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	sectionTitle(scroll, "Zones · click a pen, drag on the board", nextOrder())
	local zoneGrid = Theme.make("Frame", { BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = nextOrder() }, scroll)
	Theme.make("UIGridLayout", { CellSize = UDim2.new(0.5, -3, 0, 30), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, zoneGrid)
	for index, kind in SpellRunes.ZoneKinds do
		local color = SpellRunes.Zones[kind].Color
		local chip = Theme.button(zoneGrid, kind, {
			LayoutOrder = index,
			BackgroundColor3 = color:Lerp(Colors.panel, 0.7),
			TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.5),
			TextSize = 12,
		})
		Theme.stroke(chip, color, 1, 0.5)
		chip.Activated:Connect(function()
			hooks.onArmZone(if self.armed == kind then nil else kind)
		end)
		self.zoneChips[kind] = chip
	end

	local categoryColors: { [string]: Color3 } = {}
	for _, runeId in SpellRunes.Order do
		local def = SpellRunes.Runes[runeId]
		categoryColors[def.Category] = categoryColors[def.Category] or Board.categoryColor(def)
	end
	for _, category in SpellRunes.Categories do
		local color = categoryColors[category]
		self.headers[category] = sectionTitle(scroll, category, nextOrder(), color:Lerp(Color3.new(1, 1, 1), 0.3))
		for _, runeId in SpellRunes.Order do
			local def = SpellRunes.Runes[runeId]
			if def.Category == category then
				local item = Theme.button(scroll, "", {
					LayoutOrder = nextOrder(),
					Size = UDim2.new(1, 0, 0, 46),
					BackgroundColor3 = Colors.panel2,
					AutoButtonColor = true,
				})
				Theme.make("Frame", { Size = UDim2.new(0, 4, 1, -12), Position = UDim2.fromOffset(6, 6), BackgroundColor3 = color, BorderSizePixel = 0 }, item)
				Theme.label(item, def.Name, 13, { Font = Theme.FontBold, Position = UDim2.fromOffset(18, 5), Size = UDim2.new(1, -26, 0, 18) })
				Theme.label(item, def.Description, 11, { Position = UDim2.fromOffset(18, 23), Size = UDim2.new(1, -26, 0, 16), TextColor3 = Colors.muted })
				item.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						hooks.onRunePress(runeId)
					end
				end)
				table.insert(self.items, { frame = item, text = string.lower(def.Name .. " " .. def.Category .. " " .. def.Description), category = category })
			end
		end
	end
	return self
end

function Toolbox:setArmed(kind: string?)
	self.armed = kind
	for chipKind, chip in self.zoneChips do
		local color = SpellRunes.Zones[chipKind].Color
		chip.BackgroundColor3 = if chipKind == kind then color:Lerp(Colors.panel, 0.25) else color:Lerp(Colors.panel, 0.7)
	end
end

function Toolbox:filter(query: string)
	query = string.lower(query)
	local visibleCategories = {}
	for _, item in self.items do
		local visible = query == "" or string.find(item.text, query, 1, true) ~= nil
		item.frame.Visible = visible
		if visible then visibleCategories[item.category] = true end
	end
	for category, header in self.headers do
		header.Visible = visibleCategories[category] == true
	end
end

--------------------------------------------------------------------------------
-- Inspector
--------------------------------------------------------------------------------

local Inspector = {}
Inspector.__index = Inspector
Panels.Inspector = Inspector

-- hooks:
--  edit(fn)      -- record undo, run fn, then treat as a change
--  liveEdit(fn)  -- run fn and apply without recording (slider drags)
--  beginLive()   -- record undo once at the start of a slider drag
--  delete()      -- delete the current selection
--  doc()         -- current Document
function Inspector.new(parent: Frame, hooks: any)
	local self = setmetatable({}, Inspector)
	self.hooks = hooks
	self.scroll = scroller(parent, { Position = UDim2.fromOffset(12, 10), Size = UDim2.new(1, -16, 1, -18) })
	Theme.make("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 12) }, self.scroll)
	self.slider = nil :: any

	UserInputService.InputChanged:Connect(function(input)
		local slider = self.slider
		if slider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			slider.update(Board.pointer(input))
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if self.slider and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			self.slider = nil
			self:refresh()
		end
	end)
	return self
end

function Inspector:clear()
	for _, child in self.scroll:GetChildren() do
		if not child:IsA("UIPadding") then child:Destroy() end
	end
	self.order = 0
	Theme.list(self.scroll, 8)
end

function Inspector:nextOrder(): number
	self.order += 1
	return self.order
end

function Inspector:text(text: string, size: number?, color: Color3?, bold: boolean?): TextLabel
	return Theme.label(self.scroll, text, size or 13, {
		Font = if bold then Theme.FontBold else Theme.Font,
		TextColor3 = color or Colors.text,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = self:nextOrder(),
	})
end

function Inspector:actionButton(text: string, color: Color3?, callback: () -> ()): TextButton
	local button = Theme.button(self.scroll, text, {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = color or Colors.panel3,
		LayoutOrder = self:nextOrder(),
	})
	button.Activated:Connect(callback)
	return button
end

function Inspector:numberParam(rune: any, param: any)
	local row = Theme.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 58), LayoutOrder = self:nextOrder() }, self.scroll)
	Theme.label(row, param.Label, 12, { Size = UDim2.new(1, -130, 0, 28), TextColor3 = Colors.muted })
	local value = rune.params[param.Name]
	local minValue, maxValue, step = param.Min, param.Max, param.Step or 1

	local function commit(newValue: number, live: boolean?)
		newValue = math.clamp(math.floor(newValue / step + 0.5) * step, minValue, maxValue)
		newValue = tonumber(string.format("%.4f", newValue)) :: number
		local apply = function() rune.params[param.Name] = newValue end
		if live then self.hooks.liveEdit(apply) else self.hooks.edit(apply) end
	end

	local minus = Theme.button(row, "−", { Position = UDim2.new(1, -124, 0, 0), Size = UDim2.fromOffset(28, 26) })
	local box = Theme.make("TextBox", {
		Position = UDim2.new(1, -92, 0, 0),
		Size = UDim2.fromOffset(60, 26),
		BackgroundColor3 = Colors.panel2,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Theme.FontMedium,
		Text = tostring(value) .. (param.Suffix or ""),
		TextColor3 = Colors.text,
		TextSize = 13,
	}, row)
	Theme.corner(box, 5)
	local plus = Theme.button(row, "+", { Position = UDim2.new(1, -28, 0, 0), Size = UDim2.fromOffset(28, 26) })
	minus.Activated:Connect(function() commit(value - step) end)
	plus.Activated:Connect(function() commit(value + step) end)
	box.Focused:Connect(function() box.Text = tostring(value) end)
	box.FocusLost:Connect(function()
		local parsed = tonumber(string.match(box.Text, "%-?[%d%.]+") or "")
		if parsed then commit(parsed) else self:refresh() end
	end)

	local track = Theme.make("Frame", {
		Position = UDim2.fromOffset(4, 38),
		Size = UDim2.new(1, -8, 0, 8),
		BackgroundColor3 = Colors.panel3,
		BorderSizePixel = 0,
		Active = true,
	}, row)
	Theme.corner(track, 4)
	local alpha = (value - minValue) / math.max(maxValue - minValue, 1e-6)
	local fill = Theme.make("Frame", { Size = UDim2.fromScale(alpha, 1), BackgroundColor3 = Colors.accent, BorderSizePixel = 0 }, track)
	Theme.corner(fill, 4)
	local knob = Theme.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(alpha, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, track)
	Theme.corner(knob, 8)
	local function update(pointer: Vector2)
		local t = math.clamp((pointer.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local newValue = minValue + t * (maxValue - minValue)
		newValue = math.clamp(math.floor(newValue / step + 0.5) * step, minValue, maxValue)
		local shown = (newValue - minValue) / math.max(maxValue - minValue, 1e-6)
		fill.Size = UDim2.fromScale(shown, 1)
		knob.Position = UDim2.fromScale(shown, 0.5)
		box.Text = tostring(tonumber(string.format("%.4f", newValue))) .. (param.Suffix or "")
		commit(newValue, true)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			self.hooks.beginLive()
			self.slider = { update = update }
			update(Board.pointer(input))
		end
	end)
end

function Inspector:enumParam(rune: any, param: any)
	Theme.label(self.scroll, param.Label, 12, { Size = UDim2.new(1, 0, 0, 18), TextColor3 = Colors.muted, LayoutOrder = self:nextOrder() })
	local grid = Theme.make("Frame", { BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = self:nextOrder() }, self.scroll)
	local columns = math.min(#param.Options, 3)
	Theme.make("UIGridLayout", { CellSize = UDim2.new(1 / columns, -4, 0, 28), CellPadding = UDim2.fromOffset(4, 4), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	for index, option in param.Options do
		local active = rune.params[param.Name] == option
		local chip = Theme.button(grid, option, {
			LayoutOrder = index,
			BackgroundColor3 = if active then Colors.accent:Lerp(Colors.panel, 0.35) else Colors.panel2,
		})
		chip.Activated:Connect(function()
			self.hooks.edit(function() rune.params[param.Name] = option end)
		end)
	end
end

function Inspector:boolParam(rune: any, param: any)
	local row = Theme.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = self:nextOrder() }, self.scroll)
	Theme.label(row, param.Label, 12, { Size = UDim2.new(1, -80, 1, 0), TextColor3 = Colors.muted })
	local on = rune.params[param.Name] == true
	local toggle = Theme.button(row, if on then "On" else "Off", {
		Position = UDim2.new(1, -70, 0, 0),
		Size = UDim2.fromOffset(70, 28),
		BackgroundColor3 = if on then Colors.good:Lerp(Colors.panel, 0.45) else Colors.panel2,
	})
	toggle.Activated:Connect(function()
		self.hooks.edit(function() rune.params[param.Name] = not on end)
	end)
end

function Inspector:lockToggle(target: any, noun: string)
	local locked = target.locked == true
	local button = self:actionButton(
		if locked then `🔒 {noun} locked: click to unlock  [L]` else `Lock {noun} in place  [L]`,
		if locked then Color3.fromRGB(120, 96, 40) else Colors.panel3,
		function()
			self.hooks.edit(function() target.locked = if locked then nil else true end)
		end
	)
	button.TextSize = 12
end

function Inspector:showRune(rune: any, context: any)
	local def = SpellRunes.Runes[rune.rune]
	local color = Board.categoryColor(def)
	self:text(def.Name, 18, color:Lerp(Color3.new(1, 1, 1), 0.35), true)
	self:text(`{def.Category} rune · goes in a {table.concat(def.Zones, " or ")} zone`, 12, Colors.muted)
	self:text(def.Description, 13)
	for _, problem in context.errors do
		if problem.rune == rune.id then
			self:text("✖ " .. problem.message, 12, Colors.bad)
		end
	end
	local estimate = context.estimates and context.estimates[rune.id]
	if estimate and estimate.damage then
		self:text(`Energy in: {math.floor(estimate.energy + 0.5)}  ·  {math.floor(estimate.damage + 0.5)} impact damage per copy ×{estimate.count}`, 12, SpellRunes.PortColors.flow)
	elseif estimate and estimate.energy then
		self:text(`Energy: {math.floor(estimate.energy + 0.5)}`, 12, SpellRunes.PortColors.flow)
	end

	if #def.Params > 0 then
		sectionTitle(self.scroll, "Settings", self:nextOrder())
		for _, param in def.Params do
			if param.Type == "number" then
				self:numberParam(rune, param)
			elseif param.Type == "enum" then
				self:enumParam(rune, param)
			else
				self:boolParam(rune, param)
			end
		end
	end

	if #def.Inputs + #def.Outputs > 0 then
		sectionTitle(self.scroll, "Ports", self:nextOrder())
		local function describe(prefix: string, port: any)
			local suffix = if port.Multi then ", many" elseif port.Optional then ", optional" else ""
			local typeName = if port.Type == "vessel" then "trigger link" else port.Type
			self:text(`{prefix} {port.Label}  ({typeName}{suffix})`, 12, SpellRunes.PortColors[port.Type])
		end
		for _, port in def.Inputs do describe("◀", port) end
		for _, port in def.Outputs do describe("▶", port) end
	end
	self:lockToggle(rune, "Rune")
	self:actionButton("Delete rune  [Del]", Color3.fromRGB(110, 40, 58), self.hooks.delete)
end

function Inspector:showZone(zone: any)
	local kind = SpellRunes.Zones[zone.kind]
	self:text(`{zone.kind} zone`, 18, kind.Color:Lerp(Color3.new(1, 1, 1), 0.35), true)
	self:text(kind.Description, 13)
	local inside = #self.hooks.doc():runesInZone(zone)
	self:text(`{inside} rune{if inside == 1 then "" else "s"} inside · {zone.w} × {zone.h}`, 12, Colors.muted)

	sectionTitle(self.scroll, "Label", self:nextOrder())
	local box = Theme.make("TextBox", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = Colors.panel2,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Theme.Font,
		PlaceholderText = "Optional name for this zone",
		PlaceholderColor3 = Colors.muted,
		Text = zone.label or "",
		TextColor3 = Colors.text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = self:nextOrder(),
	}, self.scroll)
	Theme.corner(box, 6)
	Theme.make("UIPadding", { PaddingLeft = UDim.new(0, 10) }, box)
	box.FocusLost:Connect(function()
		local text = string.sub(box.Text, 1, 32)
		if text ~= (zone.label or "") then
			self.hooks.edit(function() zone.label = if text == "" then nil else text end)
		end
	end)

	sectionTitle(self.scroll, "Kind", self:nextOrder())
	local grid = Theme.make("Frame", { BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = self:nextOrder() }, self.scroll)
	Theme.make("UIGridLayout", { CellSize = UDim2.new(0.5, -3, 0, 28), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	for index, kindName in SpellRunes.ZoneKinds do
		local color = SpellRunes.Zones[kindName].Color
		local chip = Theme.button(grid, kindName, {
			LayoutOrder = index,
			TextSize = 12,
			BackgroundColor3 = if kindName == zone.kind then color:Lerp(Colors.panel, 0.3) else color:Lerp(Colors.panel, 0.75),
		})
		chip.Activated:Connect(function()
			if kindName ~= zone.kind then
				self.hooks.edit(function() zone.kind = kindName end)
			end
		end)
	end
	self:text("Double-click the zone's tab to pick it up with everything inside (locked runes stay put): drag it, or let go and click where it should land. Esc puts it back. Drag any edge or corner to resize.", 12, Colors.muted)
	self:lockToggle(zone, "Zone")
	self:actionButton("Delete zone (keeps its runes)  [Del]", Color3.fromRGB(110, 40, 58), self.hooks.delete)
end

function Inspector:showWire(wire: any)
	local doc = self.hooks.doc()
	local from, to = doc:rune(wire.from), doc:rune(wire.to)
	local fromName = from and SpellRunes.Runes[from.rune].Name or wire.from
	local toName = to and SpellRunes.Runes[to.rune].Name or wire.to
	self:text("Wire", 18, Colors.text, true)
	self:text(`{fromName} · {wire.fromPort}  →  {toName} · {wire.toPort}`, 13)
	self:text("Tip: drag a connected input port to pick its wire back up.", 12, Colors.muted)
	self:actionButton("Delete wire  [Del]", Color3.fromRGB(110, 40, 58), self.hooks.delete)
end

function Inspector:showOverview(context: any)
	self:text("Spell circle", 18, Colors.text, true)
	local analysis = context.analysis
	if analysis then
		self:text(`Costs {analysis.manaCost} mana per cast.`, 13, SpellRunes.PortColors.flow)
		for id, estimate in analysis.estimates do
			if estimate.damage then
				self:text(`• {id}: {math.floor(estimate.damage + 0.5)} impact damage ×{estimate.count} ({estimate.element or "no element"})`, 12)
			end
		end
	end
	if #context.errors == 0 then
		self:text("✓ Ready to save.", 13, Colors.good)
	else
		self:text(`✖ {#context.errors} problem{if #context.errors == 1 then "" else "s"} — see the list on the board.`, 13, Colors.bad)
	end
	sectionTitle(self.scroll, "How it works", self:nextOrder())
	for _, line in {
		"Mana is energy. Wire a Mana Well through a Transform (Fire, Arcane, Shock) into a Vessel; its damage comes from the mana that reaches it.",
		"The Vessel gives magic its form: Orb (slow, heavy), Bullet (fast tracer), Beam (traveling cylinder at 2000 studs/s), or Explosion. Sustain makes a Beam follow live aim for 1–5 seconds; Quantity fires several.",
		"Every rune must sit inside a zone of the right kind. Pick a zone pen in the toolbox and drag on the board to draw one.",
		"If routes all energy one way, Divide splits it. Sensors and Logic feed conditions and targeting.",
		"Vessels aim at your mouse unless something is wired into their Aim port: put an Aim rune in a Targeting zone and wire it in (feed it Nearest Entity, Cursor, etc.).",
		"Triggers are optional: wire a Vessel's Triggers port into On Impact / On Timer / etc. to run more of the circle mid-flight with a share of its energy.",
		"To cast: Save (your first saved spell is equipped automatically), close the editor with E, and click.",
	} do
		self:text(line, 12, Colors.muted)
	end
	sectionTitle(self.scroll, "Controls", self:nextOrder())
	for _, line in {
		"Right-drag: pan the view  ·  Wheel: zoom  ·  F: frame all",
		"Double-click a zone's tab to pick it up (drag, or click again to drop; Esc cancels)",
		"Drag a zone's edge or corner to resize",
		"L: lock/unlock the selected rune or zone",
		"Drag from a port to wire  ·  Del: delete  ·  Ctrl+D: duplicate",
		"Ctrl+Z / Ctrl+Y: undo / redo  ·  Shift while drawing: keep the pen",
	} do
		self:text(line, 12, Colors.muted)
	end
end

-- context: { selection, errors, estimates, analysis }
function Inspector:show(context: any)
	self.context = context
	if self.slider then return end -- don't rebuild the slider being dragged
	self:clear()
	local selection = context.selection
	local doc = self.hooks.doc()
	if selection and selection.kind == "rune" and doc:rune(selection.id) then
		self:showRune(doc:rune(selection.id), context)
	elseif selection and selection.kind == "zone" and doc:zone(selection.id) then
		self:showZone(doc:zone(selection.id))
	elseif selection and selection.kind == "wire" then
		self:showWire(selection.wire)
	else
		self:showOverview(context)
	end
end

function Inspector:refresh()
	if self.context then self:show(self.context) end
end

--------------------------------------------------------------------------------
-- Problems overlay
--------------------------------------------------------------------------------

local Problems = {}
Problems.__index = Problems
Panels.Problems = Problems

-- hooks: onFocus(problem)
function Problems.new(parent: Frame, hooks: any)
	local self = setmetatable({}, Problems)
	self.hooks = hooks
	self.expanded = true
	local frame = Theme.make("Frame", {
		Name = "Problems",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.new(0.5, 0, 0, 36),
		BackgroundColor3 = Colors.panel,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Active = true,
		ZIndex = 10,
	}, parent)
	Theme.corner(frame, 8)
	self.stroke = Theme.stroke(frame, Colors.line, 1, 0.3)
	Theme.make("UISizeConstraint", { MaxSize = Vector2.new(520, 260), MinSize = Vector2.new(240, 36) }, frame)
	self.frame = frame
	self.header = Theme.button(frame, "", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Theme.FontBold,
		ZIndex = 11,
	})
	Theme.make("UIPadding", { PaddingLeft = UDim.new(0, 12) }, self.header)
	self.header.Activated:Connect(function()
		self.expanded = not self.expanded
		self:show(self.errors or {}, self.summary or "")
	end)
	self.list = scroller(frame, { Position = UDim2.fromOffset(8, 36), Size = UDim2.new(1, -12, 1, -42), ZIndex = 11 })
	Theme.list(self.list, 4)
	return self
end

function Problems:show(errors: { any }, summary: string)
	self.errors, self.summary = errors, summary
	for _, child in self.list:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	local count = #errors
	if count == 0 then
		self.header.Text = "✓  " .. summary
		self.header.TextColor3 = Colors.good
		self.stroke.Color = Colors.good
	else
		self.header.Text = `✖  {count} problem{if count == 1 then "" else "s"}   {if self.expanded then "▾" else "▸"}`
		self.header.TextColor3 = Colors.bad
		self.stroke.Color = Colors.bad
	end
	local expanded = self.expanded and count > 0
	self.list.Visible = expanded
	self.frame.Size = UDim2.new(0.5, 0, 0, if expanded then 44 + math.min(count, 7) * 30 else 36)
	for index, problem in errors do
		local item = Theme.button(self.list, problem.message, {
			LayoutOrder = index,
			Size = UDim2.new(1, -6, 0, 26),
			BackgroundColor3 = Colors.panel2,
			TextSize = 12,
			Font = Theme.Font,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 12,
		})
		Theme.make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, item)
		item.Activated:Connect(function() self.hooks.onFocus(problem) end)
	end
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Shared look and small Instance helpers for the spell editor.

local Theme = {}

Theme.Colors = {
	background = Color3.fromRGB(13, 11, 22),
	board = Color3.fromRGB(17, 15, 28),
	grid = Color3.fromRGB(38, 33, 58),
	panel = Color3.fromRGB(24, 20, 38),
	panel2 = Color3.fromRGB(33, 28, 51),
	panel3 = Color3.fromRGB(46, 39, 70),
	line = Color3.fromRGB(120, 92, 180),
	text = Color3.fromRGB(238, 232, 255),
	muted = Color3.fromRGB(150, 140, 178),
	accent = Color3.fromRGB(176, 120, 255),
	good = Color3.fromRGB(96, 222, 150),
	bad = Color3.fromRGB(255, 96, 116),
	selection = Color3.fromRGB(255, 255, 255),
}

Theme.Font = Enum.Font.Gotham
Theme.FontMedium = Enum.Font.GothamMedium
Theme.FontBold = Enum.Font.GothamBold

-- Instance.new + property table + parent in one call.
function Theme.make(className: string, props: { [string]: any }?, parent: Instance?): any
	local instance = Instance.new(className)
	if props then
		for key, value in props do
			(instance :: any)[key] = value
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Theme.corner(parent: Instance, radius: number?)
	Theme.make("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

function Theme.stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Theme.make("UIStroke", {
		Color = color or Theme.Colors.line,
		Thickness = thickness or 1,
		Transparency = transparency or 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

function Theme.padding(parent: Instance, all: number)
	local pad = UDim.new(0, all)
	Theme.make("UIPadding", { PaddingTop = pad, PaddingBottom = pad, PaddingLeft = pad, PaddingRight = pad }, parent)
end

function Theme.label(parent: Instance, text: string, size: number?, props: { [string]: any }?): TextLabel
	local label = Theme.make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		Text = text,
		TextColor3 = Theme.Colors.text,
		TextSize = size or 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
	if props then
		for key, value in props do
			(label :: any)[key] = value
		end
	end
	return label
end

function Theme.button(parent: Instance, text: string, props: { [string]: any }?): TextButton
	local button = Theme.make("TextButton", {
		AutoButtonColor = true,
		BackgroundColor3 = Theme.Colors.panel3,
		BorderSizePixel = 0,
		Font = Theme.FontMedium,
		Text = text,
		TextColor3 = Theme.Colors.text,
		TextSize = 13,
	}, parent)
	Theme.corner(button, 6)
	if props then
		for key, value in props do
			(button :: any)[key] = value
		end
	end
	return button
end

function Theme.list(parent: Instance, padding: number?, horizontal: boolean?): UIListLayout
	return Theme.make("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, parent)
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">SpellEffects</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	SpellEffects (client, purely cosmetic)
	Renders instant Explosions and legacy SpellBeam flashes. New traveling
	Beams use ProjectileClient/BeamVisual and the regular projectile protocol;
	SpellRuntime no longer emits fixed SpellBeam rays.
	Self-registers its listeners at require time, same as WeaponEffects.luau.

	"SpellBeam" payload (server -> all clients):
	 - Points: { Vector3 } -- start, each bounce point, end
	 - Width: number -- the beam's hit diameter
	 - Color: Color3 (glow), Core: Color3 (hot centre)
	 - Normal: Vector3? -- surface normal where it stopped
	 - Kind: "entity" | "world" | nil -- what stopped it (nil = ran out of range)

	"SpellExplosion" payload (server -> all clients):
	 - Position: Vector3, Radius: number (blast radius), Color: Color3
	 Drawn as a white neon core inside a larger translucent neon shell in the
	 element colour; both swell quickly, then fade.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualOffload = require(Shared.VisualOffload)
local Impact = require(Shared.ProjectileClient.Impact)

local SpellEffects = {}

local FADE_TIME = 0.35
local MIN_WIDTH = 0.35

local fadeInfo = TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function neon(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	for key, value in props do
		(part :: any)[key] = value
	end
	return part
end

-- A Cylinder's length runs along its X axis, so turn the segment's look
-- frame 90 degrees to lay it along a -> b.
local function cylinderAlong(a: Vector3, b: Vector3): CFrame
	return CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
end

local function segment(a: Vector3, b: Vector3, width: number, core: Color3, glow: Color3)
	local length = (b - a).Magnitude
	if length < 0.05 then
		return
	end
	local frame = cylinderAlong(a, b)
	local inner = neon({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(length, width * 0.45, width * 0.45), CFrame = frame, Color = core })
	local outer = neon({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(length, width * 1.4, width * 1.4), CFrame = frame, Color = glow, Transparency = 0.5 })
	inner.Parent = workspace
	outer.Parent = workspace
	-- Thin to nothing while the glow swells and fades: a flash, then gone.
	TweenService:Create(inner, fadeInfo, { Size = Vector3.new(length, 0.02, 0.02), Transparency = 1 }):Play()
	TweenService:Create(outer, fadeInfo, { Size = Vector3.new(length, width * 2.4, width * 2.4), Transparency = 1 }):Play()
	Debris:AddItem(inner, FADE_TIME + 0.1)
	Debris:AddItem(outer, FADE_TIME + 0.1)
end

local function flare(position: Vector3, width: number, color: Color3)
	local ball = neon({ Shape = Enum.PartType.Ball, Size = Vector3.one * width * 2, CFrame = CFrame.new(position), Color = color, Transparency = 0.2 })
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Range = 16
	glow.Brightness = 4
	glow.Parent = ball
	ball.Parent = workspace
	TweenService:Create(ball, fadeInfo, { Size = Vector3.one * width * 5, Transparency = 1 }):Play()
	TweenService:Create(glow, fadeInfo, { Brightness = 0 }):Play()
	Debris:AddItem(ball, FADE_TIME + 0.1)
end

VisualOffload.On("SpellBeam", function(data)
	local points = data.Points
	if typeof(points) ~= "table" or #points < 2 then
		return
	end
	local width = math.max(data.Width or MIN_WIDTH, MIN_WIDTH)
	local core = data.Core or Color3.new(1, 1, 1)
	local glow = data.Color or core
	for index = 1, #points - 1 do
		segment(points[index], points[index + 1], width, core, glow)
	end
	flare(points[1], width, glow)
	for index = 2, #points - 1 do
		Impact.Play(points[index], nil, "bounce")
	end
	if data.Kind then
		flare(points[#points], width * 1.5, glow)
		Impact.Play(points[#points], data.Normal, data.Kind)
	end
end)

local EXPLOSION_GROW = TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local EXPLOSION_FADE = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

VisualOffload.On("SpellExplosion", function(data)
	local position = data.Position
	if typeof(position) ~= "Vector3" then
		return
	end
	local radius = math.max(data.Radius or 6, 1)
	local color = data.Color or Color3.new(1, 1, 1)
	local frame = CFrame.new(position)
	local core = neon({ Shape = Enum.PartType.Ball, Size = Vector3.one * radius * 0.2, CFrame = frame, Color = Color3.new(1, 1, 1) })
	local shell = neon({ Shape = Enum.PartType.Ball, Size = Vector3.one * radius * 0.4, CFrame = frame, Color = color, Transparency = 0.5 })
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Range = radius * 3
	glow.Brightness = 5
	glow.Parent = core
	core.Parent = workspace
	shell.Parent = workspace

	-- Swell to full size (the shell's diameter is the blast diameter)...
	TweenService:Create(core, EXPLOSION_GROW, { Size = Vector3.one * radius * 1.1 }):Play()
	TweenService:Create(shell, EXPLOSION_GROW, { Size = Vector3.one * radius * 2 }):Play()
	-- ...then fade away while drifting a little larger.
	task.delay(EXPLOSION_GROW.Time, function()
		TweenService:Create(core, EXPLOSION_FADE, { Transparency = 1, Size = Vector3.one * radius * 0.8 }):Play()
		TweenService:Create(shell, EXPLOSION_FADE, { Transparency = 1, Size = Vector3.one * radius * 2.3 }):Play()
		TweenService:Create(glow, EXPLOSION_FADE, { Brightness = 0 }):Play()
	end)
	local lifetime = EXPLOSION_GROW.Time + EXPLOSION_FADE.Time + 0.1
	Debris:AddItem(core, lifetime)
	Debris:AddItem(shell, lifetime)
end)

return SpellEffects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">TimeControlGui</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	TimeControlGui.luau  (client)
	A small on-screen panel to scrub YOUR OWN personal time ratio -- it only
	ever affects this player's own movement and the bullets they fire, live,
	even ones already in flight (see MovementController.SetPersonalTimeScale
	and Projectile.luau's Step, which reads Source.TimeScale every tick), never
	the world or anyone else. Dragging the slider (or clicking a preset) does
	two things:
	  • applies the ratio locally right away (MovementController.
	    SetPersonalTimeScale) so the client feels responsive, and
	  • requests it from the server (VisualOffload "RequestPersonalTimeScale"),
	    which is authoritative, clamps it, applies it to this player's Entity,
	    and replies with the clamped value on "PersonalTimeScale" (to this
	    player only -- nobody else needs to know it).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualOffload = require(Shared.VisualOffload)
local MovementController = require(script.Parent.MovementController)

local TimeControlGui = {}

local MIN_RATIO = 0
local MAX_RATIO = 3
local PRESETS = { 0, 0.25, 0.5, 1, 2 }

local started = false
local dragging = false
local currentRatio = 1

-- throttle network sends during a drag (local apply stays instant)
local SEND_INTERVAL = 0.05
local lastSent = 0
local pendingSend: number? = nil

-- built lazily in start()
local track: Frame
local fill: Frame
local handle: Frame
local valueLabel: TextLabel

local function ratioToAlpha(ratio: number): number
	return math.clamp((ratio - MIN_RATIO) / (MAX_RATIO - MIN_RATIO), 0, 1)
end

local function render(ratio: number)
	local alpha = ratioToAlpha(ratio)
	fill.Size = UDim2.new(alpha, 0, 1, 0)
	handle.Position = UDim2.new(alpha, 0, 0.5, 0)
	valueLabel.Text = string.format("Your Time  x%.2f", ratio)
end

-- Throttled request to the authoritative server. Coalesces rapid drag updates
-- and always flushes the final value (see the flush loop in start()).
local function requestServer(ratio: number)
	local now = os.clock()
	if now - lastSent >= SEND_INTERVAL then
		lastSent = now
		pendingSend = nil
		VisualOffload.Fire("RequestPersonalTimeScale", ratio)
	else
		pendingSend = ratio
	end
end

-- Apply locally + tell the server. `fromNetwork` avoids echoing the server's
-- own reply back at it.
local function applyRatio(ratio: number, fromNetwork: boolean?)
	ratio = math.clamp(ratio, MIN_RATIO, MAX_RATIO)
	currentRatio = ratio
	render(ratio)
	if not fromNetwork then
		MovementController.SetPersonalTimeScale(ratio) -- instant local feedback
		requestServer(ratio)
	end
end

local function alphaFromInput(inputX: number): number
	local left = track.AbsolutePosition.X
	local width = track.AbsoluteSize.X
	if width <= 0 then
		return 0
	end
	return math.clamp((inputX - left) / width, 0, 1)
end

local function setFromInput(inputX: number)
	local alpha = alphaFromInput(inputX)
	applyRatio(MIN_RATIO + alpha * (MAX_RATIO - MIN_RATIO))
end

local function build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local screen = Instance.new("ScreenGui")
	screen.Name = "TimeControlGui"
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.Parent = playerGui

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.Position = UDim2.new(0.5, 0, 1, -16)
	panel.Size = UDim2.fromOffset(360, 92)
	panel.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
	panel.BackgroundTransparency = 0.1
	panel.BorderSizePixel = 0
	panel.Parent = screen
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = panel
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.Parent = panel

	valueLabel = Instance.new("TextLabel")
	valueLabel.Name = "Value"
	valueLabel.BackgroundTransparency = 1
	valueLabel.Size = UDim2.new(1, 0, 0, 20)
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.TextSize = 15
	valueLabel.TextColor3 = Color3.fromRGB(235, 240, 255)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Left
	valueLabel.Parent = panel

	-- slider track
	track = Instance.new("Frame")
	track.Name = "Track"
	track.Position = UDim2.new(0, 0, 0, 30)
	track.Size = UDim2.new(1, 0, 0, 8)
	track.BackgroundColor3 = Color3.fromRGB(45, 50, 65)
	track.BorderSizePixel = 0
	track.Parent = panel
	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track

	fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(0.33, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(90, 170, 255)
	fill.BorderSizePixel = 0
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	handle = Instance.new("Frame")
	handle.Name = "Handle"
	handle.AnchorPoint = Vector2.new(0.5, 0.5)
	handle.Position = UDim2.new(0.33, 0, 0.5, 0)
	handle.Size = UDim2.fromOffset(18, 18)
	handle.BackgroundColor3 = Color3.fromRGB(235, 240, 255)
	handle.BorderSizePixel = 0
	handle.ZIndex = 2
	handle.Parent = track
	local handleCorner = Instance.new("UICorner")
	handleCorner.CornerRadius = UDim.new(1, 0)
	handleCorner.Parent = handle

	-- preset buttons
	local presetRow = Instance.new("Frame")
	presetRow.Name = "Presets"
	presetRow.BackgroundTransparency = 1
	presetRow.Position = UDim2.new(0, 0, 0, 48)
	presetRow.Size = UDim2.new(1, 0, 0, 24)
	presetRow.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	layout.Padding = UDim.new(0, 6)
	layout.Parent = presetRow

	for _, preset in PRESETS do
		local button = Instance.new("TextButton")
		button.Name = `Preset_{preset}`
		button.Size = UDim2.fromOffset(62, 24)
		button.BackgroundColor3 = Color3.fromRGB(38, 42, 56)
		button.BorderSizePixel = 0
		button.Font = Enum.Font.GothamMedium
		button.TextSize = 13
		button.TextColor3 = Color3.fromRGB(220, 226, 240)
		button.Text = preset == 0 and "Freeze" or string.format("x%.2g", preset)
		button.Parent = presetRow
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, 6)
		bc.Parent = button
		button.Activated:Connect(function()
			applyRatio(preset)
		end)
	end

	-- drag handling
	local function beginDrag(input)
		dragging = true
		setFromInput(input.Position.X)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			beginDrag(input)
		end
	end)
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			beginDrag(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromInput(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

function TimeControlGui.start()
	if started then
		return
	end
	started = true

	build()
	applyRatio(MovementController.GetPersonalTimeScale(), true)

	-- flush any coalesced send shortly after the last drag update
	task.spawn(function()
		while started do
			if pendingSend and os.clock() - lastSent >= SEND_INTERVAL then
				local value = pendingSend
				pendingSend = nil
				lastSent = os.clock()
				VisualOffload.Fire("RequestPersonalTimeScale", value)
			end
			task.wait(SEND_INTERVAL)
		end
	end)

	-- reconcile against the server's authoritative (possibly clamped) value;
	-- this only ever targets this player (see example/init.server.luau), never
	-- broadcast, since it's personal
	VisualOffload.On("PersonalTimeScale", function(scale)
		if not dragging and typeof(scale) == "number" then
			applyRatio(scale, true)
		end
	end)
end

return TimeControlGui
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="95">
          <Properties>
            <string name="Name">ToolControllers</string>
          </Properties>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">DilationBubble</string>
              <string name="Source"><![CDATA[--!optimize 2
-- Client controller for the Studio-only DilationBubble test tool.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VisualOffload = require(ReplicatedStorage:WaitForChild("Shared").VisualOffload)
local Gui = require(script.Parent.Parent.DilationBubbleGui)

local Controller = {}
local activationConnection: RBXScriptConnection? = nil

function Controller.Equip(tool: Tool, _character: Model)
	if activationConnection then
		activationConnection:Disconnect()
	end
	Gui.Start()
	Gui.SetVisible(true)
	local mouse = Players.LocalPlayer:GetMouse()
	activationConnection = tool.Activated:Connect(function()
		local config = Gui.GetConfig()
		VisualOffload.Fire("DilationBubbleTest", {
			Action = "Create",
			Position = mouse.Hit.Position,
			Scale = config.Scale,
			Radius = config.Radius,
			Duration = config.Duration,
		})
	end)
end

function Controller.Unequip(_tool: Tool, _character: Model)
	if activationConnection then
		activationConnection:Disconnect()
		activationConnection = nil
	end
	Gui.SetVisible(false)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">DummySpawner</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local VisualOffload = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").VisualOffload)

local Controller = {}
local activation: RBXScriptConnection? = nil
local CLEAR_ACTION = "ClearSpawnedTestDummies"
local SELECT_ACTION = "SelectSpawnedTestDummy"
local lastActivation = -math.huge
local selected: Model? = nil
local selectionConnection: RBXScriptConnection? = nil
local originalOutline: Color3? = nil

local function deselect()
	if selectionConnection then selectionConnection:Disconnect(); selectionConnection = nil end
	local outline = selected and selected:FindFirstChild("TestDummyOutline")
	if outline and outline:IsA("Highlight") and originalOutline then outline.OutlineColor = originalOutline end
	selected = nil
	originalOutline = nil
end

local function selectNearest(mouse: Mouse)
	if selected then deselect(); return end
	local camera = workspace.CurrentCamera
	local folder = workspace:FindFirstChild("SpawnedTestDummies")
	if not camera or not folder then return end
	local nearest: Model? = nil
	local distance = math.huge
	for _, model in folder:GetChildren() do
		if model:IsA("Model") and model.PrimaryPart and model:GetAttribute("SpawnedBy") == Players.LocalPlayer.UserId then
			-- WorldToScreenPoint matches Mouse.X/Y (including the GUI inset).
			local point, visible = camera:WorldToScreenPoint(model.PrimaryPart.Position)
			if visible then
				local offset = Vector2.new(point.X - mouse.X, point.Y - mouse.Y)
				local squared = offset:Dot(offset)
				if squared < distance then nearest = model; distance = squared end
			end
		end
	end
	selected = nearest
	if nearest then
		local outline = nearest:FindFirstChild("TestDummyOutline")
		if outline and outline:IsA("Highlight") then
			originalOutline = outline.OutlineColor
			outline.OutlineColor = Color3.fromRGB(80, 225, 255)
		end
		selectionConnection = nearest.Destroying:Connect(deselect)
	end
end

function Controller.Unequip(_tool: Tool, _character: Model)
	if activation then activation:Disconnect(); activation = nil end
	ContextActionService:UnbindAction(CLEAR_ACTION)
	ContextActionService:UnbindAction(SELECT_ACTION)
	deselect()
end

function Controller.Equip(tool: Tool, character: Model)
	Controller.Unequip(tool, character)
	local mouse = Players.LocalPlayer:GetMouse()
	activation = tool.Activated:Connect(function()
		local now = os.clock()
		if now - lastActivation < 0.25 then return end
		lastActivation = now
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignored: { Instance } = { character }
		local folder = workspace:FindFirstChild("SpawnedTestDummies")
		if folder then table.insert(ignored, folder) end
		params.FilterDescendantsInstances = ignored
		local ray = mouse.UnitRay
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
		if not hit then return end
		VisualOffload.Fire("DummySpawner", {
			Action = if selected then "Move" else "Spawn",
			Position = hit.Position,
			Dummy = selected,
		})
	end)
	ContextActionService:BindActionAtPriority(SELECT_ACTION, function(_, state)
		if state == Enum.UserInputState.Begin then selectNearest(mouse) end
		return Enum.ContextActionResult.Sink
	end, true, Enum.ContextActionPriority.High.Value, Enum.KeyCode.E)
	ContextActionService:SetTitle(SELECT_ACTION, "Select dummy")
	ContextActionService:BindAction(CLEAR_ACTION, function(_, state)
		if state == Enum.UserInputState.Begin then
			local dummy = selected
			deselect()
			VisualOffload.Fire("DummySpawner", { Action = if dummy then "Delete" else "Clear", Dummy = dummy })
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.R)
	ContextActionService:SetTitle(CLEAR_ACTION, "Remove / clear")
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">Pheonix</string>
              <string name="Source"><![CDATA[--!optimize 2
-- Railgun tool controller. Matched by Tool.Name == "Railgun" (see
-- ToolManager.luau). Plain shooting weapon -- see _ShootingWeapon.luau.
-- Fires the RailgunRod effect because "Railgun" is registered in
-- src/server/Weapons/Railgun.luau (-> ReplicatedStorage.Effects.RailgunRod).
return require(script.Parent._ShootingWeapon)
