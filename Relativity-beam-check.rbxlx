          <Item class="ModuleScript" referent="17">
            <Properties>
              <string name="Name">TV</string>
              <string name="Source">--!optimize 2
--[[ MapGen/Furniture/TV.luau -- built facing +Z, floor at local Y=0. ]]

local FurnitureBase = require(script.Parent.FurnitureBase)
local part = FurnitureBase.part

local TV = {}

export type TVConfig = {
	frameColor: Color3?,
}

function TV.generate(cframe: CFrame, config: TVConfig?): Model
	config = config or {}
	local frameColor = config.frameColor or Color3.fromRGB(35, 35, 38) -- lighter than screen, must actually contrast
	local screenColor = Color3.fromRGB(5, 5, 6) -- much darker, this contrast is the whole trick

	-- base footprint now close to panel width, not a third of it
	local base = part("Base", Vector3.new(2.6, 0.15, 1.1), CFrame.new(0, 0.075, 0), frameColor, Enum.Material.Metal)

	local stemHeight = 1.2 -- shorter, real TVs sit lower over the stand
	local stemBottomY = 0.15
	local stemCenterY = stemBottomY + stemHeight / 2

	local frameDepth = 0.15
	local frameFrontZ = frameDepth / 2

	-- bezel border: screen is visibly smaller than frame (real border width, not 0.02 studs)
	local bezel = 0.2
	local frameWidth, frameHeight = 3.4, 2.0
	local screenWidth, screenHeight = frameWidth - bezel * 2, frameHeight - bezel * 2

	local screenDepth = 0.03
	local recess = 0.05 -- visible recess, not imperceptible
	local screenFrontZ = frameFrontZ - recess
	local screenCenterZ = screenFrontZ - screenDepth / 2

	local parts = {
		part("Stem", Vector3.new(0.3, stemHeight, frameDepth), CFrame.new(0, stemCenterY, 0), frameColor, Enum.Material.Metal),

		part("Frame", Vector3.new(frameWidth, frameHeight, frameDepth), CFrame.new(0, stemBottomY + stemHeight + frameHeight/2, 0), frameColor, Enum.Material.SmoothPlastic),

		part("Screen", Vector3.new(screenWidth, screenHeight, screenDepth), CFrame.new(0, stemBottomY + stemHeight + frameHeight/2, screenCenterZ), screenColor, Enum.Material.Glass),
	}

	return FurnitureBase.assemble("TV", base, parts, cframe)
end

return TV</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="18">
            <Properties>
              <string name="Name">Table</string>
              <string name="Source"><![CDATA[--!optimize 2
--[[ MapGen/Furniture/Table.luau -- built facing +Z, floor at local Y=0. ]]

local FurnitureBase = require(script.Parent.FurnitureBase)
local part = FurnitureBase.part

local Table = {}

export type TableConfig = {
	topColor: Color3?,
	legColor: Color3?,
	width: number?, -- studs, along local X
	depth: number?, -- studs, along local Z
}

function Table.generate(cframe: CFrame, config: TableConfig?): Model
	config = config or {}
	local topColor = config.topColor or Color3.fromRGB(150, 110, 70)
	local legColor = config.legColor or Color3.fromRGB(70, 50, 30)
	local w = config.width or 4
	local d = config.depth or 3
	local legInsetX, legInsetZ = w / 2 - 0.3, d / 2 - 0.3

	local top = part("Top", Vector3.new(w, 0.3, d), CFrame.new(0, 2.5, 0), topColor, Enum.Material.Wood)

	local parts = {
		part("LegFL", Vector3.new(0.3, 2.35, 0.3), CFrame.new(legInsetX, 1.175, legInsetZ), legColor, Enum.Material.Wood),
		part("LegFR", Vector3.new(0.3, 2.35, 0.3), CFrame.new(-legInsetX, 1.175, legInsetZ), legColor, Enum.Material.Wood),
		part("LegBL", Vector3.new(0.3, 2.35, 0.3), CFrame.new(legInsetX, 1.175, -legInsetZ), legColor, Enum.Material.Wood),
		part("LegBR", Vector3.new(0.3, 2.35, 0.3), CFrame.new(-legInsetX, 1.175, -legInsetZ), legColor, Enum.Material.Wood),
	}

	return FurnitureBase.assemble("Table", top, parts, cframe)
end

return Table
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Grid</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	MapGen/Grid.luau
	A flat 2D cell grid used by the map generator. Coordinates are 1-based cell
	indices (x = column, y = row). Cells hold a CellType enum value; everything
	starts EMPTY. Storage is a single flat array indexed (y-1)*width + x for cache
	friendliness.

	This module is intentionally dumb data + helpers — the hallway generator and
	room finder read/write cells through it, and the visualizer reads it to draw.
]]

local Grid = {}
Grid.__index = Grid

-- Cell types (kept as plain numbers so the flat array stays a number array).
Grid.EMPTY = 0
Grid.HALL = 1
Grid.ROOM = 2
Grid.DOOR = 3

export type Grid = typeof(setmetatable(
	{} :: {
		width: number,
		height: number,
		cells: { number },
	},
	Grid
))

function Grid.new(width: number, height: number): Grid
	local self = setmetatable({
		width = width,
		height = height,
		cells = table.create(width * height, Grid.EMPTY),
	}, Grid)
	return self
end

function Grid.inBounds(self: Grid, x: number, y: number): boolean
	return x >= 1 and x <= self.width and y >= 1 and y <= self.height
end

function Grid.index(self: Grid, x: number, y: number): number
	return (y - 1) * self.width + x
end

-- Returns the cell type, or nil when out of bounds (so callers can treat the
-- border as "solid wall" without a separate bounds check).
function Grid.get(self: Grid, x: number, y: number): number?
	if x < 1 or x > self.width or y < 1 or y > self.height then
		return nil
	end
	return self.cells[(y - 1) * self.width + x]
end

function Grid.set(self: Grid, x: number, y: number, value: number)
	if x < 1 or x > self.width or y < 1 or y > self.height then
		return
	end
	self.cells[(y - 1) * self.width + x] = value
end

function Grid.is(self: Grid, x: number, y: number, value: number): boolean
	return self:get(x, y) == value
end

-- Count cells of a given type (used for fill targets / stats).
function Grid.count(self: Grid, value: number): number
	local n = 0
	for _, v in self.cells do
		if v == value then
			n += 1
		end
	end
	return n
end

return Grid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">HallwayGenerator</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	MapGen/HallwayGenerator.luau
	Carves the hallway network into a Grid using a coarse lattice + a randomized
	spanning tree (plus a few extra "loop" edges).

	The model
	---------
	Overlay a lattice of nodes spaced `spacing` cells apart (each interval jittered
	by +/-spacingJitter so blocks vary in size instead of all being identical --
	see buildAxis). Corridors are the straight, `hallWidth`-cell-wide runs between
	orthogonally adjacent nodes ("edges"). A randomized Prim's algorithm grows a
	spanning tree over the nodes, so every carved corridor connects back to the
	rest — the whole hallway network is one connected component (important:
	every hallway must be reachable in a real map).
	After the tree, leftover edges are carved with probability `loopChance` to add
	loops, because pure trees feel like a maze and hotels have loops.

	The big cell blocks *between* the corridor lines are left EMPTY — those are the
	pockets the RoomFinder later fills with rooms.

	Steppable
	---------
	Generation is driven one edge at a time via :step(). Each call carves at most
	one corridor segment and records the affected cells in `self.lastCarved`, so a
	visualizer can animate the network growing. :step() returns false when done.

	Usage:
		local gen = HallwayGenerator.new(grid, { spacing = 5, loopChance = 0.12 }, rng)
		while gen:step() do
			-- gen.lastCarved : { {x,y}, ... } cells carved this step
			-- gen.frontier   : current Prim frontier node cells (for markers)
		end
]]

local Grid = require(script.Parent.Grid)

local HallwayGenerator = {}
HallwayGenerator.__index = HallwayGenerator

export type Config = {
	spacing: number?, -- cells between parallel corridors (lattice pitch)
	-- corridor width in cells (must be < spacing). Without spacingJitter, a
	-- single un-merged block is exactly (spacing - hallWidth) cells square in
	-- BOTH directions -- that's the size RoomFinder's minWidth/maxWidth/
	-- minLength/maxLength bound against. Since only one axis stretches when a
	-- loop edge merges two blocks (the other stays walled in), most rooms would
	-- end up "(spacing-hallWidth) x something" -- e.g. spacing=6,hallWidth=2
	-- gives a fixed 4-cell edge on ~most rooms.
	hallWidth: number?,
	-- Randomizes each lattice interval by +/-spacingJitter cells (per column and
	-- per row) so un-merged blocks vary in size instead of all being identical.
	-- Defaults to floor(spacing/3). Set 0 for a perfectly uniform grid.
	spacingJitter: number?,
	loopChance: number?, -- probability of carving each non-tree edge
	margin: number?, -- cells of empty border kept clear around the lattice
}

local function tryCarve(grid, x, y, out)
	local v = grid:get(x, y)
	if v ~= nil and v ~= Grid.HALL then
		grid:set(x, y, Grid.HALL)
		table.insert(out, { x, y })
	end
end

-- Carve a straight corridor `width` cells wide between two node cell-coords.
-- Corridors grow toward +X/+Y off their lattice line (perpendicular to travel):
-- a horizontal run widens in Y, a vertical run widens in X. Consistent growth
-- direction keeps parallel corridors and their room gaps uniform.
local function carveSegment(grid, ax, ay, bx, by, width, out)
	local dx = math.sign(bx - ax)
	local dy = math.sign(by - ay)
	local px, py = if dx ~= 0 then 0 else 1, if dx ~= 0 then 1 else 0 -- perpendicular
	local x, y = ax, ay
	while true do
		for w = 0, width - 1 do
			tryCarve(grid, x + px * w, y + py * w, out)
		end
		if x == bx and y == by then
			break
		end
		x += dx
		y += dy
	end
end

-- Fill the width x width junction block at a node so corners stay solid where
-- corridors of different orientations meet.
local function carveNodeBlock(grid, ax, ay, width, out)
	for wy = 0, width - 1 do
		for wx = 0, width - 1 do
			tryCarve(grid, ax + wx, ay + wy, out)
		end
	end
end

-- Build one axis of lattice-line positions from `origin` up to `maxCoord`,
-- jittering each interval by +/-jitter cells (floored at `minStep` so a block
-- never collapses to zero/negative size). The last line is clamped exactly to
-- maxCoord so the far edge always closes with a real corridor instead of
-- trailing into an un-subdivided leftover strip.
local function buildAxis(origin: number, maxCoord: number, spacing: number, jitter: number, minStep: number, rng: Random): { number }
	local positions = { origin }
	local pos = origin
	while pos < maxCoord do
		local step = spacing
		if jitter > 0 then
			step += rng:NextInteger(-jitter, jitter)
		end
		step = math.max(step, minStep)
		pos = math.min(pos + step, maxCoord)
		table.insert(positions, pos)
	end
	return positions
end

function HallwayGenerator.new(grid, config: Config?, rng: Random)
	config = config or {}
	local spacing = config.spacing or 5
	local margin = config.margin or 1

	-- Corridor width must leave at least one empty cell between parallel
	-- corridors, otherwise rooms have nowhere to go.
	local hallWidth = math.clamp(config.hallWidth or 1, 1, spacing - 1)
	local minStep = hallWidth + 1
	local jitter = math.clamp(config.spacingJitter or math.floor(spacing / 3), 0, math.max(spacing - minStep, 0))

	-- Lay out lattice nodes along each axis independently (see buildAxis). Every
	-- row shares the same column positions and vice versa -- still a strict
	-- rectangular grid, just with non-uniform pitch -- so corridors stay straight
	-- and fully aligned while block sizes vary.
	local originX = 1 + margin
	local originY = 1 + margin
	local maxNodeX = grid.width - margin
	local maxNodeY = grid.height - margin
	local nodeXs = buildAxis(originX, maxNodeX, spacing, jitter, minStep, rng)
	local nodeYs = buildAxis(originY, maxNodeY, spacing, jitter, minStep, rng)
	local cols = #nodeXs
	local rows = #nodeYs

	local self = setmetatable({
		grid = grid,
		rng = rng,
		spacing = spacing,
		hallWidth = hallWidth,
		loopChance = config.loopChance or 0.12,
		cols = cols,
		rows = rows,
		nodeXs = nodeXs,
		nodeYs = nodeYs,

		inSet = {}, -- [nodeId] = true once the node joined the tree
		carvedEdges = {}, -- [edgeKey] = true
		frontier = {}, -- Prim frontier: list of {fromId, ni, nj}
		loopQueue = {}, -- non-tree edges discovered during Prim, tried later
		phase = "tree", -- "tree" -> "loops" -> "done"

		lastCarved = {}, -- cells carved on the most recent :step()
		nodeCount = cols * rows,
		joined = 0,
	}, HallwayGenerator)

	-- Seed Prim from a random node near the middle for a centered network.
	local startI = math.clamp(math.floor(cols / 2) + rng:NextInteger(-1, 1), 1, cols)
	local startJ = math.clamp(math.floor(rows / 2) + rng:NextInteger(-1, 1), 1, rows)
	self:_join(startI, startJ)

	return self
end

function HallwayGenerator._nodeId(self, i: number, j: number): number
	return (j - 1) * self.cols + i
end

function HallwayGenerator._nodeCell(self, i: number, j: number): (number, number)
	return self.nodeXs[i], self.nodeYs[j]
end

-- Add node (i,j) to the tree and push its outward edges onto the frontier.
function HallwayGenerator._join(self, i: number, j: number)
	local id = self:_nodeId(i, j)
	if self.inSet[id] then
		return
	end
	self.inSet[id] = true
	self.joined += 1
	local neighbors = { { i + 1, j }, { i - 1, j }, { i, j + 1 }, { i, j - 1 } }
	for _, n in neighbors do
		local ni, nj = n[1], n[2]
		if ni >= 1 and ni <= self.cols and nj >= 1 and nj <= self.rows then
			table.insert(self.frontier, { id, ni, nj })
		end
	end
end

local function edgeKey(a: number, b: number): number
	-- canonical, order-independent key for the undirected edge {a,b}
	if a < b then
		return a * 1e6 + b
	end
	return b * 1e6 + a
end

-- Carve the edge between two nodes given by node indices. Returns true if it
-- actually carved (edge not already carved).
function HallwayGenerator._carveEdge(self, ai, aj, bi, bj): boolean
	local key = edgeKey(self:_nodeId(ai, aj), self:_nodeId(bi, bj))
	if self.carvedEdges[key] then
		return false
	end
	self.carvedEdges[key] = true
	local ax, ay = self:_nodeCell(ai, aj)
	local bx, by = self:_nodeCell(bi, bj)
	table.clear(self.lastCarved)
	carveSegment(self.grid, ax, ay, bx, by, self.hallWidth, self.lastCarved)
	-- keep both junctions solid at this corridor width
	carveNodeBlock(self.grid, ax, ay, self.hallWidth, self.lastCarved)
	carveNodeBlock(self.grid, bx, by, self.hallWidth, self.lastCarved)
	return true
end

-- Advance generation by one carved corridor. Returns false when finished.
function HallwayGenerator.step(self): boolean
	if self.phase == "tree" then
		-- Pop random frontier edges until we find one reaching a new node.
		while #self.frontier > 0 do
			local idx = self.rng:NextInteger(1, #self.frontier)
			local edge = self.frontier[idx]
			-- swap-remove for O(1)
			self.frontier[idx] = self.frontier[#self.frontier]
			self.frontier[#self.frontier] = nil

			local fromId, ni, nj = edge[1], edge[2], edge[3]
			local toId = self:_nodeId(ni, nj)
			-- recover from-node indices
			local fi = ((fromId - 1) % self.cols) + 1
			local fj = math.floor((fromId - 1) / self.cols) + 1

			if self.inSet[toId] then
				-- both endpoints already in tree -> candidate loop edge for later
				table.insert(self.loopQueue, { fi, fj, ni, nj })
			else
				self:_carveEdge(fi, fj, ni, nj)
				self:_join(ni, nj)
				return true
			end
		end
		-- frontier exhausted: tree complete, move to loop phase
		self.phase = "loops"
	end

	if self.phase == "loops" then
		while #self.loopQueue > 0 do
			local edge = table.remove(self.loopQueue) :: any
			local key = edgeKey(self:_nodeId(edge[1], edge[2]), self:_nodeId(edge[3], edge[4]))
			if not self.carvedEdges[key] and self.rng:NextNumber() < self.loopChance then
				self:_carveEdge(edge[1], edge[2], edge[3], edge[4])
				return true
			end
		end
		self.phase = "done"
	end

	return false
end

-- Convenience: run to completion in one call (no animation).
function HallwayGenerator.run(self)
	while self:step() do
	end
end

return HallwayGenerator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">RoomFinder</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	MapGen/RoomFinder.luau
	Empty-space detection. After the hallways are carved, this figures out where
	rooms can go.

	Three stages:
	  1. detectRegions(grid) — 4-connected flood fill over EMPTY cells, grouping
	     the leftover space into distinct pockets. Each region records its bounding
	     box and whether it borders a hallway (a region with no hall neighbour is
	     unreachable and shouldn't get a room / door).

	  2. findRooms(grid, config) — greedy rectangle packing. Repeatedly finds the
	     largest axis-aligned rectangle of EMPTY cells within [minWidth,maxWidth] x
	     [minLength,maxLength] and reserves it, so the scan always makes progress.
	     A rectangle is only published as a Room if it borders at least one hallway
	     cell (a sealed rectangle with zero doorCells would be an unreachable room —
	     that floor space is left reserved-but-unused instead). This guarantees
	     every returned Room has >=1 doorCell and is reachable from the (fully
	     connected) hallway network.

	  3. resolvePockets(grid, rooms, rng, config) — findRooms always leaves some
	     EMPTY cells unclaimed (pockets too small to satisfy minWidth/minLength).
	     This flood-fills each leftover pocket and resolves it by what it borders:
	       touches exactly one room  -> merged into that room (extra floor space),
	                                     if the room isn't past its irregularity cap
	       touches two+ rooms        -> a chance to become a connecting hallway
	                                     segment (doorWidth-cell opening to every
	                                     room it touches, NOT the whole shared
	                                     boundary), otherwise merged into one
	                                     eligible room at random
	       touches no room, or every touching room is past its irregularity cap
	                                  -> becomes plain hallway (still gets a
	                                     doorWidth-cell opening to any rooms it
	                                     touches, so it's never a sealed dead end
	                                     even when it can't merge)
	     Each merge grows the room's `irregularity` rating by the merged pocket's
	     size relative to the room's original area; once a room's rating reaches
	     `irregularityThreshold` it stops accepting further merges (it can still
	     gain connecting-hallway doorways, which don't change its shape). This is
	     step one of a planned irregularity system -- eventually a room past the
	     cap might get something fancier (e.g. a portal to another irregular room)
	     instead of just being cut off from merges.
	     Rooms merge irregular pockets by simply growing their `cells` list past
	     the original rectangle (x/y/w/h stays the original packed rectangle, used
	     only for the primary door's side geometry). Returns a list of edges that
	     must stay open regardless of the normal one-door-per-room rule, for the
	     "connecting hallway" and "forced hallway" cases.

	  4. connectAdjacentRooms(grid, rooms, rng, config) — findRooms can pack two
	     rooms edge-to-edge with no hallway between them (same for pockets that
	     resolvePockets merges into one room but leave another room bordering the
	     result), which normally get a plain solid wall between them. This finds
	     every such directly-touching room pair and rolls `chance` to punch a
	     connecting door between them, widened up to `doorWidth` cells along their
	     shared boundary. Returns edges in the same {ax,ay,bx,by} shape as
	     resolvePockets, so the two lists can just be concatenated before handing
	     them to Builder.

	Everything works in cell space; the caller maps cells to world studs.
]]

local Grid = require(script.Parent.Grid)

local RoomFinder = {}

export type Region = {
	cells: { { number } },
	minX: number,
	maxX: number,
	minY: number,
	maxY: number,
	touchesHall: boolean,
}

export type Room = {
	x: number, -- min corner of the original packed rectangle (used for door geometry)
	y: number,
	w: number, -- width/height of the original packed rectangle, in cells
	h: number,
	cells: { { number } }, -- every cell this room owns: the rectangle plus any merged pockets
	doorCells: { { number } }, -- hallway cells adjacent to this room's original rectangle border
	irregularity: number, -- cumulative merged-pocket size / original area; see resolvePockets
}

export type RoomConfig = {
	minWidth: number?, -- min room edge along X, in cells
	maxWidth: number?, -- max room edge along X, in cells
	minLength: number?, -- min room edge along Y (Z in world), in cells
	maxLength: number?, -- max room edge along Y (Z in world), in cells
}

export type PocketConfig = {
	-- probability a pocket touching 2+ rooms becomes a connecting hallway
	-- segment instead of extending one of the rooms it touches
	hallwayChance: number?,
	-- a room stops accepting pocket merges once its irregularity rating (see
	-- resolvePockets) reaches this. Merges rejected this way become hallway
	-- instead, still opened to the room they couldn't merge into.
	irregularityThreshold: number?,
	-- cells wide per door opened between a forced/connecting hallway pocket and
	-- each room it touches -- NOT the whole shared boundary (a large pocket
	-- could otherwise blow out an entire wall run).
	doorWidth: number?,
}

export type RoomLinkConfig = {
	chance: number?, -- probability each directly-adjacent room pair gets a connecting door
	doorWidth: number?, -- cells wide per connecting door
}

local NEIGHBORS = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }

--------------------------------------------------------------------------------
-- Stage 1: connected empty regions
--------------------------------------------------------------------------------

function RoomFinder.detectRegions(grid): { Region }
	local visited = {} -- [index] = true
	local regions = {}

	for sy = 1, grid.height do
		for sx = 1, grid.width do
			local startIdx = grid:index(sx, sy)
			if not visited[startIdx] and grid.cells[startIdx] == Grid.EMPTY then
				-- BFS this pocket
				local cells = {}
				local minX, maxX, minY, maxY = sx, sx, sy, sy
				local touchesHall = false
				local stack = { { sx, sy } }
				visited[startIdx] = true
				while #stack > 0 do
					local c = table.remove(stack) :: any
					local cx, cy = c[1], c[2]
					table.insert(cells, c)
					minX, maxX = math.min(minX, cx), math.max(maxX, cx)
					minY, maxY = math.min(minY, cy), math.max(maxY, cy)
					for _, d in NEIGHBORS do
						local nx, ny = cx + d[1], cy + d[2]
						local v = grid:get(nx, ny)
						if v == Grid.HALL then
							touchesHall = true
						elseif v == Grid.EMPTY then
							local ni = grid:index(nx, ny)
							if not visited[ni] then
								visited[ni] = true
								table.insert(stack, { nx, ny })
							end
						end
					end
				end
				table.insert(regions, {
					cells = cells,
					minX = minX,
					maxX = maxX,
					minY = minY,
					maxY = maxY,
					touchesHall = touchesHall,
				})
			end
		end
	end

	return regions
end

--------------------------------------------------------------------------------
-- Stage 2: greedy room-rectangle packing
--------------------------------------------------------------------------------

-- Hallway cells orthogonally adjacent to the rectangle border (door candidates).
local function collectDoors(grid, x, y, w, h): { { number } }
	local doors = {}
	for cx = x, x + w - 1 do
		if grid:get(cx, y - 1) == Grid.HALL then
			table.insert(doors, { cx, y - 1 })
		end
		if grid:get(cx, y + h) == Grid.HALL then
			table.insert(doors, { cx, y + h })
		end
	end
	for cy = y, y + h - 1 do
		if grid:get(x - 1, cy) == Grid.HALL then
			table.insert(doors, { x - 1, cy })
		end
		if grid:get(x + w, cy) == Grid.HALL then
			table.insert(doors, { x + w, cy })
		end
	end
	return doors
end

function RoomFinder.findRooms(grid, config: RoomConfig?): { Room }
	config = config or {}
	local minWidth = config.minWidth or 2
	local maxWidth = config.maxWidth or 6
	local minLength = config.minLength or 2
	local maxLength = config.maxLength or 6

	-- Working "is this cell still free for a room" matrix.
	local W, H = grid.width, grid.height
	local free = table.create(W * H, false)
	for i = 1, W * H do
		free[i] = grid.cells[i] == Grid.EMPTY
	end
	local function isFree(x, y)
		return x >= 1 and x <= W and y >= 1 and y <= H and free[(y - 1) * W + x]
	end

	local rooms = {}

	while true do
		-- Find the largest rectangle within [minWidth,maxWidth] x [minLength,maxLength]
		-- of free cells.
		local best = { area = 0, x = 0, y = 0, w = 0, h = 0 }
		for y = 1, H do
			for x = 1, W do
				if isFree(x, y) then
					-- Grow a rectangle anchored at (x,y). Track the running min width
					-- as height increases (classic anchored maximal-rectangle scan).
					local minW = maxWidth
					for h = 1, maxLength do
						local ry = y + h - 1
						if ry > H then
							break
						end
						-- width of free run on row ry starting at x, capped
						local w = 0
						while w < minW and isFree(x + w, ry) do
							w += 1
						end
						if w == 0 then
							break
						end
						minW = math.min(minW, w)
						if minW >= minWidth and h >= minLength then
							local area = minW * h
							if area > best.area then
								best.area = area
								best.x, best.y, best.w, best.h = x, y, minW, h
							end
						end
					end
				end
			end
		end

		if best.area == 0 then
			break -- nothing room-sized left
		end

		-- Reserve the rectangle unconditionally so the scan always makes progress,
		-- even if it turns out to have no door (see doc comment above).
		for cy = best.y, best.y + best.h - 1 do
			for cx = best.x, best.x + best.w - 1 do
				free[(cy - 1) * W + cx] = false
			end
		end

		local doorCells = collectDoors(grid, best.x, best.y, best.w, best.h)
		if #doorCells > 0 then
			local cells = {}
			for cy = best.y, best.y + best.h - 1 do
				for cx = best.x, best.x + best.w - 1 do
					table.insert(cells, { cx, cy })
				end
			end
			table.insert(rooms, {
				x = best.x,
				y = best.y,
				w = best.w,
				h = best.h,
				cells = cells,
				doorCells = doorCells,
				irregularity = 0,
			})
		end
	end

	return rooms
end

--------------------------------------------------------------------------------
-- Stage 3: resolve leftover pockets findRooms couldn't claim
--------------------------------------------------------------------------------

-- Returns a list of {ax, ay, bx, by} cell-pair edges that must stay open (never
-- walled), for pockets that became a connecting hallway between rooms.
function RoomFinder.resolvePockets(grid, rooms, rng: Random, config: PocketConfig?): { { number } }
	config = config or {}
	local hallwayChance = config.hallwayChance or 0.4
	local irregularityThreshold = config.irregularityThreshold or 0.5
	local doorWidth = config.doorWidth or 2

	local W, H = grid.width, grid.height

	-- Which room (if any) currently owns each cell. Updated as pockets merge in,
	-- so a later pocket adjacent to an earlier merge is correctly seen as
	-- touching that room too.
	local owner = table.create(W * H, 0)
	for roomIndex, room in rooms do
		for _, c in room.cells do
			owner[grid:index(c[1], c[2])] = roomIndex
		end
	end

	local openEdges = {}
	local visited = {}

	-- Opens a doorWidth-cell run between `cells` (already converted to HALL) and
	-- each room in roomList -- NOT the whole shared boundary, so a large pocket
	-- doesn't blow out an entire wall run. Keeps a forced/culled hallway pocket
	-- from being sealed off from rooms it happens to touch.
	local function openToRooms(cells, roomList)
		for _, r in roomList do
			local edges = {}
			for _, c in cells do
				local cx, cy = c[1], c[2]
				for _, d in NEIGHBORS do
					local nx, ny = cx + d[1], cy + d[2]
					if grid:inBounds(nx, ny) and owner[grid:index(nx, ny)] == r then
						table.insert(edges, { cx, cy, nx, ny })
					end
				end
			end
			if #edges > 0 then
				local idx = rng:NextInteger(1, #edges)
				local half = math.floor((doorWidth - 1) / 2)
				local lo = math.max(1, math.min(idx - half, #edges - doorWidth + 1))
				local hi = math.min(#edges, lo + doorWidth - 1)
				for i = lo, hi do
					table.insert(openEdges, edges[i])
				end
			end
		end
	end

	for sy = 1, H do
		for sx = 1, W do
			local startIdx = grid:index(sx, sy)
			if not visited[startIdx] and grid.cells[startIdx] == Grid.EMPTY and owner[startIdx] == 0 then
				-- BFS this leftover pocket, noting every room it borders along the way.
				local cells = {}
				local touching = {} -- set of room indices
				local stack = { { sx, sy } }
				visited[startIdx] = true
				while #stack > 0 do
					local c = table.remove(stack) :: any
					local cx, cy = c[1], c[2]
					table.insert(cells, c)
					for _, d in NEIGHBORS do
						local nx, ny = cx + d[1], cy + d[2]
						if grid:inBounds(nx, ny) and grid.cells[grid:index(nx, ny)] == Grid.EMPTY then
							local ni = grid:index(nx, ny)
							local o = owner[ni]
							if o ~= 0 then
								touching[o] = true
							elseif not visited[ni] then
								visited[ni] = true
								table.insert(stack, { nx, ny })
							end
						end
					end
				end

				local roomList = {}
				for r in touching do
					table.insert(roomList, r)
				end

				local eligible = {}
				for _, r in roomList do
					if rooms[r].irregularity < irregularityThreshold then
						table.insert(eligible, r)
					end
				end

				if #roomList == 0 then
					-- not connected to any room -- becomes plain hallway
					for _, c in cells do
						grid:set(c[1], c[2], Grid.HALL)
					end
				elseif #roomList >= 2 and #eligible > 0 and rng:NextNumber() < hallwayChance then
					-- between 2+ rooms, won the coin flip -- becomes a connecting
					-- hallway segment, left fully open to every room it touches
					for _, c in cells do
						grid:set(c[1], c[2], Grid.HALL)
					end
					openToRooms(cells, roomList)
				elseif #eligible > 0 then
					-- adjoins exactly one (eligible) room, or lost the coin flip --
					-- extend a random eligible room, growing its irregularity
					local pick = eligible[rng:NextInteger(1, #eligible)]
					local room = rooms[pick]
					room.irregularity += #cells / (room.w * room.h)
					for _, c in cells do
						table.insert(room.cells, c)
						owner[grid:index(c[1], c[2])] = pick
					end
				else
					-- every room it touches is past its irregularity cap -- can't
					-- merge, so it becomes hallway instead (still opened to those
					-- rooms so it's not a sealed dead end)
					for _, c in cells do
						grid:set(c[1], c[2], Grid.HALL)
					end
					openToRooms(cells, roomList)
				end
			end
		end
	end

	return openEdges
end

--------------------------------------------------------------------------------
-- Stage 4: chance to connect directly-adjacent rooms with their own door
--------------------------------------------------------------------------------

local function pairKey(a: number, b: number): number
	if a > b then
		a, b = b, a
	end
	return a * 1e6 + b
end

function RoomFinder.connectAdjacentRooms(grid, rooms, rng: Random, config: RoomLinkConfig?): { { number } }
	config = config or {}
	local chance = config.chance or 0.15
	local doorWidth = config.doorWidth or 2

	local W, H = grid.width, grid.height
	local owner = table.create(W * H, 0)
	for roomIndex, room in rooms do
		for _, c in room.cells do
			owner[grid:index(c[1], c[2])] = roomIndex
		end
	end

	-- Every boundary edge between two DIFFERENT rooms, grouped by room pair.
	-- Only checking east/south neighbours visits each internal edge once.
	local pairEdges = {} -- [pairKey] = { {ax,ay,bx,by}, ... }
	for y = 1, H do
		for x = 1, W do
			local a = owner[grid:index(x, y)]
			if a ~= 0 then
				for _, d in { { 1, 0 }, { 0, 1 } } do
					local nx, ny = x + d[1], y + d[2]
					if grid:inBounds(nx, ny) then
						local b = owner[grid:index(nx, ny)]
						if b ~= 0 and b ~= a then
							local key = pairKey(a, b)
							pairEdges[key] = pairEdges[key] or {}
							table.insert(pairEdges[key], { x, y, nx, ny })
						end
					end
				end
			end
		end
	end

	local openEdges = {}
	for _, edges in pairEdges do
		if rng:NextNumber() < chance then
			-- Open a doorWidth-cell run centered on a random edge along their
			-- shared boundary (row/column scan order keeps a straight shared
			-- wall's entries array-adjacent, so this is a real contiguous gap
			-- for the common case of two rectangular rooms sharing a wall).
			local idx = rng:NextInteger(1, #edges)
			local half = math.floor((doorWidth - 1) / 2)
			local lo = math.max(1, math.min(idx - half, #edges - doorWidth + 1))
			local hi = math.min(#edges, lo + doorWidth - 1)
			for i = lo, hi do
				table.insert(openEdges, edges[i])
			end
		end
	end

	return openEdges
end

return RoomFinder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Visualizer</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	MapGen/Visualizer.luau
	Draws the generation state as parts in the workspace so you can watch the
	map build. It renders a flat grid of floor tiles (one per cell), recolors
	tiles as cells change type, tints empty regions during detection, and pops
	translucent boxes + labels over detected room rectangles.

	It holds no generation logic — the orchestrator (init.luau) steps the
	generator and calls into here to reflect each change, pacing the animation
	with waits. Everything lives under a single workspace Folder that :destroy()
	tears down, so re-running is clean.

	Cell -> world mapping:
	  worldXZ(x,y) = origin + ((x-0.5)*cellSize, (y-0.5)*cellSize) on the XZ plane.
]]

local Grid = require(script.Parent.Grid)
local CellSpace = require(script.Parent.CellSpace)

local Visualizer = {}
Visualizer.__index = Visualizer

local TILE_THICKNESS = 0.4

local COLORS = {
	[Grid.EMPTY] = Color3.fromRGB(38, 40, 48),
	[Grid.HALL] = Color3.fromRGB(228, 208, 170),
	[Grid.ROOM] = Color3.fromRGB(90, 130, 200),
	[Grid.DOOR] = Color3.fromRGB(240, 120, 80),
}

-- Distinct, readable palette cycled across regions / rooms.
local PALETTE = {
	Color3.fromRGB(232, 108, 108),
	Color3.fromRGB(232, 168, 92),
	Color3.fromRGB(224, 214, 96),
	Color3.fromRGB(120, 208, 120),
	Color3.fromRGB(96, 200, 208),
	Color3.fromRGB(120, 152, 232),
	Color3.fromRGB(176, 128, 232),
	Color3.fromRGB(232, 128, 192),
}

function Visualizer.new(grid, config)
	local origin = config.origin or Vector3.new(0, 0, 0)
	local self = setmetatable({
		grid = grid,
		cellSize = config.cellSize or 8,
		origin = origin,
		tiles = table.create(grid.width * grid.height), -- flat, parallel to grid.cells
		root = nil,
		tileFolder = nil,
		overlayFolder = nil,
		enabled = true,
	}, Visualizer)

	local root = Instance.new("Folder")
	root.Name = "MapGenVisualizer"
	local tiles = Instance.new("Folder")
	tiles.Name = "Tiles"
	tiles.Parent = root
	local overlays = Instance.new("Folder")
	overlays.Name = "Overlays"
	overlays.Parent = root
	root.Parent = workspace

	self.root = root
	self.tileFolder = tiles
	self.overlayFolder = overlays
	return self
end

function Visualizer.worldXZ(self, x: number, y: number): Vector3
	return CellSpace.worldXZ(self.origin, self.cellSize, x, y)
end

-- Show/hide the whole debug overlay by reparenting its folder (mirrors
-- ChunkVisualizer's convention). Useful once Builder has placed real geometry
-- and you want to compare it against the debug preview without both rendering
-- at once.
function Visualizer.setEnabled(self, value: boolean)
	self.enabled = value
	if self.root then
		self.root.Parent = value and workspace or nil
	end
end

function Visualizer.toggle(self)
	self:setEnabled(not self.enabled)
end

-- Center of the whole map (handy for aiming a camera).
function Visualizer.center(self): Vector3
	return self.origin + Vector3.new(self.grid.width * self.cellSize / 2, 0, self.grid.height * self.cellSize / 2)
end

-- Build every floor tile up front, colored by current cell type.
function Visualizer.drawBase(self)
	local size = self.cellSize
	for y = 1, self.grid.height do
		for x = 1, self.grid.width do
			local idx = self.grid:index(x, y)
			local tile = Instance.new("Part")
			tile.Name = `T_{x}_{y}`
			tile.Anchored = true
			tile.CanCollide = false
			tile.CanQuery = false
			tile.CanTouch = false
			tile.CastShadow = false
			tile.Material = Enum.Material.SmoothPlastic
			tile.Size = Vector3.new(size - 0.15, TILE_THICKNESS, size - 0.15)
			tile.Position = self:worldXZ(x, y) - Vector3.new(0, TILE_THICKNESS / 2, 0)
			tile.Color = COLORS[self.grid.cells[idx]] or COLORS[Grid.EMPTY]
			tile.Parent = self.tileFolder
			self.tiles[idx] = tile
		end
	end
end

-- Recolor one tile to match its current grid cell type.
function Visualizer.paintCell(self, x: number, y: number)
	local idx = self.grid:index(x, y)
	local tile = self.tiles[idx]
	if tile then
		tile.Color = COLORS[self.grid.cells[idx]] or COLORS[Grid.EMPTY]
	end
end

function Visualizer.paintCells(self, cells)
	for _, c in cells do
		self:paintCell(c[1], c[2])
	end
end

function Visualizer.paletteColor(self, index: number): Color3
	return PALETTE[((index - 1) % #PALETTE) + 1]
end

-- Tint an empty region's tiles (empty-space detection visualization).
function Visualizer.highlightRegion(self, region, color: Color3)
	for _, c in region.cells do
		local tile = self.tiles[self.grid:index(c[1], c[2])]
		if tile then
			tile.Color = color
		end
	end
end

-- Pop a translucent box + label over a detected room rectangle.
function Visualizer.addRoom(self, room, color: Color3, label: string?)
	local size = self.cellSize
	local box = Instance.new("Part")
	box.Name = `Room_{room.x}_{room.y}`
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.CastShadow = false
	box.Material = Enum.Material.SmoothPlastic
	box.Transparency = 0.5
	box.Color = color
	box.Size = Vector3.new(room.w * size - 0.4, size * 0.6, room.h * size - 0.4)
	-- center of the rectangle in cell space
	local cx = room.x + (room.w - 1) / 2
	local cy = room.y + (room.h - 1) / 2
	box.Position = self:worldXZ(cx, cy) + Vector3.new(0, box.Size.Y / 2, 0)
	box.Parent = self.overlayFolder

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(44, 16)
	billboard.AlwaysOnTop = true
	billboard.Parent = box
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.GothamBold
	text.TextScaled = true
	text.TextStrokeTransparency = 0.3
	text.TextColor3 = Color3.new(1, 1, 1)
	text.Text = label or `{room.w}x{room.h}`
	text.Parent = billboard

	-- Mark door cells with a distinct color on the base tiles.
	for _, d in room.doorCells do
		local tile = self.tiles[self.grid:index(d[1], d[2])]
		if tile then
			tile.Color = COLORS[Grid.DOOR]
		end
	end

	return box
end

function Visualizer.clearOverlays(self)
	self.overlayFolder:ClearAllChildren()
end

function Visualizer.destroy(self)
	if self.root then
		self.root:Destroy()
		self.root = nil
	end
end

-- Remove any previous visualization folder before making a new one.
function Visualizer.clearWorkspace()
	local existing = workspace:FindFirstChild("MapGenVisualizer")
	if existing then
		existing:Destroy()
	end
end

return Visualizer
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">ProjectileClient</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	ProjectileClient (client rendering, purely cosmetic)
	Receives the server-authoritative Projectile system's replication stream
	(see Shared.ProjectileProtocol for the wire format, and
	ServerScriptService.Server.Projectile/Replication.luau for the sending
	side) and renders tracers/impacts. This module never makes a gameplay
	decision -- no hit detection, no damage, no entity access -- it only draws
	what the server tells it happened. All client-side simulation between
	updates is dead-reckoning for smoothness (see Prediction.luau); the
	server's own independent Step is always authoritative, and any visual
	drift is corrected the instant ProjHit snaps the final position.

	Modules:
	 init        message handlers + the bounded per-frame render scheduler
	 Prediction  dead-reckoning physics (mirrors the server Step)
	 VisualModel building, posing, culling and retiring the rendered Instance
	 View        camera frustum test
	 Impact      hit flashes (swappable via SetImpactHandler)
	 DebugRays   ProjRay debug lines

	API:
	 ProjectileClient.EnableClientRendering()          -- call once on the client
	 ProjectileClient.SetImpactHandler(fn(position, normal, model, kind))
	     -- replaces the built-in flash/ring effect; see Impact.luau
]]

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Shared = script.Parent
local Heartbeat = require(Shared:WaitForChild("Heartbeat"))
local ChunkManager = require(Shared:WaitForChild("ChunkManager"))
local VisualOffload = require(Shared:WaitForChild("VisualOffload"))
local Protocol = require(Shared:WaitForChild("ProjectileProtocol"))

local DebugRays = require(script.DebugRays)
local Impact = require(script.Impact)
local Prediction = require(script.Prediction)
local Types = require(script.Types)
local View = require(script.View)
local VisualModel = require(script.VisualModel)
local BeamVisual = require(script.BeamVisual)

type Visual = Types.Visual

local Channels = Protocol.Channels

local ProjectileClient = {}

function ProjectileClient.SetImpactHandler(fn: (Vector3, Vector3, Instance?, string?) -> ())
	Impact.SetHandler(fn)
end

-- Matches the server's own default -- used only if a spawn payload is ever
-- missing MaxRealLifetime, which shouldn't normally happen.
local DEFAULT_MAX_REAL_LIFETIME = 60

-- Range loss is now explicit, not inferred from missing homing updates.
-- Under heavy load a bounded pose stream can legitimately pause for seconds;
-- only server death/range exit or the real-lifetime backstop removes it.
-- Hard cap on visible Transform work in one client frame. Exact off-screen
-- trajectories defer prediction until needed; complex ones retain simulation. The
-- persistent round-robin cursor is independent of dilated time, so changing
-- GlobalTimeScale cannot collapse previously staggered cohorts onto one frame.
local MAX_VISUAL_UPDATES_PER_FRAME = 2500
local SMOOTH_RADIUS = 100
local MAX_SMOOTH_PROJECTILES = 500
local SMOOTH_SET_REFRESH_INTERVAL = 0.1 -- real seconds; selection is presentation-only
local DEFAULT_SMOOTH_DURATION = 1 / 60

local clientRendering = false
local visuals: { [number]: Visual } = {}
local deferredVisuals: { [number]: Visual } = {}
local visualCount = 0
local visualOrder: { number } = {} -- append-only between compactions; dead ids are tombstones
local visualCursor = 1
local visualTombstones = 0
-- Sum of global (dilated) dt since rendering began; a visual's
-- lastSimulationTime is a reading of this clock.
local globalSimulationClock = 0
local smoothVisuals: { Visual } = {}
local nextSmoothSetRefresh = 0

local function visualInView(visual: Types.Visual, position: Vector3): boolean
	if visual.rig and visual.rig.beam then
		local center, radius = BeamVisual.GetBounds(visual, position, globalSimulationClock)
		return View.contains(center, radius)
	end
	return View.contains(position)
end

--------------------------------------------------------------------------------
-- Smooth set: the nearest visuals get per-frame interpolation
--------------------------------------------------------------------------------

local function refreshSmoothVisuals(now: number)
	if now < nextSmoothSetRefresh then
		return
	end
	nextSmoothSetRefresh = now + SMOOTH_SET_REFRESH_INTERVAL

	local player = Players.LocalPlayer
	local character = player and player.Character
	local root = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
	debug.profilebegin("ProjectileClient.RefreshSmoothSet")
	-- Keep only the nearest K candidates in a max-heap, so this never sorts
	-- every nearby visual when only MAX_SMOOTH_PROJECTILES can be selected.
	local heapVisuals: { Visual } = table.create(MAX_SMOOTH_PROJECTILES)
	local heapDistances: { number } = table.create(MAX_SMOOTH_PROJECTILES)
	local heapSize = 0
	local function swap(a: number, b: number)
		heapVisuals[a], heapVisuals[b] = heapVisuals[b], heapVisuals[a]
		heapDistances[a], heapDistances[b] = heapDistances[b], heapDistances[a]
	end
	local function push(visual: Visual, distanceSq: number)
		heapSize += 1
		local index = heapSize
		heapVisuals[index] = visual
		heapDistances[index] = distanceSq
		while index > 1 do
			local parent = index // 2
			if heapDistances[parent] >= distanceSq then
				break
			end
			swap(parent, index)
			index = parent
		end
	end
	local function replaceRoot(visual: Visual, distanceSq: number)
		heapVisuals[1] = visual
		heapDistances[1] = distanceSq
		local index = 1
		while true do
			local left = index * 2
			if left > heapSize then
				break
			end
			local right = left + 1
			local largest = if right <= heapSize and heapDistances[right] > heapDistances[left] then right else left
			if heapDistances[index] >= heapDistances[largest] then
				break
			end
			swap(index, largest)
			index = largest
		end
	end
	if root and root:IsA("BasePart") then
		local rootPosition = root.Position
		local radiusSq = SMOOTH_RADIUS * SMOOTH_RADIUS
		for _, visual in visuals do
			local offset = visual.position - rootPosition
			local distanceSq = offset:Dot(offset)
			if distanceSq <= radiusSq and View.contains(visual.position) then
				if heapSize < MAX_SMOOTH_PROJECTILES then
					push(visual, distanceSq)
				elseif distanceSq < heapDistances[1] then
					replaceRoot(visual, distanceSq)
				end
			end
		end
	end

	local selected: { [Visual]: boolean } = {}
	local newSmoothVisuals: { Visual } = table.create(heapSize)
	for index = 1, heapSize do
		local visual = heapVisuals[index]
		selected[visual] = true
		table.insert(newSmoothVisuals, visual)
		if not visual.smoothTransform then
			visual.smoothTransform = true
			visual.lastSmoothStep = now
			visual.lastSmoothTarget = nil
		end
	end
	for _, visual in smoothVisuals do
		if not selected[visual] then
			visual.smoothTransform = false
			visual.lastSmoothStep = nil
			visual.lastSmoothTarget = nil
		end
	end
	smoothVisuals = newSmoothVisuals
	debug.profileend()
end

local function setSmoothTarget(visual: Visual, now: number)
	local previousTarget = visual.lastSmoothTarget
	local duration = if previousTarget
		then math.clamp(now - previousTarget, DEFAULT_SMOOTH_DURATION, 0.1)
		else DEFAULT_SMOOTH_DURATION
	visual.lastSmoothTarget = now
	VisualModel.SetTarget(visual, visual.position, visual.velocity, duration)
end

--------------------------------------------------------------------------------
-- Visual lifecycle
--------------------------------------------------------------------------------

-- Removes the flying tracer. Impact VFX is played from the ProjHit handler
-- itself, so this fires for real hits AND harmless expiry without ever
-- flashing in mid-air. The bullet DISAPPEARS instantly, but the actual
-- :Destroy() waits out the longest lifetime among the effects that were
-- emitting (or DestroyDelay, whichever is longer) -- see VisualModel.Retire.
local function destroyVisual(id: number)
	local visual = visuals[id]
	if not visual then
		return
	end
	visuals[id] = nil
	deferredVisuals[id] = nil
	visualCount -= 1
	visualTombstones += 1
	VisualModel.Retire(visual, visual.destroyDelay)
end

-- Adopts an authoritative pose as of NOW. Every server pose (spawn, bounce,
-- sync transition) is an end-of-server-frame snapshot, so the next
-- render-loop visit must only integrate time that passes after receipt --
-- not the backlog since this visual's previous round-robin visit, which
-- already happened before the pose was taken.
local function rebaseline(visual: Visual, position: Vector3, velocity: Vector3)
	visual.position = position
	visual.velocity = velocity
	visual.simulationDebt = 0
	visual.lastSimulationTime = globalSimulationClock
	visual.deferredPrediction = false
	deferredVisuals[visual.id] = nil
end

local function onSpawn(data: Protocol.SpawnPayload)
	if visuals[data.Id] then
		return
	end
	local model, rig = VisualModel.Build(data)
	local now = os.clock()
	local inView = View.contains(data.Position, data.Beam and data.Beam.Length)
	local visual: Visual = {
		id = data.Id,
		model = model,
		rig = rig,
		destroyDelay = data.DestroyDelay or 0,
		-- See VisualModel.FadeOut -- both default true.
		waitForParticles = data.WaitForParticles ~= false,
		waitForTrails = data.WaitForTrails ~= false,

		position = data.Position,
		velocity = data.Velocity,
		gravity = data.Gravity or 0,
		acceleration = data.Acceleration or 0,
		accelerationDirection = data.AccelerationDirection,
		minSpeed = data.MinSpeed or 0,
		maxSpeed = data.MaxSpeed or math.huge,
		life = data.Lifetime,
		simulationDebt = 0,
		-- Combined Source.TimeScale * projectile.TimeScale; updated live via
		-- ProjTimeScale -- see the "Local time" section of the server module.
		timeScale = data.TimeScale or 1,
		lastSimulationTime = globalSimulationClock,
		deferredPrediction = false,
		synced = data.Synced == true,

		-- Real (undilated) safety-net cap. spawnRealTime is THIS client's own
		-- os.clock() at spawn -- fine, since this only needs to be a generous
		-- backstop, not an exact match to the server's own cap.
		spawnRealTime = now,
		maxRealLifetime = data.MaxRealLifetime or DEFAULT_MAX_REAL_LIFETIME,
		lastUpdate = now,

		lastRenderStep = now,
		inView = inView,
		offscreenSince = if inView then nil else now,
		culled = false,
		effectCullDelay = VisualModel.GetLongestEffectLifetime(model),
		smoothTransform = false,
		transformElapsed = 0,
		transformDuration = 0,
	}
	BeamVisual.Attach(visual)
	if data.ActivateParticlesOnCreate then
		VisualModel.ActivateParticles(model)
	end
	visuals[data.Id] = visual
	visualCount += 1
	table.insert(visualOrder, data.Id)
end

--------------------------------------------------------------------------------
-- Message handlers
--------------------------------------------------------------------------------

-- Fires only when the combined personal/local TimeScale actually changes --
-- not a per-frame stream. The client just needs the number; from here it
-- predicts locally exactly like it already does for chunk/world dilation.
local function onTimeScale(data: Protocol.TimeScalePayload)
	local visual = visuals[data.Id]
	if not visual then
		return
	end
	if not visual.synced then
		-- Settle time already elapsed at the OLD scale first; otherwise the
		-- new scale would be applied retroactively to the whole backlog
		-- since this visual's last round-robin visit.
		local elapsed = globalSimulationClock - visual.lastSimulationTime
		if elapsed > 0 then
			Prediction.simulate(visual, elapsed * visual.timeScale)
		end
		visual.lastSimulationTime = globalSimulationClock
		visual.deferredPrediction = false
		deferredVisuals[visual.id] = nil
	end
	visual.timeScale = data.TimeScale
end

-- Homing lock acquired/dropped -- rare, only on an actual transition, never
-- per-frame. Synced switches the visual into "trust the streamed ProjMove"
-- mode; unsynced switches it back to local physics. Either way the message
-- carries the server's pose at the transition, which is the only correct
-- starting point for local physics after a lock drops.
local function onSync(data: Protocol.SyncPayload)
	local visual = visuals[data.Id]
	if not visual then
		return
	end
	visual.synced = data.Synced
	rebaseline(visual, data.Position, data.Velocity)
	if visual.synced then
		-- Reset the staleness clock right at the transition, so a lastUpdate
		-- left over from before it can't immediately read as stale before the
		-- first real ProjMove arrives.
		visual.lastUpdate = os.clock()
	end
end

-- Batched authoritative pose updates. Two kinds of entries:
--  - Bounced = true: a one-shot bounce correction, applied whether or not
--    the visual is synced (for a non-homing bouncer it is the ONLY update
--    between spawn and impact). Snaps instead of tweening -- a straight
--    tween from the old position would cut through the surface it bounced
--    off -- plays the ricochet flash, and re-baselines local physics.
--  - Otherwise: ordinary continuous homing, or a timestamped beam correction.
--    Beams predict between snapshots regardless of the ordinary Synced flag.
local function onMove(batch: { Protocol.MovePayload })
	local now = os.clock()
	for _, data in batch do
		local visual = visuals[data.Id]
		if not visual then
			continue
		end
		if visual.rig and visual.rig.beam then
			BeamVisual.AdoptPath(visual, data.BeamPath, data.BeamClipped)
			BeamVisual.AdoptMotion(visual, data.ServerTime, data.GlobalScale, data.BeamPreviousId)
			if data.TimeScale ~= nil then visual.timeScale = data.TimeScale end
			if data.Lifetime then visual.life = data.Lifetime end
		end
		if data.Bounced or data.Corrected then
			visual.lastUpdate = now
			rebaseline(visual, data.Position, data.Velocity)
			BeamVisual.Correct(visual, data.Point or data.Position)
			if visual.rig and visual.rig.beam and visual.rig.beam.group then
				BeamVisual.Update(visual, data.Position, data.Velocity)
			end
			if visualInView(visual, data.Position) then
				VisualModel.SuspendTrails(visual)
				VisualModel.Place(visual, data.Position, data.Velocity)
				visual.resumeEffectsOnNextUpdate = now
				if data.Bounced and BeamVisual.ShouldPlayImpact(visual, data.Point or data.Position) then
					Impact.Play(data.Point or data.Position, data.Normal, "bounce")
				end
			end
		elseif visual.synced or (visual.rig and visual.rig.beam) then
			local duration = math.clamp(now - visual.lastUpdate, 0.03, 0.2)
			visual.lastUpdate = now
			rebaseline(visual, data.Position, data.Velocity)
			if visual.rig and visual.rig.beam and visual.rig.beam.group then
				-- Retain authoritative curvature while offscreen; no Instances
				-- are moved here. Re-entry must not invent a homing shortcut.
				BeamVisual.Update(visual, data.Position, data.Velocity)
			end
			if visual.inView and visualInView(visual, data.Position) then
				VisualModel.SetTarget(visual, data.Position, data.Velocity, duration)
			end
		end
	end
end

local function onHit(data: Protocol.HitPayload)
	local visual = visuals[data.Id]
	if visual then
		BeamVisual.AdoptPath(visual, data.BeamPath, data.BeamClipped, true)
		rebaseline(visual, data.Position, visual.velocity)
		-- Snap to the server's exact position before destroying, so any
		-- imperceptible mid-flight drift from local simulation never shows at
		-- the one moment it would be visible.
		if data.BeamBody then
			BeamVisual.StopBody(visual, data.Position)
		else
			BeamVisual.Correct(visual, data.Position)
			VisualModel.Place(visual, data.Position, visual.velocity)
		end
		if data.Kind and BeamVisual.ShouldPlayImpact(visual, data.Position) then
			Impact.Play(data.Position, data.Normal, data.Kind)
		end
	end
	destroyVisual(data.Id)
end

--------------------------------------------------------------------------------
-- Render scheduler
--------------------------------------------------------------------------------

-- Visual came back on screen: place it without drawing a trail across the
-- jump, restore it if it had been fully culled, and resume effects on a
-- later update.
local function reenterView(visual: Visual, now: number)
	VisualModel.SuspendTrails(visual)
	BeamVisual.Reset(visual)
	VisualModel.Place(visual, visual.position, visual.velocity)
	visual.culled = false
	visual.resumeEffectsOnNextUpdate = now
	visual.offscreenSince = nil
end

-- Roblox performs draw culling. Keep the rig parented; after the authored
-- effects' grace period we suspend emission and prediction/interpolation work.
local function recoverStalePose(visual: Visual, position: Vector3, now: number)
	local rig = visual.rig
	if rig and rig.beam and rig.beam.group then return end -- shared geometry is flushed once per channel
	-- Native culling uses the Instance's last rendered bounds. If a camera turn
	-- exposes those stale bounds while the current trajectory is still outside
	-- view, move them outside too. No scene unparenting/visibility override.
	local model = visual.model
	local renderedPosition = if rig then rig.root.Position
		elseif model:IsA("Model") then model:GetPivot().Position
		elseif model:IsA("BasePart") then model.Position
		else position
	if visualInView(visual, renderedPosition) then
		VisualModel.SuspendTrails(visual)
		VisualModel.Place(visual, position, visual.velocity)
		if not visual.culled then visual.resumeEffectsOnNextUpdate = now end
	end
end

local function updateOffscreen(visual: Visual, now: number)
	local since: number = if visual.inView then now else visual.offscreenSince or now
	visual.offscreenSince = since
	if not visual.culled and now - since >= visual.effectCullDelay then
		VisualModel.SuspendEffects(visual)
		visual.culled = true
	end
	recoverStalePose(visual, visual.position, now)
	-- Targets received before leaving view must not continue tweening later.
	visual.transformFrom = nil
	visual.transformTo = nil
end

local function resumeEffectsIfDue(visual: Visual)
	if visual.resumeEffectsOnNextUpdate then
		VisualModel.ResumeEffects(visual)
		visual.resumeEffectsOnNextUpdate = nil
	end
end

-- A SYNCED visual (actively homing) is posed entirely by ProjMove; this only
-- advances its tween and handles visibility. Returns whether it used
-- transform budget, or nil if it was destroyed.
local function updateSynced(visual: Visual, now: number): boolean?
	local inView = visualInView(visual, visual.position)
	if inView then
		if not visual.inView then
			reenterView(visual, now)
		elseif not visual.smoothTransform then
			resumeEffectsIfDue(visual)
			VisualModel.Step(visual, math.max(now - visual.lastRenderStep, 0))
		end
		visual.lastRenderStep = now
	else
		updateOffscreen(visual, now)
	end
	visual.inView = inView
	return inView
end

-- An UNSYNCED visual (the common case -- including a bouncer between
-- bounces) is dead-reckoned by Prediction over all global time accumulated
-- since its previous visit. Returns whether it used transform budget, or nil
-- if it was destroyed.
local function updatePredicted(visual: Visual, elapsedGlobalDt: number, now: number): boolean?
	if not visual.inView and visual.culled and Prediction.canDefer(visual) then
		local dt = elapsedGlobalDt * visual.timeScale
		local projectedPosition = Prediction.projectDeferred(visual, dt)
		if dt < visual.life and not visualInView(visual, projectedPosition) then
			-- Leave the baseline timestamp untouched. Re-entry consumes the whole
			-- interval exactly once; corrections replace that baseline immediately.
			visual.deferredPrediction = true
			deferredVisuals[visual.id] = visual
			recoverStalePose(visual, projectedPosition, now)
			return false
		end
	end
	local alive, moved = Prediction.simulate(visual, elapsedGlobalDt * visual.timeScale)
	visual.lastSimulationTime = globalSimulationClock
	visual.deferredPrediction = false
	deferredVisuals[visual.id] = nil
	local inView = visualInView(visual, visual.position)
	if inView then
		if not visual.inView then
			reenterView(visual, now)
		else
			if moved and visual.smoothTransform then
				setSmoothTarget(visual, now)
			elseif moved then
				VisualModel.Place(visual, visual.position, visual.velocity)
			end
			resumeEffectsIfDue(visual)
		end
		visual.lastRenderStep = now
	else
		updateOffscreen(visual, now)
	end
	visual.inView = inView
	if not alive then
		-- Safety net: normally ProjHit arrives first and removes this entry.
		-- This only fires if it never does (e.g. the projectile left this
		-- client's VisualRange).
		destroyVisual(visual.id)
		return nil
	end
	return inView
end

local function compactVisualOrder()
	local oldOrder = visualOrder
	local oldCount = #oldOrder
	local compacted: { number } = table.create(math.max(oldCount - visualTombstones, 0))
	-- Begin at the next due slot so compaction preserves round-robin fairness.
	for offset = 0, oldCount - 1 do
		local id = oldOrder[(visualCursor + offset - 1) % oldCount + 1]
		if visuals[id] then
			table.insert(compacted, id)
		end
	end
	visualOrder = compacted
	visualCursor = 1
	visualTombstones = 0
end

-- Visits visuals round-robin until MAX_VISUAL_UPDATES_PER_FRAME on-screen
-- transforms have been spent (or every visual was visited once).
local function renderStep(globalDt: number)
	globalSimulationClock += globalDt
	BeamVisual.PredictGroups(workspace:GetServerTimeNow(), globalSimulationClock)
	BeamVisual.StepRetired(globalDt)
	local now = os.clock()
	View.refresh()
	refreshSmoothVisuals(now)

	local slotCount = #visualOrder
	local inspected = 0
	local transformed = 0
	while inspected < slotCount and transformed < MAX_VISUAL_UPDATES_PER_FRAME do
		if visualCursor > slotCount then
			visualCursor = 1
		end
		local id = visualOrder[visualCursor]
		visualCursor += 1
		inspected += 1
		local visual = visuals[id]
		if not visual then
			continue
		end
		local elapsedGlobalDt = math.max(globalSimulationClock - visual.lastSimulationTime, 0)

		-- Real (undilated) backstop mirroring the server's MaxRealLifetime.
		-- Normally ProjHit removes the visual first; this only matters if that
		-- message is missed (e.g. the visual drifted outside VisualRange).
		if now - visual.spawnRealTime >= visual.maxRealLifetime then
			destroyVisual(id)
			continue
		end

		local usedBudget = if visual.synced or (visual.rig and visual.rig.beam and visual.rig.beam.predictedAt)
			then updateSynced(visual, now)
			else updatePredicted(visual, elapsedGlobalDt, now)
		if usedBudget then
			transformed += 1
		end
	end

	-- Nearby visuals receive presentation-only interpolation every real frame.
	-- Their logical simulation and network snapshots remain in the bounded
	-- scheduler above, so this adds at most MAX_SMOOTH_PROJECTILES transforms.
	for _, visual in smoothVisuals do
		if visual.inView and visuals[visual.id] == visual then
			local resumeAt = visual.resumeEffectsOnNextUpdate
			if resumeAt and resumeAt < now then
				resumeEffectsIfDue(visual)
			end
			VisualModel.Step(visual, math.max(now - (visual.lastSmoothStep or now), 0))
			visual.lastSmoothStep = now
		end
	end

	-- Avoid an ever-growing sparse order array without changing which live
	-- visual is next. This is metadata work only; it performs no transforms.
	if visualTombstones >= 256 and visualTombstones * 4 >= #visualOrder then
		compactVisualOrder()
	end
	BeamVisual.FlushGroups(globalSimulationClock)
end

function ProjectileClient.EnableClientRendering()
	if clientRendering or RunService:IsServer() then
		return
	end
	clientRendering = true
	ChunkManager.BeforeTimeScaleChange:Connect(function()
		BeamVisual.PredictGroups(workspace:GetServerTimeNow(), globalSimulationClock)
		for _, visual in deferredVisuals do
				Prediction.settleDeferred(visual,
					math.max(globalSimulationClock - visual.lastSimulationTime, 0) * visual.timeScale)
				visual.lastSimulationTime = globalSimulationClock
				visual.deferredPrediction = false
		end
		table.clear(deferredVisuals)
	end)

	VisualOffload.On(Channels.SpawnBatch, function(batch: { Protocol.SpawnPayload })
		debug.profilebegin("ProjectileClient.BuildSpawnBatch")
		for _, data in batch do
			onSpawn(data)
		end
		debug.profileend()
	end)
	VisualOffload.On(Channels.TimeScale, onTimeScale)
	VisualOffload.On(Channels.Sync, onSync)
	VisualOffload.On(Channels.Move, onMove)
	VisualOffload.On(Channels.RangeExit, function(ids: { number })
		for _, id in ids do
			local visual = visuals[id]
			if not visual then continue end
			if BeamVisual.Discard(visual) then
				visuals[id], deferredVisuals[id] = nil, nil
				visualCount -= 1
				visualTombstones += 1
			else destroyVisual(id) end
		end
	end)
	VisualOffload.On(Channels.HitBatch, function(batch: { Protocol.HitPayload })
		for _, data in batch do
			onHit(data)
		end
	end)
	VisualOffload.On(Channels.Ray, function(data: Protocol.RayPayload)
		DebugRays.Draw(data.From, data.To, data.LowRes)
	end)

	View.refresh()
	Heartbeat.Connect(renderStep, { Name = "ProjectileSystem.ClientSimulate", Priority = 5 })
end

function ProjectileClient.GetStats()
	return {
		Visuals = visualCount,
		VisualUpdatesPerFrame = MAX_VISUAL_UPDATES_PER_FRAME,
		SmoothLimit = MAX_SMOOTH_PROJECTILES,
	}
end

return ProjectileClient
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">BeamGeometry</string>
            <string name="Source"><![CDATA[--!strict
-- Pure geometry union for a sustained channel. Overlapping collinear packet
-- tails become one cylinder, not stacked bars/glow. Distinct paths stay
-- distinct: never invent a connecting chord through untraveled geometry.
local Geometry = {}
Geometry.MaxSegmentLength = 12

-- Tessellate after union, so overlaps are removed but no pooled cylinder can
-- grow into an enormous bar on a flick or a stretched time-field boundary.
function Geometry.Split(segments: { any }): { any }
	local result = {}
	for _, span in segments do
		local a, b = span[1], span[2]
		local count = math.max(1, math.ceil((b-a).Magnitude/(Geometry.MaxSegmentLength-.01)))
		for index = 1, count do
			table.insert(result, { a:Lerp(b,(index-1)/count), a:Lerp(b,index/count) })
		end
	end
	return result
end

function Geometry.Merge(paths: { any }, radius: number): ({ any }, { Vector3 })
	local families: { [string]: any } = {}
	local order: { any } = {}
	local tolerance = math.max(radius * .15, .005)
	local function quant(value: number, scale: number): number return math.floor(value / scale + .5) end
	for _, points in paths do
		-- A point is a control endpoint, not a beam body. Rounded caps are
		-- generated only for nonzero segments below; singleton snapshots must
		-- not leave floating glow dots (especially after retirement/freeze).
		for index = 1, #points - 1 do
			local a, b = points[index], points[index + 1]
			local offset = b - a
			if offset.Magnitude < 1e-4 then continue end
			local direction = offset.Unit
			local abs = Vector3.new(math.abs(direction.X), math.abs(direction.Y), math.abs(direction.Z))
			local main = if abs.X >= abs.Y and abs.X >= abs.Z then direction.X elseif abs.Y >= abs.Z then direction.Y else direction.Z
			if main < 0 then direction = -direction end
			local directionKey = `{quant(direction.X, 1/4096)}:{quant(direction.Y, 1/4096)}:{quant(direction.Z, 1/4096)}`
			local family = families[directionKey]
			if not family then
				family = { direction = direction, cells = {} }
				families[directionKey] = family
			end
			-- Use one representative direction for spatial hashing. Computing a
			-- perpendicular origin with EACH segment's float-rounded direction
			-- amplified tiny angle errors at long range and split a straight beam
			-- back into dozens of bars. Neighbor cells handle grid boundaries.
			local origin = a - family.direction * a:Dot(family.direction)
			local x, y, z = quant(origin.X, tolerance), quant(origin.Y, tolerance), quant(origin.Z, tolerance)
			local function cellKey(dx, dy, dz) return `{x+dx}:{y+dy}:{z+dz}` end
			local function fits(candidate)
				for _, point in { a, b } do
					local delta = point - candidate.origin
					if (delta - candidate.direction * delta:Dot(candidate.direction)).Magnitude > tolerance then return false end
				end
				return true
			end
			local bucket
			local key = cellKey(0,0,0)
			for _, candidate in family.cells[key] or {} do if fits(candidate) then bucket = candidate; break end end
			if not bucket then
				for dx = -1, 1 do
					for dy = -1, 1 do
						for dz = -1, 1 do
							for _, candidate in family.cells[cellKey(dx,dy,dz)] or {} do
								if fits(candidate) then bucket = candidate; break end
							end
							if bucket then break end
						end
						if bucket then break end
					end
					if bucket then break end
				end
			end
			if not bucket then
				bucket = { key = directionKey .. ":" .. key .. ":" .. tostring(#order + 1), origin = a, direction = direction, intervals = {} }
				local cell = family.cells[key]
				if not cell then cell = {}; family.cells[key] = cell end
				table.insert(cell, bucket)
				table.insert(order, bucket)
			end
			local from = (a - bucket.origin):Dot(bucket.direction)
			local to = (b - bucket.origin):Dot(bucket.direction)
			table.insert(bucket.intervals, { math.min(from, to), math.max(from, to) })
		end
	end
	table.sort(order, function(a, b) return a.key < b.key end)
	local segments, joints, seenJoints = {}, {}, {}
	local function addJoint(point: Vector3)
		local key = `{quant(point.X,tolerance)}:{quant(point.Y,tolerance)}:{quant(point.Z,tolerance)}`
		if not seenJoints[key] then seenJoints[key] = true; table.insert(joints, point) end
	end
	local function add(bucket, from, to)
		local a = bucket.origin + bucket.direction * from
		local b = bucket.origin + bucket.direction * to
		table.insert(segments, { a, b })
		for _, point in { a, b } do
			addJoint(point)
		end
	end
	for _, bucket in order do
		table.sort(bucket.intervals, function(a, b) return a[1] < b[1] end)
		local from, to = bucket.intervals[1][1], bucket.intervals[1][2]
		for index = 2, #bucket.intervals do
			local interval = bucket.intervals[index]
			if interval[1] <= to + tolerance then to = math.max(to, interval[2])
			else add(bucket, from, to); from, to = interval[1], interval[2] end
		end
		add(bucket, from, to)
	end
	return Geometry.Split(segments), joints
end

return Geometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">BeamVisual</string>
            <string name="Source"><![CDATA[--!strict
-- Finite, traveling cylinders along a bounded path, not an instantaneous ray
-- from the muzzle to the cursor. Sustained channels share a linked centerline
-- with server collision; individual beams retain their traveled path tail.
-- Collision/damage/bounce/pierce/homing stay server-owned.
local ChunkManager = require(script.Parent.Parent.ChunkManager)
local Types = require(script.Parent.Types)
local Protocol = require(script.Parent.Parent.ProjectileProtocol)
local Geometry = require(script.Parent.BeamGeometry)
local View = require(script.Parent.View)
local RunService = game:GetService("RunService")
local Planner = require(script.Parent.Parent.ProjectileStepPlanner)
local Prediction = require(script.Parent.Prediction)
local Heartbeat = require(script.Parent.Parent.Heartbeat)
local BeamPath = require(script.Parent.Parent.BeamPath)

local BeamVisual = {}
local MAX_SEGMENTS = 8
local MAX_RETIRE_UPDATES = 128
local retired: { any } = {}
local retireCursor = 1
local clock = 0
local ROTATION = CFrame.Angles(0, math.pi / 2, 0) -- cylinder's X axis -> path Z
local groups: { [number]: any } = {}
local pending: { [any]: any } = {}
local applyConnection: RBXScriptConnection? = nil
local predicting: { [any]: boolean } = {}

-- Advance all channel endpoints to ONE presentation epoch before joining any
-- of them. The ordinary round-robin renderer must not mix endpoint ages.
function BeamVisual.PredictGroups(now: number, simulationClock: number)
	for state in predicting do
		local visual = state.visual
		if not visual or not state.predictedAt then continue end
		if now < state.predictedAt then visual.lastSimulationTime = simulationClock; continue end
		local elapsed = math.max(now - state.predictedAt, 0)
		local _, moved = Prediction.simulate(visual, elapsed * state.globalScale * visual.timeScale)
		state.predictedAt = now
		visual.lastSimulationTime = simulationClock
		if state.group then state.group.dirty = true
		elseif moved then BeamVisual.Update(visual, visual.position, visual.velocity) end
	end
end

local function predictedPath(state: any): { Vector3 }?
	local source = state.authoritativePath
	if not source or not state.visual or not state.predictedAt then return source end
	local result = table.clone(source)
	if #result == 0 then return result end
	local position = state.visual.position
	result[1] = position
	if #result > 1 and not state.pathClipped then
		local front = state.group.byId[state.previousId]
		if front and front.visual and not front.retired then
			result[#result] = front.visual.position
		elseif state.previousId == 0 then
			-- A detached fragment translates; world bend vertices remain fixed.
			result[#result] += position - source[1]
		else
			-- The front is gone/pending; never pin a moving packet to an old
			-- spawn/impact location. Translate the last approved finite fragment
			-- until the server supplies a replacement link or a clipped anchor.
			if #result == 2 then result[2] += position - source[1]
			else return { position } end
		end
	end
	-- Prediction cannot authorize a giant collision body. Physical refinement
	-- seeds replacement nodes on the next server frame; until those arrive,
	-- don't draw a shortcut from a moving head to a stale bend/impact anchor.
	for index = 1, #result - 1 do
		if (result[index+1]-result[index]).Magnitude > BeamPath.MaxStretch * 2 then
			return { position }
		end
	end
	return result
end

function BeamVisual.AdoptMotion(visual: Types.Visual, serverTime: number?, globalScale: number?, previousId: number?)
	local state = visual.rig and visual.rig.beam
	if not state then return end
	if previousId ~= nil then state.previousId = previousId end
	if serverTime then
		state.predictedAt = serverTime
		state.globalScale = globalScale or Heartbeat.GetGlobalTimeScale()
	end
	if state.group then state.group.dirty = true end
end

local function part(parent: Instance, name: string, color: Color3, transparency: number, initialPose: CFrame?): Part
	local p = Instance.new("Part")
	p.Name, p.Color, p.Transparency = name, color, transparency
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.one * 0.05
	p.Material = Enum.Material.Neon
	p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
	-- Motor6D.Transform is applied in the engine's simulation phase. New
	-- cylinders need their correct world pose BEFORE being made visible;
	-- otherwise their default X-axis orientation flashes for one frame.
	if initialPose then p.CFrame = initialPose end
	p.Parent = parent
	return p
end

local function motor(driver: BasePart, p: BasePart, initialPose: CFrame?): Motor6D
	local joint = Instance.new("Motor6D")
	-- Connecting Part1 immediately applies C0/C1, before Transform's deferred
	-- engine update. Seed C0 as well as the Part pose to prevent an axis flash.
	joint.C0 = if initialPose then driver.CFrame:ToObjectSpace(initialPose) else CFrame.identity
	joint.Part0, joint.Part1, joint.Parent = driver, p, driver
	return joint
end

local function shape(group: any, pool: any, index: number, pose: CFrame, size: Vector3, ball: boolean)
	local pair = pool[index]
	if not pair then
		local core = part(group.model, if ball then "BeamJointCore" else "BeamCore", group.core, 1, pose)
		local glow = part(group.model, if ball then "BeamJointGlow" else "BeamGlow", group.color, 1, pose)
		if ball then core.Shape = Enum.PartType.Ball; glow.Shape = Enum.PartType.Ball end
		pair = { core = core, glow = glow, coreMotor = motor(group.driver, core, pose), glowMotor = motor(group.driver, glow, pose) }
		pool[index] = pair
	end
	local transform = group.driver.CFrame:ToObjectSpace(pose)
	pair.core.Size = if ball then size * .55 else Vector3.new(size.X, size.Y * .55, size.Z * .55)
	pair.glow.Size = size
	pair.coreMotor.Transform = pair.coreMotor.C0:Inverse() * transform
	pair.glowMotor.Transform = pair.glowMotor.C0:Inverse() * transform
	pair.core.Transparency, pair.glow.Transparency = 0, .5
end

local function hideAfter(pool: any, used: number)
	for index = used + 1, #pool do
		pool[index].core.Transparency, pool[index].glow.Transparency = 1, 1
	end
end

-- Apply size and Motor6D pose together before the engine commits transforms.
-- Reusing a long cylinder at a new angle during Heartbeat otherwise exposes
-- its new length at the old orientation for a rendered frame.
function BeamVisual.ApplyGroups()
	for group, geometry in pending do
		pending[group] = nil
		if not group.model.Parent then continue end
		for index, span in geometry.segments do
			local a, b = span[1], span[2]
			local length = (b - a).Magnitude
			local up = if math.abs((b - a).Y / length) > .99 then Vector3.xAxis else Vector3.yAxis
			shape(group, group.segments, index, CFrame.lookAt((a + b) * .5, b, up) * ROTATION,
				Vector3.new(math.min(length, Geometry.MaxSegmentLength), group.radius * 2, group.radius * 2), false)
		end
		hideAfter(group.segments, #geometry.segments)
		for index, point in geometry.joints do
			shape(group, group.joints, index, CFrame.new(point), Vector3.one * group.radius * 2, true)
		end
		hideAfter(group.joints, #geometry.joints)
	end
end

-- One aggregation per channel per frame, never one visible bar per packet.
-- Only already-simulated paths enter the union. Offscreen packets retain the
-- normal prediction timestamp/correction rules and resume through Reset.
function BeamVisual.GetBounds(visual: Types.Visual, position: Vector3, simulationClock: number): (Vector3, number)
	local state = visual.rig and visual.rig.beam
	if not state then return position, 0 end
	local path = if state.group then predictedPath(state) else state.authoritativePath
	if path and #path > 1 then
		local low, high = position, position
		for _, point in path do low, high = low:Min(point), high:Max(point) end
		return (low+high)*.5, (high-low).Magnitude*.5+state.maxLength
	end
	return position, state.maxLength
end

function BeamVisual.FlushGroups(simulationClock: number?)
	for _, group in groups do
		for state in group.members do
			local visual = state.visual
			local visible = if state.retired then View.contains((state.points[1]+state.points[#state.points])*.5, state.length*.5+state.radius)
				else visual and visual.inView or false
			if visible ~= state.wasVisible then state.wasVisible = visible; group.dirty = true end
		end
		if not group.dirty then continue end
		group.dirty = false
		local paths = {}
		for state in group.members do
			local visual = state.visual
			local inView = if state.retired then View.contains((state.points[1]+state.points[#state.points])*.5, state.length*.5+state.radius)
				else visual and visual.inView
			if not inView then continue end
			if state.retired then
				if state.length > 1e-4 then table.insert(paths, state.points) end
				continue
			end
			-- A sustained sample renders exactly ONE server-approved path.
			-- Its old travel history is never a second tail, even after a split,
			-- clipping, interest loss, delayed pose, or missing predecessor.
			state.linkPoints = predictedPath(state)
			if state.linkPoints and #state.linkPoints > 0 then table.insert(paths, state.linkPoints) end
		end
		if #paths > 0 then
			local segments, joints = Geometry.Merge(paths, group.radius)
			pending[group] = { segments = segments, joints = joints }
		elseif group.visible then
			-- Do not leave stale cylinders at their exit pose where a camera turn
			-- could expose them while their authoritative heads are elsewhere.
			pending[group] = { segments = {}, joints = {} }
		end
		group.visible = #paths > 0
	end
end

local function releaseState(visual: Types.Visual)
	local state = (visual.rig :: Types.Rig).beam
	predicting[state] = nil
	pending[state] = nil
	local group = state.group
	if group then
		group.dirty = true
		group.members[state] = nil
		group.byId[state.id] = nil
		if next(group.members) == nil then
			groups[group.id], pending[group] = nil, nil
			group.model:Destroy()
		end
	end
	visual.model:Destroy()
end

local function trim(state: any, distance: number)
	local points = state.points
	while distance > 0 and #points > 1 do
		local length = (points[2] - points[1]).Magnitude
		if distance >= length then
			table.remove(points, 1)
			distance -= length
			state.length -= length
		else
			points[1] = points[1]:Lerp(points[2], distance / length)
			state.length -= distance
			distance = 0
		end
	end
	state.length = math.max(state.length, 0)
end

local function append(state: any, position: Vector3)
	local points = state.points
	local last = points[#points]
	local offset = position - last
	local distance = offset.Magnitude
	if distance < 1e-4 then return end
	if #points >= 2 then
		local previous = last - points[#points - 1]
		if previous.Magnitude > 1e-4 and previous.Unit:Dot(offset.Unit) > 0.9999 then
			points[#points] = position
		else
			table.insert(points, position)
		end
	else
		table.insert(points, position)
	end
	state.length += distance
	trim(state, math.max(state.length - state.maxLength, 0))
	-- Drop old detail instead of drawing a shortcut across a bend/wall.
	while #points > MAX_SEGMENTS + 1 do trim(state, (points[2] - points[1]).Magnitude) end
end

local function draw(rig: Types.Rig)
	local state = rig.beam
	if state.group then return end
	state.model, state.driver = rig.model, rig.driver
	state.joints = state.joints or {}
	local spans = {}
	for index = 1, #state.points-1 do table.insert(spans, { state.points[index], state.points[index+1] }) end
	pending[state] = { segments = Geometry.Split(spans), joints = {} }
	if not applyConnection then applyConnection = RunService.PreSimulation:Connect(BeamVisual.ApplyGroups) end
end
function BeamVisual.Build(data: Protocol.SpawnPayload): (Instance, Types.Rig)
	local beam = assert(data.Beam)
	local spec = data.Visual
	local color = spec and spec.Color or Color3.fromRGB(255, 96, 28)
	if beam.ChannelId then
		local group = groups[beam.ChannelId]
		if not group then
			local model = Instance.new("Model")
			model.Name = "SustainedBeam_" .. beam.ChannelId
			local driver = part(model, "ProjectileMotorRoot", color, 1)
			driver.Anchored = true
			driver.CFrame = CFrame.new(beam.Origin)
			local root = part(model, "BeamHead", color, 1)
			group = { id = beam.ChannelId, model = model, driver = driver, root = root,
				motor = motor(driver, root), color = color, core = spec and spec.Core or Color3.new(1, 1, 1),
				radius = math.max(beam.Radius, .025), segments = {}, joints = {}, members = {}, byId = {}, visible = false, dirty = true }
			groups[beam.ChannelId] = group
			model.Parent = workspace
			if not applyConnection then applyConnection = RunService.PreSimulation:Connect(BeamVisual.ApplyGroups) end
		end
		-- Each logical packet owns only metadata, not cylinders/Motor6Ds. Its
		-- placeholder can retire without deleting another packet's shared rig.
		local placeholder = Instance.new("Folder")
		placeholder.Name = "BeamPacket_" .. data.Id
		placeholder.Parent = group.model
		local state = { points = { data.Position }, length = 0, maxLength = beam.Length,
			radius = group.radius, speed = data.Velocity.Magnitude, group = group,
			id = data.Id, previousId = beam.PreviousId or 0,
			predictedAt = data.ServerTime, globalScale = data.GlobalScale or Heartbeat.GetGlobalTimeScale(),
		}
		state.authoritativePath = beam.Path
		state.pathClipped = beam.Clipped
		group.members[state] = true
		group.byId[data.Id] = state
		group.dirty = true
		return placeholder, { model = placeholder, driver = group.driver, root = group.root,
			motor = group.motor, rootOffset = CFrame.identity, beam = state }
	end
	local model = Instance.new("Model")
	model.Name = "ProjectileBeam"
	local driver = part(model, "ProjectileMotorRoot", color, 1)
	driver.Anchored = true
	driver.CFrame = CFrame.new(data.Position)
	local root = part(model, "BeamHead", color, 1)
	model.PrimaryPart = root
	local rig: Types.Rig = {
		driver = driver, root = root, motor = motor(driver, root), model = model,
		rootOffset = CFrame.identity,
		beam = { points = { beam.Origin }, segments = {}, length = 0,
			predictedAt = data.ServerTime, globalScale = data.GlobalScale or Heartbeat.GetGlobalTimeScale(),
			maxLength = beam.Length, radius = math.max(beam.Radius, 0.025),
			color = color, core = spec and spec.Core or Color3.new(1, 1, 1), speed = data.Velocity.Magnitude },
	}
	append(rig.beam, data.Position)
	draw(rig)
	model.Parent = workspace
	return model, rig
end

function BeamVisual.Attach(visual: Types.Visual)
	local rig = visual.rig
	if rig and rig.beam then
		rig.beam.visual = visual
		predicting[rig.beam] = true
	end
end

function BeamVisual.AdoptPath(visual: Types.Visual, points: { Vector3 }?, clipped: boolean?, final: boolean?)
	local state = visual.rig and visual.rig.beam
	if not state then return end
	state.authoritativePath = points
	state.pathClipped = clipped
	state.finalPath = final == true
	if state.group then state.group.dirty = true end
end

-- Interest loss is not an impact: do not leave a retired copy with the same
-- id in a channel when the authoritative re-entry snapshot rebuilds it.
function BeamVisual.Discard(visual: Types.Visual): boolean
	if not visual.rig or not visual.rig.beam then return false end
	releaseState(visual)
	return true
end

function BeamVisual.ShouldPlayImpact(visual: Types.Visual, point: Vector3): boolean
	local rig = visual.rig
	local group = rig and rig.beam and rig.beam.group
	if not group then return true end
	-- Cosmetic throttle only: every packet still delivers its server damage.
	local now = os.clock()
	if group.lastImpact and now - group.lastImpact < .1 and (point - group.impactPoint).Magnitude < 4 then return false end
	group.lastImpact, group.impactPoint = now, point
	return true
end

function BeamVisual.Update(visual: Types.Visual, position: Vector3, velocity: Vector3)
	local rig = visual.rig
	if not rig or not rig.beam then return end
	rig.beam.linkPoints = nil
	if rig.beam.group then
		rig.beam.group.dirty = true
		rig.beam.points, rig.beam.length = {position}, 0
		rig.beam.speed = velocity.Magnitude
		return
	end
	append(rig.beam, position)
	rig.beam.speed = velocity.Magnitude
	draw(rig)
end

function BeamVisual.StopBody(visual: Types.Visual, contact: Vector3)
	local state = visual.rig and visual.rig.beam
	if not state or not state.group then return end
	state.group.dirty = true
	local stop = table.clone(state.authoritativePath or { contact })
	if #stop == 1 then
		state.stopPath, state.pathClipped = { contact }, true
		return
	end
	-- The actual stop can precede a predecessor's next bounce. Retain only
	-- the contacts up to the segment containing this impact, never overshoot.
	local best, distance = 1, math.huge
	for index = 1, #stop - 1 do
		local a, b = stop[index], stop[index+1]
		local offset = b-a
		local t = math.clamp((contact-a):Dot(offset)/math.max(offset:Dot(offset),1e-8),0,1)
		local d = (a+offset*t-contact).Magnitude
		if d < distance then best, distance = index, d end
	end
	while #stop > best + 1 do table.remove(stop) end
	stop[#stop] = contact
	state.stopPath = stop
	state.pathClipped = true
end

-- Remove predicted overshoot before an authoritative bounce/impact. Retain
-- the incoming path up to the contact, then let the new heading extend it.
function BeamVisual.Correct(visual: Types.Visual, contact: Vector3)
	local rig = visual.rig
	if not rig or not rig.beam then return end
	local state, bestIndex, bestDistance = rig.beam, 1, math.huge
	if state.group then state.group.dirty = true; return end
	for index = 1, #state.points - 1 do
		local a, b = state.points[index], state.points[index + 1]
		local offset = b - a
		local t = math.clamp((contact - a):Dot(offset) / math.max(offset:Dot(offset), 1e-8), 0, 1)
		local distance = (a + offset * t - contact).Magnitude
		if distance < bestDistance then bestIndex, bestDistance = index, distance end
	end
	while #state.points > bestIndex + 1 do table.remove(state.points) end
	if #state.points > 1 then state.points[#state.points] = contact else table.insert(state.points, contact) end
	state.length = 0
	for index = 1, #state.points - 1 do state.length += (state.points[index + 1] - state.points[index]).Magnitude end
	trim(state, math.max(state.length - state.maxLength, 0))
end

function BeamVisual.Reset(visual: Types.Visual)
	local rig = visual.rig
	if rig and rig.beam then
		local state = rig.beam
		if state.group then
			state.group.dirty = true
			state.points, state.length = {visual.position}, 0
			return
		end
		rig.beam.points = { visual.position }
		rig.beam.length = 0
		draw(rig)
	end
end

function BeamVisual.Retire(visual: Types.Visual, delay: number): boolean
	local rig = visual.rig
	if not rig or not rig.beam then return false end
	if rig.beam.retired then return true end
	local state = rig.beam
	predicting[state] = nil
	if state.group then
		state.group.dirty = true
		local points = state.stopPath or (if state.finalPath then state.authoritativePath else predictedPath(state))
		state.points = if points and #points > 0 then table.clone(points) else { visual.position }
		state.length = 0
		for index = 1, #state.points - 1 do state.length += (state.points[index+1]-state.points[index]).Magnitude end
	end
	if state.speed <= 1e-4 then state.points = { state.points[#state.points] }; state.length = 0 end
	state.retired = true
	-- Drain already-traveled geometry from the tail. Hiding the whole packet
	-- on impact would leave a frame-sized hole in a sustained beam.
	table.insert(retired, { visual = visual, lastClock = clock, started = os.clock(), delay = delay })
	return true
end

function BeamVisual.StepRetired(globalDt: number)
	clock += globalDt
	local visited = 0
	local budget = math.min(#retired, MAX_RETIRE_UPDATES)
	while #retired > 0 and visited < budget do
		if retireCursor > #retired then retireCursor = 1 end
		local item = retired[retireCursor]
		local visual = item.visual
		local rig = visual.rig :: Types.Rig
		local state = rig.beam
		local elapsed = (clock - item.lastClock) * visual.timeScale
		item.lastClock = clock
		local remaining = math.max(elapsed, 0) + (state.retireDebt or 0)
		local beforeLength = state.length
		if elapsed <= 0 then
			-- Like server Step, frozen time does not spend carried simulation debt.
		elseif ChunkManager.IsTimeUniform() then
			trim(state, remaining * state.speed)
			remaining = 0
		else
			local guard = 0
			while remaining > 1e-6 and #state.points > 1 and state.speed > 1e-4 and guard < 16 do
				guard += 1
				local origin, offset = state.points[1], state.points[2]-state.points[1]
				if offset.Magnitude < 1e-4 then trim(state,.0001); continue end
				local scale = ChunkManager.GetTimeScaleAt(origin)
				if scale <= 0 then remaining = 0; break end
				local dt = Planner.StepDt(origin, offset.Unit*state.speed, Vector3.zero, scale, remaining,
					math.huge, true, false, offset.Magnitude/state.speed)
				if dt <= 0 then break end
				trim(state, dt*state.speed)
				remaining -= dt/scale
			end
		end
		state.retireDebt = remaining
		if state.group and state.length ~= beforeLength then state.group.dirty = true end
		draw(rig)
		visited += 1
		if (state.length <= 1e-4 and os.clock() - item.started >= item.delay) or os.clock() - item.started >= 60 then
			releaseState(visual)
			table.remove(retired, retireCursor)
		else
			retireCursor += 1
		end
	end
end

return BeamVisual
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">DebugRays</string>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	ProjectileClient/DebugRays.luau
	Draws one raycast segment as a thin fading line, colored by resolution --
	receives ProjRay events streamed while the server's Projectile.SetDebugRays
	is on (see example/init.server.luau's "SetProjectileDebug" handler).
]]

local TweenService = game:GetService("TweenService")

local DebugRays = {}

-- Red = coarse cast through an empty chunk; green = fine cast near entities.
local RAY_LOWRES_COLOR = Color3.fromRGB(255, 70, 70)
local RAY_HIGHRES_COLOR = Color3.fromRGB(90, 255, 140)

function DebugRays.Draw(from: Vector3, to: Vector3, lowRes: boolean?)
	local delta = to - from
	local dist = delta.Magnitude
	if dist < 1e-3 then
		return
	end
	local line = Instance.new("Part")
	line.Anchored = true
	line.CanCollide = false
	line.CanQuery = false
	line.CanTouch = false
	line.CastShadow = false
	line.Material = Enum.Material.Neon
	line.Color = lowRes and RAY_LOWRES_COLOR or RAY_HIGHRES_COLOR
	line.Size = Vector3.new(0.08, 0.08, dist)
	line.CFrame = CFrame.lookAt((from + to) * 0.5, to)
	line.Transparency = 0.15
	line.Parent = workspace
	TweenService:Create(line, TweenInfo.new(0.3, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
	task.delay(0.3, function()
		line:Destroy()
	end)
end

return DebugRays
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Impact</string>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	ProjectileClient/Impact.luau
	Hit-effect visuals -- a short neon flash + spreading ring at the impact
	point, color-coded by what was struck. Games can swap this out entirely
	via Impact.SetHandler(fn(position, normal, model, kind)).
]]

local TweenService = game:GetService("TweenService")

local Impact = {}

-- Custom impact hook: fn(position, normal, model?, kind). When set, it replaces
-- the built-in effect below. (model is nil for impacts; kind is
-- "entity" | "world" | "bounce" | "detonate".)
local impactHandler: ((Vector3, Vector3, Instance?, string?) -> ())? = nil

function Impact.SetHandler(fn: ((Vector3, Vector3, Instance?, string?) -> ())?)
	impactHandler = fn
end

local IMPACT_COLORS: { [string]: Color3 } = {
	entity = Color3.fromRGB(255, 80, 80), -- hit a damageable target
	world = Color3.fromRGB(255, 225, 150), -- hit geometry
	bounce = Color3.fromRGB(120, 220, 255), -- ricochet
	detonate = Color3.fromRGB(255, 160, 60), -- spell trigger ended the bolt mid-air
}

local function defaultImpact(position: Vector3, normal: Vector3, kind: string?)
	local color = IMPACT_COLORS[kind or "world"] or IMPACT_COLORS.world
	local big = kind ~= "bounce"
	local info = TweenInfo.new(big and 0.28 or 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	-- expanding core flash
	local burst = Instance.new("Part")
	burst.Shape = Enum.PartType.Ball
	burst.Size = Vector3.one * (big and 0.6 or 0.3)
	burst.CFrame = CFrame.new(position)
	burst.Anchored = true
	burst.CanCollide = false
	burst.CanQuery = false
	burst.CanTouch = false
	burst.CastShadow = false
	burst.Material = Enum.Material.Neon
	burst.Color = color
	burst.Transparency = 0.1
	burst.Parent = workspace
	TweenService:Create(burst, info, { Size = Vector3.one * (big and 3.5 or 1.5), Transparency = 1 }):Play()

	-- flat ring spreading along the surface (Cylinder's length runs along local X,
	-- so aim X down the normal and keep it thin there)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.12, 0.5, 0.5)
	local n = if normal.Magnitude > 1e-3 then normal.Unit else Vector3.yAxis
	ring.CFrame = CFrame.lookAt(position, position + n) * CFrame.Angles(0, math.rad(90), 0)
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.Parent = workspace
	local ringSpan = big and 4 or 2
	TweenService:Create(ring, info, { Size = Vector3.new(0.12, ringSpan, ringSpan), Transparency = 1 }):Play()

	task.delay(info.Time, function()
		burst:Destroy()
		ring:Destroy()
	end)
end

function Impact.Play(position: Vector3, normal: Vector3?, kind: string?)
	local n = normal or Vector3.yAxis
	if impactHandler then
		task.spawn(impactHandler, position, n, nil, kind)
	else
		defaultImpact(position, n, kind)
	end
end

return Impact
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Prediction</string>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	ProjectileClient/Prediction.luau
	Client dead-reckoning: the mirror of the server's Projectile Step minus
	hit detection. Substeps are chosen by the same ProjectileStepPlanner the
	server uses, and time that is too small to integrate is carried exactly
	the same way, so both sides consume identical simulated time.

	Prediction.simulate(visual, baseDt) advances one visual by baseDt
	personal/global seconds (already multiplied by visual.timeScale) and
	returns (alive, moved).
]]

local Shared = script.Parent.Parent
local ChunkManager = require(Shared:WaitForChild("ChunkManager"))
local ProjectileMotion = require(Shared:WaitForChild("ProjectileMotion"))
local Planner = require(Shared:WaitForChild("ProjectileStepPlanner"))
local SafeMath = require(Shared:WaitForChild("SafeMath"))

local Types = require(script.Parent.Types)

type Visual = Types.Visual

local Prediction = {}

local MIN_STEP_DT = ProjectileMotion.MinStepDt
local MAX_SUBSTEPS = 16

local function integrate(visual: Visual, dt: number)
	local movementVelocity
	visual.velocity, movementVelocity = ProjectileMotion.Integrate(
		visual.velocity,
		visual.acceleration,
		visual.accelerationDirection,
		visual.gravity,
		visual.minSpeed,
		visual.maxSpeed,
		dt
	)
	visual.position += movementVelocity * dt
	visual.life -= dt
end

-- Only these trajectories have an exact elapsed-time solution. Everything
-- else keeps the normal planner so skipping frames cannot change its path.
function Prediction.canDefer(visual: Visual): boolean
	return ChunkManager.IsTimeUniform()
		and visual.simulationDebt == 0
		and visual.minSpeed <= 0
		and visual.maxSpeed == math.huge
		and (typeof(visual.acceleration) ~= "number" or visual.acceleration == 0)
end

-- Cheap visibility probe without advancing any simulation state. Using the
-- current projected position (not the frozen exit pose) also detects shots
-- that fly into view while the camera stays still.
function Prediction.projectDeferred(visual: Visual, dt: number): Vector3
	dt = math.min(math.max(dt, 0), math.max(visual.life, 0))
	local acceleration = ProjectileMotion.GetAcceleration(
		visual.velocity, visual.acceleration, visual.accelerationDirection, visual.gravity
	)
	return visual.position + visual.velocity * dt + acceleration * (0.5 * dt * dt)
end

-- Used before a world time-field mutation: settle the old uniform interval
-- before any new zone could be applied retroactively to the deferred time.
function Prediction.settleDeferred(visual: Visual, dt: number)
	if dt > 0 then integrate(visual, math.min(dt, math.max(visual.life, 0))) end
end

function Prediction.simulate(visual: Visual, baseDt: number): (boolean, boolean)
	if not (baseDt > 0) then
		return true, false
	end

	local remaining = baseDt + visual.simulationDebt
	visual.simulationDebt = 0
	local uniformTime = ChunkManager.IsTimeUniform()

	-- Fast path: with no dilation anywhere there are no boundaries to stop at,
	-- and constant (vector/gravity) acceleration without speed clamps is
	-- integrated exactly by one averaged-velocity step. The substep loop below
	-- only exists for boundaries, clamps and velocity-relative acceleration.
	if
		uniformTime
		and visual.minSpeed <= 0
		and visual.maxSpeed == math.huge
		and (typeof(visual.acceleration) ~= "number" or visual.acceleration == 0)
	then
		integrate(visual, math.min(remaining, visual.life))
		return visual.life > MIN_STEP_DT and SafeMath.isFiniteVector(visual.position), true
	end

	local moved = false
	local guard = 0
	while remaining > MIN_STEP_DT and guard < MAX_SUBSTEPS do
		guard += 1
		if visual.life <= MIN_STEP_DT then
			return false, moved
		end

		local accelerationVector = ProjectileMotion.GetAcceleration(
			visual.velocity,
			visual.acceleration,
			visual.accelerationDirection,
			visual.gravity
		)
		local _, chunkScale = Planner.Sample(visual.position, visual.velocity, accelerationVector, uniformTime)
		if chunkScale <= 0 then
			remaining = 0
			break
		end

		-- The client can't see entities, so it always plans at the fine
		-- resolution; that only changes where substeps fall, not the path.
		local stepDt = Planner.StepDt(
			visual.position,
			visual.velocity,
			accelerationVector,
			chunkScale,
			remaining,
			visual.life,
			true,
			uniformTime,
			math.huge
		)
		if stepDt <= 0 then
			break
		end

		integrate(visual, stepDt)
		remaining -= stepDt / chunkScale
		moved = true
		if visual.life <= MIN_STEP_DT then
			return false, moved
		end
	end

	-- Carry whatever wasn't simulated, exactly like the server's Step.
	visual.simulationDebt = remaining
	-- Mirrors the server expiring a projectile past SafeMath.Limit.
	return SafeMath.isFiniteVector(visual.position), moved
end

return Prediction
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Types</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ProjectileClient/Types.luau
	Shared shapes for the client renderer's modules. No runtime behaviour.
]]

local Protocol = require(script.Parent.Parent:WaitForChild("ProjectileProtocol"))

-- A visual driven by a Motor6D from an invisible anchored root; see
-- VisualModel.Build.
export type Rig = {
	driver: BasePart,
	motor: Motor6D,
	rootOffset: CFrame,
	model: Instance,
	root: BasePart,
	poolKey: string?,
	beam: any?, -- bounded cylindrical path geometry (BeamVisual)
}

-- One rendered projectile. Physics fields mirror the server projectile and
-- are advanced by Prediction; the rest is presentation state.
export type Visual = {
	id: number,
	model: Instance,
	rig: Rig?,
	destroyDelay: number,
	waitForParticles: boolean,
	waitForTrails: boolean,

	-- physics mirror (see Prediction)
	position: Vector3,
	velocity: Vector3,
	gravity: Protocol.Acceleration,
	acceleration: Protocol.Acceleration,
	accelerationDirection: Vector3?,
	minSpeed: number,
	maxSpeed: number,
	life: number, -- dilated seconds remaining
	simulationDebt: number, -- personal/global seconds carried across visits
	timeScale: number, -- combined Source * projectile TimeScale
	lastSimulationTime: number, -- global simulation clock the pose corresponds to
	deferredPrediction: boolean,
	synced: boolean, -- homing: driven by ProjMove instead of Prediction

	-- lifetime backstops
	spawnRealTime: number,
	maxRealLifetime: number,
	lastUpdate: number, -- os.clock() of the last authoritative pose

	-- presentation
	lastRenderStep: number,
	inView: boolean,
	offscreenSince: number?,
	culled: boolean,
	effectCullDelay: number,
	resumeEffectsOnNextUpdate: number?,
	smoothTransform: boolean,
	lastSmoothStep: number?,
	lastSmoothTarget: number?,
	transformFrom: CFrame?,
	transformTo: CFrame?,
	transformElapsed: number,
	transformDuration: number,
	suspendedTrails: { Trail }?,
	suspendedParticles: { ParticleEmitter }?,
}

-- ModuleScripts must return exactly one non-nil value.
return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">View</string>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	ProjectileClient/View.luau
	Calculation-visibility snapshot, refreshed once per frame. This gates Lua
	work only; Roblox retains ownership of draw culling. View.contains is then
	pure Luau dot products instead of one WorldToViewportPoint engine call per
	visual, which dominated the render loop at 10k visuals.
]]

local View = {}

local VIEWPORT_CULL_MARGIN = 128 -- pixels beyond each edge; avoids boundary flicker

local valid = false
local viewPosition = Vector3.zero
local viewRight, viewUp, viewLook = Vector3.xAxis, Vector3.yAxis, -Vector3.zAxis
local limitX, limitY = 1, 1 -- tan(half-FOV) per axis, widened by the pixel margin

function View.refresh()
	local camera = workspace.CurrentCamera
	local size = camera and camera.ViewportSize
	if not camera or not size or size.X <= 0 or size.Y <= 0 then
		valid = false
		return
	end
	local cframe = camera.CFrame
	local tanY = math.tan(math.rad(camera.FieldOfView) * 0.5)
	local tanX = tanY * size.X / size.Y
	-- A pixel margin m past an edge is 2m/size in normalized device units.
	limitX = tanX * (1 + 2 * VIEWPORT_CULL_MARGIN / size.X)
	limitY = tanY * (1 + 2 * VIEWPORT_CULL_MARGIN / size.Y)
	viewPosition = cframe.Position
	viewRight, viewUp, viewLook = cframe.RightVector, cframe.UpVector, cframe.LookVector
	valid = true
end

-- Whether `position` is on screen (with margin). Everything counts as
-- visible while no camera snapshot is available.
function View.contains(position: Vector3, radius: number?): boolean
	if not valid then
		return true
	end
	local offset = position - viewPosition
	local depth = offset:Dot(viewLook)
	if radius and radius > 0 then
		return depth + radius > 0
			and math.abs(offset:Dot(viewRight)) <= depth * limitX + radius * math.sqrt(1 + limitX * limitX)
			and math.abs(offset:Dot(viewUp)) <= depth * limitY + radius * math.sqrt(1 + limitY * limitY)
	end
	return depth > 0 and math.abs(offset:Dot(viewRight)) <= depth * limitX and math.abs(offset:Dot(viewUp)) <= depth * limitY
end

return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">VisualModel</string>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	ProjectileClient/VisualModel.luau
	Builds and positions the actual Instance a projectile visual renders as.
	Pure presentation -- no networking, no gameplay state.
]]

local Protocol = require(script.Parent.Parent:WaitForChild("ProjectileProtocol"))
local SafeMath = require(script.Parent.Parent:WaitForChild("SafeMath"))

local Types = require(script.Parent.Types)
local BeamVisual = require(script.Parent.BeamVisual)

type Visual = Types.Visual
type Rig = Types.Rig

local VisualModel = {}

-- Defaults for ActivateParticlesOnCreate (see VisualModel.ActivateParticles)
-- when a ParticleEmitter doesn't carry its own EmitCount/EmitDelay attribute.
local DEFAULT_EMIT_COUNT = 5
local DEFAULT_EMIT_DELAY = 0

local function poseFrom(position: Vector3, velocity: Vector3): CFrame
	return CFrame.lookAt(position, position + SafeMath.direction(velocity, Vector3.zAxis))
end

-- `model` itself plus every descendant, without first copying them all into
-- one table (unpacking GetDescendants() also errors on very large models).
local function forSelfAndDescendants(model: Instance, fn: (Instance) -> ())
	fn(model)
	for _, instance in model:GetDescendants() do
		fn(instance)
	end
end

-- Built-in (non-Model) visuals are pooled per appearance: a burst otherwise
-- creates two Parts and a Motor6D per projectile and destroys them all on
-- impact. Custom Models aren't pooled -- their effects/transparency state is
-- mutated by FadeOut and would need a full restore.
local POOL_LIMIT = 4096
local pools: { [string]: { Rig } } = {}

local function builtinPoolKey(data: Protocol.SpawnPayload): string
	local spec = data.Visual
	local scale = math.clamp(data.VisualScale or 1, 0.05, 20)
	if spec then
		return `{spec.Shape}|{spec.Size}|{spec.Color}|{scale}`
	end
	return `default|{scale}`
end

--------------------------------------------------------------------------------
-- Styled visuals: Visual = { Style = "Orb" | "Bullet", Color, Core }
-- Built procedurally once per (style, colours) as a template Model, then
-- cloned like an authored Model. Every part is welded to a hot neon core so
-- the whole thing rides the core's Motor6D; trails/particles fade out
-- naturally on impact via FadeOut. Not pooled (their effects state changes).
--------------------------------------------------------------------------------

local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local WISP_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"
local styledTemplates: { [string]: Model } = {}

local function effectPart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Material = Enum.Material.Neon
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Anchored = false
	for key, value in props do
		(part :: any)[key] = value
	end
	return part
end

local function weld(part: BasePart, to: BasePart)
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = to
	constraint.Part1 = part
	constraint.Parent = part
end

local function trail(parent: BasePart, halfWidth: number, lifetime: number, core: Color3, glow: Color3)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, halfWidth, 0)
	a0.Parent = parent
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -halfWidth, 0)
	a1.Parent = parent
	local effect = Instance.new("Trail")
	effect.Attachment0 = a0
	effect.Attachment1 = a1
	effect.Lifetime = lifetime
	effect.MinLength = 0
	effect.FaceCamera = true
	effect.LightEmission = 1
	effect.LightInfluence = 0
	effect.Color = ColorSequence.new(core, glow)
	effect.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(1, 1) })
	effect.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })
	effect.Parent = parent
end

local function light(parent: BasePart, color: Color3, range: number, brightness: number)
	local effect = Instance.new("PointLight")
	effect.Color = color
	effect.Range = range
	effect.Brightness = brightness
	effect.Shadows = false
	effect.Parent = parent
end

local function buildOrb(core: Color3, glow: Color3): Model
	local model = Instance.new("Model")
	model.Name = "SpellOrb"
	local center = effectPart({ Name = "Core", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.9, Color = core })
	center.Parent = model
	model.PrimaryPart = center
	local shell = effectPart({ Name = "Glow", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.9, Color = glow, Transparency = 0.55 })
	shell.Parent = model
	weld(shell, center)
	local halo = effectPart({ Name = "Halo", Shape = Enum.PartType.Ball, Size = Vector3.one * 3, Color = glow, Transparency = 0.85 })
	halo.Parent = model
	weld(halo, center)
	light(center, glow, 14, 3)
	trail(center, 0.55, 0.3, core, glow)

	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "Sparks"
	sparks.Texture = SPARK_TEXTURE
	sparks.Color = ColorSequence.new(core, glow)
	sparks.LightEmission = 1
	sparks.LightInfluence = 0
	sparks.Rate = 45
	sparks.Lifetime = NumberRange.new(0.25, 0.5)
	sparks.Speed = NumberRange.new(2, 5)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Drag = 4
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0) })
	sparks.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	sparks.Parent = center

	local wisps = Instance.new("ParticleEmitter")
	wisps.Name = "Wisps"
	wisps.Texture = WISP_TEXTURE
	wisps.Color = ColorSequence.new(glow)
	wisps.LightEmission = 0.8
	wisps.LightInfluence = 0
	wisps.Rate = 30
	wisps.Lifetime = NumberRange.new(0.3, 0.5)
	wisps.Speed = NumberRange.new(0.3, 1)
	wisps.SpreadAngle = Vector2.new(180, 180)
	wisps.Rotation = NumberRange.new(0, 360)
	wisps.RotSpeed = NumberRange.new(-90, 90)
	wisps.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0.2) })
	wisps.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1) })
	wisps.Parent = center
	return model
end

local function buildBullet(core: Color3, glow: Color3): Model
	local model = Instance.new("Model")
	model.Name = "SpellBullet"
	-- Long axis is Z: the pose CFrame looks along the velocity.
	local center = effectPart({ Name = "Core", Size = Vector3.new(0.22, 0.22, 1.8), Color = core })
	center.Parent = model
	model.PrimaryPart = center
	local shell = effectPart({ Name = "Glow", Size = Vector3.new(0.55, 0.55, 2.4), Color = glow, Transparency = 0.6 })
	shell.Parent = model
	weld(shell, center)
	light(center, glow, 8, 2)
	trail(center, 0.14, 0.14, core, glow)
	return model
end

local function styledModel(spec: Protocol.VisualSpec): Model?
	local core = spec.Core or Color3.new(1, 1, 1)
	local glow = spec.Color or core
	local key = `{spec.Style}|{core}|{glow}`
	local template = styledTemplates[key]
	if not template then
		if spec.Style == "Orb" then
			template = buildOrb(core, glow)
		elseif spec.Style == "Bullet" then
			template = buildBullet(core, glow)
		else
			return nil
		end
		styledTemplates[key] = template
	end
	return template:Clone()
end

local function builtinPart(spec: Protocol.VisualSpec?): Part
	local part = Instance.new("Part")
	if spec then
		if spec.Shape == "Ball" then
			part.Shape = Enum.PartType.Ball
		elseif spec.Shape == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		end
		part.Size = spec.Size or Vector3.one * 0.5
		part.Color = spec.Color or Color3.new(1, 1, 1)
	else
		part.Size = Vector3.one * 0.4
		part.Color = Color3.fromRGB(255, 220, 120)
	end
	part.Material = Enum.Material.Neon
	return part
end

local function makeCosmetic(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
end

function VisualModel.Build(data: Protocol.SpawnPayload): (Instance, Rig?)
	if data.Beam then return BeamVisual.Build(data) end
	local spec = data.Visual
	local authored = data.Model
	local styled = if spec and spec.Style and not authored then styledModel(spec) else nil
	local poolKey = if authored or styled then nil else builtinPoolKey(data)

	local pool = if poolKey then pools[poolKey] else nil
	local pooledRig = if pool then table.remove(pool) else nil
	if pooledRig then
		pooledRig.driver.CFrame = CFrame.new(data.Position)
		pooledRig.motor.Transform =
			pooledRig.driver.CFrame:ToObjectSpace(poseFrom(data.Position, data.Velocity) * pooledRig.rootOffset)
		pooledRig.root.Transparency = 0
		pooledRig.model.Parent = workspace
		return pooledRig.model, pooledRig
	end

	local model: Instance = styled or (if authored then authored:Clone() else builtinPart(spec))

	-- Scale the cloned presentation once at construction. This does not add
	-- any per-frame work and keeps gameplay collision radius server-owned.
	local visualScale = math.clamp(data.VisualScale or 1, 0.05, 20)
	local root: BasePart?
	local pivot: CFrame
	if model:IsA("Model") then
		if visualScale ~= 1 then
			pcall(model.ScaleTo, model, model:GetScale() * visualScale)
		end
		root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
		pivot = model:GetPivot()
		forSelfAndDescendants(model, function(instance)
			if instance:IsA("BasePart") then
				makeCosmetic(instance)
			end
		end)
	elseif model:IsA("BasePart") then
		if visualScale ~= 1 then
			model.Size *= visualScale
		end
		root = model
		pivot = model.CFrame
		makeCosmetic(model)
	else
		pivot = CFrame.identity
	end

	-- Drive the visual as an assembly from one stationary, invisible root. A
	-- Motor6D Transform is considerably cheaper to update every render frame
	-- than creating/cancelling Tween instances or repeatedly moving a model
	-- pivot. rootOffset preserves a custom Model's authored pivot.
	local rig: Rig? = nil
	if root then
		local driver = Instance.new("Part")
		driver.Name = "ProjectileMotorRoot"
		driver.Size = Vector3.one * 0.05
		driver.Transparency = 1
		driver.Anchored = true
		driver.CanCollide = false
		driver.CanQuery = false
		driver.CanTouch = false
		driver.CastShadow = false
		driver.CFrame = CFrame.new(data.Position)
		driver.Parent = model

		local motor = Instance.new("Motor6D")
		motor.Name = "ProjectileTransform"
		motor.Part0 = driver
		motor.Part1 = root
		motor.Parent = driver

		local rootOffset = pivot:ToObjectSpace(root.CFrame)
		motor.Transform = driver.CFrame:ToObjectSpace(poseFrom(data.Position, data.Velocity) * rootOffset)
		rig = {
			driver = driver :: BasePart,
			motor = motor,
			rootOffset = rootOffset,
			model = model,
			root = root,
			poolKey = poolKey,
		}
	end

	model.Parent = workspace
	return model, rig
end

local function transformFor(rig: Rig, pose: CFrame): CFrame
	return rig.driver.CFrame:ToObjectSpace(pose * rig.rootOffset)
end

local function placeFallback(model: Instance, pose: CFrame)
	if model:IsA("Model") then
		model:PivotTo(pose)
	elseif model:IsA("BasePart") then
		model.CFrame = pose
	end
end

function VisualModel.Place(visual: Visual, position: Vector3, velocity: Vector3)
	visual.transformFrom = nil
	visual.transformTo = nil
	BeamVisual.Update(visual, position, velocity)
	if visual.rig and visual.rig.beam and visual.rig.beam.group then return end

	local pose = poseFrom(position, velocity)
	local rig = visual.rig
	if rig then
		rig.motor.Transform = transformFor(rig, pose)
	else
		placeFallback(visual.model, pose)
	end
end

-- Preserve exactly which trails were emitting, then clear their positional
-- history before a culled visual is moved. Keeping them disabled until a later
-- render turn prevents Roblox from drawing a segment between the old and new
-- transforms.
function VisualModel.SuspendTrails(visual: Visual)
	if visual.suspendedTrails then
		return
	end
	local suspended: { Trail } = {}
	for _, instance in visual.model:GetDescendants() do
		if instance:IsA("Trail") and instance.Enabled then
			instance.Enabled = false
			instance:Clear()
			table.insert(suspended, instance)
		end
	end
	visual.suspendedTrails = suspended
end

function VisualModel.ResumeTrails(visual: Visual)
	local suspended = visual.suspendedTrails
	if not suspended then
		return
	end
	for _, trail in suspended do
		if trail.Parent then
			trail:Clear()
			trail.Enabled = true
		end
	end
	visual.suspendedTrails = nil
end

-- Returns the real-time grace period a visual should remain alive and
-- emitting after it first leaves the viewport. EmitDelay is included because
-- one-shot particle bursts may not have fired yet when the projectile exits.
function VisualModel.GetLongestEffectLifetime(model: Instance): number
	local longest = 0
	for _, instance in model:GetDescendants() do
		if instance:IsA("ParticleEmitter") then
			local rawDelay = instance:GetAttribute("EmitDelay")
			local emitDelay = if typeof(rawDelay) == "number" then math.max(rawDelay, 0) else 0
			longest = math.max(longest, emitDelay + instance.Lifetime.Max)
		elseif instance:IsA("Trail") then
			longest = math.max(longest, instance.Lifetime)
		end
	end
	return longest
end

-- Off-screen culling eventually stops both continuous particle emission and
-- trails, but only after GetLongestEffectLifetime has elapsed. Remember the
-- exact enabled set so authored-disabled effects stay disabled on re-entry.
function VisualModel.SuspendEffects(visual: Visual)
	VisualModel.SuspendTrails(visual)
	if visual.suspendedParticles then
		return
	end
	local suspended: { ParticleEmitter } = {}
	for _, instance in visual.model:GetDescendants() do
		if instance:IsA("ParticleEmitter") and instance.Enabled then
			instance.Enabled = false
			table.insert(suspended, instance)
		end
	end
	visual.suspendedParticles = suspended
end

function VisualModel.ResumeEffects(visual: Visual)
	VisualModel.ResumeTrails(visual)
	local suspended = visual.suspendedParticles
	if not suspended then
		return
	end
	for _, emitter in suspended do
		if emitter.Parent then
			emitter.Enabled = true
		end
	end
	visual.suspendedParticles = nil
end

-- Instantly hides a bullet visual without destroying it: every BasePart goes
-- fully transparent, and every Trail/ParticleEmitter/Beam (and Light) is
-- either faded or deleted outright depending on waitForParticles/
-- waitForTrails (see the Projectile config's WaitForParticles/WaitForTrails --
-- both default true). Returns how many seconds of grace the caller should
-- wait before actually :Destroy()ing the model:
--  - waitForParticles/waitForTrails true (default): disabling a
--    Trail/ParticleEmitter only stops NEW emission, while everything already
--    emitted keeps fading out naturally over its Lifetime, so destroying any
--    earlier would cut those remnants off mid-air (the "unnatural deletion"
--    this exists to prevent) -- contributes that Lifetime to the grace period.
--  - waitForParticles/waitForTrails false: the instance is :Destroy()d
--    immediately instead of just disabled -- no lingering remnants, no grace
--    contribution from it.
-- Beams/Lights have no lingering emission (disabling hides them instantly)
-- and never contribute grace. Returns 0 (safe to destroy immediately) when
-- nothing in the model still needs to wait -- e.g. both flags false, or one
-- flag false and the model has none of the other kind.
function VisualModel.FadeOut(model: Instance, waitForParticles: boolean, waitForTrails: boolean): number
	local grace = 0
	forSelfAndDescendants(model, function(inst)
		if inst:IsA("BasePart") then
			inst.Transparency = 1
		elseif inst:IsA("ParticleEmitter") then
			if waitForParticles then
				if inst.Enabled then
					grace = math.max(grace, inst.Lifetime.Max)
				end
				inst.Enabled = false
			else
				inst:Destroy()
			end
		elseif inst:IsA("Trail") then
			if waitForTrails then
				if inst.Enabled then
					grace = math.max(grace, inst.Lifetime)
				end
				inst.Enabled = false
			else
				inst:Destroy()
			end
		elseif inst:IsA("Beam") then
			inst.Enabled = false
		elseif inst:IsA("Light") then
			inst.Enabled = false
		end
	end)
	return grace
end

local function release(visual: Visual)
	local rig = visual.rig
	local poolKey = rig and rig.poolKey
	if rig and poolKey then
		local pool = pools[poolKey]
		if not pool then
			pool = {}
			pools[poolKey] = pool
		end
		if #pool < POOL_LIMIT then
			visual.model.Parent = nil
			table.insert(pool, rig)
			return
		end
	end
	visual.model:Destroy()
end

-- Hides a finished visual, then destroys it (or returns a built-in one to the
-- pool) after max(destroyDelay, FadeOut's effect grace period).
function VisualModel.Retire(visual: Visual, destroyDelay: number)
	if BeamVisual.Retire(visual, destroyDelay) then return end
	local rig = visual.rig
	local delay = destroyDelay
	if rig and rig.poolKey then
		-- Built-in visuals are a bare Part: nothing to fade, only to hide.
		if delay > 0 then
			rig.root.Transparency = 1
		end
	else
		delay = math.max(delay, VisualModel.FadeOut(visual.model, visual.waitForParticles, visual.waitForTrails))
	end
	if delay > 0 then
		task.delay(delay, release, visual)
	else
		release(visual)
	end
end

-- ActivateParticlesOnCreate support: fires every ParticleEmitter under
-- `model` exactly once via :Emit(), per its own EmitCount/EmitDelay
-- attributes (defaulting to 5 / 0s when either is missing). EmitDelay is
-- seconds from THIS call until that emitter actually emits -- 0 emits
-- inline, synchronously. Call once, right after VisualModel.Build.
function VisualModel.ActivateParticles(model: Instance)
	forSelfAndDescendants(model, function(inst)
		if inst:IsA("ParticleEmitter") then
			local rawCount = inst:GetAttribute("EmitCount")
			local emitCount = if typeof(rawCount) == "number" then rawCount else DEFAULT_EMIT_COUNT
			local rawDelay = inst:GetAttribute("EmitDelay")
			local emitDelay = if typeof(rawDelay) == "number" then rawDelay else DEFAULT_EMIT_DELAY
			if emitDelay > 0 then
				task.delay(emitDelay, function()
					if inst.Parent then
						inst:Emit(emitCount)
					end
				end)
			else
				inst:Emit(emitCount)
			end
		end
	end)
end

-- Starts a linear pose interpolation for a server-synced visual. The render
-- loop advances it by writing Motor6D.Transform; no Tween objects are created.
function VisualModel.SetTarget(visual: Visual, position: Vector3, velocity: Vector3, duration: number)
	local rig = visual.rig
	-- Cylinders use their own traveled path, never a pose tween that rotates
	-- an entire tail across a corner. Homing still adopts every server pose.
	if rig and rig.beam then VisualModel.Place(visual, position, velocity); return end
	if not rig or not (duration > 0) then
		VisualModel.Place(visual, position, velocity)
		return
	end

	visual.transformFrom = rig.motor.Transform
	visual.transformTo = transformFor(rig, poseFrom(position, velocity))
	visual.transformElapsed = 0
	visual.transformDuration = duration
end

function VisualModel.Step(visual: Visual, dt: number)
	local from = visual.transformFrom
	local target = visual.transformTo
	local rig = visual.rig
	if not from or not target or not rig then
		return
	end

	local elapsed = visual.transformElapsed + dt
	-- SetTarget only starts a tween with a positive duration.
	local alpha = math.min(elapsed / visual.transformDuration, 1)
	rig.motor.Transform = from:Lerp(target, alpha)
	visual.transformElapsed = elapsed
	if alpha >= 1 then
		visual.transformFrom = nil
		visual.transformTo = nil
	end
end

return VisualModel
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ProjectileMotion</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	Shared projectile acceleration integration. Keeping this here ensures the
	server-authoritative trajectory and client dead-reckoning use identical
	math. Pure functions only -- chunk/time-zone lookups are passed in (see
	ProjectileStepPlanner, which wires these to ChunkManager for both sides).

	Acceleration accepts either:
	 - a Vector3 in world-space studs/s^2, or
	 - a number applied along AccelerationDirection (or current velocity when
	   no direction is supplied, preserving the original speed-up/slow-down API).

	Gravity is also acceleration: a number means that many studs/s^2 downward,
	while a Vector3 supplies a custom world-space gravity vector.

	Precision: Vector3 is float32, so a fixed nudge like 1e-3 studs vanishes
	entirely once a coordinate passes ~8k studs (the float32 spacing there is
	~1e-3). Boundary math below therefore runs on plain Luau numbers (doubles),
	and every positional nudge scales with distance from the origin via
	GetNudge.
]]

local SafeMath = require(script.Parent.SafeMath)

export type Acceleration = number | Vector3

local ProjectileMotion = {}

local EPSILON = 1e-5

-- Minimum positional nudge near the origin; see GetNudge.
ProjectileMotion.PositionEpsilon = 1e-3
-- Dilated seconds below which a substep is not worth integrating; smaller
-- slices of time are carried to the next frame, never discarded.
ProjectileMotion.MinStepDt = 1e-5
-- Maximum studs between a curved path and the straight chord cast for it.
ProjectileMotion.CurveError = 0.35
-- Chunk/zone time scales below this count as frozen. A scale of 1e-9 would
-- otherwise accumulate carried time for minutes and then spend all of it in
-- one burst the moment the projectile reaches ordinary time.
ProjectileMotion.MinTimeScale = 1e-4

-- 2^-18: 32 float32 ulps, so a nudged Vector3 always lands strictly past
-- the point it was nudged from, however far that is from the origin.
local RELATIVE_NUDGE = 2 ^ -18

-- Smallest offset guaranteed to move a Vector3 at `position`.
function ProjectileMotion.GetNudge(position: Vector3): number
	local largest = math.max(math.abs(position.X), math.abs(position.Y), math.abs(position.Z))
	return math.max(ProjectileMotion.PositionEpsilon, largest * RELATIVE_NUDGE)
end

-- Collapses negligible (or NaN) scales to a clean 0 and caps absurd ones.
function ProjectileMotion.SnapTimeScale(scale: number): number
	if not (scale >= ProjectileMotion.MinTimeScale) then
		return 0
	end
	return math.min(scale, SafeMath.Limit)
end

function ProjectileMotion.GetAcceleration(
	velocity: Vector3,
	acceleration: Acceleration?,
	accelerationDirection: Vector3?,
	gravity: Acceleration?
): Vector3
	local result = Vector3.zero

	if typeof(acceleration) == "Vector3" then
		result += acceleration
	elseif typeof(acceleration) == "number" and acceleration ~= 0 then
		local heading = SafeMath.direction(velocity, Vector3.zAxis)
		local direction = if accelerationDirection then SafeMath.direction(accelerationDirection, heading) else heading
		result += direction * acceleration
	end

	if typeof(gravity) == "Vector3" then
		result += gravity
	elseif typeof(gravity) == "number" and gravity ~= 0 then
		result += Vector3.new(0, -gravity, 0)
	end

	return result
end

-- Returns the velocity at the end of the step and the average velocity to use
-- for displacement during the step. The average makes constant acceleration
-- (including gravity) integrate as p += v*dt + 0.5*a*dt^2 instead of treating
-- the end velocity as a fixed speed for the entire frame. Speed is always
-- held within SafeMath.Limit, even with MaxSpeed = math.huge, so unbounded
-- acceleration can never overflow float32.
function ProjectileMotion.Integrate(
	velocity: Vector3,
	acceleration: Acceleration?,
	accelerationDirection: Vector3?,
	gravity: Acceleration?,
	minSpeed: number,
	maxSpeed: number,
	dt: number
): (Vector3, Vector3)
	local accelerationVector = ProjectileMotion.GetAcceleration(velocity, acceleration, accelerationDirection, gravity)
	if accelerationVector == Vector3.zero or dt <= 0 then
		return velocity, velocity
	end

	local nextVelocity = velocity + accelerationVector * dt
	local unclampedSpeed = nextVelocity.Magnitude
	local ceiling = math.min(maxSpeed, SafeMath.Limit)
	local speed = math.clamp(unclampedSpeed, math.min(minSpeed, ceiling), ceiling)
	if speed ~= unclampedSpeed then
		nextVelocity = SafeMath.direction(nextVelocity, SafeMath.direction(velocity, Vector3.zAxis)) * speed
	end

	return nextVelocity, (velocity + nextVelocity) * 0.5
end

-- Longer casts are safe for fast, mostly-linear projectiles because Roblox
-- ray/sphere casts sweep the full segment. The cap grows with speed to avoid
-- ray-count explosions, while nearby entities retain a tighter ceiling.
function ProjectileMotion.GetAdaptiveMaxDistance(speed: number, nearEntities: boolean): number
	if nearEntities then
		return math.clamp(speed / 120, 4, 64) -- roughly 120 Hz near targets
	end
	return math.clamp(speed / 30, 64, 256) -- roughly 30 Hz in empty space
end

-- Bounds the straight-chord approximation by limiting how far constant
-- acceleration can bend away from that chord during one integration step.
function ProjectileMotion.GetCurvatureStepDt(velocity: Vector3, acceleration: Vector3, allowedError: number): number
	local speed = velocity.Magnitude
	local perpendicular = acceleration
	if speed > EPSILON then
		local direction = velocity / speed
		perpendicular -= direction * acceleration:Dot(direction)
	end
	local magnitude = perpendicular.Magnitude
	if not (magnitude >= EPSILON) then
		return math.huge
	end
	return math.sqrt(8 * allowedError / magnitude)
end

-- Time until the current straight trajectory reaches the next chunk plane.
-- Sampling a nudge ahead resolves the ambiguous "exactly on a plane" case in
-- favor of the chunk the projectile is entering; the sample is a double, not
-- a Vector3, so the nudge survives at any distance from the origin.
function ProjectileMotion.GetChunkBoundaryDt(
	position: Vector3,
	velocity: Vector3,
	chunkSize: number,
	useY: boolean
): number
	local speed = velocity.Magnitude
	if not (speed >= EPSILON) then
		return math.huge
	end

	local nudge = ProjectileMotion.GetNudge(position)
	local best = math.huge

	local function consider(coordinate: number, velocityComponent: number)
		local directionComponent = velocityComponent / speed
		if math.abs(directionComponent) < EPSILON then
			return
		end
		local cell = math.floor((coordinate + directionComponent * nudge) / chunkSize)
		local boundary = if directionComponent > 0 then (cell + 1) * chunkSize else cell * chunkSize
		local dt = (boundary - coordinate) / velocityComponent
		if dt > 0 and dt < best then
			best = dt
		end
	end

	consider(position.X, velocity.X)
	consider(position.Z, velocity.Z)
	if useY then
		consider(position.Y, velocity.Y)
	end

	return best
end

-- Finds the first crossed chunk plane whose far side actually has a different
-- time scale. Equal-scale chunks are skipped, so very fast projectiles do not
-- pay one substep per 64 studs across ordinary 1x space.
function ProjectileMotion.GetTimeScaleBoundaryDt(
	position: Vector3,
	velocity: Vector3,
	chunkSize: number,
	useY: boolean,
	currentScale: number,
	maxDt: number,
	getScaleAt: (Vector3) -> number
): number
	local speed = velocity.Magnitude
	if not (speed >= EPSILON) then
		return math.huge
	end

	local direction = velocity / speed
	local cursorTime = 0
	for _ = 1, 32 do
		local cursorPosition = position + velocity * cursorTime
		local boundaryDt = ProjectileMotion.GetChunkBoundaryDt(cursorPosition, velocity, chunkSize, useY)
		if boundaryDt == math.huge then
			return math.huge
		end
		local boundaryTime = cursorTime + boundaryDt
		if boundaryTime >= maxDt then
			return math.huge
		end
		local boundaryPosition = position + velocity * boundaryTime
		local nudge = ProjectileMotion.GetNudge(boundaryPosition)
		if getScaleAt(boundaryPosition + direction * nudge) ~= currentScale then
			return boundaryTime
		end
		cursorTime = boundaryTime + nudge / speed
	end

	-- Bound the scan itself in pathological ultra-fast cases; the next
	-- simulation segment resumes the search from here without losing time.
	return cursorTime
end

return ProjectileMotion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">ProjectileProtocol</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ProjectileProtocol.luau
	The wire format between the server projectile system
	(ServerScriptService.Server.Projectile/Replication.luau, sending) and
	ProjectileClient (receiving). Channel names and payload shapes live here
	so both sides are type-checked against one definition.

	Beam snapshots carry a synchronized real-time epoch and global scale.
	Clients catch up from that epoch, predict endpoints together and tessellate
	locally. Topology/clipping and hits remain server-authoritative. Ordinary
	projectile snapshots retain their existing receipt-time baseline.
]]

local Protocol = {}

Protocol.Channels = {
	SpawnBatch = "ProjSpawnBatch", -- { SpawnPayload }
	Move = "ProjMove", -- { MovePayload }
	HitBatch = "ProjHitBatch", -- { HitPayload }
	RangeExit = "ProjRangeExit", -- { number }; not projectile death
	Sync = "ProjSync", -- SyncPayload
	TimeScale = "ProjTimeScale", -- TimeScalePayload
	Ray = "ProjRay", -- RayPayload
}

export type Acceleration = number | Vector3

export type VisualSpec = {
	Shape: string?,
	Size: Vector3?,
	Color: Color3?,
	Style: string?,
	Core: Color3?,
}

-- Optional fields are omitted when equal to the client default (noted),
-- because remote events serialize every key name per entry.
export type SpawnPayload = {
	Id: number,
	Position: Vector3,
	Velocity: Vector3,
	Lifetime: number, -- dilated seconds remaining
	MaxRealLifetime: number, -- real seconds remaining
	AccelerationDirection: Vector3?,
	Model: Instance?,
	Visual: VisualSpec?,
	Gravity: Acceleration?, -- 0
	Acceleration: Acceleration?, -- 0
	MinSpeed: number?, -- 0
	MaxSpeed: number?, -- math.huge
	Synced: boolean?, -- false
	TimeScale: number?, -- 1
	VisualScale: number?, -- 1
	ServerTime: number?, -- synchronized real-time epoch for predicted beams
	GlobalScale: number?,
	Beam: { Length: number, Radius: number, Origin: Vector3, ChannelId: number?, PreviousId: number?,
		Path: { Vector3 }?, Clipped: boolean? }?, -- linked stream centerline
	DestroyDelay: number?, -- 0
	WaitForParticles: boolean?, -- true
	WaitForTrails: boolean?, -- true
	ActivateParticlesOnCreate: boolean?, -- false
}

-- Either a homing pose (Bounced nil) or a one-shot bounce snap.
export type MovePayload = {
	Id: number,
	Position: Vector3,
	Velocity: Vector3,
	Bounced: boolean?,
	Corrected: boolean?, -- authoritative beam-body contact, not a ricochet flash
	BeamPreviousId: number?, -- 0 explicitly unlinks; nil means not a beam
	ServerTime: number?,
	GlobalScale: number?,
	TimeScale: number?,
	BeamPath: { Vector3 }?, -- authoritative linked body, clipped at obstructions
	BeamClipped: boolean?, -- true only when the body stops before its PreviousId
	Lifetime: number?,
	Point: Vector3?, -- bounce contact point
	Normal: Vector3?, -- bounce surface normal
}

export type HitPayload = {
	Id: number,
	Position: Vector3,
	Normal: Vector3,
	Kind: string?, -- nil: expired without hitting anything
	BeamBody: boolean?,
	BeamPath: { Vector3 }?,
	BeamClipped: boolean?,
}

export type SyncPayload = {
	Id: number,
	Synced: boolean,
	Position: Vector3,
	Velocity: Vector3,
}

export type TimeScalePayload = {
	Id: number,
	TimeScale: number,
}

export type RayPayload = {
	From: Vector3,
	To: Vector3,
	LowRes: boolean,
}

return Protocol
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">ProjectileStepPlanner</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	ProjectileStepPlanner.luau
	Chooses the next integration substep for a projectile. The authoritative
	server Step and the client's dead-reckoning both call this, so they
	partition time identically: same chunk sampling, same boundary stops,
	same curvature limit, same carry rule for time too small to integrate.
	Keeping one copy is what keeps the two sides from drifting apart as
	either one is tuned.

	Per substep:
	 local sample, chunkScale = Planner.Sample(position, velocity, accel, uniformTime)
	 -- chunkScale == 0: frozen chunk; consume the frame's remaining time.
	 local stepDt = Planner.StepDt(position, velocity, accel, chunkScale,
	     remaining, lifeRemaining, nearEntities, uniformTime, maxDt)
	 -- stepDt == 0: not enough time for a meaningful step; carry `remaining`.

	Remaining time is in personal/global seconds (before chunk dilation); a
	step of stepDt dilated seconds consumes stepDt / chunkScale of it.
]]

local ChunkManager = require(script.Parent.ChunkManager)
local ProjectileMotion = require(script.Parent.ProjectileMotion)
local SafeMath = require(script.Parent.SafeMath)

local Planner = {}

-- Chunk/zone scale as projectile motion sees it -- see
-- ProjectileMotion.SnapTimeScale.
function Planner.ChunkTimeScaleAt(position: Vector3): number
	return ProjectileMotion.SnapTimeScale(ChunkManager.GetTimeScaleAt(position))
end

-- Returns a point just ahead of `position` along the direction of travel,
-- and the chunk time scale there (the chunk being entered wins when
-- sitting exactly on a boundary).
function Planner.Sample(
	position: Vector3,
	velocity: Vector3,
	accelerationVector: Vector3,
	uniformTime: boolean
): (Vector3, number)
	local direction = SafeMath.direction(velocity, SafeMath.direction(accelerationVector, Vector3.zAxis))
	local sample = position + direction * ProjectileMotion.GetNudge(position)
	return sample, if uniformTime then 1 else Planner.ChunkTimeScaleAt(sample)
end

function Planner.StepDt(
	position: Vector3,
	velocity: Vector3,
	accelerationVector: Vector3,
	chunkScale: number,
	remaining: number,
	lifeRemaining: number,
	nearEntities: boolean,
	uniformTime: boolean,
	maxDt: number
): number
	local minStepDt = ProjectileMotion.MinStepDt
	local availableDt = remaining * chunkScale
	if availableDt <= minStepDt then
		return 0
	end

	local predictedVelocity = velocity + accelerationVector * availableDt
	local movementVelocity = (velocity + predictedVelocity) * 0.5
	local speed = movementVelocity.Magnitude
	local stepDt = math.min(availableDt, lifeRemaining, maxDt)
	if speed > 1e-5 then
		stepDt = math.min(stepDt, ProjectileMotion.GetAdaptiveMaxDistance(speed, nearEntities) / speed)
		if not uniformTime then
			stepDt = math.min(
				stepDt,
				ProjectileMotion.GetTimeScaleBoundaryDt(
					position,
					movementVelocity,
					ChunkManager.ChunkSize,
					ChunkManager.UseY,
					chunkScale,
					stepDt,
					Planner.ChunkTimeScaleAt
				),
				ChunkManager.GetRadialTimeScaleBoundaryDt(position, movementVelocity, stepDt)
			)
		end
	end
	stepDt = math.min(
		stepDt,
		ProjectileMotion.GetCurvatureStepDt(velocity, accelerationVector, ProjectileMotion.CurveError)
	)

	-- Boundary and curvature limits can shrink a step toward zero -- e.g. a
	-- projectile resting a hair before a chunk plane. Floor it so they can
	-- never stall progress; overshooting a boundary by minStepDt of travel
	-- is far below anything visible.
	return math.max(stepDt, math.min(minStepDt, availableDt, lifeRemaining))
end

return Planner
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">SafeMath</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	SafeMath.luau
	Finite-number guards for anything that feeds projectile motion. Roblox
	Vector3 components are float32, so a NaN or inf that slips into a
	position/velocity poisons every Dot/Magnitude/raycast after it, and a
	value that is merely enormous can still overflow once squared. Everything
	here clamps to Limit instead of rejecting, so a client aiming at
	Vector3.new(math.huge, 0, 0) still gets a sensible +X shot.

	API:
	 SafeMath.Limit                          -- 1e9; see below
	 SafeMath.isFinite(x) -> boolean
	 SafeMath.isFiniteVector(v) -> boolean   -- every component within +-Limit
	 SafeMath.number(value, fallback, min?, max?) -> number
	 SafeMath.cap(value, min?) -> number     -- like number(), but >= Limit means "no cap" (math.huge)
	 SafeMath.vector(value, fallback) -> Vector3
	 SafeMath.direction(v, fallback) -> Vector3  -- unit vector of an already-finite v
	 SafeMath.unit(value, fallback) -> Vector3   -- sanitize, then direction()
]]

local SafeMath = {}

-- Absurdly large for any real gameplay value, yet its square (1e18) is far
-- inside float32 range (~3.4e38), so Magnitude/Dot on a clamped Vector3 can
-- never overflow to inf.
local LIMIT = 1e9
SafeMath.Limit = LIMIT

-- Below this largest-component size a vector is treated as having no
-- direction. It sits above float32's subnormal range, where dividing stops
-- being exact; anything larger -- however tiny -- still normalizes exactly.
local TINY = 1e-30

function SafeMath.isFinite(x: number): boolean
	return x == x and x > -math.huge and x < math.huge
end

function SafeMath.hasNaN(v: Vector3): boolean
	return v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z
end

-- NaN fails every comparison, so `<=` doubles as the NaN check.
function SafeMath.isFiniteVector(v: Vector3): boolean
	return math.abs(v.X) <= LIMIT and math.abs(v.Y) <= LIMIT and math.abs(v.Z) <= LIMIT
end

-- Non-numbers and NaN fall back; +-inf and anything past +-Limit clamp to
-- the nearest bound. `min`/`max` narrow the range further (never widen it).
function SafeMath.number(value: unknown, fallback: number, min: number?, max: number?): number
	if typeof(value) ~= "number" or value ~= value then
		return fallback
	end
	local low = math.max(min or -LIMIT, -LIMIT)
	local high = math.max(math.min(max or LIMIT, LIMIT), low)
	return math.clamp(value, low, high)
end

-- For fields where math.huge is a meaningful "unlimited" sentinel (MaxSpeed,
-- VisualRange): NaN and anything at or past Limit become math.huge.
function SafeMath.cap(value: unknown, min: number?): number
	if typeof(value) ~= "number" or value ~= value or value >= LIMIT then
		return math.huge
	end
	return math.max(value, min or 0)
end

local function clampComponent(x: number): number
	if x ~= x then
		return 0
	end
	return math.clamp(x, -LIMIT, LIMIT)
end

-- Non-Vector3 values fall back; NaN components become 0 and +-inf/huge
-- components clamp to +-Limit.
function SafeMath.vector(value: unknown, fallback: Vector3): Vector3
	if typeof(value) ~= "Vector3" then
		return fallback
	end
	if SafeMath.isFiniteVector(value) then
		return value
	end
	return Vector3.new(clampComponent(value.X), clampComponent(value.Y), clampComponent(value.Z))
end

-- Unit vector along `v`, or `fallback` when it has no usable direction.
-- Rescaling by the largest component first means neither a tiny vector
-- (whose squared magnitude would underflow) nor a huge one (which would
-- overflow) loses its direction. Hot-path safe for internally maintained,
-- already-finite vectors; use unit() for anything from outside.
function SafeMath.direction(v: Vector3, fallback: Vector3): Vector3
	local largest = math.max(math.abs(v.X), math.abs(v.Y), math.abs(v.Z))
	if largest >= TINY and largest < math.huge then
		local unit = (v / largest).Unit
		-- math.max can swallow a NaN component, so check the result itself.
		if unit.X == unit.X and unit.Y == unit.Y and unit.Z == unit.Z then
			return unit
		end
	end
	return fallback
end

function SafeMath.unit(value: unknown, fallback: Vector3): Vector3
	return SafeMath.direction(SafeMath.vector(value, Vector3.zero), fallback)
end

return SafeMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	Signal.luau
	A lightweight, allocation-friendly signal used across the framework for
	entity events (Damaged, Died, ...), hitbox hits, and anything else that
	needs an event without a BindableEvent round-trip.

	API:
	 Signal.new() -> Signal
	 signal:Connect(fn) -> Connection      (Connection has :Disconnect())
	 signal:Once(fn) -> Connection
	 signal:Wait() -> ...                   (yields the calling coroutine)
	 signal:Fire(...)
	 signal:DisconnectAll()
	 signal:Destroy()

	Handlers are dispatched on fresh threads (task.spawn) so a throwing or
	yielding listener never blocks or breaks :Fire() for the others.
]]

local Signal = {}
Signal.__index = Signal

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	local connections = self._signal._connections
	local index = table.find(connections, self)
	if index then
		local n = #connections
		connections[index] = connections[n]
		connections[n] = nil
	end
end
Connection.Destroy = Connection.Disconnect

function Signal.new()
	return setmetatable({ _connections = {} }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	local connection = setmetatable({
		Connected = true,
		_signal = self,
		_fn = fn,
	}, Connection)
	table.insert(self._connections, connection)
	return connection
end

function Signal:Once(fn: (...any) -> ())
	local connection
	connection = self:Connect(function(...)
		if connection.Connected then
			connection:Disconnect()
		end
		fn(...)
	end)
	return connection
end

function Signal:Wait(): ...any
	local thread = coroutine.running()
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:Fire(...)
	-- Iterate over a snapshot so listeners may disconnect (or the signal be
	-- destroyed) mid-dispatch without corrupting the loop.
	local connections = self._connections
	for i = #connections, 1, -1 do
		local connection = connections[i]
		if connection and connection.Connected then
			task.spawn(connection._fn, ...)
		end
	end
end

function Signal:DisconnectAll()
	for _, connection in self._connections do
		connection.Connected = false
	end
	table.clear(self._connections)
end

function Signal:Destroy()
	self:DisconnectAll()
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">SpellCompiler</string>
          <string name="Source"><![CDATA[--!strict
--[[
	SpellCompiler.luau (graph v3)
	Validates a whiteboard spell graph and compiles it into the plan the
	server runtime executes (see server/SpellRuntime.luau). Pure and shared:
	the editor runs it live for feedback and the server runs it again on
	every save and cast, so a client can never smuggle in an invalid circle.

	Graph format
	 {
	   version = 3, name = string,
	   zones = { { id, kind, label?, locked?, x, y, w, h } },          -- board units
	   runes = { { id, rune, x, y, locked?, params = { [name]: value } } }, -- x,y = card top-left
	   wires = { { from, fromPort, to, toPort } },
	 }

	Compile(graph) -> (compiled?, errors, normalized?)
	 errors: { { message: string, rune: string?, zone: string? } }
	 Params are sanitized (clamped / defaulted) rather than rejected.
]]

local SpellRunes = require(script.Parent.SpellRunes)

local SpellCompiler = {}

SpellCompiler.GraphVersion = 3
SpellCompiler.MaxRunes = 64
SpellCompiler.MaxWires = 128
SpellCompiler.MaxZones = 24
SpellCompiler.MaxTriggerDepth = 3
SpellCompiler.BoardLimit = 20000

-- Card geometry shared with the editor. A rune "sits in" a zone when the
-- middle of its header does.
SpellCompiler.Layout = { RuneWidth = 176, Header = 30, Row = 22, Footer = 24 }

function SpellCompiler.RuneHeight(runeId: string): number
	local def = SpellRunes.Runes[runeId]
	local rows = if def then math.max(#def.Inputs, #def.Outputs, 1) else 1
	local layout = SpellCompiler.Layout
	return layout.Header + rows * layout.Row + layout.Footer
end

function SpellCompiler.RuneAnchor(rune: any): (number, number)
	local layout = SpellCompiler.Layout
	return rune.x + layout.RuneWidth / 2, rune.y + layout.Header / 2
end

type Error = { message: string, rune: string?, zone: string? }

local function finite(value: any): boolean
	return typeof(value) == "number" and value == value and math.abs(value) < math.huge
end

local function validId(value: any): boolean
	return typeof(value) == "string" and #value >= 1 and #value <= 32 and string.match(value, "^[%w_%-]+$") ~= nil
end

local function sanitizeParams(def: any, raw: any): { [string]: any }
	local params = {}
	local source = if typeof(raw) == "table" then raw else {}
	for _, param in def.Params do
		local value = source[param.Name]
		if param.Type == "number" then
			if not finite(value) then
				value = param.Default
			end
			local step = param.Step or 0
			if step > 0 then
				value = math.floor(value / step + 0.5) * step
				-- Remove float noise from steps like 0.1 so saved values stay tidy.
				value = tonumber(string.format("%.4f", value)) :: number
			end
			value = math.clamp(value, param.Min or -math.huge, param.Max or math.huge)
		elseif param.Type == "enum" then
			if typeof(value) ~= "string" or not table.find(param.Options :: { string }, value) then
				value = param.Default
			end
		elseif param.Type == "bool" then
			if typeof(value) ~= "boolean" then
				value = param.Default
			end
		end
		params[param.Name] = value
	end
	return params
end

local function normalize(graph: any, errors: { Error }): (any, any)
	local function fail(message: string, rune: string?, zone: string?)
		table.insert(errors, { message = message, rune = rune, zone = zone })
	end
	if typeof(graph) ~= "table" then
		fail("Spell graph must be a table.")
		return nil, nil
	end
	if graph.version ~= SpellCompiler.GraphVersion then
		fail("This spell was made with an older editor and can't be loaded.")
		return nil, nil
	end
	if typeof(graph.zones) ~= "table" or typeof(graph.runes) ~= "table" or typeof(graph.wires) ~= "table" then
		fail("Spell graph needs zones, runes and wires.")
		return nil, nil
	end
	local limit = SpellCompiler.BoardLimit
	local normalized = {
		version = SpellCompiler.GraphVersion,
		name = if typeof(graph.name) == "string" then string.sub(graph.name, 1, 96) else "Untitled Spell",
		zones = {},
		runes = {},
		wires = {},
	}

	if #graph.zones > SpellCompiler.MaxZones then
		fail(`A spell may have at most {SpellCompiler.MaxZones} zones.`)
	end
	local zoneIds = {}
	for index, raw in ipairs(graph.zones) do
		if index > SpellCompiler.MaxZones then break end
		if typeof(raw) ~= "table" or not validId(raw.id) or zoneIds[raw.id]
			or not SpellRunes.Zones[raw.kind]
			or not finite(raw.x) or not finite(raw.y) or not finite(raw.w) or not finite(raw.h)
			or math.abs(raw.x) > limit or math.abs(raw.y) > limit
			or raw.w < 80 or raw.h < 60 or raw.w > 8000 or raw.h > 8000 then
			fail(`Zone {index} is malformed.`)
			continue
		end
		zoneIds[raw.id] = true
		table.insert(normalized.zones, {
			id = raw.id,
			kind = raw.kind,
			label = if typeof(raw.label) == "string" then string.sub(raw.label, 1, 32) else nil,
			locked = if raw.locked == true then true else nil,
			x = raw.x, y = raw.y, w = raw.w, h = raw.h,
		})
	end

	if #graph.runes > SpellCompiler.MaxRunes then
		fail(`A spell may have at most {SpellCompiler.MaxRunes} runes.`)
	end
	local runeById = {}
	for index, raw in ipairs(graph.runes) do
		if index > SpellCompiler.MaxRunes then break end
		local def = typeof(raw) == "table" and SpellRunes.Runes[raw.rune] or nil
		if typeof(raw) ~= "table" or not validId(raw.id) then
			fail(`Rune {index} has an invalid id.`)
			continue
		end
		if runeById[raw.id] then
			fail(`Duplicate rune id "{raw.id}".`, raw.id)
			continue
		end
		if not def then
			fail(`Rune "{tostring(raw.rune)}" doesn't exist.`, raw.id)
			continue
		end
		if not finite(raw.x) or not finite(raw.y) or math.abs(raw.x) > limit or math.abs(raw.y) > limit then
			fail(`{def.Name} has an invalid position.`, raw.id)
			continue
		end
		local rune = {
			id = raw.id,
			rune = def.Id,
			x = raw.x,
			y = raw.y,
			params = sanitizeParams(def, raw.params),
			locked = if raw.locked == true then true else nil,
		}
		runeById[raw.id] = rune
		table.insert(normalized.runes, rune)
	end

	if #graph.wires > SpellCompiler.MaxWires then
		fail(`A spell may have at most {SpellCompiler.MaxWires} wires.`)
	end
	local seen = {}
	for index, raw in ipairs(graph.wires) do
		if index > SpellCompiler.MaxWires then break end
		if typeof(raw) ~= "table" or not validId(raw.from) or not validId(raw.to)
			or typeof(raw.fromPort) ~= "string" or typeof(raw.toPort) ~= "string" then
			fail(`Wire {index} is malformed.`)
			continue
		end
		local fromRune, toRune = runeById[raw.from], runeById[raw.to]
		if not fromRune or not toRune then
			fail(`Wire {index} connects a missing rune.`)
			continue
		end
		if raw.from == raw.to then
			fail("A rune can't be wired to itself.", raw.from)
			continue
		end
		local fromDef, toDef = SpellRunes.Runes[fromRune.rune], SpellRunes.Runes[toRune.rune]
		local outPort = SpellRunes.FindPort(fromDef.Outputs, raw.fromPort)
		local inPort = SpellRunes.FindPort(toDef.Inputs, raw.toPort)
		if not outPort or not inPort then
			fail(`Wire {index} uses a port that doesn't exist.`, raw.to)
			continue
		end
		if not SpellRunes.Compatible(outPort.Type, inPort.Type) then
			fail(`{fromDef.Name} {outPort.Label} ({outPort.Type}) can't feed {toDef.Name} {inPort.Label} ({inPort.Type}).`, raw.to)
			continue
		end
		local key = `{raw.from}.{raw.fromPort}>{raw.to}.{raw.toPort}`
		if seen[key] then
			continue -- exact duplicates are harmless; drop them
		end
		seen[key] = true
		table.insert(normalized.wires, { from = raw.from, fromPort = raw.fromPort, to = raw.to, toPort = raw.toPort })
	end
	return normalized, runeById
end

local function zoneContains(zone: any, x: number, y: number): boolean
	return x >= zone.x and y >= zone.y and x <= zone.x + zone.w and y <= zone.y + zone.h
end

-- A starter circle: Mana -> Fire -> Orb with a Speed modifier.
function SpellCompiler.CreateDefaultGraph()
	return {
		version = SpellCompiler.GraphVersion,
		name = "Fireball",
		zones = {
			{ id = "zone_input", kind = "Input", x = 0, y = 0, w = 260, h = 200 },
			{ id = "zone_transform", kind = "Transform", x = 320, y = 0, w = 260, h = 200 },
			{ id = "zone_modifier", kind = "Modifier", x = 320, y = 260, w = 260, h = 200 },
			{ id = "zone_output", kind = "Output", x = 640, y = 0, w = 280, h = 260 },
		},
		runes = {
			{ id = "mana", rune = "Mana", x = 42, y = 60, params = SpellRunes.DefaultParams("Mana") },
			{ id = "fire", rune = "Fire", x = 362, y = 60, params = {} },
			{ id = "speed", rune = "Speed", x = 362, y = 320, params = SpellRunes.DefaultParams("Speed") },
			{ id = "orb", rune = "Orb", x = 692, y = 60, params = {} },
		},
		wires = {
			{ from = "mana", fromPort = "out", to = "fire", toPort = "in" },
			{ from = "fire", fromPort = "out", to = "orb", toPort = "in" },
			{ from = "speed", fromPort = "mod", to = "orb", toPort = "mods" },
		},
	}
end

function SpellCompiler.Compile(graph: any)
	local errors: { Error } = {}
	local normalized, runeById = normalize(graph, errors)
	if not normalized or not runeById then
		return nil, errors, nil
	end
	local function fail(message: string, rune: string?, zone: string?)
		for _, existing in errors do
			if existing.message == message and existing.rune == rune then return end
		end
		table.insert(errors, { message = message, rune = rune, zone = zone })
	end

	-- Adjacency ---------------------------------------------------------------
	local inputs: { [string]: any } = {}
	local outputs: { [string]: any } = {}
	for _, rune in normalized.runes do
		inputs[rune.id], outputs[rune.id] = {}, {}
	end
	for _, wire in normalized.wires do
		local ins = inputs[wire.to]
		ins[wire.toPort] = ins[wire.toPort] or {}
		table.insert(ins[wire.toPort], { from = wire.from, port = wire.fromPort })
		local outs = outputs[wire.from]
		outs[wire.fromPort] = outs[wire.fromPort] or {}
		table.insert(outs[wire.fromPort], { to = wire.to, port = wire.toPort })
	end

	-- Per-rune structural rules ------------------------------------------------
	local counts = {}
	local manaRoots, vessels = {}, {}
	for _, rune in normalized.runes do
		local def = SpellRunes.Runes[rune.rune]
		counts[def.Id] = (counts[def.Id] or 0) + 1
		if def.Unique and counts[def.Id] > 1 then
			fail(`Only one {def.Name} rune is allowed.`, rune.id)
		end
		if def.Id == "Mana" then table.insert(manaRoots, rune.id) end
		if def.Vessel then table.insert(vessels, rune.id) end

		local ax, ay = SpellCompiler.RuneAnchor(rune)
		local placed = false
		for _, zone in normalized.zones do
			if table.find(def.Zones, zone.kind) and zoneContains(zone, ax, ay) then
				placed = true
				break
			end
		end
		if not placed then
			fail(`{def.Name} must sit inside a {table.concat(def.Zones, " or ")} zone.`, rune.id)
		end

		for _, port in def.Inputs do
			local wires = inputs[rune.id][port.Name]
			local n = if wires then #wires else 0
			if n == 0 and not port.Optional then
				fail(`{def.Name}: connect its {port.Label} input.`, rune.id)
			elseif n > 1 and not port.Multi then
				fail(`{def.Name}: {port.Label} accepts only one wire.`, rune.id)
			end
		end
		for _, port in def.Outputs do
			local wires = outputs[rune.id][port.Name]
			local n = if wires then #wires else 0
			if (port.Type == "flow" or port.Type == "mod") and n > 1 then
				fail(`{def.Name}: {port.Label} can only feed one wire. Use Divide to split energy.`, rune.id)
			end
			if port.Type == "mod" and n == 0 then
				fail(`{def.Name} isn't attached to a vessel (Orb, Bullet or Beam).`, rune.id)
			end
			if def.Id == "Target" and n == 0 then
				fail("Aim: wire its Aim output into a vessel's Aim port.", rune.id)
			end
		end
	end
	if #manaRoots == 0 then fail("Add a Mana Well in an Input zone.") end
	if #vessels == 0 then fail("Add a vessel (Orb, Bullet or Beam) in an Output zone.") end

	-- Vessel modifier/trigger budgets -----------------------------------------
	local vesselInfo = {}
	for _, vesselId in vessels do
		local vesselDef = SpellRunes.Runes[runeById[vesselId].rune]
		local mods, seenMods, modCost, count = {}, {}, 0, 1
		for _, link in inputs[vesselId].mods or {} do
			local source = runeById[link.from]
			local def = SpellRunes.Runes[source.rune]
			if seenMods[def.Id] then
				fail(`{vesselDef.Name} has two {def.Name} modifiers.`, vesselId)
			end
			if not SpellRunes.ModifierApplies(vesselDef.Id, def.Id) then
				fail(`{def.Name} does nothing on this {vesselDef.Name}.`, link.from)
			end
			seenMods[def.Id] = true
			modCost += SpellRunes.ModifierCost(def.Id, source.params)
			if def.Id == "Quantity" then
				count = source.params.Count
			end
			table.insert(mods, link.from)
		end
		if modCost > SpellRunes.MaxModifierCost then
			fail(`Modifiers on this {vesselDef.Name} would consume {math.floor(modCost * 100)}% of its energy (max {math.floor(SpellRunes.MaxModifierCost * 100)}%).`, vesselId)
		end
		local triggers, share = {}, 0
		for _, link in (outputs[vesselId].vessel or {}) do
			local trigger = runeById[link.to]
			if not SpellRunes.TriggerApplies(vesselDef.Id, trigger.rune) then
				fail(`{SpellRunes.Runes[trigger.rune].Name} can't be used on this {vesselDef.Name}: it has no flight time.`, link.to)
			end
			table.insert(triggers, link.to)
			share += trigger.params.Share / 100
		end
		if share > SpellRunes.MaxTriggerShare + 1e-6 then
			fail(`Triggers on this {vesselDef.Name} claim {math.floor(share * 100 + 0.5)}% of its energy (max {math.floor(SpellRunes.MaxTriggerShare * 100)}%).`, vesselId)
		end
		vesselInfo[vesselId] = { mods = mods, modCost = modCost, triggers = triggers, triggerShare = share, count = count }
	end

	-- Cycles -------------------------------------------------------------------
	local state = {}
	local cyclic = false
	local function visit(id: string)
		if state[id] == 1 then
			cyclic = true
			return
		end
		if state[id] == 2 then
			return
		end
		state[id] = 1
		for _, links in outputs[id] do
			for _, link in links do visit(link.to) end
		end
		state[id] = 2
	end
	for id in runeById do visit(id) end
	if cyclic then fail("Wires form a loop; spells must flow one way.") end

	-- Energy + element propagation (static estimates) -------------------------
	-- Walks each flow tree from its root carrying energy, element and trigger
	-- depth. With If both sides get the full amount ("up to").
	local estimates: { [string]: any } = {}
	local elements: { [string]: string } = {}
	local reached = {}
	local function follow(id: string, port: string, energy: number, element: string?, depth: number)
		for _, link in (outputs[id][port] or {}) do
			local rune = runeById[link.to]
			local def = SpellRunes.Runes[rune.rune]
			reached[link.to] = true
			estimates[link.to] = { energy = energy }
			if def.Element then
				follow(link.to, "out", energy, def.Element, depth)
			elseif def.Id == "If" then
				follow(link.to, "yes", energy, element, depth)
				follow(link.to, "no", energy, element, depth)
			elseif def.Id == "Divide" then
				local share = rune.params.Share / 100
				follow(link.to, "a", energy * share, element, depth)
				follow(link.to, "b", energy * (1 - share), element, depth)
			elseif def.Vessel then
				if not element then
					fail(`Energy reaches this {def.Name} without a Transform rune (Fire, Arcane or Shock).`, link.to)
				else
					elements[link.to] = element
				end
				local info = vesselInfo[link.to]
				local perBolt = energy * (1 - math.min(info.modCost, 1)) / info.count
				local elementDef = element and SpellRunes.Elements[element]
				local impact = (if elementDef then elementDef.Impact else 1) * SpellRunes.Vessels[def.Id].Impact
				estimates[link.to].count = info.count
				estimates[link.to].damage = perBolt * (1 - info.triggerShare) * impact
				estimates[link.to].element = element
				if #info.triggers > 0 then
					if depth >= SpellCompiler.MaxTriggerDepth then
						fail(`Triggers can nest at most {SpellCompiler.MaxTriggerDepth} deep.`, link.to)
					else
						for _, triggerId in info.triggers do
							local triggerEnergy = perBolt * runeById[triggerId].params.Share / 100
							reached[triggerId] = true
							estimates[triggerId] = { energy = triggerEnergy }
							follow(triggerId, "out", triggerEnergy, element, depth + 1)
						end
					end
				end
			end
		end
	end
	if not cyclic then
		for _, rootId in manaRoots do
			local amount = runeById[rootId].params.Amount
			estimates[rootId] = { energy = amount }
			reached[rootId] = true
			follow(rootId, "out", amount, nil, 0)
		end
		for _, rune in normalized.runes do
			local def = SpellRunes.Runes[rune.rune]
			if SpellRunes.FindPort(def.Inputs, "in") and inputs[rune.id]["in"] and not reached[rune.id] then
				fail(`{def.Name} never receives energy from a Mana Well.`, rune.id)
			end
			if def.Category == "Trigger" and not reached[rune.id] and inputs[rune.id].vessel then
				fail(`{def.Name}'s vessel never receives energy.`, rune.id)
			end
		end
	end

	local manaCost = 0
	for _, rootId in manaRoots do
		manaCost += runeById[rootId].params.Amount
	end

	local analysis = { estimates = estimates, manaCost = manaCost }
	if #errors > 0 then
		return nil, errors, normalized, analysis
	end

	local runes = {}
	for _, rune in normalized.runes do
		runes[rune.id] = { id = rune.id, rune = rune.rune, params = rune.params }
	end
	return {
		version = SpellCompiler.GraphVersion,
		name = normalized.name,
		manaCost = manaCost,
		runes = runes,
		inputs = inputs,
		outputs = outputs,
		manaRoots = manaRoots,
		vessels = vesselInfo,
		elements = elements,
		estimates = estimates,
	}, errors, normalized, analysis
end

return SpellCompiler
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">SpellRunes</string>
          <string name="Source"><![CDATA[--!strict
--[[
	SpellRunes.luau
	The rune catalog for the spell whiteboard: zone kinds, port types,
	elements and every rune's ports/params. Pure data, shared by the editor
	(client), the compiler (both) and the runtime (server) so all three agree
	on what a rune is.

	Spell model
	 - Mana is energy. A Mana Well pushes its Amount along "flow" wires; every
	   cast charges the sum of all wells. Energy is conserved: a flow output
	   feeds at most one wire (use Divide to split it), If routes it one way,
	   and a Vessel (Orb / Bullet / Beam) turns what arrives into damage after its modifiers and
	   triggers take their cut.
	 - Values (number / bool / entity / point) are computed by Sensor and
	   Logic runes whenever the flow that needs them runs: at cast time, or
	   at the moment a Trigger fires in flight.
	 - Every rune must sit inside a zone whose kind it allows. Zones are the
	   player-drawn structure of the circle.

	Port types
	 flow   -- mana energy (one wire out, one wire in)
	 number, bool, entity, point -- values (fan out freely, one wire in)
	 mod    -- Modifier -> Vessel "Modifiers" (many into one)
	 vessel -- Vessel "Triggers" -> Trigger (one vessel may carry many triggers)
	 entity may be wired into a point input (it reads the entity's position).
]]

local SpellRunes = {}

export type PortDef = {
	Name: string,
	Type: string,
	Label: string,
	Optional: boolean?,
	Multi: boolean?,
}

export type ParamDef = {
	Name: string,
	Label: string,
	Type: string, -- "number" | "enum" | "bool"
	Default: any,
	Min: number?,
	Max: number?,
	Step: number?,
	Options: { string }?,
	Suffix: string?,
}

export type RuneDef = {
	Id: string,
	Name: string,
	Category: string,
	Zones: { string },
	Description: string,
	Inputs: { PortDef },
	Outputs: { PortDef },
	Params: { ParamDef },
	Unique: boolean?,
	Element: string?,
	ModifierCost: number?, -- energy fraction consumed per level (Modifier runes)
	Vessel: boolean?, -- an Output rune that gives magic its form (Orb/Bullet/Beam)
	Instant: boolean?, -- a vessel with no flight (Explosion)
}

--------------------------------------------------------------------------------
-- Zones
--------------------------------------------------------------------------------

SpellRunes.ZoneKinds = { "Input", "Targeting", "Conditional", "Branch", "Transform", "Modifier", "Output", "Trigger" }

SpellRunes.Zones = {
	Input = { Color = Color3.fromRGB(80, 170, 255), Description = "Where mana enters the circle." },
	Targeting = { Color = Color3.fromRGB(90, 220, 150), Description = "Decides where the spell aims. Leave it out to aim at the mouse." },
	Conditional = { Color = Color3.fromRGB(255, 205, 80), Description = "Sensors and logic that compute conditions." },
	Branch = { Color = Color3.fromRGB(255, 150, 70), Description = "Routes or splits the flow of mana." },
	Transform = { Color = Color3.fromRGB(255, 95, 80), Description = "Converts raw mana into an element." },
	Modifier = { Color = Color3.fromRGB(170, 130, 255), Description = "Shapes how a vessel flies, how many there are, and what it passes through." },
	Output = { Color = Color3.fromRGB(255, 90, 140), Description = "Where energy leaves the circle: Vessels (Orb, Bullet, Beam) give the magic its form." },
	Trigger = { Color = Color3.fromRGB(80, 215, 230), Description = "Runs more of the circle while a vessel is in flight, or where it lands." },
}

--------------------------------------------------------------------------------
-- Types and elements
--------------------------------------------------------------------------------

SpellRunes.PortColors = {
	flow = Color3.fromRGB(255, 210, 90),
	number = Color3.fromRGB(90, 210, 255),
	bool = Color3.fromRGB(255, 120, 200),
	entity = Color3.fromRGB(255, 140, 80),
	point = Color3.fromRGB(110, 230, 140),
	mod = Color3.fromRGB(180, 140, 255),
	vessel = Color3.fromRGB(90, 150, 255),
}

-- Can a wire carrying `from` feed an input of type `to`?
function SpellRunes.Compatible(from: string, to: string): boolean
	return from == to or (from == "entity" and to == "point")
end

-- Impact is the share of a vessel's energy dealt as hit damage. Fire adds a
-- burn worth BurnRatio of the energy over BurnDuration; Shock stuns instead.
-- Color is the glow, Core the hot centre the client renders (see
-- ProjectileClient/VisualModel's styled visuals and client/SpellEffects).
SpellRunes.Elements = {
	Fire = { Color = Color3.fromRGB(255, 96, 28), Core = Color3.fromRGB(255, 226, 150), Impact = 0.8, BurnRatio = 0.35, BurnDuration = 3 },
	Arcane = { Color = Color3.fromRGB(150, 60, 255), Core = Color3.fromRGB(214, 160, 255), Impact = 1.0 },
	Shock = { Color = Color3.fromRGB(70, 196, 255), Core = Color3.fromRGB(226, 250, 255), Impact = 0.7, StunPerEnergy = 1 / 100, StunMax = 1 },
}

local FILTERS = { "Any", "Enemy", "Player" }
local LEVEL: ParamDef = { Name = "Level", Label = "Level", Type = "number", Default = 1, Min = 1, Max = 5, Step = 1 }
local SHARE: ParamDef = { Name = "Share", Label = "Energy share", Type = "number", Default = 50, Min = 10, Max = 90, Step = 5, Suffix = "%" }
local VALUE_ZONES = { "Conditional", "Targeting" }

local function flowIn(): PortDef
	return { Name = "in", Type = "flow", Label = "Energy" }
end
local function flowOut(name: string?, label: string?): PortDef
	return { Name = name or "out", Type = "flow", Label = label or "Energy" }
end
local function modOut(): PortDef
	return { Name = "mod", Type = "mod", Label = "Vessel" }
end
local function vesselIn(): PortDef
	return { Name = "vessel", Type = "vessel", Label = "Vessel" }
end
local function vesselDef(id: string, name: string, description: string, instant: boolean?): RuneDef
	return {
		Id = id, Name = name, Category = "Vessel", Zones = { "Output" }, Vessel = true, Instant = instant,
		Description = description,
		Inputs = {
			flowIn(),
			{ Name = "mods", Type = "mod", Label = "Modifiers", Optional = true, Multi = true },
			{ Name = "aim", Type = "point", Label = "Aim", Optional = true },
		},
		Outputs = { { Name = "vessel", Type = "vessel", Label = "Triggers" } },
		Params = {},
	}
end

--------------------------------------------------------------------------------
-- Runes
--------------------------------------------------------------------------------

local defs: { RuneDef } = {
	-- Input ---------------------------------------------------------------------
	{
		Id = "Mana", Name = "Mana Well", Category = "Input", Zones = { "Input" },
		Description = "Draws Amount mana each cast and pushes it into the circle as energy.",
		Inputs = {}, Outputs = { flowOut() },
		Params = { { Name = "Amount", Label = "Mana", Type = "number", Default = 30, Min = 1, Max = 1000, Step = 1, Suffix = " mana" } },
	},

	-- Targeting -----------------------------------------------------------------
	{
		Id = "Target", Name = "Aim", Category = "Targeting", Zones = { "Targeting" },
		Description = "Where a vessel points: wire Aim into a vessel's Aim port. With nothing in Aim at it aims at your mouse; feed it a point or entity (e.g. Nearest Entity) to aim there instead, falling back to the mouse when that's empty.",
		Inputs = { { Name = "point", Type = "point", Label = "Aim at", Optional = true } },
		Outputs = { { Name = "point", Type = "point", Label = "Aim" } },
		Params = {},
	},

	-- Sensors -------------------------------------------------------------------
	{
		Id = "Caster", Name = "Caster", Category = "Sensor", Zones = VALUE_ZONES,
		Description = "You.",
		Inputs = {}, Outputs = { { Name = "entity", Type = "entity", Label = "Caster" } }, Params = {},
	},
	{
		Id = "Cursor", Name = "Cursor", Category = "Sensor", Zones = VALUE_ZONES,
		Description = "Where you aimed when casting, and the entity under the crosshair (if any).",
		Inputs = {},
		Outputs = { { Name = "point", Type = "point", Label = "Point" }, { Name = "entity", Type = "entity", Label = "Entity" } },
		Params = {},
	},
	{
		Id = "Here", Name = "Here", Category = "Sensor", Zones = VALUE_ZONES,
		Description = "Where this part of the circle is running: your hand at cast time, or the bolt's position when a trigger fires.",
		Inputs = {}, Outputs = { { Name = "point", Type = "point", Label = "Point" } }, Params = {},
	},
	{
		Id = "Struck", Name = "Struck Entity", Category = "Sensor", Zones = VALUE_ZONES,
		Description = "The entity that set off the current trigger (the one hit, or the one that came close). Empty at cast time.",
		Inputs = {}, Outputs = { { Name = "entity", Type = "entity", Label = "Entity" } }, Params = {},
	},
	{
		Id = "Nearest", Name = "Nearest Entity", Category = "Sensor", Zones = VALUE_ZONES,
		Description = "Closest living entity (never you) within Radius of From. From defaults to Here.",
		Inputs = { { Name = "from", Type = "point", Label = "From", Optional = true } },
		Outputs = { { Name = "entity", Type = "entity", Label = "Entity" } },
		Params = {
			{ Name = "Radius", Label = "Radius", Type = "number", Default = 60, Min = 5, Max = 200, Step = 5, Suffix = " st" },
			{ Name = "Filter", Label = "Only", Type = "enum", Default = "Enemy", Options = FILTERS },
		},
	},
	{
		Id = "Distance", Name = "Distance", Category = "Sensor", Zones = VALUE_ZONES,
		Description = "Studs between two points. Huge if either is empty.",
		Inputs = { { Name = "a", Type = "point", Label = "A" }, { Name = "b", Type = "point", Label = "B" } },
		Outputs = { { Name = "value", Type = "number", Label = "Studs" } }, Params = {},
	},
	{
		Id = "Health", Name = "Health", Category = "Sensor", Zones = VALUE_ZONES,
		Description = "An entity's health (0 if empty).",
		Inputs = { { Name = "entity", Type = "entity", Label = "Entity" } },
		Outputs = { { Name = "value", Type = "number", Label = "Health" } },
		Params = { { Name = "Mode", Label = "As", Type = "enum", Default = "Points", Options = { "Points", "Percent" } } },
	},
	{
		Id = "Exists", Name = "Exists", Category = "Sensor", Zones = VALUE_ZONES,
		Description = "True when the entity is present and alive.",
		Inputs = { { Name = "entity", Type = "entity", Label = "Entity" } },
		Outputs = { { Name = "value", Type = "bool", Label = "Yes" } }, Params = {},
	},
	{
		Id = "IsPlayer", Name = "Is Player", Category = "Sensor", Zones = VALUE_ZONES,
		Description = "True when the entity is a player character.",
		Inputs = { { Name = "entity", Type = "entity", Label = "Entity" } },
		Outputs = { { Name = "value", Type = "bool", Label = "Yes" } }, Params = {},
	},

	-- Logic ---------------------------------------------------------------------
	{
		Id = "Number", Name = "Number", Category = "Logic", Zones = VALUE_ZONES,
		Description = "A constant.",
		Inputs = {}, Outputs = { { Name = "value", Type = "number", Label = "Value" } },
		Params = { { Name = "Value", Label = "Value", Type = "number", Default = 30, Min = -10000, Max = 10000, Step = 1 } },
	},
	{
		Id = "Math", Name = "Math", Category = "Logic", Zones = VALUE_ZONES,
		Description = "A op B. Division by zero gives 0.",
		Inputs = { { Name = "a", Type = "number", Label = "A" }, { Name = "b", Type = "number", Label = "B" } },
		Outputs = { { Name = "value", Type = "number", Label = "Result" } },
		Params = { { Name = "Op", Label = "Op", Type = "enum", Default = "+", Options = { "+", "-", "×", "÷", "min", "max" } } },
	},
	{
		Id = "Compare", Name = "Compare", Category = "Logic", Zones = VALUE_ZONES,
		Description = "True when A op B.",
		Inputs = { { Name = "a", Type = "number", Label = "A" }, { Name = "b", Type = "number", Label = "B" } },
		Outputs = { { Name = "value", Type = "bool", Label = "Result" } },
		Params = { { Name = "Op", Label = "Op", Type = "enum", Default = "<", Options = { "<", "≤", "=", "≠", "≥", ">" } } },
	},
	{
		Id = "And", Name = "And", Category = "Logic", Zones = VALUE_ZONES,
		Description = "True when both are true.",
		Inputs = { { Name = "a", Type = "bool", Label = "A" }, { Name = "b", Type = "bool", Label = "B" } },
		Outputs = { { Name = "value", Type = "bool", Label = "Result" } }, Params = {},
	},
	{
		Id = "Or", Name = "Or", Category = "Logic", Zones = VALUE_ZONES,
		Description = "True when either is true.",
		Inputs = { { Name = "a", Type = "bool", Label = "A" }, { Name = "b", Type = "bool", Label = "B" } },
		Outputs = { { Name = "value", Type = "bool", Label = "Result" } }, Params = {},
	},
	{
		Id = "Not", Name = "Not", Category = "Logic", Zones = VALUE_ZONES,
		Description = "Flips true and false.",
		Inputs = { { Name = "a", Type = "bool", Label = "In" } },
		Outputs = { { Name = "value", Type = "bool", Label = "Result" } }, Params = {},
	},
	{
		Id = "Select", Name = "Choose Point", Category = "Logic", Zones = VALUE_ZONES,
		Description = "Then if the condition holds, otherwise Else. Handy for targeting fallbacks.",
		Inputs = {
			{ Name = "cond", Type = "bool", Label = "If" },
			{ Name = "a", Type = "point", Label = "Then" },
			{ Name = "b", Type = "point", Label = "Else" },
		},
		Outputs = { { Name = "point", Type = "point", Label = "Point" } }, Params = {},
	},

	-- Branch --------------------------------------------------------------------
	{
		Id = "If", Name = "If", Category = "Branch", Zones = { "Branch" },
		Description = "Sends all energy down True or False depending on the condition. An unwired side fizzles.",
		Inputs = { flowIn(), { Name = "cond", Type = "bool", Label = "Condition" } },
		Outputs = { flowOut("yes", "True"), flowOut("no", "False") }, Params = {},
	},
	{
		Id = "Divide", Name = "Divide", Category = "Branch", Zones = { "Branch" },
		Description = "Splits energy between two paths; both run.",
		Inputs = { flowIn() },
		Outputs = { flowOut("a", "A"), flowOut("b", "B") },
		Params = { { Name = "Share", Label = "Share to A", Type = "number", Default = 50, Min = 5, Max = 95, Step = 5, Suffix = "%" } },
	},

	-- Transform -----------------------------------------------------------------
	{
		Id = "Fire", Name = "Fire", Category = "Transform", Zones = { "Transform" }, Element = "Fire",
		Description = "80% of energy on impact, plus a burn worth 35% over 3s.",
		Inputs = { flowIn() }, Outputs = { flowOut() }, Params = {},
	},
	{
		Id = "Arcane", Name = "Arcane", Category = "Transform", Zones = { "Transform" }, Element = "Arcane",
		Description = "All energy lands as impact damage.",
		Inputs = { flowIn() }, Outputs = { flowOut() }, Params = {},
	},
	{
		Id = "Shock", Name = "Shock", Category = "Transform", Zones = { "Transform" }, Element = "Shock",
		Description = "70% of energy on impact, and stuns 0.01s per energy (max 1s).",
		Inputs = { flowIn() }, Outputs = { flowOut() }, Params = {},
	},

	-- Modifiers -----------------------------------------------------------------
	{
		Id = "Speed", Name = "Speed", Category = "Modifier", Zones = { "Modifier" }, ModifierCost = 0.03,
		Description = "Faster flight (×1.3 to ×3.2), including Beam segments.",
		Inputs = {}, Outputs = { modOut() }, Params = { LEVEL },
	},
	{
		Id = "Size", Name = "Size", Category = "Modifier", Zones = { "Modifier" }, ModifierCost = 0.04,
		Description = "Bigger hitbox and visual (×1.4 to ×3.6); a wider Beam.",
		Inputs = {}, Outputs = { modOut() }, Params = { LEVEL },
	},
	{
		Id = "Gravity", Name = "Gravity", Category = "Modifier", Zones = { "Modifier" }, ModifierCost = 0.01,
		Description = "Arcing flight, including Beam segments.",
		Inputs = {}, Outputs = { modOut() }, Params = { LEVEL },
	},
	{
		Id = "Bounce", Name = "Bounce", Category = "Modifier", Zones = { "Modifier" }, ModifierCost = 0.05,
		Description = "Ricochets off walls Level times. Beams reflect too.",
		Inputs = {}, Outputs = { modOut() }, Params = { LEVEL },
	},
	{
		Id = "Pierce", Name = "Pierce", Category = "Modifier", Zones = { "Modifier" }, ModifierCost = 0.06,
		Description = "Passes through Level enemies (15% less damage each).",
		Inputs = {}, Outputs = { modOut() }, Params = { LEVEL },
	},
	{
		Id = "Quantity", Name = "Quantity", Category = "Modifier", Zones = { "Modifier" },
		Description = "Fires Count copies that share the energy: a Fan across Spread degrees, a Ring around the aim, or a Stream one after another.",
		Inputs = {}, Outputs = { modOut() },
		Params = {
			{ Name = "Count", Label = "Count", Type = "number", Default = 3, Min = 1, Max = 12, Step = 1 },
			{ Name = "Pattern", Label = "Pattern", Type = "enum", Default = "Fan", Options = { "Fan", "Ring", "Stream" } },
			{ Name = "Spread", Label = "Spread", Type = "number", Default = 20, Min = 0, Max = 120, Step = 1, Suffix = "°" },
			{ Name = "Interval", Label = "Stream gap", Type = "number", Default = 0.08, Min = 0.03, Max = 0.5, Step = 0.01, Suffix = "s" },
		},
	},
	{
		Id = "Homing", Name = "Homing", Category = "Modifier", Zones = { "Modifier" }, ModifierCost = 0.06,
		Description = "Seeks targets. Wire an entity into Lock on to chase that one; otherwise it finds its own. Beams steer in flight too.",
		Inputs = { { Name = "entity", Type = "entity", Label = "Lock on", Optional = true } },
		Outputs = { modOut() },
		Params = { LEVEL, { Name = "Filter", Label = "Seek", Type = "enum", Default = "Enemy", Options = FILTERS } },
	},
	{
		Id = "Range", Name = "Range", Category = "Modifier", Zones = { "Modifier" }, ModifierCost = 0.03,
		Description = "Longer flight time (×1.3 to ×3.5).",
		Inputs = {}, Outputs = { modOut() }, Params = { LEVEL },
	},
	{
		Id = "Sustain", Name = "Sustain", Category = "Modifier", Zones = { "Modifier" }, ModifierCost = 0.04,
		Description = "Beam only: hold to channel for up to 1–5 seconds; release to stop. Follows live aim. Energy is shared across the maximum duration; segments keep all flight modifiers and triggers.",
		Inputs = {}, Outputs = { modOut() }, Params = { LEVEL },
	},

	-- Vessels (the form the magic takes) ---------------------------------------
	vesselDef("Orb", "Orb", "A slow, heavy sphere of magic with a big hitbox. Flies at your mouse unless something is wired into Aim."),
	vesselDef("Bullet", "Bullet", "A fast, thin tracer. Flies at your mouse unless something is wired into Aim."),
	vesselDef("Beam", "Beam", "A cylinder of magic traveling at 2000 studs/s. Supports all flight modifiers and triggers; Sustain emits a continuous cursor-following beam."),
	{
		Id = "Explosion", Name = "Explosion", Category = "Vessel", Zones = { "Output" }, Vessel = true, Instant = true,
		Description = "Bursts on the spot, hitting everything within 8 studs (Size widens it): full damage at the centre, half at the edge. Fed by On Impact it goes off at the impact point; cast directly it goes off at At, or your mouse. Only Size applies.",
		Inputs = {
			flowIn(),
			{ Name = "mods", Type = "mod", Label = "Modifiers", Optional = true, Multi = true },
			{ Name = "aim", Type = "point", Label = "At", Optional = true },
		},
		Outputs = {},
		Params = {},
	},

	-- Triggers ------------------------------------------------------------------
	{
		Id = "OnImpact", Name = "On Impact", Category = "Trigger", Zones = { "Trigger" },
		Description = "When the vessel stops on a wall or enemy, releases Share of its energy from the impact point. What it fires ricochets unless aimed.",
		Inputs = { vesselIn() }, Outputs = { flowOut() }, Params = { SHARE },
	},
	{
		Id = "OnExpire", Name = "On Expire", Category = "Trigger", Zones = { "Trigger" },
		Description = "When the vessel runs out of range without hitting anything, releases Share of its energy there.",
		Inputs = { vesselIn() }, Outputs = { flowOut() }, Params = { SHARE },
	},
	{
		Id = "OnTimer", Name = "On Timer", Category = "Trigger", Zones = { "Trigger" },
		Description = "After Delay seconds of flight, releases Share of the energy. Detonate ends the vessel.",
		Inputs = { vesselIn() }, Outputs = { flowOut() },
		Params = {
			{ Name = "Delay", Label = "Delay", Type = "number", Default = 0.5, Min = 0.1, Max = 5, Step = 0.1, Suffix = "s" },
			SHARE,
			{ Name = "Detonate", Label = "Detonate", Type = "bool", Default = false },
		},
	},
	{
		Id = "OnProximity", Name = "On Proximity", Category = "Trigger", Zones = { "Trigger" },
		Description = "When an entity comes within Radius of the vessel, releases Share of the energy. Struck Entity is that entity; what it fires aims at it.",
		Inputs = { vesselIn() }, Outputs = { flowOut() },
		Params = {
			{ Name = "Radius", Label = "Radius", Type = "number", Default = 8, Min = 2, Max = 40, Step = 1, Suffix = " st" },
			{ Name = "Filter", Label = "Only", Type = "enum", Default = "Enemy", Options = FILTERS },
			SHARE,
			{ Name = "Detonate", Label = "Detonate", Type = "bool", Default = true },
		},
	},
}

SpellRunes.Categories = { "Input", "Targeting", "Sensor", "Logic", "Branch", "Transform", "Modifier", "Vessel", "Trigger" }
SpellRunes.Order = {} :: { string }
SpellRunes.Runes = {} :: { [string]: RuneDef }
for _, def in defs do
	SpellRunes.Runes[def.Id] = def
	table.insert(SpellRunes.Order, def.Id)
end

-- Per-level numbers used by the runtime (and the editor's estimates). Speed,
-- Size and Range multiply the vessel's base stats below.
SpellRunes.ModifierTables = {
	Speed = { 1.3, 1.6, 2.0, 2.5, 3.2 },
	Size = { 1.4, 1.8, 2.3, 2.9, 3.6 },
	Range = { 1.3, 1.7, 2.2, 2.8, 3.5 },
	Gravity = { 20, 40, 70, 110, 160 },
	HomingRadius = { 30, 45, 60, 80, 100 },
	HomingTurn = { 75, 105, 140, 180, 230 }, -- degrees/s
	Sustain = { 1, 2, 3, 4, 5 }, -- caster-dilated seconds
}

-- Base stats per vessel. Radius is the hitbox (a Beam's is half its width),
-- Scale the visual size multiplier, Impact multiplies element impact damage.
SpellRunes.Vessels = {
	Orb = { Speed = 85, Radius = 0.7, Lifetime = 4, Scale = 1, Impact = 1.0 },
	Bullet = { Speed = 300, Radius = 0.15, Lifetime = 2, Scale = 1, Impact = 0.9 },
	Beam = { Speed = 2000, Lifetime = 3, Radius = 0.35, Scale = 1, Impact = 0.8 },
	-- Radius is the blast radius; MaxCastRange keeps a cast-time blast near you.
	Explosion = { Radius = 8, Impact = 0.9, MaxCastRange = 80 },
}

-- Energy fraction a modifier consumes. Quantity costs per extra copy.
function SpellRunes.ModifierCost(runeId: string, params: { [string]: any }): number
	if runeId == "Quantity" then
		return 0.02 * (params.Count - 1)
	end
	local def = SpellRunes.Runes[runeId]
	return (def and def.ModifierCost or 0) * (params.Level or 0)
end

-- Beams use the same flight pipeline as Orb/Bullet. Sustain is Beam-only.

function SpellRunes.ModifierApplies(vesselId: string, modifierId: string): boolean
	if modifierId == "Sustain" then return vesselId == "Beam" end
	if vesselId == "Explosion" then
		return modifierId == "Size"
	end
	return true
end

function SpellRunes.TriggerApplies(vesselId: string, triggerId: string): boolean
	return vesselId ~= "Explosion"
end
SpellRunes.MaxModifierCost = 0.85
SpellRunes.MaxTriggerShare = 0.9

function SpellRunes.Get(id: string): RuneDef?
	return SpellRunes.Runes[id]
end

function SpellRunes.FindPort(ports: { PortDef }, name: string): PortDef?
	for _, port in ports do
		if port.Name == name then
			return port
		end
	end
	return nil
end

-- Default params for a freshly placed rune.
function SpellRunes.DefaultParams(id: string): { [string]: any }
	local params = {}
	local def = SpellRunes.Runes[id]
	if def then
		for _, param in def.Params do
			params[param.Name] = param.Default
		end
	end
	return params
end

return SpellRunes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">StatusEffectSys</string>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	StatusEffectSys.luau
	A duration/stack-based status effect system for Entity.luau entities (buffs,
	debuffs, DoTs/HoTs, anything with a timer and an optional stack count).
	Effect *behavior* is defined once via Register(); ApplyEffect/RemoveEffect
	then just reference it by name, matching how Entity's tags work.

	Time model: ticking (duration countdown + OnTick) rides the same per-entity
	dilated dt as entity:OnUpdate -- already scaled by global * chunk * the
	entity's own TimeScale -- so a Poison stack burns slower inside a slow-mo
	zone for free, same as everything else in this framework.

	Stacking: one active instance per (entity, effect name). Reapplying an
	already-active effect does NOT reset it -- the new duration is ADDED to
	whatever time remains, and the new potency is added to the current stack
	count (capped at the definition's MaxStacks, default unlimited). An effect
	ends the moment either Duration or Potency reaches 0 (whichever first).

	API:
	 StatusEffectSys.Register(name, definition: EffectDefinition)
	 StatusEffectSys:ApplyEffect(entity, name, duration, potency?) -> ActiveEffect?
	 StatusEffectSys:RemoveEffect(entity, name, duration?, potency?)
	   -- duration/potency each: a number subtracts that much from the
	   -- respective field; omitted (nil) leaves that field untouched. Omitting
	   -- BOTH is a shorthand for removing the effect entirely right now. So
	   -- RemoveEffect(entity, "Poison") removes it outright; RemoveEffect(
	   -- entity, "Poison", nil, 2) strips 2 stacks and leaves the remaining
	   -- duration alone; RemoveEffect(entity, "Poison", 3) shaves 3 seconds off
	   -- the remaining duration and leaves stacks alone.
	 StatusEffectSys:HasEffect(entity, name) -> boolean
	 StatusEffectSys:GetEffect(entity, name) -> ActiveEffect?
	 StatusEffectSys:GetEffects(entity) -> { ActiveEffect }

	 EffectDefinition (all optional except nothing is required):
	   OnApply(entity, effect)                 -- fires once: 0 -> active
	   OnStack(entity, effect, addedDuration, addedPotency) -- fires on every
	                                            -- reapplication while already active
	   OnTick(entity, effect, dt)               -- fires every TickInterval
	                                            -- dilated seconds while active
	   OnExpire(entity, effect)                 -- fires once the effect ends,
	                                            -- however it ended (natural
	                                            -- countdown, RemoveEffect, or
	                                            -- the entity being destroyed)
	   TickInterval: number?                    -- omitted/0 = OnTick never fires
	   MaxStacks: number?                       -- default unlimited

	 ActiveEffect (returned by ApplyEffect/GetEffect, read freely -- e.g. for a
	 debuff timer UI): { Name, Definition, Duration, Potency }
]]

local StatusEffectSys = {}

export type EffectDefinition = {
	OnApply: ((entity: any, effect: any) -> ())?,
	OnStack: ((entity: any, effect: any, addedDuration: number, addedPotency: number) -> ())?,
	OnTick: ((entity: any, effect: any, dt: number) -> ())?,
	OnExpire: ((entity: any, effect: any) -> ())?,
	TickInterval: number?,
	MaxStacks: number?,
}

local definitions: { [string]: EffectDefinition } = {}
local activeEffects: { [any]: { [string]: any } } = {} -- [entity] = { [name] = ActiveEffect }
local hasDriver: { [any]: boolean } = {} -- [entity] = true once its OnUpdate driver is wired up

--------------------------------------------------------------------------------
-- Registration
--------------------------------------------------------------------------------

function StatusEffectSys.Register(name: string, definition: EffectDefinition)
	definitions[name] = definition
end

--------------------------------------------------------------------------------
-- Internals
--------------------------------------------------------------------------------

local function expireEffect(entity, name: string, effect)
	local effects = activeEffects[entity]
	if effects then
		effects[name] = nil
	end
	local onExpire = effect.Definition.OnExpire
	if onExpire then
		onExpire(entity, effect)
	end
end

-- Lazily wires one entity:OnUpdate driver per entity (reusing Entity's existing
-- dilated-time loop instead of a second Heartbeat connection) plus a Destroyed
-- hook so activeEffects never leaks an entry for a dead entity.
local function ensureDriver(entity)
	if hasDriver[entity] then
		return
	end
	hasDriver[entity] = true
	activeEffects[entity] = activeEffects[entity] or {}

	entity:OnUpdate(function(dt: number)
		local effects = activeEffects[entity]
		if not effects then
			return
		end
		for name, effect in effects do
			local elapsed = math.min(dt, math.max(effect.Duration, 0))
			effect.Duration -= dt

			local interval = effect.Definition.TickInterval
			if interval and interval > 0 then
				effect._tickAccumulator += elapsed
				if effect._tickAccumulator >= interval or (effect.Duration <= 0 and effect._tickAccumulator > 0) then
					-- Coalesce elapsed ticks into one callback, including the final
					-- partial tick. Lag must not silently discard burn damage/time.
					local tickElapsed = effect._tickAccumulator
					effect._tickAccumulator = 0
					local onTick = effect.Definition.OnTick
					if onTick then
						onTick(entity, effect, tickElapsed)
					end
				end
			end

			if effects[name] == effect and (effect.Duration <= 0 or effect.Potency <= 0) then
				expireEffect(entity, name, effect)
			end
		end
	end)

	entity.Destroyed:Connect(function()
		local effects = activeEffects[entity]
		if effects then
			for name, effect in effects do
				expireEffect(entity, name, effect)
			end
		end
		activeEffects[entity] = nil
		hasDriver[entity] = nil
	end)
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------

function StatusEffectSys:ApplyEffect(entity, name: string, duration: number, potency: number?)
	-- Non-finite timers would leave a status active forever.
	if entity.IsDestroyed or typeof(duration) ~= "number" or duration ~= duration
		or duration <= 0 or duration == math.huge then return nil end
	if potency ~= nil and (typeof(potency) ~= "number" or potency ~= potency
		or potency <= 0 or potency == math.huge) then return nil end
	local definition = definitions[name]
	if not definition then
		warn(`[StatusEffectSys] "{name}" is not registered -- call StatusEffectSys.Register() first`)
		return nil
	end
	potency = potency or 1

	ensureDriver(entity)
	local effects = activeEffects[entity]
	local effect = effects[name]
	local maxStacks = definition.MaxStacks or math.huge

	if effect then
		effect.Duration += duration
		local before = effect.Potency
		effect.Potency = math.min(effect.Potency + potency, maxStacks)
		local onStack = definition.OnStack
		if onStack then
			onStack(entity, effect, duration, effect.Potency - before)
		end
	else
		effect = {
			Name = name,
			Definition = definition,
			Duration = duration,
			Potency = math.min(potency, maxStacks),
			_tickAccumulator = 0,
		}
		effects[name] = effect
		local onApply = definition.OnApply
		if onApply then
			onApply(entity, effect)
		end
	end

	return effect
end

function StatusEffectSys:RemoveEffect(entity, name: string, duration: number?, potency: number?)
	local effects = activeEffects[entity]
	local effect = effects and effects[name]
	if not effect then
		return
	end

	-- Neither amount given: shorthand for "remove it entirely, right now."
	if duration == nil and potency == nil then
		expireEffect(entity, name, effect)
		return
	end

	if duration then
		effect.Duration -= duration
	end
	if potency then
		effect.Potency -= potency
	end

	if effect.Duration <= 0 or effect.Potency <= 0 then
		expireEffect(entity, name, effect)
	end
end

function StatusEffectSys:HasEffect(entity, name: string): boolean
	local effects = activeEffects[entity]
	return effects ~= nil and effects[name] ~= nil
end

function StatusEffectSys:GetEffect(entity, name: string)
	local effects = activeEffects[entity]
	return effects and effects[name]
end

function StatusEffectSys:GetEffects(entity)
	local effects = activeEffects[entity]
	if not effects then
		return {}
	end
	local result = {}
	for _, effect in effects do
		table.insert(result, effect)
	end
	return result
end

return StatusEffectSys
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">VisualOffload</string>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	VisualOffload.luau
	A thin publish/subscribe layer over a single RemoteEvent. The server stays
	authoritative over simulation but offloads *cosmetic* work to clients:
	 - ChunkManager mirrors chunk + global time scales so client-side visual
	   simulation dilates identically to the server.
	 - Projectile streams spawn/hit events so clients render tracers instead of
	   the server replicating a moving part per bullet.

	Messages are addressed by a string channel. Handlers registered with :On
	fire for every message on that channel.

	API:
	 VisualOffload.Fire(channel, payload)            -- server -> all clients (or client -> server)
	 VisualOffload.FireClient(player, channel, payload)   -- server only
	 VisualOffload.On(channel, handler) -> { Disconnect }
	     server handler: handler(payload, player)
	     client handler: handler(payload)
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local REMOTE_NAME = "VisualOffloadRemote"

local VisualOffload = {}

local handlers: { [string]: { (any, any?) -> () } } = {}
local remote: RemoteEvent? = nil
local listening = false

local function getRemote(): RemoteEvent
	if remote then
		return remote
	end
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
		if existing and existing:IsA("RemoteEvent") then
			remote = existing
		else
			local created = Instance.new("RemoteEvent")
			created.Name = REMOTE_NAME
			created.Parent = ReplicatedStorage
			remote = created
		end
	else
		remote = ReplicatedStorage:WaitForChild(REMOTE_NAME) :: RemoteEvent
	end
	return remote :: RemoteEvent
end

local function dispatch(channel: string, payload: any, player: Player?)
	local list = handlers[channel]
	if not list then
		return
	end
	for _, fn in list do
		task.spawn(fn, payload, player)
	end
end

local function ensureListening()
	if listening then
		return
	end
	listening = true
	local r = getRemote()
	if RunService:IsServer() then
		r.OnServerEvent:Connect(function(player, channel, payload)
			if typeof(channel) == "string" then
				dispatch(channel, payload, player)
			end
		end)
	else
		r.OnClientEvent:Connect(function(channel, payload)
			if typeof(channel) == "string" then
				dispatch(channel, payload)
			end
		end)
	end
end

function VisualOffload.Fire(channel: string, payload: any?)
	
	local r = getRemote()
	if RunService:IsServer() then
		r:FireAllClients(channel, payload)
	else
		r:FireServer(channel, payload)
	end
end

function VisualOffload.FireClient(player: Player, channel: string, payload: any?)
	assert(RunService:IsServer(), "VisualOffload.FireClient is server-only")
	getRemote():FireClient(player, channel, payload)
end

function VisualOffload.On(channel: string, handler: (any, any?) -> ())
	ensureListening()
	local list = handlers[channel]
	if not list then
		list = {}
		handlers[channel] = list
	end
	table.insert(list, handler)
	return {
		Disconnect = function()
			local index = table.find(list, handler)
			if index then
				table.remove(list, index)
			end
		end,
	}
end

return VisualOffload
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="41">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="42">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">BeamProjectileHandler</string>
          <string name="Source"><![CDATA[--!strict
-- Continuous beams are ordered chains of REAL projectile beamlets. Every
-- section owns its collision, energy and impact/expiry handlers; rendering
-- receives the same authoritative endpoints that collision used.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Heartbeat = require(Shared.Heartbeat)
local ChunkManager = require(Shared.ChunkManager)
local Projectile = require(script.Parent.Projectile)
local BeamPath = require(Shared.BeamPath)

local Handler = {}
Handler.Interval = 1 / 30
Handler.MaxJoinersPerBeam = 512
Handler.MaxNewJoinersPerFrame = 128
function Handler.GetInterval(speed: number): number
	return math.max(1 / 60, math.min(Handler.Interval, (BeamPath.MaxStretch - 2) / math.max(speed, 1)))
end
local INPUT_TIMEOUT = .75
local MAX_PACKETS_PER_CHANNEL_FRAME = 2
local MAX_CHANNELS_PER_PLAYER = 32
local channels: { any } = {}
local lastInput: { [Player]: number } = {}
local nextChannelId = 0
local streams: { [number]: any } = {}
local streamOrder: { number } = {}
local streamCursor = 1
local lastJoinerStats = { Created = 0, Updated = 0, BudgetSplits = 0 }
local breakReasons = { Geometry = 0, ChannelBudget = 0, FrameBudget = 0, Quota = 0 }

local function nodeFor(p: any, previous: any): any
	p._beamPrevious = previous and previous.projectile
	if p.Beam then p.Beam.PreviousId = previous and previous.projectile.Id end
	return { projectile = p, previous = previous, everLinked = false,
		tail = {p.Position}, tailTurns = #(p._beamTurns or {}) }
end

-- Break ONLY this link. Surviving siblings keep their identities, motion and
-- triggers. A disconnected section keeps a finite body, never an immortal dot
-- or a resurrected old trajectory spur.
local function unlink(node: any)
	local p = node.projectile
	local path = p._beamSpan
	local offset = path and path[2] and path[2]-path[1]
	if not offset or offset.Magnitude < 1e-4 then
		offset = if p.Velocity.Magnitude > 1e-4 then p.Velocity.Unit * math.min(p.Beam.Length, BeamPath.MaxStretch) else nil
	end
	if offset and offset.Magnitude > BeamPath.MaxStretch then offset = offset.Unit * BeamPath.MaxStretch end
	node.fragment = offset
	node.previous, node.everLinked = nil, true
	p:ClearBeamPrevious()
end

local function initialPath(node: any): { Vector3 }
	local p = node.projectile
	if node.incoming then return { p.Position } end
	if node.fragment then return { p.Position, p.Position + node.fragment } end
	if node.everLinked then
		if p.Velocity.Magnitude > 1e-4 then
			return { p.Position, p.Position + p.Velocity.Unit * math.min(p.Beam.Length, BeamPath.MaxStretch) }
		end
		return { p.Position }
	end
	local tail = node.tail
	for index = node.tailTurns + 1, #(p._beamTurns or {}) do table.insert(tail, p._beamTurns[index]) end
	node.tailTurns = #(p._beamTurns or {})
	if (tail[#tail]-p.Position).Magnitude > 1e-4 then table.insert(tail, p.Position) end
	local length, cap = 0, math.min(p.Beam.Length, BeamPath.MaxStretch)
	for index = #tail, 2, -1 do
		local span = (tail[index]-tail[index-1]).Magnitude
		if length + span > cap then
			tail[index-1] = tail[index]:Lerp(tail[index-1], (cap-length)/span)
			for _ = 1, index-2 do table.remove(tail, 1) end
			break
		end
		length += span
	end
	while #tail > 9 do table.remove(tail, 1) end
	local reverse = {}
	for index = #tail, 1, -1 do table.insert(reverse, tail[index]) end
	return reverse
end

function Handler.Launch(config: any): any
	local beamConfig = table.clone(config)
	beamConfig.Beam = table.clone(config.Beam or {})
	local id = beamConfig.Beam.ChannelId
	local stream = id and streams[id]
	if id and not stream then
		stream = { nodes = {}, last = nil, joinerCount = 0 }
		streams[id] = stream
		table.insert(streamOrder, id)
	end
	local previous = stream and stream.last
	if previous and previous.projectile.Dead then previous = nil end
	if previous then beamConfig.Beam.PreviousId = previous.projectile.Id end
	local p = Projectile.new(beamConfig)
	if stream then
		local node = nodeFor(p, previous)
		table.insert(stream.nodes, node)
		stream.last = node
	end
	return p
end

local function resolve(node: any, points: { Vector3 }, dt: number)
	local p = node.projectile
	p._beamSpan = p:ResolveBeamSpan(points, dt > 0)
end

Projectile.SetBeamSpanStep(function(globalDt: number)
	local created, updated, budgetSplits = 0, 0, 0
	local orderCount = #streamOrder
	if orderCount == 0 then
		lastJoinerStats = { Created = 0, Updated = 0, BudgetSplits = 0 }
		return
	end
	for offset = 0, orderCount - 1 do
		local id = streamOrder[(streamCursor + offset - 1) % orderCount + 1]
		local stream = streams[id]
		if not stream then continue end
		local live, count = {}, 0
		for _, node in stream.nodes do
			node.incoming = false
			if not node.projectile.Dead then
				table.insert(live, node)
				if node.projectile._beamJoiner then count += 1; updated += 1 end
			end
		end
		if #live == 0 then streams[id] = nil; continue end
		stream.nodes, stream.joinerCount = live, count
		for _, node in live do
			if node.previous and not node.previous.projectile.Dead then node.previous.incoming = true end
		end
		local originalCount = #live
		for index = 1, originalCount do
			local node = live[index]
			local p, previous = node.projectile, node.previous
			if p.Dead then continue end
			if previous and previous.projectile.Dead and not previous.projectile._beamJoinerWorldStop then
				unlink(node); previous = nil
			end
			if not previous then resolve(node, initialPath(node), globalDt); continue end
			local front = previous.projectile
			local corners, needed = BeamPath.Plan(p.Position, front.Position, p._beamTurns, front._beamTurns)
			local reason = if not corners then "Geometry"
				elseif stream.joinerCount + needed > Handler.MaxJoinersPerBeam then "ChannelBudget"
				elseif created + needed > Handler.MaxNewJoinersPerFrame then "FrameBudget"
				elseif needed > 0 and p._beamReserveChildren and not p._beamReserveChildren(needed) then "Quota"
				else nil
			if reason then
				breakReasons[reason] += 1
				budgetSplits += 1
				unlink(node)
				resolve(node, initialPath(node), globalDt)
				continue
			end
			-- Refine EVERY adjacent link every frame, including child-to-child
			-- links. New children enter the ordinary simulation once next frame;
			-- their bodies can collide immediately at their insertion positions.
			local chain = {node}
			local behind, ahead = p._beamTurns or {}, front._beamTurns or {}
			for leg = 1, #corners-1 do
				local from, to = corners[leg], corners[leg+1]
				local pieces = math.max(1, math.ceil((to-from).Magnitude / BeamPath.MaxStretch))
				local phase = math.min(#behind+leg-1, #ahead)
				for piece = 1, pieces-1 do
					local t = piece/pieces
					local prototype = if phase == #ahead then front else p
					local velocity = if #behind == #ahead then p.Velocity:Lerp(front.Velocity,t)
						elseif phase == #behind then p.Velocity
						elseif phase == #ahead then front.Velocity
						else (to-from).Unit * p.Velocity.Magnitude * p.Restitution^(phase-#behind)
					local turns = {}
					for turn = 1, phase do turns[turn] = ahead[turn] end
					local child = Projectile.CreateBeamSample(prototype, from:Lerp(to,t), velocity, turns)
					child.Age = p.Age + (front.Age-p.Age)*t
					-- Spell callbacks are bound synchronously, before any hit.
					child.Damage = p.Damage / (needed+1)
					if p._beamBindChild then p._beamBindChild(child, 1/(needed+1)) end
					local childNode = nodeFor(child, nil)
					childNode.everLinked = true
					table.insert(chain, childNode)
					table.insert(live, childNode)
				end
			end
			if needed > 0 then
				if p._beamScaleEnergy then p._beamScaleEnergy(1/(needed+1))
				else p.Damage /= needed+1 end
			end
			table.insert(chain, previous)
			for link = 1, #chain-1 do
				local back, aheadNode = chain[link], chain[link+1]
				back.previous, back.everLinked = aheadNode, true
				aheadNode.everLinked, aheadNode.incoming = true, true
				local bp, fp = back.projectile, aheadNode.projectile
				bp._beamPrevious, bp.Beam.PreviousId = fp, fp.Id
				local path = BeamPath.Connect(bp.Position, fp.Position, bp._beamTurns, fp._beamTurns)
				if path then resolve(back, path, globalDt)
				else unlink(back); resolve(back, initialPath(back), globalDt) end
				if link > 1 then Projectile.PublishBeamSample(bp) end
			end
			-- The front's incoming section is its geometry, not a private tail.
			-- Do not wipe a stopped front's already-clipped impact snapshot.
			if not front.Dead and not previous.previous then front._beamSpan = { front.Position } end
			stream.joinerCount += needed
			created += needed
		end
	end
	streamCursor = streamCursor % orderCount + 1
	local liveOrder = {}
	for offset = 0, orderCount - 1 do
		local id = streamOrder[(streamCursor + offset - 1) % orderCount + 1]
		if streams[id] then table.insert(liveOrder, id) end
	end
	for index = orderCount + 1, #streamOrder do
		local id = streamOrder[index]
		if streams[id] then table.insert(liveOrder, id) end
	end
	streamOrder, streamCursor = liveOrder, 1
	lastJoinerStats = { Created = created, Updated = updated, BudgetSplits = budgetSplits }
end)

function Handler.GetJoinerStats()
	local count = 0
	for _, stream in streams do
		for _, node in stream.nodes do
			if node.projectile._beamJoiner and not node.projectile.Dead then count += 1 end
		end
	end
	return { Active = count, Created = lastJoinerStats.Created, Updated = lastJoinerStats.Updated,
		BudgetSplits = lastJoinerStats.BudgetSplits, MaxPerBeam = Handler.MaxJoinersPerBeam,
		MaxNewPerFrame = Handler.MaxNewJoinersPerFrame, BreakReasons = table.clone(breakReasons) }
end

function Handler.IsActive(player: Player): boolean
	for _, channel in channels do if channel.Player == player then return true end end
	return false
end

function Handler.Stop(player: Player)
	for index = #channels, 1, -1 do
		if channels[index].Player == player then table.remove(channels, index) end
	end
	lastInput[player] = nil
end

-- KeepAlive cannot begin a cast or modify its duration/stats. Only the
-- server's validated SpellCast path can call Start.
function Handler.KeepAlive(player: Player)
	if lastInput[player] then lastInput[player] = os.clock() end
end

function Handler.BeginCast(player: Player)
	lastInput[player] = os.clock()
end

function Handler.Start(options: any): boolean
	if not lastInput[options.Player] or os.clock() - lastInput[options.Player] > INPUT_TIMEOUT then return false end
	local count = 0
	for _, channel in channels do if channel.Player == options.Player then count += 1 end end
	if count >= MAX_CHANNELS_PER_PLAYER then return false end
	local channel = table.clone(options)
	nextChannelId += 1
	channel.Id = nextChannelId
	channel.Interval = Handler.GetInterval(options.Speed or 2000)
	channel.Remaining = options.Duration
	channel.NextEmit = options.Delay or 0
	channel.Started = os.clock()
	if channel.NextEmit == 0 then
		local slice = math.min(channel.Interval, channel.Remaining)
		channel.Emit(slice / options.Duration, channel.Id)
		channel.Remaining -= slice
		channel.NextEmit = channel.Interval
	end
	table.insert(channels, channel)
	return true
end

Heartbeat.Connect(function(globalDt: number)
	local now = os.clock()
	for index = #channels, 1, -1 do
		local channel = channels[index]
		local player, character = channel.Player, channel.Character
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local tool = character:FindFirstChild("SpellAssembler")
		if channel.Remaining <= 1e-8 or not player.Parent or player.Character ~= character
			or not humanoid or humanoid.Health <= 0 or not tool or not tool:IsA("Tool")
			or now - (lastInput[player] or 0) > INPUT_TIMEOUT or now - channel.Started >= 60 then
			table.remove(channels, index)
			continue
		end
		local caster = channel.Caster
		if caster and (caster.IsDestroyed or caster.Health <= 0) then
			table.remove(channels, index)
			continue
		end
		local scale = ChunkManager.GetTimeScaleAt(channel.Origin()) * (caster and caster.TimeScale or 1)
		if scale <= 0 then continue end
		channel.NextEmit -= globalDt * scale
		local emitted = 0
		while channel.NextEmit <= 0 and channel.Remaining > 1e-8 and emitted < MAX_PACKETS_PER_CHANNEL_FRAME do
			local slice = math.min(channel.Interval, channel.Remaining)
			channel.Emit(slice / channel.Duration, channel.Id)
			channel.Remaining -= slice
			channel.NextEmit += channel.Interval
			emitted += 1
		end
	end
end, { Name = "BeamProjectileHandler.Channel", Priority = 4 })

Players.PlayerRemoving:Connect(Handler.Stop)
return Handler
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="44">
        <Properties>
          <string name="Name">DilationBubbleTest</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!optimize 2
-- Studio-only configurable time-dilation bubble tool and authoritative zones.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPack = game:GetService("StarterPack")

if not RunService:IsStudio() then
	return
end

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChunkManager = require(Shared.ChunkManager)
local VisualOffload = require(Shared.VisualOffload)

local TOOL_NAME = "DilationBubble"
local MAX_PLACEMENT_DISTANCE = 512
local MAX_BUBBLES_PER_PLAYER = 8
local CREATE_COOLDOWN = 0.15

local nextBubbleId = 0
local lastCreate: { [Player]: number } = {}
local bubblesByPlayer: { [Player]: { any } } = {}

local zoneFolder = workspace:FindFirstChild("DilationTestZones") or Instance.new("Folder")
zoneFolder.Name = "DilationTestZones"
zoneFolder.Parent = workspace

local function makeTool(): Tool
	local existing = StarterPack:FindFirstChild(TOOL_NAME)
	if existing and existing:IsA("Tool") then
		return existing
	end
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.ToolTip = "Create a configurable time-dilation test zone"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Parent = StarterPack
	return tool
end

local toolTemplate = makeTool()

local function ensureTool(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if not backpack then
		return
	end
	local character = player.Character
	if backpack:FindFirstChild(TOOL_NAME) or (character and character:FindFirstChild(TOOL_NAME)) then
		return
	end
	toolTemplate:Clone().Parent = backpack
end

local function watchPlayer(player: Player)
	task.defer(ensureTool, player)
	player.CharacterAdded:Connect(function()
		task.defer(ensureTool, player)
	end)
end

for _, player in Players:GetPlayers() do
	watchPlayer(player)
end
Players.PlayerAdded:Connect(watchPlayer)

local function removeBubble(bubble)
	if bubble.Removed then
		return
	end
	bubble.Removed = true
	if bubble.Visual then
		bubble.Visual:Destroy()
	end
	ChunkManager.RemoveTimeScaleZone(bubble.Id)

	local owned = bubblesByPlayer[bubble.Owner]
	if owned then
		local index = table.find(owned, bubble)
		if index then
			table.remove(owned, index)
		end
		if #owned == 0 then
			bubblesByPlayer[bubble.Owner] = nil
		end
	end
end

local function zoneColor(scale: number): Color3
	if scale == 0 then
		return Color3.fromRGB(165, 90, 255)
	elseif scale < 1 then
		return Color3.fromRGB(70, 170, 255)
	elseif scale > 1 then
		return Color3.fromRGB(255, 145, 55)
	end
	return Color3.fromRGB(125, 235, 150)
end

local function makeZoneVisual(position: Vector3, radius: number, scale: number, duration: number): BasePart
	local sphere = Instance.new("Part")
	sphere.Name = "DilationBubble"
	sphere.Shape = Enum.PartType.Ball
	sphere.Size = Vector3.one * radius * 2
	sphere.CFrame = CFrame.new(position)
	sphere.Anchored = true
	sphere.CanCollide = false
	sphere.CanQuery = false
	sphere.CanTouch = false
	sphere.CastShadow = false
	sphere.Material = Enum.Material.ForceField
	sphere.Color = zoneColor(scale)
	sphere.Transparency = 0.78
	sphere.Parent = zoneFolder

	local label = Instance.new("BillboardGui")
	label.Name = "Info"
	label.Size = UDim2.fromOffset(210, 48)
	label.StudsOffset = Vector3.new(0, radius + 3, 0)
	label.AlwaysOnTop = true
	label.Parent = sphere
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
	text.BackgroundTransparency = 0.2
	text.BorderSizePixel = 0
	text.Font = Enum.Font.GothamBold
	text.TextSize = 14
	text.TextColor3 = Color3.new(1, 1, 1)
	text.Text = string.format("Time x%.2f  |  radius %.0f\n%.1fs exact radial zone", scale, radius, duration)
	text.Parent = label
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 7)
	corner.Parent = text

	return sphere
end

local function finiteNumber(value: any, fallback: number, minimum: number, maximum: number): number
	if typeof(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return fallback
	end
	return math.clamp(value, minimum, maximum)
end

local function createBubble(player: Player, data)
	local character = player.Character
	local root = character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))
	local equipped = character and character:FindFirstChild(TOOL_NAME)
	if not root or not equipped or not equipped:IsA("Tool") then
		return
	end

	local position = data.Position
	if
		typeof(position) ~= "Vector3"
		or position.X ~= position.X
		or position.Y ~= position.Y
		or position.Z ~= position.Z
		or (position - root.Position).Magnitude > MAX_PLACEMENT_DISTANCE
	then
		return
	end

	local now = os.clock()
	if lastCreate[player] and now - lastCreate[player] < CREATE_COOLDOWN then
		return
	end
	lastCreate[player] = now

	local radius = finiteNumber(data.Radius, 64, 8, 256)
	local scale = finiteNumber(data.Scale, 0.25, 0, 3)
	local duration = finiteNumber(data.Duration, 8, 0.25, 30)
	nextBubbleId += 1
	local bubble = {
		Id = `DilationBubble:{nextBubbleId}`,
		Owner = player,
		Removed = false,
	}
	ChunkManager.AddTimeScaleZone(bubble.Id, position, radius, scale)

	bubble.Visual = makeZoneVisual(position, radius, scale, duration)
	local owned = bubblesByPlayer[player]
	if not owned then
		owned = {}
		bubblesByPlayer[player] = owned
	end
	table.insert(owned, bubble)
	if #owned > MAX_BUBBLES_PER_PLAYER then
		removeBubble(owned[1])
	end
	task.delay(duration, removeBubble, bubble)
end

VisualOffload.On("DilationBubbleTest", function(data, player)
	if not player or typeof(data) ~= "table" then
		return
	end
	if data.Action == "Clear" then
		local owned = bubblesByPlayer[player]
		if owned then
			for i = #owned, 1, -1 do
				removeBubble(owned[i])
			end
		end
	elseif data.Action == "Create" then
		createBubble(player, data)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	local owned = bubblesByPlayer[player]
	if owned then
		for i = #owned, 1, -1 do
			removeBubble(owned[i])
		end
	end
	lastCreate[player] = nil
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="45">
        <Properties>
          <string name="Name">DummyManager</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	DummyManager (server)
	Owns the Workspace "Dummy" NPC:
	 - registers it as an Entity (so bullets damage it and homing can find it),
	 - tags it "Enemy" (the shooter's homing locks onto this tag),
	 - respawns a fresh rig a few seconds after it dies.

	A pristine clone is taken at startup and used as the respawn template.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Entity = require(Shared.Entity)

local SPAWN_CFRAME = CFrame.new(24, 5, 24)
local RESPAWN_DELAY = 3
local MAX_HEALTH = 100

local template: Model? = nil
local spawnDummy -- forward declaration

local function registerDummy(model: Model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.MaxHealth = MAX_HEALTH
		humanoid.Health = MAX_HEALTH
	end

	local entity = Entity.new(model, {
		Team = "Undead",
		ScaleHumanoid = true, -- moves/reacts in dilated time inside slow chunks
	})
	entity:AddTag("Enemy") -- homing targets this tag

	entity.Died:Connect(function()
		local elapsed = 0
		local delayConnection
		delayConnection = entity:OnUpdate(function(dt)
			elapsed += dt
			if elapsed < RESPAWN_DELAY then
				return
			end
			delayConnection:Disconnect()
			if model.Parent then
				model:Destroy() -- clear the corpse
			end
			spawnDummy()
		end)
	end)

	return entity
end

function spawnDummy()
	if not template then
		return
	end
	local model = template:Clone()
	model.Name = "Dummy"
	model:PivotTo(SPAWN_CFRAME)
	model.Parent = workspace
	registerDummy(model)
end

local existing = workspace:WaitForChild("Dummy", 10)
if not existing or not existing:IsA("Model") then
	warn("[Relativity] DummyManager: no Dummy rig found in Workspace")
	return
end

-- keep a pristine copy for respawns, then start a fresh managed instance
template = existing:Clone()
existing:Destroy()
spawnDummy()

print("[Relativity] dummy manager online")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="46">
        <Properties>
          <string name="Name">DummySpawner</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!optimize 2
-- Authored Entity test dummies with a coalesced, server-owned damage display.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Entity = require(Shared.Entity)
local SafeMath = require(Shared.SafeMath)
local VisualOffload = require(Shared.VisualOffload)

-- Duplicate Studio Script instances must never install a second handler.
if Shared:GetAttribute("DummySpawnerRunning") then return end
Shared:SetAttribute("DummySpawnerRunning", true)

local folder = Instance.new("Folder")
folder.Name = "SpawnedTestDummies"
folder.Parent = workspace
local owned, lastCommand, counters = {}, {}, {}
local GOLD = Color3.fromRGB(235, 199, 150)
local BLUE = Color3.fromRGB(28, 56, 88)

local function round(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function text(parent, name, value, position, size, fontSize)
	local label = Instance.new("TextLabel")
	label.Name, label.Text = name, value
	label.Position, label.Size = position, size
	label.BackgroundTransparency = 1
	label.TextColor3 = GOLD
	label.Font = Enum.Font.GothamMedium
	label.TextSize = fontSize
	label.TextScaled = true
	label.Parent = parent
	return label
end

local function makeDisplay(model, root)
	local gui = Instance.new("BillboardGui")
	gui.Name = "DamageCounter"
	gui.Adornee = root
	-- Scale components of BillboardGui.Size are studs, so native projection
	-- makes this shrink with distance instead of keeping a large pixel panel.
	gui.Size = UDim2.fromScale(3.5, 2.53)
	gui.StudsOffset = Vector3.new(3.8, 0.5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 200
	gui.Parent = root
	local title = Instance.new("Frame")
	title.Name = "Title"
	title.Size = UDim2.fromScale(1, 20 / 112)
	title.BackgroundColor3 = BLUE
	title.BackgroundTransparency = 0.25
	title.BorderSizePixel = 0
	title.Parent = gui
	round(title, 6)
	text(title, "Name", "- " .. model.Name .. " -", UDim2.new(), UDim2.fromScale(1, 1), 12)
	local panel = Instance.new("Frame")
	panel.Name = "Stats"
	panel.Position = UDim2.fromScale(0, 24 / 112)
	panel.Size = UDim2.fromScale(1, 88 / 112)
	panel.BackgroundColor3 = BLUE
	panel.BackgroundTransparency = 0.2
	panel.BorderSizePixel = 0
	panel.Parent = gui
	round(panel, 7)
	text(panel, "Heart", "♥", UDim2.fromScale(8 / 155, 0), UDim2.fromScale(44 / 155, 45 / 88), 36)
	local hp = text(panel, "Health", "", UDim2.fromScale(54 / 155, 0), UDim2.fromScale(95 / 155, 45 / 88), 27)
	local damage = text(panel, "Damage", "", UDim2.fromScale(8 / 155, 48 / 88), UDim2.fromScale(139 / 155, 32 / 88), 12)
	local highlight = Instance.new("Highlight")
	highlight.Name = "TestDummyOutline"
	highlight.Adornee = model
	highlight.FillTransparency = 1
	highlight.OutlineColor = GOLD
	highlight.OutlineTransparency = 0.15
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	return hp, damage
end

local function clear(player)
	local list = owned[player]
	if list then
		for _, model in list do model:Destroy() end
		table.clear(list)
	end
end

local function resolveTemplate(tool)
	-- ObjectValue selects an arbitrary replicated Model; the attribute selects
	-- a direct child by name. Both choices are configured on the server Tool.
	local selection = tool:FindFirstChild("DummyModel")
	local template = if selection and selection:IsA("ObjectValue") then selection.Value
		else ReplicatedStorage:FindFirstChild(tool:GetAttribute("DummyModel") or "Dummy")
	if template and template:IsA("Model") and template:IsDescendantOf(ReplicatedStorage) then return template end
	warn("[DummySpawner] DummyModel must select a Model under ReplicatedStorage")
	return nil
end

local function spawn(player, tool, playerRoot, target)
	local template = resolveTemplate(tool)
	if not template then return end
	local model = template:Clone()
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if not humanoid or not root or not root:IsA("BasePart") then
		model:Destroy()
		warn("[DummySpawner] Template needs a Humanoid and root BasePart")
		return
	end
	-- Keep authored rig geometry/joints, but avoid template scripts installing
	-- their own spawners or damage systems.
	for _, instance in model:GetDescendants() do
		if instance:IsA("BaseScript") then instance:Destroy()
		elseif instance:IsA("BillboardGui") and instance.Name == "DamageCounter" then instance:Destroy() end
	end
	model.PrimaryPart = root
	humanoid.WalkSpeed = 0
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local health = SafeMath.number(tool:GetAttribute("DummyHealth"), humanoid.MaxHealth, 1, 1000000)
	humanoid.MaxHealth, humanoid.Health = health, health
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, folder }
	local ground = workspace:Raycast(target + Vector3.new(0, 20, 0), Vector3.new(0, -100, 0), params)
	if not ground then model:Destroy(); return end
	local pivot = model:GetPivot()
	local box, size = model:GetBoundingBox()
	local feetOffset = pivot.Position.Y - (box.Position.Y - size.Y * 0.5)
	local position = ground.Position + Vector3.new(0, feetOffset + 0.05, 0)
	local facing = Vector3.new(playerRoot.Position.X, position.Y, playerRoot.Position.Z)
	model:PivotTo(if (facing - position).Magnitude > 0.01 then CFrame.lookAt(position, facing) else CFrame.new(position))
	local list = owned[player] or {}
	owned[player] = list
	for i = #list, 1, -1 do if not list[i].Parent then table.remove(list, i) end end
	if #list >= 10 then table.remove(list, 1):Destroy() end
	model:SetAttribute("SpawnedBy", player.UserId)
	model.Parent = folder
	for _, instance in model:GetDescendants() do
		if instance:IsA("BasePart") then
			local canSet = instance:CanSetNetworkOwnership()
			if canSet then instance:SetNetworkOwner(nil) end
		end
	end
	local entity = Entity.new(model, { Team = "Undead", ScaleHumanoid = true })
	entity:AddTag("Enemy")
	entity:AddTag("TestDummy")
	table.insert(list, model)
	local hp, damage = makeDisplay(model, root)
	local state = { HealthLabel = hp, DamageLabel = damage, Entity = entity, Total = 0, Last = 0, Hits = 0, Dirty = true, FeetOffset = feetOffset }
	counters[model] = state
	model:SetAttribute("TotalDamage", 0)
	model:SetAttribute("HitCount", 0)
	model:SetAttribute("DamagePulse", 0)
	entity.Damaged:Connect(function(amount)
		state.Total += amount
		state.Last = amount
		state.Hits += 1
		state.Dirty = true
		model:SetAttribute("DamagePulse", state.Hits)
	end)
	humanoid.HealthChanged:Connect(function() state.Dirty = true end)
	model.Destroying:Connect(function()
		counters[model] = nil
		if not entity.IsDestroyed then entity:Destroy() end
	end)
end

local function moveDummy(player, model, target)
	-- Only this tool's server-owned dummies belonging to the requester can move.
	if typeof(model) ~= "Instance" or not model:IsA("Model") or model.Parent ~= folder then return end
	local state = counters[model]
	if not state or model:GetAttribute("SpawnedBy") ~= player.UserId then return end
	local root = model.PrimaryPart
	if not root then return end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, folder }
	local ground = workspace:Raycast(target + Vector3.new(0, 20, 0), Vector3.new(0, -100, 0), params)
	if not ground then return end
	local from = model:GetPivot()
	local position = ground.Position + Vector3.new(0, state.FeetOffset + 0.05, 0)
	local wasAnchored = if state.Move then state.Move.WasAnchored else root.Anchored
	root.Anchored = true
	for _, instance in model:GetDescendants() do
		if instance:IsA("BasePart") then
			instance.AssemblyLinearVelocity = Vector3.zero
			instance.AssemblyAngularVelocity = Vector3.zero
		end
	end
	state.Move = { From = from, To = CFrame.new(position) * from.Rotation, Elapsed = 0, WasAnchored = wasAnchored }
end

VisualOffload.On("DummySpawner", function(data, player)
	if not player or typeof(data) ~= "table" then return end
	local character = player.Character
	local tool = character and character:FindFirstChild("DummySpawner")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not tool or not tool:IsA("Tool") or not root or not humanoid or humanoid.Health <= 0 then return end
	if data.Action ~= "Spawn" and data.Action ~= "Clear" and data.Action ~= "Move" and data.Action ~= "Delete" then return end
	local now = os.clock()
	if lastCommand[player] and now - lastCommand[player] < 0.25 then return end
	lastCommand[player] = now
	if data.Action == "Clear" then clear(player); return end
	if data.Action == "Delete" then
		local model = data.Dummy
		if typeof(model) ~= "Instance" or not model:IsA("Model") or model.Parent ~= folder then return end
		if not counters[model] or model:GetAttribute("SpawnedBy") ~= player.UserId then return end
		local list = owned[player]
		local index = list and table.find(list, model)
		if index then table.remove(list, index) end
		model:Destroy()
		return
	end
	local target = data.Position
	if typeof(target) ~= "Vector3" or not SafeMath.isFiniteVector(target) then return end
	if (target - root.Position).Magnitude > 200 then return end
	if data.Action == "Move" then moveDummy(player, data.Dummy, target)
	else spawn(player, tool, root, target) end
end)

local elapsed = 0
RunService.Heartbeat:Connect(function(dt)
	for model, state in counters do
		local move = state.Move
		if move then
			move.Elapsed += dt
			local alpha = math.min(move.Elapsed / 0.2, 1)
			model:PivotTo(move.From:Lerp(move.To, alpha * (2 - alpha)))
			if alpha >= 1 then
				if model.PrimaryPart then model.PrimaryPart.Anchored = move.WasAnchored end
				state.Move = nil
			end
		end
	end
	elapsed += dt
	if elapsed < 0.1 then return end
	elapsed = 0
	for model, state in counters do
		if state.Dirty then
			state.Dirty = false
			state.HealthLabel.Text = string.format("%.0f", state.Entity.Health)
			state.DamageLabel.Text = string.format("Damage %.1f  ·  Hits %d\nLast %.1f", state.Total, state.Hits, state.Last)
			model:SetAttribute("TotalDamage", state.Total)
			model:SetAttribute("LastDamage", state.Last)
			model:SetAttribute("HitCount", state.Hits)
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	clear(player)
	owned[player] = nil
	lastCommand[player] = nil
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="47">
        <Properties>
          <string name="Name">MapGenDemo</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	MapGenDemo.server.luau
	Runs the prop-hunt map generator and animates its build when you press Play.

	Gated behind a Workspace attribute so it doesn't fire during unrelated
	playtests: set Workspace:SetAttribute("RunMapGen", true) (or flip the
	DEFAULT_ON flag below) to enable it.

	Phase 1 shows: hallway network growing, then empty-space detection tinting the
	reachable pockets, then candidate room rectangles popping in. Phase 2 then
	builds real, collidable geometry (walls with door openings, room floors,
	hallway carpet, a roof, and ceiling lights) and hides the debug preview --
	press G client-side to bring the debug preview back and compare it against
	the built map.

	CONFIG below is the single source of truth for a test run — every key it sets
	overrides MapGen.DefaultConfig (src/shared/MapGen/init.luau), so edit values
	HERE, not there, when tweaking a playtest. DefaultConfig only fills in keys
	CONFIG omits.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DEFAULT_ON = true

if not (workspace:GetAttribute("RunMapGen") or DEFAULT_ON) then
	return
end

local MapGen = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapGen"))

local CONFIG = {
	width = 100,
	height = 100,
	cellSize = 16,
	origin = Vector3.new(-250, 1, -250), -- lift the whole map up off the baseplate
	seed = 1, --nil :: number?, -- set a number for a fixed, repeatable layout

	spacing = 6, -- cells between parallel corridors
	hallWidth = 2, -- corridor width in cells (2 * cellSize = 16-stud halls)
	spacingJitter = 2, -- +/- cells per lattice interval, for room size variety
	loopChance = 0.2, -- corridor-grid density; higher = smaller/more numerous rooms

	-- room rectangle bounds, independent per axis (in cells; x cellSize = studs)
	minWidth = 3,
	maxWidth = 10,
	minLength = 3,
	maxLength = 10,

	-- leftover pockets too small for the bounds above: touching one room merges
	-- into it, touching none is culled into the hallway, touching 2+ rooms rolls
	-- this chance to become a connecting hallway segment instead of extending one
	pocketHallwayChance = 0.8,
	-- a room stops accepting pocket merges once it's grown by this fraction of
	-- its original area (e.g. 0.5 = 50% bigger); rejected merges become hallway
	irregularityThreshold = 0.5,
	-- cells wide per door opened between a forced/connecting hallway pocket and
	-- each room it touches -- NOT the whole shared boundary
	pocketDoorWidth = 2,

	-- rooms packed directly edge-to-edge (no hallway between them) normally get
	-- a plain wall; this is the chance each such pair instead gets its own door
	roomLinkChance = 0.6,
	roomLinkDoorWidth = 2,
}

local BUILD_CONFIG = {
	wallThickness = 1, -- studs
	wallHeight = 20, -- studs
	doorWidth = 1, -- cells wide per door opening

	ceilingThickness = 1, -- studs

	-- Ceiling lights: with cellSize=16, spacing 4 cells = 64 studs between
	-- fixtures. lightRange must clear half that (32 studs) with real margin or
	-- the roof (which blocks the outdoor sun) leaves dark gaps between lights --
	-- Ambient is (0,0,0) in this game, so these are the only indoor light source.
	lightSpacing = 4, -- cells
	lightRange = 55, -- studs
	lightBrightness = 0.1,
}

-- Debug-overlay toggle: the client fires this when G is pressed; the server
-- owns the Visualizer instance (see MapGenToggleDebug.client.luau).
local toggleDebugEvent = ReplicatedStorage:FindFirstChild("MapGenToggleDebug")
if not toggleDebugEvent then
	toggleDebugEvent = Instance.new("RemoteEvent")
	toggleDebugEvent.Name = "MapGenToggleDebug"
	toggleDebugEvent.Parent = ReplicatedStorage
end

-- was expecting game:GetService("ServerScriptService")

task.spawn(function()
	local result = MapGen.visualizeAnimated(CONFIG)

	print(string.format(
		"[MapGen] hallways done: %d hallway cells, %d regions, %d candidate rooms",
		result.grid:count(MapGen.Grid.HALL),
		#result.regions,
		#result.rooms
	))

	MapGen.Builder.build(result.grid, result.rooms, {
		cellSize = CONFIG.cellSize,
		origin = CONFIG.origin,
		wallThickness = BUILD_CONFIG.wallThickness,
		wallHeight = BUILD_CONFIG.wallHeight,
		doorWidth = BUILD_CONFIG.doorWidth,
		ceilingThickness = BUILD_CONFIG.ceilingThickness,
		lightSpacing = BUILD_CONFIG.lightSpacing,
		lightRange = BUILD_CONFIG.lightRange,
		lightBrightness = BUILD_CONFIG.lightBrightness,
		seed = CONFIG.seed,
		openEdges = result.openEdges,
	})

	-- hide the debug preview now that real geometry exists (avoids overlapping
	-- the same floor space); G brings it back for comparison
	result.visualizer:setEnabled(false)
	toggleDebugEvent.OnServerEvent:Connect(function()
		result.visualizer:toggle()
	end)

	print("[MapGen] build complete — press G to toggle the debug overlay")
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="48">
        <Properties>
          <string name="Name">PlayerManager</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	PlayerManager (server)
	Owns the link between player characters and the Entity system:
	 - registers every spawned character as an Entity (so projectiles can hit it
	   and homing can find it),
	 - tags it "Player" (the shooter's homing locks onto this tag alongside
	   "Enemy"),
	 - scales the character's Humanoid with time dilation inside slow chunks,
	 - destroys the PREVIOUS character's Entity registration on respawn/leave.

	Without this, raycasts that hit a player limb resolve to no entity (Entity.Get
	walks ancestors looking for one in byInstance -- see Entity.luau), so the
	Projectile system falls back to treating the hit as world geometry and never
	deals damage. It also leaves Projectile.Source nil for player-fired shots,
	which is what prevents homing from locking onto its own creator: acquireTarget
	and _resolveEntityHit both hard-exclude projectile.Source (see Projectile.luau),
	but that comparison is only meaningful once Source is a real entity -- which
	only happens once the firing character is registered here. CharacterAdded does
	NOT fire for a character that already exists at connection time (e.g. the
	solo-test host), so the initial player.Character check below is required, not
	optional -- skipping it leaves that player's Source nil for its entire first
	life, with nothing excluding its own hurtbox from its own raycasts.

	The stale-entity cleanup matters more than it looks: Entity.new only tears
	itself down automatically via the character instance's Destroying signal (see
	Entity.luau), but Roblox does NOT destroy a character's corpse on death by
	default -- it just sits in the workspace until the next respawn. DummyManager
	explicitly destroys its corpse in its Died handler for exactly this reason;
	without the equivalent here, every player death would leave a permanent ghost
	Entity behind -- still tagged "Player", still live in the spatial index and
	still hit/homing-testable -- at the death location, distinct from (and
	invisible to) the player's new Source. A shot fired near a spawn point that
	doubles as a death spot could then appear to "hit yourself" via that leftover
	corpse even though the raycast correctly excludes your CURRENT character.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Entity = require(Shared.Entity)

local Players = game:GetService("Players")

local playerEntities: { [Player]: any } = {} -- most recent Entity per player

local function registerCharacter(player: Player, character: Model)
	local previous = playerEntities[player]
	if previous and not previous.IsDestroyed then
		previous:Destroy() -- drop the old corpse from the hit/homing index
	end

	local entity = Entity.new(character, {
		ScaleHumanoid = true, -- moves in dilated time inside slow chunks
		BodyOffset = Vector3.new(0, -1, 0),
		HitboxRadius = 2.5,
		HeadRadius = 1.2

	})
	entity:AddTag("Player") -- homing targets this tag

	-- Reapply this player's own personal time ratio (see
	-- example/init.server.luau's "RequestPersonalTimeScale" handler) -- a
	-- fresh Entity otherwise starts at 1x, silently resetting it on every
	-- respawn even though the client's slider still shows the old value.
	entity:SetTimeScale(player:GetAttribute("PersonalTimeScale") or 1)

	playerEntities[player] = entity
end

local function onPlayer(player: Player)
	-- CharacterAdded does not fire for a character that already exists at
	-- connection time (e.g. the solo-test host), so register it explicitly and
	-- then connect for subsequent respawns.
	if player.Character then
		registerCharacter(player, player.Character)
	end
	player.CharacterAdded:Connect(function(character)
		registerCharacter(player, character)
	end)
end

for _, player in Players:GetPlayers() do
	onPlayer(player)
end
Players.PlayerAdded:Connect(onPlayer)

Players.PlayerRemoving:Connect(function(player)
	local entity = playerEntities[player]
	if entity and not entity.IsDestroyed then
		entity:Destroy()
	end
	playerEntities[player] = nil
end)

print("[Relativity] player manager online")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Projectile</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	Projectile (server)
	Server-authoritative, raycast-driven projectiles that live in dilated time.
	Every projectile steps in the local time of the chunk it currently occupies,
	so a bullet flying through a 0.2x slow zone crawls, its gravity floats, and
	its fuse burns slower — all for free. Because of that, a dilated Lifetime
	alone can't bound a projectile's real-world lifespan -- something frozen at
	0x (its own TimeScale, its Source's personal ratio, or its chunk) would
	never expire on its own. MaxRealLifetime is a separate, real-time
	(wall-clock) hard cap that always applies regardless of dilation -- see
	DEFAULT_MAX_REAL_LIFETIME / Projectile.SetDefaultMaxRealLifetime below.

	This module lives in ServerScriptService (never replicated to clients) --
	all hit-detection, lag-compensation, homing-acquisition, and damage-
	adjacent logic (raycast filters, penetration math, pierce/damage
	multipliers) stays server-only and unreadable by any client, on purpose.
	The purely cosmetic rendering half lives in ReplicatedStorage.Shared as
	ProjectileClient -- require that from client code, this module from
	server code. The two communicate only over VisualOffload's ProjSpawnBatch /
	ProjMove / ProjHitBatch / ProjSync / ProjTimeScale / ProjRay channels (see
	Projectile/Replication.luau for the sending side).

	Supported behaviours (mix and match): straight shots, ballistic gravity,
	acceleration/deceleration, bouncing (restitution), homing (explicit target or
	auto-acquire by tag(s), with optional Permalock), piercing with falloff, and
	cone bursts. Rendering can be offloaded to clients (Visualize = true): the
	server keeps only the logic. Visuals receive ProjSpawn with their current
	trajectory config and ProjHit on destruction. Finite-range observers also
	receive ProjRangeExit and a fresh authoritative spawn on re-entry; sparse
	corrections must never be lost permanently outside that range.
	On top of that there are three
	independent, orthogonal streaming mechanisms, each covering a different case
	the client can't safely reproduce on its own:
	 - Continuous sync while actively homing (self.HomingTarget ~= nil, checked
	   fresh every tick, never a static classification): the client only ever
	   sees a target's position through that target's own replication lag, which
	   differs per observer, so if it rotated toward that position locally, two
	   clients watching the same missile chase the same target could compute two
	   different flight paths. While a lock is held, the server streams
	   authoritative Position/Velocity through a persistent round-robin batch
	   capped at MAX_SYNC_UPDATES_PER_FRAME. At ordinary counts that is every
	   tick; at stress-test counts each cohort updates on alternating frames.
	   The cursor advances in real frame order and is never reset by dilation,
	   so changing GlobalTimeScale cannot merge staggered cohorts into one spike.
	   A rare ProjSync event tells clients when a visual crosses in or out of
	   continuous-sync mode.
	 - A one-shot correction on every bounce: reproducing a bounce client-side
	   requires matching the server's exact raycast resolution/timing AND
	   knowing which hits are really entities (piercable/filterable, server-only
	   knowledge -- the client has no replicated entity registry to check
	   against), neither of which the client can do reliably. So rather than
	   staying synced for the rest of its life, a bouncing projectile is only
	   ever corrected on the frame it actually bounces: that frame's ProjMove
	   batch carries one entry (Bounced = true) with the contact point and the
	   end-of-frame post-bounce Position/Velocity, which the client snaps to
	   and treats as its new local physics baseline. Between bounces (and
	   before the first one, and after the last one) the client is fully
	   unsynced and coasts on local physics, just like a non-homing,
	   non-bouncing shot.
	 - A one-shot ProjTimeScale message every time a projectile's personal/local
	   dilation actually CHANGES (Source.TimeScale * projectile.TimeScale --
	   see "Local time" below), not a continuous stream: the client can't
	   predict a ratio it's never been told, but once it knows the current
	   number it can fold it straight into the same local ChunkManager.ScaleDt
	   dead-reckoning every unsynced visual already does (see ProjectileClient's
	   render loop), exactly like it already does for chunk/world dilation
	   (which similarly replicates as sparse chunk-scale updates, not a
	   per-projectile stream).
	These three mechanisms are independent and compose freely: a homing
	projectile that also bounces stays continuously synced while locked (the
	bounce's position/velocity is folded into that same stream) and, if it
	loses its lock while bounces remain, drops to the bounce-only
	one-shot-correction mode instead of going fully local. A bounce correction
	is always applied unconditionally on receipt, whether or not the visual is
	currently in continuous-sync mode; likewise a ProjTimeScale update always
	applies unconditionally (a homing-synced visual just caches it for later,
	in case its lock later drops). All client-side simulation is purely
	cosmetic; the server always runs its own independent, authoritative Step,
	and any visual drift is corrected the instant ProjHit snaps the final
	position.

	Beams predict their linked centerline from timestamped motion seeds, with
	sparse safety/steering snapshots and immediate topology/clipping corrections.
	A body contact never teleports a distant
	back endpoint onto the leading endpoint's wall; each moving head owns its
	wall bounce/penetration timing. Client beam sections are tessellated after
	union and capped to 12 studs without limiting the beam's total reach.

	API:
	 Projectile.new(config) -> projectile
	 Projectile.Burst(config, count) -> { projectile }
	 Projectile.SetDebugRays(enabled)            -- default off; see debugRays below
	 Projectile.SetDefaultMaxRealLifetime(seconds) -- default 60; see MaxRealLifetime below
	 Projectile.SetDebugSync(enabled)            -- see Projectile/Replication.luau
	 (Rendering API -- EnableClientRendering(), SetImpactHandler(fn) -- moved to
	 ProjectileClient in ReplicatedStorage.Shared; require that from client code.)

	 Query (server-only -- projectiles only ever live in the server's `active`
	 list. Every result is the LIVE projectile object, not a copy, so an
	 ability can read OR write any field on it directly -- e.g.
	 projectile.Damage = x, or the dedicated projectile:SetTimeScale(x) below --
	 and it takes effect on the very next Step, same tick):
	 Projectile.GetAll() -> { projectile }
	 Projectile.GetBySource(source) -> { projectile }       -- e.g. "my own live shots"
	 Projectile.GetInRadius(position, radius, options?) -> { projectile }
	    options: { Filter: (projectile) -> boolean }
	    -- Linear scan, not chunk-indexed like Entity/ChunkManager's spatial
	    -- queries -- fine at this game's projectile counts (MAX_ACTIVE_
	    -- PROJECTILES_PER_PLAYER in Shooter.server.luau caps it well below
	    -- where that would matter); revisit if a future ability calls this
	    -- every frame at very high projectile counts.

	 projectile:SetTimeScale(scale)   -- clamped >= 0; see TimeScale below

	 Events (Signal.luau -- see that module for the full API; :Connect(fn) ->
	 Connection with :Disconnect()). There is no config.OnHit anymore: connect
	 on the returned projectile instead, e.g.
	   local proj = Projectile.new(config)
	   proj.OnHit:Connect(function(hit) ... end)
	 projectile.OnHit    -- fires on EVERY contact worth reporting: an entity
	                         hit (piercing or final), a world bounce, a
	                         successful wall-penetration, or a final world
	                         stop. Does NOT fire for natural Lifetime/
	                         MaxRealLifetime expiry (nothing was actually hit).
	                         Listener receives one table:
	                           { CFrame: CFrame, Part: BasePart, Entity: Entity?,
	                             Hurtbox: ("Head" | "Body")? }
	                         Entity is nil for a pure world/wall contact.
	                         Hurtbox is which of the entity's two hurtboxes
	                         (see Entity.luau's "Head + Body hurtboxes"
	                         section) was struck -- nil alongside a nil
	                         Entity. Shooter.server.luau applies the target's
	                         HeadshotMultiplier when this is "Head". The
	                         module deals no damage itself anymore -- read
	                         projectile.Damage * projectile.DamageMultiplier
	                         (the latter already reflects PierceFalloff) and
	                         apply it yourself, e.g. via hit.Entity:TakeDamage
	                         or projectile.Source:DealDamage. This is what
	                         makes per-projectile custom effects possible
	                         (status effects, chain lightning, whatever) without
	                         touching this module.
	 projectile.OnDestroy -- fires exactly ONCE, whenever the projectile is
	                         actually removed (entity kill shot, world stop,
	                         bounces/penetration exhausted, or natural
	                         expiry). Listener receives
	                           { Position: Vector3, Normal: Vector3, Kind: string? }
	                         Kind is "entity" | "world" | nil (nil covers both
	                         a fizzled/expired shot and a bare Destroy() call),
	                         or whatever a caller passes to Destroy(result,
	                         kind) -- e.g. SpellRuntime's "detonate".
	                         Use this for exactly-once bookkeeping (e.g.
	                         Shooter.server.luau's activeProjectileCount
	                         decrement) -- OnHit is NOT exactly-once, since
	                         piercing/bouncing/penetrating fire it without
	                         destroying the projectile.

	 config (all optional unless noted):
	   Origin: Vector3          (required)
	   Direction: Vector3       (required unless TargetPosition given)
	   TargetPosition: Vector3  (aim at a world point instead of a direction)
	   Speed = 100
	   Acceleration = 0         (number: studs/s² along AccelerationDirection,
	              or current velocity when no direction is supplied; negative
	              decelerates. Vector3: arbitrary world-space acceleration)
	   AccelerationDirection = nil (optional direction for numeric Acceleration)
	   MinSpeed = 0, MaxSpeed = math.huge   (clamp after acceleration + gravity)
	   Lifetime = 5             (3 for beams; dilated seconds; no upper bound is enforced)
	   MaxRealLifetime = 60     (real, undilated seconds -- a hard safety cap
	              independent of Lifetime/TimeScale/chunk dilation; see
	              DEFAULT_MAX_REAL_LIFETIME below. Fires even if this
	              projectile's effective time is completely frozen, since
	              Age itself would otherwise never advance)
	   TimeScale = 1            (this projectile's OWN dilation, independent of
	              Source -- see the "Local time" section below; live-mutable
	              via projectile:SetTimeScale() or the field directly)
	   Damage = 0               (data only -- the module never deals damage
	              itself anymore; read Damage * DamageMultiplier in your own
	              projectile.OnHit listener and apply it yourself. Kept +
	              still adjusted by PierceFalloff purely as a convenience so
	              callers don't have to reimplement pierce falloff bookkeeping)
	   Source = entity          (excluded from ever being hit; see IgnoreInstances)
	   IgnoreInstances = {Instance} (raw instances the raycast/spherecast never
	              hits, e.g. the shooter's character -- independent of Source,
	              so self-hits stay impossible even if the firing entity hasn't
	              been registered with the Entity system yet; see Raycast.buildRayParams)
	   Filter = (entity)->bool  (which entities count as targets; also applied to homing acquisition)
	   Gravity = 0              (number: studs/s² downward; Vector3: custom
	              world-space gravity. Integrated as acceleration with dilated dt)
	   Radius = 0               (>0 sweeps a capsule: cylindrical segment body
	                              plus spherical substep-joint/end caps)
	   Bounces = 0              (world bounces before it dies; no upper bound is enforced)
	   Restitution = 0.5        (velocity kept per bounce)
	   Penetration = 0          (studs of wall material this projectile can punch
	              through; see attemptPenetration in Raycast.luau. Tried BEFORE
	              bouncing on a world hit; a wall thicker than the remaining
	              Penetration blocks it, falling through to Bounces/destroy as
	              normal. Persistent, depleting state -- punching through
	              several thin walls in a row keeps consuming the same budget)
	   MaxPierces = 0           (enemies passed through)
	   PierceFalloff = 0        (damage lost per pierce, 0..1 -- see Damage above)
	   Homing = { Target?, TargetTag?, TargetTags?, AcquireRadius?, Retarget?,
	              ReacquireRate?, AcquireInterval = 0.1, Permalock?,
	              TurnRate = rad/s, Delay = 0 }
	              -- AcquireInterval: dilated seconds between searches while no
	              -- target is held (jittered 0.5x-1.5x to spread bursts).
	              -- TargetTags (plural, list of strings) matches any tag in the
	              -- list; TargetTag (singular) is still supported for a single tag.
	              -- Permalock (default off): once locked, a Retarget recheck never
	              -- drops the target due to range -- only if it's destroyed. Off by
	              -- default, a dropped-out-of-range lock is genuinely released (not
	              -- silently kept stale). The projectile's own Source is always
	              -- excluded from acquisition, and Filter (if set) is respected.
	   Visualize = false, VisualRange = math.huge
	   Model = Instance?        (cloned client-side) or Visual = {Shape,Size,Color}
	   VisualScale = 1          (0.05..20; applied once when the client clones
	                            the visual, with no per-frame scaling cost)
	   Beam = { Length = 24 }   (optional traveling cylinder path tail; defaults
	                            Speed to 2000 and Radius to 0.35 when omitted.
	                            Length clamps to 0.05..512 studs; swept-radius
	                            head collision is unchanged. The visual tail
	                            follows the already-swept path, including bends,
	                            and drains after impact instead of vanishing.
	                            Sustained spells launch through BeamProjectileHandler:
	                            ChannelId/PreviousId join moving endpoints; tilted
	                            section-body collision runs through this same resolver.)
	   DestroyDelay = 0         (client keeps the visual this long after impact)
	   WaitForParticles = true (client-side; while true, a ParticleEmitter
	              under the visual is only disabled on destroy -- already-
	              emitted particles keep fading out over their own Lifetime,
	              and the model's actual :Destroy() waits out the longest one.
	              false deletes every ParticleEmitter immediately instead,
	              contributing no wait -- see VisualModel.FadeOut)
	   WaitForTrails = true    (same as WaitForParticles, but for Trail
	              instances. If both this and WaitForParticles are false, or
	              one is false and the model has none of the other kind, the
	              visual is destroyed instantly with no grace period)
	   ActivateParticlesOnCreate = false (client-side; when true, every
	              ParticleEmitter under the visual fires once via :Emit()
	              right after spawn, per its own EmitCount/EmitDelay
	              attributes -- defaults to 5 / 0s when either is unset;
	              EmitDelay is seconds from spawn until that emitter actually
	              emits -- see VisualModel.ActivateParticles)
	   OnBounce = fn(projectile, result)   -- still config-driven, unlike OnHit (see Events above)
	   RewindSeconds = 0        (lag compensation; see below)

	 Lag compensation: when RewindSeconds > 0 (set by Shooter.server.luau from the
	 firing player's Player:GetNetworkPing() / 2), entity-hit validity while the
	 projectile is stepping through a chunk that contains entities is decided
	 against each nearby entity's Entity:GetPositionAt(now - RewindSeconds) instead
	 of its live position, LOS-checked against real geometry. This is fixed per
	 projectile at creation time (the shooter's desync at the moment they fired),
	 so simultaneous shots from different-ping players independently see hurtboxes
	 rewound by their own offset. Projectiles not created with a positive
	 RewindSeconds (anything not fired through Shooter.server.luau) are unaffected.

	 Personal time: a projectile's Source may carry its own TimeScale (see
	 Entity:SetTimeScale) independent of the world/chunk dilation the projectile
	 flies through -- a player's own personal time ratio (see TimeControlGui.luau /
	 PlayerManager.server.luau) only affects them and, via this, the bullets they
	 fire. Source.TimeScale is read LIVE every Step (not snapshotted), so a
	 shooter dragging their ratio mid-flight speeds up or slows down bullets
	 already in the air, in real time, exactly like it does their own movement.
	 A projectile with no Source, or a Source that never had its TimeScale set,
	 flies at 1x personal scale (i.e. unaffected).

	 Local time: independent of Source.TimeScale, every projectile also carries
	 its own TimeScale (config.TimeScale, default 1). This is the hook for
	 abilities that affect projectiles directly rather than through who fired
	 them -- e.g. an AoE "time bubble" that finds every projectile in a radius
	 (Projectile.GetInRadius) each tick and sets an extra multiplier on it, or
	 permanently slows/speeds a specific shot via projectile:SetTimeScale().
	 Both TimeScale sources are read live every Step and simply multiply
	 together (world/chunk dilation * Source.TimeScale * projectile.TimeScale),
	 so an ability's effect composes with the shooter's own personal ratio
	 rather than overriding it, and always reflects whatever either was most
	 recently set to -- there's no snapshotting anywhere in this chain.

	 The client can't predict a live-changing ratio it was never told about (an
	 ability's radius check, or another player's personal TimeScale, aren't
	 otherwise replicated to observers) -- but it doesn't need continuous
	 position streaming to use one once it knows it. Every Step, the server
	 diffs the combined Source.TimeScale * projectile.TimeScale against the
	 last value it streamed for that projectile and, only on an actual change,
	 sends a single small ProjTimeScale { Id, TimeScale } message (see
	 Projectile.new for the initial value and Replication.updateTimeScale for
	 the on-change check). The client stores that number per visual and
	 multiplies it straight into its local dead-reckoning (see
	 ProjectileClient's render loop), the same way it already accounts for
	 chunk/world dilation.

	 Input safety: every config value goes through Config.normalize (NaN falls
	 back to the default, +-inf and anything past SafeMath.Limit = 1e9 clamps),
	 so a hostile or broken aim can never put a NaN into the simulation.
	 Position/Velocity/TimeScale stay live-writable and are re-checked each
	 Step; a projectile that leaves the +-1e9 world bound simply expires. This is unrelated to Replication.isSynced/homing,
	 which is still the one case that genuinely needs a continuous
	 authoritative stream (see above).
]]


local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local Heartbeat = require(Shared:WaitForChild("Heartbeat"))
local ChunkManager = require(Shared:WaitForChild("ChunkManager"))
local Entity = require(Shared:WaitForChild("Entity"))
local ProjectileMotion = require(Shared:WaitForChild("ProjectileMotion"))
local Planner = require(Shared:WaitForChild("ProjectileStepPlanner"))
local SafeMath = require(Shared:WaitForChild("SafeMath"))
local Signal = require(Shared:WaitForChild("Signal"))
local BeamPath = require(Shared:WaitForChild("BeamPath"))

local Config = require(script.Config)
local Homing = require(script.Homing)
local Math = require(script.Math)
local Raycast = require(script.Raycast)
local Replication = require(script.Replication)
local RewindHit = require(script.RewindHit)
local Types = require(script.Types)

export type Config = Types.Config
export type HitInfo = Types.HitInfo
export type DestroyInfo = Types.DestroyInfo

local Projectile = {}
Projectile.__index = Projectile

-- The live projectile: its public/internal state plus the methods below.
-- Declared as an intersection (not typeof(setmetatable(...))) so a projectile
-- is directly usable anywhere a Types.State is expected.
type Methods = {
	Step: (self: Projectile, globalDt: number) -> boolean,
	Destroy: (self: Projectile, result: { Position: Vector3, Normal: Vector3 }?, kind: string?) -> (),
	SetTimeScale: (self: Projectile, scale: number) -> (),
	ResolveBeamSpan: (self: Projectile, points: { Vector3 }, allowHits: boolean?, cornerIndices: { number }?) -> { Vector3 },
	ClearBeamPrevious: (self: Projectile) -> (),
}
export type Projectile = Types.State & Methods

local MIN_STEP_DT = ProjectileMotion.MinStepDt
local MAX_SUBSTEPS = 16
-- Homing re-aims once per substep, so cap how far one substep can turn.
local MAX_HOMING_TURN_STEP = math.rad(5)
-- Projectile.Burst never creates more than this many pellets in one call.
local MAX_BURST_COUNT = 10000

local active: { Projectile } = {} -- server-side live projectiles
local nextId = 0
local beamSpanStep: ((number) -> ())? = nil

-- Dedicated beam work runs after ALL heads are stepped, but before pose
-- replication. Never mix an old front pose with an already-stepped back.
function Projectile.SetBeamSpanStep(callback: (number) -> ())
	assert(not beamSpanStep, "Beam span handler already installed")
	beamSpanStep = callback
end

-- When on, every movement raycast is streamed to rendering clients so the hit
-- detection can be seen as lines (see ProjRay in ProjectileClient). Off by
-- default -- this is a per-substep debug stream, expensive at high projectile
-- counts. Toggle from a client via the "SetProjectileDebug" channel (see
-- example/init.server.luau).
local debugRays = false

function Projectile.SetDebugRays(enabled: boolean)
	debugRays = enabled == true
end

function Projectile.SetDebugSync(enabled: boolean)
	Replication.DebugSync = enabled == true
end

-- Hard real-time (wall-clock, undilated) cap on how long any projectile can
-- stay alive, regardless of its own dilated Lifetime/Age. A projectile whose
-- effective time is frozen (its Source's personal ratio, its own TimeScale,
-- or the chunk it's sitting in all read as 0 -- see Step) never advances Age,
-- so the normal Lifetime expiry alone would let it live in `active` forever.
-- Checked every Step via os.clock(), independent of dt. Per-shot override via
-- config.MaxRealLifetime.
local defaultMaxRealLifetime = 60 -- real seconds

function Projectile.SetDefaultMaxRealLifetime(seconds: number)
	defaultMaxRealLifetime = SafeMath.number(seconds, defaultMaxRealLifetime, 0)
end

-- The shooter's personal ratio times this projectile's own ratio -- see the
-- "Local time" section above. Both are live-writable from outside (an Entity
-- or an ability can set either to anything), so both are sanitized here.
local function combinedTimeScale(projectile: Types.State): number
	local source = projectile.Source
	local sourceScale = SafeMath.number(source and source.TimeScale, 1, 0)
	return SafeMath.number(sourceScale * SafeMath.number(projectile.TimeScale, 1, 0), 0, 0)
end

--------------------------------------------------------------------------------
-- Construction
--------------------------------------------------------------------------------

function Projectile.new(config: Config): Projectile
	local settings = Config.normalize(config, defaultMaxRealLifetime)
	local homing = settings.Homing
	nextId += 1

	local state: Types.State = {
		Id = nextId,
		Position = settings.Origin,
		Velocity = settings.Direction * settings.Speed,
		Speed = settings.Speed,
		Acceleration = settings.Acceleration,
		AccelerationDirection = settings.AccelerationDirection,
		MinSpeed = settings.MinSpeed,
		MaxSpeed = settings.MaxSpeed,
		Gravity = settings.Gravity,
		Radius = settings.Radius,

		Lifetime = settings.Lifetime,
		Age = 0,
		MaxRealLifetime = settings.MaxRealLifetime,
		TimeScale = settings.TimeScale,

		Damage = settings.Damage,
		DamageMultiplier = 1,
		Source = settings.Source,
		IgnoreInstances = settings.IgnoreInstances,
		Filter = settings.Filter,

		BouncesLeft = settings.Bounces,
		Restitution = settings.Restitution,
		Penetration = settings.Penetration,
		PiercesLeft = settings.MaxPierces,
		PierceFalloff = settings.PierceFalloff,

		Homing = homing,
		HomingDelay = if homing then homing.Delay else 0,
		HomingTarget = if homing then homing.Target else nil,
		ReacquireTimer = 0,

		Visualize = settings.Visualize,
		VisualRange = settings.VisualRange,
		Model = settings.Model,
		Visual = settings.Visual,
		VisualScale = settings.VisualScale,
		Beam = settings.Beam,
		_beamOrigin = if settings.Beam then settings.Origin else nil,
		_beamTurns = if settings.Beam and settings.Beam.ChannelId then {} else nil,
		DestroyDelay = settings.DestroyDelay,
		WaitForParticles = settings.WaitForParticles,
		WaitForTrails = settings.WaitForTrails,
		ActivateParticlesOnCreate = settings.ActivateParticlesOnCreate,

		-- See "Events" in the module doc comment. Fresh Signal per projectile.
		OnHit = Signal.new() :: any,
		OnDestroy = Signal.new() :: any,
		OnBounce = settings.OnBounce,

		RewindSeconds = settings.RewindSeconds,
		Dead = false,

		_spawnRealTime = os.clock(),
		_acquireTimer = 0, -- throttles searches while no target is held; see Homing
		_ignore = {}, -- entities already pierced
		-- Lag-compensation working state, reset each Step (see RewindHit).
		_rewindTime = 0,
		_rewindCache = {},
		_simulationDebt = 0, -- personal/global seconds carried across frames
		_rayParams = Raycast.buildRayParams(settings.Source, settings.IgnoreInstances),
		_spawnStreamed = false,
		_streamedSynced = false,
		_lastStreamedTimeScale = 1,
	}
	state._streamedSynced = Replication.isSynced(state)
	-- Baseline for Replication.updateTimeScale; set before spawnVisual so the
	-- spawn snapshot's TimeScale matches.
	state._lastStreamedTimeScale = combinedTimeScale(state)

	local self: Projectile = setmetatable(state, Projectile) :: any
	table.insert(active, self)
	Replication.spawnVisual(self)
	return self
end

-- A real beamlet: unique identity, ordinary simulation, replication and
-- collision events. The handler binds spell energy/quota before its first step.
function Projectile.CreateBeamSample(template: Projectile, position: Vector3, velocity: Vector3, turns: { Vector3 }): Projectile
	local state = table.clone(template)
	nextId += 1
	state.Id = nextId
	state.Position, state.Velocity, state.Speed = position, velocity, velocity.Magnitude
	state.RewindSeconds = 0
	state._beamJoiner, state._beamJoinerWorldStop = true, nil
	state.Beam = template.Beam and table.clone(template.Beam)
	state.Homing = template.Homing and table.clone(template.Homing)
	state._beamTurns = table.clone(turns)
	state._beamPrevious, state._beamSpan, state._beamSpanClipped = nil, nil, nil
	state._spawnStreamed, state._streamedSynced = false, Replication.isSynced(state)
	state._ignore, state._rewindCache, state._simulationDebt = table.clone(template._ignore), {}, 0
	state._rayParams = Raycast.buildRayParams(state.Source, state.IgnoreInstances)
	state.Dead, state._beamBodyHit = false, nil
	state._beamReserveChildren, state._beamBindChild, state._beamScaleEnergy = nil, nil, nil
	state.OnHit, state.OnDestroy = Signal.new() :: any, Signal.new() :: any
	local self = setmetatable(state, Projectile) :: any
	table.insert(active, self)
	return self
end

function Projectile.PublishBeamSample(self: Projectile)
	Replication.spawnVisual(self)
end

-- Cone burst: `count` projectiles spread around the base direction.
function Projectile.Burst(config: Config, count: number): { Projectile }
	local origin = SafeMath.vector(config.Origin, Vector3.zero)
	local baseDirection = Config.direction(config, origin)
	local spread = Config.spread(config)
	local shots = {}
	for _ = 1, math.floor(SafeMath.number(count, 0, 0, MAX_BURST_COUNT)) do
		-- Each pellet gets its own normalized Homing table from Config, so
		-- siblings never share mutable state.
		local pellet = table.clone(config)
		pellet.TargetPosition = nil
		pellet.Direction = Math.coneDirection(baseDirection, spread)
		table.insert(shots, Projectile.new(pellet))
	end
	return shots
end

-- This projectile's OWN local dilation -- see the module doc comment's
-- "Local time" section. Read live every Step, so an ability can dial this up
-- or down over time (or reset it to 1) and the change is immediate. Setting
-- the .TimeScale field directly works identically.
function Projectile.SetTimeScale(self: Projectile, scale: number)
	self.TimeScale = SafeMath.number(scale, 1, 0)
end

--------------------------------------------------------------------------------
-- Query (server-only in practice -- see the module doc comment's API section)
--------------------------------------------------------------------------------

function Projectile.GetAll(): { Projectile }
	return table.clone(active)
end

function Projectile.GetStats()
	local stats = Replication.getQueueStats()
	return {
		Active = #active,
		VisualSpawnsPerFrame = stats.VisualSpawnsPerFrame,
		VisualHitsPerFrame = stats.VisualHitsPerFrame,
		PendingVisualSpawns = stats.PendingVisualSpawns,
		PendingVisualHits = stats.PendingVisualHits,
		BeamPoseCandidates = stats.BeamPoseCandidates,
		BeamPoseUpdates = stats.BeamPoseUpdates,
		BeamRefreshInterval = stats.BeamRefreshInterval,
		BeamHomingRefreshInterval = stats.BeamHomingRefreshInterval,
	}
end

function Projectile.GetBySource(source: Types.EntityLike): { Projectile }
	local result = {}
	for _, projectile in active do
		if projectile.Source == source then
			table.insert(result, projectile)
		end
	end
	return result
end

export type QueryOptions = {
	Filter: ((projectile: Projectile) -> boolean)?,
}

function Projectile.GetInRadius(position: Vector3, radius: number, options: QueryOptions?): { Projectile }
	local filter = options and options.Filter
	local result = {}
	for _, projectile in active do
		if (projectile.Position - position).Magnitude <= radius then
			if not filter or filter(projectile) then
				table.insert(result, projectile)
			end
		end
	end
	return result
end

--------------------------------------------------------------------------------
-- Per-substep movement
--------------------------------------------------------------------------------

local function integrate(projectile: Types.State, velocity: Vector3, dt: number): (Vector3, Vector3)
	return ProjectileMotion.Integrate(
		velocity,
		projectile.Acceleration,
		projectile.AccelerationDirection,
		projectile.Gravity,
		projectile.MinSpeed,
		projectile.MaxSpeed,
		dt
	)
end

-- Moves to `fraction` of this substep's chord and spends only the matching
-- share of stepDt. The time after a contact is refunded to the caller, so a
-- pierce/penetration/bounce keeps flying for the rest of the frame instead of
-- silently losing it -- the client never sees pierces or penetrations and
-- keeps coasting, so any time lost here would be pure server/client drift.
-- Returns the dilated seconds consumed.
local function advanceToContact(
	projectile: Types.State,
	from: Vector3,
	displacement: Vector3,
	fraction: number,
	startVelocity: Vector3,
	stepDt: number
): number
	local clamped = math.clamp(fraction, 0, 1)
	local contactDt = stepDt * clamped
	projectile.Velocity = if contactDt > 0 then (integrate(projectile, startVelocity, contactDt)) else startVelocity
	projectile.Position = from + displacement * clamped
	projectile.Age += contactDt
	return contactDt
end

-- A pass-through contact (pierce, penetration, or a nudge past an ignored
-- entity) teleports the projectile forward past the surface. The client
-- flies straight through the same span in real time, so charge the time it
-- would take to cover it. Returns the dilated seconds consumed.
local function chargePassThrough(projectile: Types.State, contactPosition: Vector3): number
	local speed = projectile.Velocity.Magnitude
	if not (speed >= 1e-5) then
		return 0
	end
	local skipped = (projectile.Position - contactPosition):Dot(projectile.Velocity) / speed
	if not (skipped > 0) then
		return 0
	end
	local skipDt = skipped / speed
	projectile.Velocity = (integrate(projectile, projectile.Velocity, skipDt))
	projectile.Age += skipDt
	return skipDt
end

-- Applies a resolver's verdict. Returns the total dilated seconds this
-- substep consumed, or nil once the projectile has been destroyed.
local function settle(
	projectile: Projectile,
	verdict: Types.Verdict,
	kind: string?,
	contact: Types.Contact,
	contactPosition: Vector3,
	consumed: number
): number?
	if verdict == "destroy" then
		projectile:Destroy(contact, kind)
		return nil
	elseif verdict == "pass" then
		return consumed + chargePassThrough(projectile, contactPosition)
	end
	-- "bounce": the client is re-baselined by the bounce snap instead.
	-- ("fallthrough" can't reach here: both callers resolve it first.)
	return consumed
end

-- Moves one planned substep of `stepDt` dilated seconds, resolving the first
-- contact along the way. Returns the dilated seconds actually consumed (less
-- than stepDt when a contact interrupted the chord, possibly more when a
-- pass-through skipped ahead), or nil once the projectile has been destroyed.
local function advance(projectile: Projectile, stepDt: number, highRes: boolean): number?
	Homing.update(projectile, stepDt)
	local startVelocity = projectile.Velocity
	local endVelocity, movementVelocity = integrate(projectile, startVelocity, stepDt)
	local from = projectile.Position
	local displacement = movementVelocity * stepDt
	local to = from + displacement

	-- Lag-compensated entity check, only while in an entity-containing chunk
	-- and only for shots carrying a shooter's rewind offset. RewindHit already
	-- applies Filter, so a hit here never falls through.
	if highRes and projectile.RewindSeconds > 0 then
		local entity, point, normal, hurtbox = RewindHit.check(projectile, from, to)
		if entity and point and normal then
			if debugRays then
				Replication.streamRay(projectile, from, point, false)
			end
			local contact: Types.Contact = { Position = point, Normal = normal }
			local fraction = Math.chordFraction(from, displacement, point)
			local consumed = advanceToContact(projectile, from, displacement, fraction, startVelocity, stepDt)
			local contactPosition = projectile.Position
			-- (casts: the analyzer widens literal unions returned across modules)
			local verdict = Raycast.resolveEntityHit(projectile, entity, contact, hurtbox :: Types.Hurtbox?)
			return settle(projectile, verdict :: Types.Verdict, "entity", contact, contactPosition, consumed)
		end
	end

	local contact = Raycast.castMovement(projectile, from, displacement)
	if debugRays then
		Replication.streamRay(projectile, from, if contact then contact.Position else to, not highRes)
	end
	if not contact then
		projectile.Velocity = endVelocity
		projectile.Position = to
		projectile.Age += stepDt
		return stepDt
	end

	-- Distance is how far the ray (or sphere center) travelled, which is exact
	-- for Spherecast where contact.Position is the surface instead.
	local length = displacement.Magnitude
	local fraction = if length > 1e-5 then (contact.Distance or 0) / length else 0
	local consumed = advanceToContact(projectile, from, displacement, fraction, startVelocity, stepDt)
	local contactPosition = projectile.Position

	local instance = contact.Instance
	if highRes and projectile.RewindSeconds > 0 and instance and Entity.Get(instance) then
		-- We're lag-compensating this segment and the rewound check above
		-- found no valid hit -- from the shooter's ping-adjusted view this
		-- entity wasn't actually there, so the live-position coincidence
		-- doesn't count. Nudge past and keep flying.
		Raycast.nudgePast(projectile, contact.Position)
		return settle(projectile, "pass", nil, contact, contactPosition, consumed)
	end

	local verdict, kind = Raycast.resolveHit(projectile, contact)
	return settle(projectile, verdict :: Types.Verdict, kind, contact, contactPosition, consumed)
end

--------------------------------------------------------------------------------
-- Per-projectile step
--------------------------------------------------------------------------------

-- Advances the projectile one frame; returns false when it should be
-- removed. Returning false without hitting anything (Lifetime/MaxRealLifetime
-- expiry, leaving the world limit) is a natural expiry: no OnHit fires, and
-- the step loop's Destroy() fires OnDestroy with a nil Kind.
function Projectile.Step(self: Projectile, globalDt: number): boolean
	if self.Dead then
		return false
	end

	-- Hard real-time cap, checked BEFORE anything dt-dependent -- this is the
	-- one expiry check that MUST run even while the projectile is completely
	-- frozen, since Age never advances in that state.
	if os.clock() - self._spawnRealTime >= self.MaxRealLifetime then
		return false
	end

	-- Position/Velocity are public and live-writable; a bad write from an
	-- ability must not poison the math. Out-of-world positions expire.
	self.Velocity = SafeMath.vector(self.Velocity, Vector3.zero)
	if not SafeMath.isFiniteVector(self.Position) then
		return false
	end

	-- Personal/global time is consumed below one spatial segment at a time.
	-- Chunk scale is deliberately NOT folded in here: each segment samples the
	-- chunk it is entering, so crossing a slow/frozen boundary takes effect at
	-- the boundary instead of one whole frame late.
	local combinedScale = combinedTimeScale(self)
	-- Sent BEFORE the frozen early return below, so a ratio change that
	-- freezes the projectile entirely still reaches the client.
	Replication.updateTimeScale(self, combinedScale)
	if not (globalDt > 0) or combinedScale <= 0 then
		-- Frozen: keep it alive, don't move it. A lock can still be cleared
		-- externally while frozen.
		Replication.updateSyncState(self)
		return true
	end

	-- Pin the rewind instant for every substep this frame; see RewindHit.
	if self.RewindSeconds > 0 then
		self._rewindTime = os.clock() - self.RewindSeconds
		table.clear(self._rewindCache)
	end

	local remaining = globalDt * combinedScale + self._simulationDebt
	-- With no dilated chunk or zone anywhere, every boundary search can only
	-- return "none", so skip them (they dominate substep cost at scale).
	local uniformTime = ChunkManager.IsTimeUniform()
	local homing = self.Homing
	local guard = 0
	while remaining > MIN_STEP_DT and guard < MAX_SUBSTEPS do
		guard += 1
		local lifeRemaining = self.Lifetime - self.Age
		if lifeRemaining <= MIN_STEP_DT then
			return false
		end

		local accelerationVector =
			ProjectileMotion.GetAcceleration(self.Velocity, self.Acceleration, self.AccelerationDirection, self.Gravity)
		local sample, chunkScale = Planner.Sample(self.Position, self.Velocity, accelerationVector, uniformTime)
		if chunkScale <= 0 then
			-- Real time spent in a frozen chunk is consumed without building a
			-- catch-up burst for when the chunk is unfrozen.
			remaining = 0
			break
		end

		-- Adaptive raycast resolution: fine steps where entities are (so fast
		-- bullets can't tunnel through a target), long ones in empty space. A
		-- cast is never skipped outright, only lengthened.
		local highRes = Raycast.chunkHasEntities(sample)
		local maxDt = math.huge
		if homing and self.HomingTarget and homing.TurnRate > 0 then
			maxDt = MAX_HOMING_TURN_STEP / homing.TurnRate
		end
		local stepDt = Planner.StepDt(
			self.Position,
			self.Velocity,
			accelerationVector,
			chunkScale,
			remaining,
			lifeRemaining,
			highRes,
			uniformTime,
			maxDt
		)
		if stepDt <= 0 then
			break -- too little time to integrate; carried below
		end

		local consumed = advance(self, stepDt, highRes)
		if not consumed then
			return false -- destroyed by a hit
		end
		remaining -= consumed / chunkScale

		if self.Age >= self.Lifetime - MIN_STEP_DT then
			return false
		end
	end

	-- Whatever wasn't simulated -- past this frame's substep budget, too small
	-- to integrate, or overspent by a pass-through (negative) -- carries to the
	-- next frame, so no time is ever lost or gained relative to the client.
	self._simulationDebt = remaining

	if not SafeMath.isFiniteVector(self.Position) then
		return false -- flew past SafeMath.Limit
	end
	Replication.updateSyncState(self)
	return true
end

-- Linked-body tests must never advance/reflect the distant back endpoint.
-- Movement Step owns wall bounces/penetration and their triggers. Here a world
-- obstruction clips the body; entity contacts still use the normal damage and
-- pierce pipeline once per packet. This prevents a leading ricochet from
-- instantly pulling every trailing sample onto the same wall.
function Projectile.ResolveBeamSpan(self: Projectile, points: { Vector3 }, allowHits: boolean?, cornerIndices: { number }?): { Vector3 }
	local clipped = { points[1] }
	self._beamSpanClipped = nil
	if self.Dead then return clipped end
	local ignore = self._rayParams.FilterDescendantsInstances
	for entity in self._ignore do if entity.Instance then table.insert(ignore, entity.Instance) end end
	local filtered = RaycastParams.new()
	filtered.FilterType = Enum.RaycastFilterType.Exclude
	filtered.IgnoreWater = self._rayParams.IgnoreWater
	filtered.CollisionGroup = self._rayParams.CollisionGroup
	filtered.FilterDescendantsInstances = ignore
	local contacts = 0
	for index = 1, #points - 1 do
		local from, to = points[index], points[index + 1]
		local offset = to - from
		local length = offset.Magnitude
		if length < 1e-4 then continue end
		local heading, traveled = offset / length, 0
		while traveled < length - 1e-4 do
			local distance = math.min(length - traveled, 1000)
			local contact = Raycast.castMovement(self, from + heading * traveled, heading * distance, filtered)
			if not contact then traveled += distance; continue end
			local entity = contact.Instance and Entity.Get(contact.Instance)
			if not entity then
				-- Surface contact is not the sphere center. Keep the rendered
				-- endpoint on the swept centerline, including its radius clearance.
				table.insert(clipped, from + heading * (traveled + contact.Distance))
				self._beamSpanClipped = true
				-- Each inserted beamlet owns its contact/trigger, not the whole
				-- original gap. Bounce still belongs to its moving tip; do not
				-- reflect an endpoint from a distant body contact.
				if self._beamJoiner and self.BouncesLeft <= 0 and self.Penetration <= 0
					and allowHits ~= false and combinedTimeScale(self) > 0
					and ChunkManager.GetTimeScaleAt(contact.Position) > 0 then
					self._beamSpan, self._beamBodyHit = clipped, true
					self.OnHit:Fire(Raycast.buildHitInfo(contact, nil, nil))
					self:Destroy(contact, "world")
				end
				return clipped
			end
			-- Frozen portions do not deliver repeated body-trigger hits. Still
			-- calculate clipping so geometry stays coherent across time bubbles.
			if allowHits == false or combinedTimeScale(self) <= 0 or ChunkManager.GetTimeScaleAt(contact.Position) <= 0 then
				table.insert(ignore, entity.Instance)
				filtered.FilterDescendantsInstances = ignore
			else
				local position, velocity = self.Position, self.Velocity
				self.Velocity = heading * velocity.Magnitude
				local headPosition = entity:GetHeadPosition()
				local hurtbox: Types.Hurtbox = if headPosition and (contact.Position-headPosition).Magnitude <= entity.HeadRadius then "Head" else "Body"
				local verdict = Raycast.resolveEntityHit(self, entity, contact, hurtbox)
				self.Position, self.Velocity = position, velocity
				if verdict == "destroy" then
					table.insert(clipped, from + heading * (traveled + contact.Distance))
					self._beamSpan = BeamPath.Compact(clipped, cornerIndices)
					self._beamSpanClipped = true
					self._beamBodyHit = true
					self:Destroy(contact, "entity")
					return clipped
				end
				-- A rejected entity must not fall through into world reflection.
				table.insert(ignore, entity.Instance)
				filtered.FilterDescendantsInstances = ignore
			end
			contacts += 1
			if contacts >= 16 then self._beamSpanClipped = true; return clipped end
		end
		table.insert(clipped, to)
	end
	return clipped
end
function Projectile.ClearBeamPrevious(self: Projectile)
	if not self.Beam or not self.Beam.PreviousId then return end
	self.Beam.PreviousId, self._beamPrevious = nil, nil
	self._beamSpanClipped = nil
	Replication.queueCorrection(self, self.Position, Vector3.yAxis)
end

function Projectile.Destroy(self: Projectile, result: { Position: Vector3, Normal: Vector3 }?, kind: string?)
	if self.Dead then
		return
	end
	self.Dead = true
	self._beamJoinerWorldStop = kind == "world" and not self._beamBodyHit
	local info: Types.DestroyInfo = {
		Position = if result then SafeMath.vector(result.Position, self.Position) else self.Position,
		Normal = if result then SafeMath.unit(result.Normal, Vector3.yAxis) else Vector3.yAxis,
		Kind = kind,
	}
	if self.Beam and kind == "world" and not self._beamBodyHit then
		-- Followers may finish at this stopped tip. Store its cleared center,
		-- not the pre-cast position or a point inside the wall.
		self.Position = info.Position + info.Normal * self.Radius
	end
	Replication.queueHit(self, info)

	-- Exactly-once -- see the module doc comment's "Events" section. Every
	-- removal path funnels through this one call, including natural expiry
	-- (which the step loop below Destroy()s once Step returns false).
	self.OnDestroy:Fire(info)

	-- Defensive: drop heavy references so a projectile object that somehow
	-- outlives removal from `active` (e.g. a caller retaining the returned
	-- handle) doesn't keep entities/closures alive through it.
	table.clear(self._ignore)
	self.HomingTarget = nil
	self._beamPrevious = nil
	self.OnHit:Destroy()
	self.OnDestroy:Destroy()
end

--------------------------------------------------------------------------------
-- Server step loop
--------------------------------------------------------------------------------

Heartbeat.Connect(function(globalDt: number)
	Replication.flushHitBatch()

	debug.profilebegin("Projectile.StepAll")
	-- Backwards with swap-removal: dead projectiles leave `active` the same
	-- frame (so GetAll/GetInRadius never return them), and anything spawned by
	-- an OnHit/OnDestroy handler mid-loop is appended past `i` and first steps
	-- next frame.
	for i = #active, 1, -1 do
		local projectile = active[i]
		if projectile:Step(globalDt) then
			-- Ordinary homing streams continuously; beams are filtered into sparse
			-- refreshes and immediate topology corrections after link refinement.
			Replication.queuePose(projectile)
		else
			local last = #active
			active[i] = active[last]
			active[last] = nil
			projectile:Destroy(nil, nil)
		end
	end
	debug.profileend()
	if beamSpanStep then beamSpanStep(globalDt) end

	-- Publish only completed end-of-frame snapshots. Beam refinement can
	-- insert colliding children above: sending their parent before those
	-- children existed exposed an incomplete newest section for one frame.
	-- Keep spawn-before-move ordering and the existing bounded spawn queue.
	Replication.flushSpawnBatch()
	Replication.flushMoveBatch()
end, { Name = "ProjectileSystem.Step", Priority = 5 })

return Projectile
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Config</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Projectile/Config.luau
	Turns a caller's Projectile.new config into validated settings. Every
	value is treated as untrusted -- configs are assembled from weapon data,
	spell graphs and (in Studio) a client-tunable debug panel -- so NaN,
	+-inf, wrong types and out-of-range numbers are all normalized here, once,
	and nothing downstream has to re-check them.

	Numbers clamp to SafeMath.Limit (1e9) instead of being rejected, so an
	absurd value still behaves predictably; NaN falls back to the default.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local SafeMath = require(Shared:WaitForChild("SafeMath"))

local Types = require(script.Parent.Types)

local Config = {}

local DEFAULT_SPEED = 100
local DEFAULT_LIFETIME = 5
local DEFAULT_RESTITUTION = 0.5
local DEFAULT_TURN_RATE = math.rad(120)
local DEFAULT_REACQUIRE_RATE = 0.3
-- Dilated seconds between searches while no target is held; see Homing.
local DEFAULT_ACQUIRE_INTERVAL = 0.1

export type Settings = {
	Origin: Vector3,
	Direction: Vector3,
	Speed: number,
	Acceleration: Types.Acceleration,
	AccelerationDirection: Vector3?,
	MinSpeed: number,
	MaxSpeed: number,
	Gravity: Types.Acceleration,
	Radius: number,
	Lifetime: number,
	MaxRealLifetime: number,
	TimeScale: number,
	Damage: number,
	Source: Types.EntityLike?,
	IgnoreInstances: { Instance }?,
	Filter: ((entity: Types.EntityLike) -> boolean)?,
	Bounces: number,
	Restitution: number,
	Penetration: number,
	MaxPierces: number,
	PierceFalloff: number,
	Homing: Types.Homing?,
	Visualize: boolean,
	VisualRange: number,
	Model: Instance?,
	Visual: Types.VisualSpec?,
	VisualScale: number,
	Beam: { Length: number, ChannelId: number?, PreviousId: number? }?,
	DestroyDelay: number,
	WaitForParticles: boolean,
	WaitForTrails: boolean,
	ActivateParticlesOnCreate: boolean,
	OnBounce: ((projectile: any, contact: Types.Contact) -> ())?,
	RewindSeconds: number,
}

local function acceleration(value: unknown): Types.Acceleration
	if typeof(value) == "Vector3" then
		return SafeMath.vector(value, Vector3.zero)
	end
	return SafeMath.number(value, 0)
end

local function count(value: unknown): number
	return math.floor(SafeMath.number(value, 0, 0))
end

local function optionalDirection(value: unknown): Vector3?
	if typeof(value) ~= "Vector3" then
		return nil
	end
	local direction = SafeMath.unit(value, Vector3.zero)
	return if direction == Vector3.zero then nil else direction
end

-- Keeps only real Instances; anything else in the list is dropped.
local function instanceList(value: unknown): { Instance }?
	if typeof(value) ~= "table" then
		return nil
	end
	local list: { Instance } = {}
	for _, item in value :: { any } do
		if typeof(item) == "Instance" then
			table.insert(list, item)
		end
	end
	return list
end

local function optionalFunction<T>(value: T?): T?
	return if typeof(value) == "function" then value else nil
end

-- The launch direction: toward TargetPosition when given, else Direction.
-- Degenerate aims (zero, NaN) fall back to +Z rather than producing NaN.
function Config.direction(raw: Types.Config, origin: Vector3): Vector3
	if typeof(raw.TargetPosition) == "Vector3" then
		local target = SafeMath.vector(raw.TargetPosition, origin)
		return SafeMath.direction(target - origin, Vector3.zAxis)
	end
	return SafeMath.unit(raw.Direction, Vector3.zAxis)
end

function Config.normalizeHoming(raw: Types.HomingOptions?): Types.Homing?
	if typeof(raw) ~= "table" then
		return nil
	end
	local target = raw.Target
	if typeof(target) == "Vector3" then
		target = SafeMath.vector(target, Vector3.zero)
	end
	local acquireRadius = raw.AcquireRadius
	return {
		Target = target,
		TargetTag = if typeof(raw.TargetTag) == "string" then raw.TargetTag else nil,
		TargetTags = if typeof(raw.TargetTags) == "table" then raw.TargetTags else nil,
		-- nil keeps its meaning of "unbounded"; NaN is treated as unset.
		AcquireRadius = if typeof(acquireRadius) == "number" and acquireRadius == acquireRadius
			then SafeMath.number(acquireRadius, 0, 0)
			else nil,
		Retarget = raw.Retarget == true,
		ReacquireRate = SafeMath.number(raw.ReacquireRate, DEFAULT_REACQUIRE_RATE, 0),
		AcquireInterval = SafeMath.number(raw.AcquireInterval, DEFAULT_ACQUIRE_INTERVAL, 0),
		Permalock = raw.Permalock == true,
		TurnRate = SafeMath.number(raw.TurnRate, DEFAULT_TURN_RATE, 0),
		Delay = SafeMath.number(raw.Delay, 0, 0),
	}
end

function Config.normalize(raw: Types.Config, defaultMaxRealLifetime: number): Settings
	local origin = SafeMath.vector(raw.Origin, Vector3.zero)
	local minSpeed = SafeMath.number(raw.MinSpeed, 0, 0)
	local visual = raw.Visual
	local model = raw.Model
	return {
		Origin = origin,
		Direction = Config.direction(raw, origin),
		Speed = SafeMath.number(raw.Speed, if typeof(raw.Beam) == "table" then 2000 else DEFAULT_SPEED, 0),
		Acceleration = acceleration(raw.Acceleration),
		AccelerationDirection = optionalDirection(raw.AccelerationDirection),
		MinSpeed = minSpeed,
		-- math.huge stays the "no cap" sentinel; a cap below MinSpeed is raised to it.
		MaxSpeed = SafeMath.cap(raw.MaxSpeed, minSpeed),
		Gravity = acceleration(raw.Gravity),
		Radius = SafeMath.number(raw.Radius, if typeof(raw.Beam) == "table" then 0.35 else 0, 0),
		Lifetime = SafeMath.number(raw.Lifetime, if typeof(raw.Beam) == "table" then 3 else DEFAULT_LIFETIME, 0),
		MaxRealLifetime = SafeMath.number(raw.MaxRealLifetime, defaultMaxRealLifetime, 0),
		TimeScale = SafeMath.number(raw.TimeScale, 1, 0),
		Damage = SafeMath.number(raw.Damage, 0),
		Source = if typeof(raw.Source) == "table" then raw.Source else nil,
		IgnoreInstances = instanceList(raw.IgnoreInstances),
		Filter = optionalFunction(raw.Filter),
		Bounces = count(raw.Bounces),
		Restitution = SafeMath.number(raw.Restitution, DEFAULT_RESTITUTION, 0),
		Penetration = SafeMath.number(raw.Penetration, 0, 0),
		MaxPierces = count(raw.MaxPierces),
		PierceFalloff = SafeMath.number(raw.PierceFalloff, 0, 0, 1),
		Homing = Config.normalizeHoming(raw.Homing),
		Visualize = raw.Visualize == true,
		VisualRange = SafeMath.cap(raw.VisualRange, 0),
		Model = if typeof(model) == "Instance" then model else nil,
		Visual = if typeof(visual) == "table" then visual else nil,
		VisualScale = SafeMath.number(raw.VisualScale, 1, 0.05, 20),
		Beam = if typeof(raw.Beam) == "table" then {
			Length = SafeMath.number(raw.Beam.Length, 24, 0.05, 512),
			ChannelId = if typeof(raw.Beam.ChannelId) == "number" then math.floor(SafeMath.number(raw.Beam.ChannelId, 1, 1)) else nil,
			PreviousId = if typeof(raw.Beam.PreviousId) == "number" then math.floor(SafeMath.number(raw.Beam.PreviousId, 1, 1)) else nil,
		} else nil,
		DestroyDelay = SafeMath.number(raw.DestroyDelay, 0, 0),
		WaitForParticles = raw.WaitForParticles ~= false,
		WaitForTrails = raw.WaitForTrails ~= false,
		ActivateParticlesOnCreate = raw.ActivateParticlesOnCreate == true,
		OnBounce = optionalFunction(raw.OnBounce),
		RewindSeconds = SafeMath.number(raw.RewindSeconds, 0, 0),
	}
end

-- Burst cone half-angle in degrees.
function Config.spread(raw: Types.Config): number
	return SafeMath.number(raw.Spread, 0, 0, 180)
end

return Config
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Homing</string>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	Projectile/Homing.luau
	Target acquisition and steering. Homing.update(projectile, dt) runs once
	per substep from init.luau's Step; it only ever changes the projectile's
	HomingTarget, its homing timers, and the direction of its Velocity.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ChunkManager = require(Shared:WaitForChild("ChunkManager"))
local Entity = require(Shared:WaitForChild("Entity"))

local Math = require(script.Parent.Math)
local Types = require(script.Parent.Types)

type State = Types.State

local Homing = {}

function Homing.targetPosition(target: Types.HomingTarget?): Vector3?
	if target == nil then
		return nil
	end
	if typeof(target) == "Vector3" then
		return target
	end
	if typeof(target) == "Instance" then
		if target:IsA("BasePart") then
			return target.Position
		elseif target:IsA("Model") then
			return target:GetPivot().Position
		end
		return nil
	end
	-- an Entity
	if target.IsDestroyed then
		return nil
	end
	return target:GetPosition()
end

local function isEligible(projectile: State, homing: Types.Homing, entity: Types.EntityLike): boolean
	if entity == projectile.Source or entity.IsDestroyed then
		return false
	end
	local filter = projectile.Filter
	if filter and not filter(entity) then
		return false
	end
	local tags = homing.TargetTags
	if tags then
		for _, tag in tags do
			if entity:HasTag(tag) then
				return true
			end
		end
		return false
	elseif homing.TargetTag then
		return entity:HasTag(homing.TargetTag)
	end
	return true
end

-- Finds the nearest valid homing target: entities matching TargetTag/TargetTags
-- (or ALL entities if neither given), excluding the projectile's own Source and
-- anything its Filter rejects. Uses ChunkManager's spatial index when
-- AcquireRadius is set (the normal case -- every real spawn site sets one), so
-- cost scales with local entity density, not total entity/projectile count; the
-- unbounded case (rare) falls back to a full scan.
function Homing.acquireTarget(projectile: State, homing: Types.Homing, position: Vector3): Types.EntityLike?
	local function eligible(entity: Types.EntityLike): boolean
		return isEligible(projectile, homing, entity)
	end

	local radius = homing.AcquireRadius
	local candidates: { Types.EntityLike }
	local bestDistance = math.huge
	if radius then
		candidates = ChunkManager.GetEntitiesInRadius(position, radius, { Filter = eligible })
		bestDistance = radius
	else
		candidates = {}
		local pool = if homing.TargetTag then Entity.GetTagged(homing.TargetTag) else Entity.GetAll()
		for _, entity in pool do
			if eligible(entity) then
				table.insert(candidates, entity)
			end
		end
	end

	local best: Types.EntityLike? = nil
	for _, entity in candidates do
		local distance = (entity:GetPosition() - position).Magnitude
		if distance <= bestDistance then
			best, bestDistance = entity, distance
		end
	end
	return best
end

function Homing.update(projectile: State, dt: number)
	local homing = projectile.Homing
	if not homing then
		return
	end

	if projectile.HomingDelay > 0 then
		projectile.HomingDelay -= dt
		return
	end

	-- (re)acquire a target when none / auto-targeting
	local target = projectile.HomingTarget
	local targetGone = target == nil or Homing.targetPosition(target) == nil

	if targetGone then
		if homing.AcquireRadius or homing.TargetTag or homing.TargetTags then
			projectile._acquireTimer -= dt
			if projectile._acquireTimer <= 0 then
				-- Jittered so a burst fired on one frame spreads its searches
				-- across frames instead of spiking together forever.
				projectile._acquireTimer = homing.AcquireInterval * (0.5 + math.random())
				target = Homing.acquireTarget(projectile, homing, projectile.Position)
				projectile.HomingTarget = target
			end
		end
	elseif not homing.Permalock and homing.Retarget then
		projectile.ReacquireTimer -= dt
		if projectile.ReacquireTimer <= 0 then
			projectile.ReacquireTimer = homing.ReacquireRate
			-- No `or target` fallback: if nothing is in range anymore, the lock
			-- is genuinely dropped. Homing.Permalock (checked above) is the
			-- explicit opt-in for "never drop a lock due to range."
			target = Homing.acquireTarget(projectile, homing, projectile.Position)
			projectile.HomingTarget = target
		end
	end

	local goal = Homing.targetPosition(target)
	if not goal then
		return
	end
	local speed = projectile.Velocity.Magnitude
	local newDirection = Math.rotateTowards(projectile.Velocity, goal - projectile.Position, homing.TurnRate * dt)
	projectile.Velocity = newDirection * speed
end

return Homing
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Math</string>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	Projectile/Math.luau
	Pure geometry helpers shared by the other Projectile server modules
	(Homing, RewindHit, init). No projectile/entity state, no side effects.
	Finite-number guards live in Shared.SafeMath.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local SafeMath = require(Shared:WaitForChild("SafeMath"))

local Math = {}

-- Rotate `from` toward `to` by at most `maxAngle` radians; returns a unit vector.
function Math.rotateTowards(from: Vector3, to: Vector3, maxAngle: number): Vector3
	local fromDir = SafeMath.direction(from, Vector3.zAxis)
	local toDir = SafeMath.direction(to, fromDir)
	local dot = math.clamp(fromDir:Dot(toDir), -1, 1)
	local angle = math.acos(dot)
	if angle <= maxAngle or angle < 1e-4 then
		return toDir
	end
	local axis = fromDir:Cross(toDir)
	if axis.Magnitude < 1e-4 then
		-- opposite directions: pick an arbitrary perpendicular axis
		axis = if math.abs(fromDir.Y) < 0.99 then fromDir:Cross(Vector3.yAxis) else fromDir:Cross(Vector3.xAxis)
	end
	return CFrame.fromAxisAngle(axis.Unit, maxAngle):VectorToWorldSpace(fromDir)
end

-- Closest point on segment [a,b] to point p, and the distance to it. Used by
-- lag-compensated hit detection to test a rewound entity position against a
-- substep's movement segment.
function Math.closestPointOnSegment(p: Vector3, a: Vector3, b: Vector3): (Vector3, number)
	local ab = b - a
	local lengthSq = ab:Dot(ab)
	local t = if lengthSq > 1e-8 then math.clamp((p - a):Dot(ab) / lengthSq, 0, 1) else 0
	local closest = a + ab * t
	return closest, (p - closest).Magnitude
end

-- How far along the chord from `from` to `from + displacement` the point
-- lies, as a 0..1 fraction (0 for a degenerate chord).
function Math.chordFraction(from: Vector3, displacement: Vector3, point: Vector3): number
	local lengthSq = displacement:Dot(displacement)
	if not (lengthSq >= 1e-10) then
		return 0
	end
	return math.clamp((point - from):Dot(displacement) / lengthSq, 0, 1)
end

-- Uniformly random direction within `spreadDeg` of the unit vector `dir`.
function Math.coneDirection(dir: Vector3, spreadDeg: number): Vector3
	if not (spreadDeg > 0) then
		return dir
	end
	local spread = math.rad(math.min(spreadDeg, 180))
	-- sqrt for an even areal distribution across the cone
	local theta = math.sqrt(math.random()) * spread
	local roll = math.random() * 2 * math.pi
	local up = if math.abs(dir.Y) < 0.99 then Vector3.yAxis else Vector3.xAxis
	local right = dir:Cross(up).Unit
	local realUp = right:Cross(dir).Unit
	-- Rotate rather than offset by tan(theta): tan blows up toward 90 degrees.
	local radial = right * math.cos(roll) + realUp * math.sin(roll)
	return SafeMath.direction(dir * math.cos(theta) + radial * math.sin(theta), dir)
end

return Math
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Raycast</string>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	Projectile/Raycast.luau
	Physical ray/capsule movement casts, world/entity hit resolution, and wall
	penetration. The resolvers decide what a contact does and apply its
	immediate effects (OnHit, pierce bookkeeping, reflection, nudging past the
	surface), then return a Types.Verdict; lifecycle -- Destroy(), time
	accounting -- stays with the caller in init.luau.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Entity = require(Shared:WaitForChild("Entity"))
local ChunkManager = require(Shared:WaitForChild("ChunkManager"))
local SafeMath = require(Shared:WaitForChild("SafeMath"))

local Replication = require(script.Parent.Replication)
local Types = require(script.Parent.Types)

type State = Types.State
type Verdict = Types.Verdict

local Raycast = {}

-- Clearance when stepping just past a surface after a pass-through contact.
local PASS_CLEARANCE = 0.1
-- Clearance off a surface after a bounce.
local BOUNCE_CLEARANCE = 0.05

-- Built once per projectile and cached on it (Source never changes after
-- construction), reused for every raycast that projectile makes -- Roblox
-- re-evaluates FilterDescendantsInstances against the live scene at cast time, so
-- one instance is safe to reuse across many casts/frames; this only removes the
-- allocation churn of rebuilding it every substep, not a correctness change.
-- NOTE: if a future feature needs to grow the exclude list dynamically (e.g.
-- adding pierced entities instead of the current position-nudge approach),
-- mutating `ignore` in place won't take effect -- FilterDescendantsInstances
-- would need reassigning.
function Raycast.buildRayParams(source: Types.EntityLike?, ignoreInstances: { Instance }?): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = {}
	local sourceInstance = source and source.Instance
	if sourceInstance then
		table.insert(ignore, sourceInstance)
	end
	-- Excluded independently of Source: Source only exists once the firing
	-- entity is registered with the Entity system (see PlayerManager.server.luau),
	-- so a shot fired in the window before that registration lands would
	-- otherwise have nothing excluding the shooter's own character from this
	-- raycast -- IgnoreInstances closes that gap without depending on timing.
	if ignoreInstances then
		table.move(ignoreInstances, 1, #ignoreInstances, #ignore + 1, ignore)
	end
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	return params
end

-- Sweeps the projectile's body along `displacement`. Returns the contact as a
-- plain table (see Types.Contact) or nil. Distance is how far the ray -- or
-- the sphere's center -- travelled, which is what the time accounting in
-- init.luau needs; for a Spherecast, Position is the surface point instead.
function Raycast.castMovement(projectile: State, origin: Vector3, displacement: Vector3, overrideParams: RaycastParams?): Types.Contact?
	local params = overrideParams or projectile._rayParams
	local result
	if projectile.Radius > 0 then
		-- Sweeping a sphere along a line is exactly a capsule: a cylindrical
		-- body of Radius around this segment plus spherical caps at both ends.
		-- Adjacent adaptive substeps share the cap at their common joint, so
		-- curved paths have no wedge-shaped collision gaps.
		result = workspace:Spherecast(origin, projectile.Radius, displacement, params)
	else
		result = workspace:Raycast(origin, displacement, params)
	end
	if not result then
		return nil
	end
	return {
		Position = result.Position,
		Normal = result.Normal,
		Instance = result.Instance,
		Distance = result.Distance,
	}
end

-- Does the chunk containing `position` currently hold any entities? Drives the
-- high/low resolution decision each substep.
function Raycast.chunkHasEntities(position: Vector3): boolean
	local chunk = ChunkManager.GetChunk(position)
	return chunk ~= nil and chunk.EntityCount > 0
end

-- Builds the table passed to every projectile.OnHit listener -- see the
-- "Events" section in init.luau. `entity` is nil for a pure world/wall contact.
function Raycast.buildHitInfo(contact: Types.Contact, entity: Types.EntityLike?, hurtbox: Types.Hurtbox?): Types.HitInfo
	local normal = SafeMath.direction(contact.Normal, Vector3.zAxis)
	return {
		CFrame = CFrame.lookAt(contact.Position, contact.Position + normal),
		Part = contact.Instance,
		Entity = entity,
		Hurtbox = hurtbox,
	}
end

-- Steps the projectile just past `surface` along its direction of travel.
function Raycast.nudgePast(projectile: State, surface: Vector3)
	projectile.Position = surface
		+ SafeMath.direction(projectile.Velocity, Vector3.zAxis) * (projectile.Radius + PASS_CLEARANCE)
end
local nudgePast = Raycast.nudgePast

-- Resolves `entity` being struck at `contact` (by a raycast, or by a
-- lag-compensated rewind check -- see RewindHit). "destroy" means the caller
-- must Destroy(contact, "entity").
function Raycast.resolveEntityHit(
	projectile: State,
	entity: Types.EntityLike,
	contact: Types.Contact,
	hurtbox: Types.Hurtbox?
): Verdict
	if entity == projectile.Source or projectile._ignore[entity] then
		-- can't collide with ourselves or an already-pierced target
		nudgePast(projectile, contact.Position)
		return "pass"
	end
	local filter = projectile.Filter
	if filter and not filter(entity) then
		return "fallthrough"
	end

	projectile.OnHit:Fire(Raycast.buildHitInfo(contact, entity, hurtbox))
	if projectile.PiercesLeft > 0 then
		projectile.PiercesLeft -= 1
		projectile.DamageMultiplier *= (1 - projectile.PierceFalloff)
		projectile._ignore[entity] = true
		nudgePast(projectile, contact.Position)
		return "pass"
	end
	return "destroy"
end

-- Attempts to punch this projectile through the wall it just hit. Probes a
-- point Penetration studs further along the ray past the entry point, then
-- raycasts BACKWARD from that probe to the entry point, whitelisted to ONLY
-- the part that was just hit:
--  - Hit: the wall's far/exit surface lies between the probe and the entry
--    point, i.e. the wall is thinner than the remaining budget. The wall's
--    actual thickness (not the probe distance) is subtracted, so a thin wall
--    barely dents the budget and a thick one nearly exhausts it.
--  - Nil: the probe point is still INSIDE the wall (Roblox raycasts never hit
--    a part they start inside), so the wall is thicker than the budget.
-- Returns the position just past the exit surface, or nil if blocked.
local function attemptPenetration(projectile: State, contact: Types.Contact): Vector3?
	local instance = contact.Instance
	if not instance then
		return nil
	end

	local direction = SafeMath.direction(projectile.Velocity, Vector3.zAxis)
	local probeOrigin = contact.Position + direction * projectile.Penetration

	local probeParams = RaycastParams.new()
	probeParams.FilterType = Enum.RaycastFilterType.Include
	probeParams.FilterDescendantsInstances = { instance }

	local probeResult = workspace:Raycast(probeOrigin, contact.Position - probeOrigin, probeParams)
	if not probeResult then
		return nil
	end

	local thickness = (probeResult.Position - contact.Position).Magnitude
	projectile.Penetration = math.max(projectile.Penetration - thickness, 0)
	return probeResult.Position + direction * (projectile.Radius + PASS_CLEARANCE)
end

-- Resolves a physical cast contact. Returns the verdict and, for "destroy",
-- the kind to Destroy() with. A bounce queues a one-shot ProjMove correction
-- (Bounced = true) -- the ONLY streaming a non-homing bouncing projectile
-- ever gets; it tells rendering clients to snap instead of tween and to
-- re-baseline their local physics (see ProjectileClient).
function Raycast.resolveHit(projectile: State, contact: Types.Contact): (Verdict, string?)
	local instance = contact.Instance
	local entity: Types.EntityLike? = if instance then Entity.Get(instance) else nil

	if entity then
		-- Head/Body classification is purely analytic: the raycast hits
		-- whatever real rig geometry is physically in the way; we just check
		-- whether that hit POINT falls within HeadRadius of the Head center
		-- (see Entity.luau's "Head + Body hurtboxes" section).
		local hurtbox: Types.Hurtbox = "Body"
		local headPosition = entity:GetHeadPosition()
		if headPosition and (contact.Position - headPosition).Magnitude <= entity.HeadRadius then
			hurtbox = "Head"
		end

		local verdict = Raycast.resolveEntityHit(projectile, entity, contact, hurtbox)
		if verdict == "destroy" then
			return "destroy", "entity"
		elseif verdict ~= "fallthrough" then
			-- (cast: Luau widens the refined literal union back to string)
			return verdict :: Verdict, nil
		end
		-- filtered out: treat like world geometry below
	end

	-- Penetration is tried before bouncing; a wall thicker than the remaining
	-- budget falls through to bounce/destroy as if Penetration were 0.
	if projectile.Penetration > 0 then
		local exitPosition = attemptPenetration(projectile, contact)
		if exitPosition then
			projectile.OnHit:Fire(Raycast.buildHitInfo(contact, entity, nil))
			projectile.Position = exitPosition
			return "pass", nil
		end
	end

	if projectile.BouncesLeft > 0 then
		projectile.BouncesLeft -= 1
		local normal = SafeMath.direction(contact.Normal, Vector3.yAxis)
		local velocity = projectile.Velocity
		projectile.Velocity = (velocity - 2 * velocity:Dot(normal) * normal) * projectile.Restitution
		projectile.Position = contact.Position + normal * (projectile.Radius + BOUNCE_CLEARANCE)
		if projectile.Beam and not projectile._spawnStreamed then projectile._beamOrigin = projectile.Position end
		-- Connect the cleared sphere center, not the surface inside its radius.
		if projectile._beamTurns then table.insert(projectile._beamTurns, projectile.Position) end
		-- The client must SNAP on a bounce instead of tweening a straight line
		-- from its pre-bounce position, which would visibly cut through the
		-- surface it bounced off. The snap goes out with this frame's ProjMove
		-- batch (see Replication.queueBounce for why it carries the end-of-frame
		-- pose), even if a later substep this same tick destroys the
		-- projectile; ProjHit is only flushed on a later frame, so the snap
		-- always reaches the client first.
		Replication.queueBounce(projectile, contact.Position, normal)
		local onBounce = projectile.OnBounce
		if onBounce then
			task.spawn(onBounce, projectile, contact)
		end
		projectile.OnHit:Fire(Raycast.buildHitInfo(contact, entity, nil))
		return "bounce", nil
	end

	projectile.OnHit:Fire(Raycast.buildHitInfo(contact, entity, nil))
	return "destroy", "world"
end

return Raycast
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Replication</string>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	Projectile/Replication.luau
	Everything that pushes projectile state from the server to rendering
	clients (see ProjectileClient in ReplicatedStorage.Shared for the
	receiving side, and Shared.ProjectileProtocol for the wire format). The
	server stays authoritative; this module only ever sends -- see the
	top-level Projectile doc comment (init.luau) for the protocol's design.

	Per frame, init.luau's step loop calls, in order:
	 flushHitBatch                   (start of frame, bounded)
	 Step -> updateTimeScale / updateSyncState / queueBounce / queueHit
	 queuePose -> refine/collide beam links
	 flushSpawnBatch                 (completed snapshots, bounded)
	 flushMoveBatch                   (end of frame, bounded round-robin)
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local VisualOffload = require(Shared:WaitForChild("VisualOffload"))
local Protocol = require(Shared:WaitForChild("ProjectileProtocol"))
local Heartbeat = require(Shared:WaitForChild("Heartbeat"))

local Types = require(script.Parent.Types)

type State = Types.State

local Channels = Protocol.Channels

local Replication = {}

-- Bounded per-frame work so one client event never grows without bound.
local MAX_SPAWNS_PER_FRAME = 1000
local MAX_HITS_PER_FRAME = 1000
-- Homing poses are round-robined past this; the cursor advances in real frame
-- order and is never reset by dilation, so changing GlobalTimeScale cannot
-- merge staggered cohorts into one spike.
local MAX_POSES_PER_FRAME = 2500
-- Beam geometry is reconstructed locally. Ballistic safety snapshots are
-- sparse; homing and topology/clipping/time changes are never rate-throttled.
local BEAM_REFRESH = 0.5
local beamSnapshots: { [number]: any } = {}

local function rememberBeam(projectile: State, now: number)
	if not projectile.Beam then return end
	beamSnapshots[projectile.Id] = {
		Time = now, PreviousId = projectile.Beam.PreviousId or 0,
		Clipped = projectile._beamSpanClipped == true,
		Path = table.clone(projectile._beamSpan or {}),
		Scale = Heartbeat.GetGlobalTimeScale(), PersonalScale = projectile._lastStreamedTimeScale,
	}
end

local function beamDue(projectile: State, now: number): boolean
	if projectile.HomingTarget then return true end
	local previous = beamSnapshots[projectile.Id]
	if not previous then return true end
	if previous.PreviousId ~= (projectile.Beam.PreviousId or 0)
		or previous.Clipped ~= (projectile._beamSpanClipped == true)
		or previous.Scale ~= Heartbeat.GetGlobalTimeScale()
		or previous.PersonalScale ~= projectile._lastStreamedTimeScale then return true end
	local path = projectile._beamSpan or {}
	if #path ~= #previous.Path then return true end
	-- Bend vertices and clipped endpoints are world anchors, not predictions.
	for index = 2, #path - (if projectile._beamSpanClipped then 0 else 1) do
		if (path[index] - previous.Path[index]).Magnitude > 0.05 then return true end
	end
	return now - previous.Time >= BEAM_REFRESH
end

-- When on, prints every ProjSpawn/ProjSync/ProjTimeScale/ProjHit as it is
-- streamed (individually rare enough to log one line each), plus a
-- once-a-second rate summary for ProjMove. Toggled via Projectile.SetDebugSync.
Replication.DebugSync = false

-- One queued, range-limited message payload.
type Entry = {
	Range: number,
	Position: Vector3,
	Payload: any,
	Recipients: { [Player]: boolean }?,
}

type BounceSnap = {
	Projectile: State,
	Point: Vector3,
	Normal: Vector3,
	Corrected: boolean?,
}

local spawnQueue: { State } = {}
local spawnQueueHead = 1
local hitQueue: { Entry } = {}
local hitQueueHead = 1
local pendingBounces: { BounceSnap } = {} -- flushed with this frame's ProjMove
local pendingBounceHead = 1
local poseCandidates: { State } = {} -- homing and beam correction candidates
local poseCursor = 1
local moveStats = { batches = 0, entries = 0 }
local beamStats = { Candidates = 0, Updates = 0 }

-- Only finite-range visuals need interest bookkeeping. Unlimited-range
-- stress tests retain the broadcast fast path. The persistent cursor limits
-- re-entry checks independently of simulation/dilation and spawn cohorts.
local interests: { [number]: { Projectile: State, Observers: { [Player]: boolean } } } = {}
local interestOrder: { number } = {}
local interestCursor = 1
local interestCount = 0
local frameRoots: { [Player]: BasePart }? = nil

local function playerRoots(): { [Player]: BasePart }
	local roots: { [Player]: BasePart } = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character.PrimaryPart
		if root then
			roots[player] = root
		end
	end
	return roots
end

-- Sends each entry to every player within its Range (everyone when the range
-- is unlimited), as ONE event per recipient no matter how many entries.
local function fanOut(channel: string, entries: { Entry })
	if #entries == 0 then
		return
	end
	local broadcast: { any } = {}
	local perPlayer: { [Player]: { any } } = {}
	local roots: { [Player]: BasePart }? = nil
	for _, entry in entries do
		if entry.Recipients then
			for player in entry.Recipients do
				if not player.Parent then continue end
				local list = perPlayer[player] or {}
				perPlayer[player] = list
				table.insert(list, entry.Payload)
			end
		elseif entry.Range >= math.huge then
			table.insert(broadcast, entry.Payload)
		else
			roots = roots or playerRoots()
			for player, root in roots :: { [Player]: BasePart } do
				if (root.Position - entry.Position).Magnitude <= entry.Range then
					local list = perPlayer[player]
					if not list then
						list = {}
						perPlayer[player] = list
					end
					table.insert(list, entry.Payload)
				end
			end
		end
	end
	if #broadcast > 0 then
		VisualOffload.Fire(channel, broadcast)
	end
	for player, list in perPlayer do
		VisualOffload.FireClient(player, channel, list)
	end
end

-- Sends one immediate (unbatched) message about `projectile`.
local function streamTo(projectile: State, channel: string, payload: any)
	if not projectile.Visualize then
		return
	end
	-- State changes that happen while a visual is still waiting in the bounded
	-- spawn queue are folded into its eventual spawn snapshot. Sending them
	-- first would create out-of-order client state for visuals not built yet.
	if not projectile._spawnStreamed then
		return
	end
	if projectile.VisualRange >= math.huge then
		VisualOffload.Fire(channel, payload)
		return
	end
	local interest = interests[projectile.Id]
	for player in interest and interest.Observers or {} do
		if player.Parent then
			VisualOffload.FireClient(player, channel, payload)
		end
	end
end

-- Ordinary homing retains its pose stream. Beam endpoints are predicted at
-- one common client epoch, with sparse ballistic snapshots and immediate
-- authoritative steering/topology/clipping/bounce corrections.
function Replication.isSynced(projectile: State): boolean
	return projectile.HomingTarget ~= nil and projectile.Beam == nil
end

-- Fields equal to ProjectileClient's defaults are omitted: remote events
-- serialize every key name per entry, so at batch sizes the defaults were most
-- of the spawn bandwidth.
local function spawnPayload(projectile: State): Protocol.SpawnPayload
	local payload: Protocol.SpawnPayload = {
		Id = projectile.Id,
		Position = projectile.Position,
		Velocity = projectile.Velocity,
		Lifetime = math.max(projectile.Lifetime - projectile.Age, 0),
		MaxRealLifetime = math.max(projectile.MaxRealLifetime - (os.clock() - projectile._spawnRealTime), 0),
		AccelerationDirection = projectile.AccelerationDirection,
		Model = projectile.Model,
		Visual = projectile.Visual,
	}
	if projectile.Gravity ~= 0 then payload.Gravity = projectile.Gravity end
	if projectile.Acceleration ~= 0 then payload.Acceleration = projectile.Acceleration end
	if projectile.MinSpeed ~= 0 then payload.MinSpeed = projectile.MinSpeed end
	if projectile.MaxSpeed ~= math.huge then payload.MaxSpeed = projectile.MaxSpeed end
	if Replication.isSynced(projectile) then payload.Synced = true end
	if projectile._lastStreamedTimeScale ~= 1 then payload.TimeScale = projectile._lastStreamedTimeScale end
	if projectile.VisualScale ~= 1 then payload.VisualScale = projectile.VisualScale end
	if projectile.Beam then
		payload.ServerTime = workspace:GetServerTimeNow()
		payload.GlobalScale = Heartbeat.GetGlobalTimeScale()
		payload.Beam = { Length = projectile.Beam.Length, Radius = projectile.Radius,
			Origin = if projectile.Beam.ChannelId then projectile.Position else projectile._beamOrigin or projectile.Position,
			ChannelId = projectile.Beam.ChannelId, PreviousId = projectile.Beam.PreviousId,
			Path = projectile._beamSpan, Clipped = projectile._beamSpanClipped }
	end
	if projectile.DestroyDelay ~= 0 then payload.DestroyDelay = projectile.DestroyDelay end
	if not projectile.WaitForParticles then payload.WaitForParticles = false end
	if not projectile.WaitForTrails then payload.WaitForTrails = false end
	if projectile.ActivateParticlesOnCreate then payload.ActivateParticlesOnCreate = true end
	return payload
end

--------------------------------------------------------------------------------
-- Lifecycle messages
--------------------------------------------------------------------------------

-- Queues the visual's creation; it spawns from its latest pose when flushed.
function Replication.spawnVisual(projectile: State)
	if not projectile.Visualize then
		return
	end
	if Replication.DebugSync then
		print(`[Relativity][sync] queued ProjSpawn Id={projectile.Id} Synced={Replication.isSynced(projectile)}`)
	end
	table.insert(spawnQueue, projectile)
end

-- Destruction is queued for the same reason creation is: a mass expiry must
-- become a few bounded batch messages, not thousands of individual remote
-- invocations in one frame. A projectile that dies before its queued spawn
-- was streamed needs no hit message because no client visual exists yet.
function Replication.queueHit(projectile: State, info: Types.DestroyInfo)
	beamSnapshots[projectile.Id] = nil
	if Replication.DebugSync then
		print(`[Relativity][sync] ProjHit Id={projectile.Id} Kind={info.Kind or "fizzle"}`)
	end
	if not projectile.Visualize or not projectile._spawnStreamed then
		return
	end
	local payload: Protocol.HitPayload = {
		Id = projectile.Id,
		Position = info.Position,
		Normal = info.Normal,
		Kind = info.Kind,
		BeamBody = projectile._beamBodyHit,
		BeamPath = projectile._beamSpan,
		BeamClipped = projectile._beamSpanClipped,
	}
	local interest = interests[projectile.Id]
	table.insert(hitQueue, { Range = projectile.VisualRange, Position = info.Position, Payload = payload,
		Recipients = interest and table.clone(interest.Observers) })
	interests[projectile.Id] = nil
	if interest then interestCount -= 1 end
end

-- Compacts a head-indexed queue once its consumed prefix dominates it.
local function compact<T>(queue: { T }, head: number): ({ T }, number)
	if head > #queue then
		table.clear(queue)
		return queue, 1
	elseif head > 4096 and head > #queue / 2 then
		return table.move(queue, head, #queue, 1, {}), 1
	end
	return queue, head
end

function Replication.flushHitBatch()
	local batch: { Entry } = {}
	local last = math.min(#hitQueue, hitQueueHead + MAX_HITS_PER_FRAME - 1)
	for index = hitQueueHead, last do
		table.insert(batch, hitQueue[index])
	end
	hitQueue, hitQueueHead = compact(hitQueue, last + 1)
	fanOut(Channels.HitBatch, batch)
end

-- Sends at most MAX_SPAWNS_PER_FRAME new visuals per frame, combined into one
-- RemoteEvent per recipient. Simulation starts immediately on the server;
-- queued visuals spawn from their latest authoritative pose, so batching never
-- rewinds or slows gameplay.
function Replication.flushSpawnBatch()
	frameRoots = playerRoots()
	local batch: { Entry } = {}
	local exits: { [Player]: { number } } = {}
	local remaining = MAX_SPAWNS_PER_FRAME
	local last = math.min(#spawnQueue, spawnQueueHead + remaining - 1)
	for index = spawnQueueHead, last do
		local projectile = spawnQueue[index]
		if projectile.Dead then continue end
		projectile._spawnStreamed = true
		local payload = spawnPayload(projectile)
		projectile._streamedSynced = payload.Synced == true
		rememberBeam(projectile, workspace:GetServerTimeNow())
		local recipients
		if projectile.VisualRange < math.huge then
			recipients = {}
			for player, root in frameRoots :: { [Player]: BasePart } do
				if (root.Position-projectile.Position).Magnitude <= projectile.VisualRange then recipients[player] = true end
			end
			interests[projectile.Id] = { Projectile = projectile, Observers = recipients }
			interestCount += 1
			table.insert(interestOrder, projectile.Id)
		end
		table.insert(batch, { Range = projectile.VisualRange, Position = projectile.Position, Payload = payload, Recipients = recipients })
		remaining -= 1
	end
	spawnQueue, spawnQueueHead = compact(spawnQueue, last + 1)
	-- At most 2500 checks and 1000 creation/re-entry snapshots in a frame.
	-- Hysteresis prevents churn when the player sits on the range boundary.
	for _ = 1, math.min(#interestOrder, MAX_POSES_PER_FRAME) do
		if interestCursor > #interestOrder then interestCursor = 1 end
		local id = interestOrder[interestCursor]
		interestCursor += 1
		local interest = interests[id]
		if not interest then continue end
		local projectile, observers = interest.Projectile, interest.Observers
		local entering: { [Player]: boolean } = {}
		for player in observers do
			local root = (frameRoots :: { [Player]: BasePart })[player]
			if not root or (root.Position-projectile.Position).Magnitude > projectile.VisualRange*1.1+8 then
				observers[player] = nil
				if player.Parent then
					local list = exits[player] or {}; exits[player] = list
					table.insert(list, id)
				end
			end
		end
		for player, root in frameRoots :: { [Player]: BasePart } do
			if not observers[player] and remaining > 0 and (root.Position-projectile.Position).Magnitude <= projectile.VisualRange then
				entering[player], observers[player] = true, true
			end
		end
		if next(entering) then
			table.insert(batch, { Range = projectile.VisualRange, Position = projectile.Position,
				Payload = spawnPayload(projectile), Recipients = entering })
			remaining -= 1
		end
	end
	for player, ids in exits do VisualOffload.FireClient(player, Channels.RangeExit, ids) end
	fanOut(Channels.SpawnBatch, batch)
	if #interestOrder > 4096 and #interestOrder > 2*interestCount then
		local ordered = {}
		for offset = 0, #interestOrder-1 do
			local id = interestOrder[(interestCursor+offset-1)%#interestOrder+1]
			if interests[id] then table.insert(ordered,id) end
		end
		interestOrder, interestCursor = ordered, 1
	end
end
function Replication.getQueueStats()
	return {
		VisualSpawnsPerFrame = MAX_SPAWNS_PER_FRAME,
		VisualHitsPerFrame = MAX_HITS_PER_FRAME,
		PendingVisualSpawns = math.max(#spawnQueue - spawnQueueHead + 1, 0),
		PendingVisualHits = math.max(#hitQueue - hitQueueHead + 1, 0),
		BeamPoseCandidates = beamStats.Candidates,
		BeamPoseUpdates = beamStats.Updates,
		BeamRefreshInterval = BEAM_REFRESH,
		BeamHomingRefreshInterval = 0,
	}
end

--------------------------------------------------------------------------------
-- State changes (sent immediately, only when something actually changed)
--------------------------------------------------------------------------------

-- Tells clients the combined Source.TimeScale * projectile.TimeScale only
-- when it CHANGES -- see the "Local time" section in init.luau. In the common
-- case (nobody touches it after firing) this never fires after spawn.
function Replication.updateTimeScale(projectile: State, combinedScale: number)
	if combinedScale == projectile._lastStreamedTimeScale then
		return
	end
	projectile._lastStreamedTimeScale = combinedScale
	if Replication.DebugSync then
		print(`[Relativity][sync] ProjTimeScale Id={projectile.Id} TimeScale={combinedScale}`)
	end
	local payload: Protocol.TimeScalePayload = { Id = projectile.Id, TimeScale = combinedScale }
	streamTo(projectile, Channels.TimeScale, payload)
end

-- Tells clients only when the homing-sync state actually changed. True
-- switches the client into "trust the continuous ProjMove stream" mode; false
-- switches it back to local physics. The authoritative pose rides on this
-- message: it is sent immediately (mid-step) over the same ordered remote as
-- ProjMove, so a separate end-of-frame pose would arrive after the client had
-- already left synced mode and be discarded -- and the round-robin cap could
-- skip it entirely.
function Replication.updateSyncState(projectile: State)
	local synced = Replication.isSynced(projectile)
	if synced == projectile._streamedSynced then
		return
	end
	projectile._streamedSynced = synced
	if Replication.DebugSync then
		print(`[Relativity][sync] ProjSync Id={projectile.Id} Synced={synced}`)
	end
	local payload: Protocol.SyncPayload = {
		Id = projectile.Id,
		Synced = synced,
		Position = projectile.Position,
		Velocity = projectile.Velocity,
	}
	streamTo(projectile, Channels.Sync, payload)
end

-- Debug visualization of one movement cast (see Projectile.SetDebugRays).
function Replication.streamRay(projectile: State, from: Vector3, to: Vector3, lowRes: boolean)
	local payload: Protocol.RayPayload = { From = from, To = to, LowRes = lowRes }
	streamTo(projectile, Channels.Ray, payload)
end

--------------------------------------------------------------------------------
-- Pose stream (ProjMove)
--------------------------------------------------------------------------------

-- One-shot bounce snap (see Raycast.resolveHit). Queued rather than fired so
-- a volley bouncing off one floor costs one event per recipient, not one per
-- projectile. Ordering still holds: this frame's flushMoveBatch sends it, and
-- any ProjHit for the same projectile is flushed at the start of a LATER frame.
-- Only the contact point/normal are captured now; the snapped pose is read at
-- flush time, i.e. the end-of-frame pose, the same time base as ProjSpawn and
-- the homing stream. A mid-frame pose would leave the client behind by the
-- rest of the frame the server kept simulating after the bounce.
function Replication.queueBounce(projectile: State, point: Vector3, normal: Vector3)
	if not projectile.Visualize or not projectile._spawnStreamed then
		return
	end
	table.insert(pendingBounces, { Projectile = projectile, Point = point, Normal = normal })
end

function Replication.queueCorrection(projectile: State, point: Vector3, normal: Vector3)
	if not projectile.Visualize or not projectile._spawnStreamed then return end
	table.insert(pendingBounces, { Projectile = projectile, Point = point, Normal = normal, Corrected = true })
end

-- Collects homing/beam candidates. Beam cadence and topology are checked AFTER
-- link refinement; payloads are built only for the bounded slice actually sent.
function Replication.queuePose(projectile: State)
	if projectile.Visualize and projectile._spawnStreamed and (projectile._streamedSynced or projectile.Beam ~= nil) then
		table.insert(poseCandidates, projectile)
	end
end

local function poseEntry(projectile: State): Entry
	local payload: Protocol.MovePayload = {
		Id = projectile.Id,
		Position = projectile.Position,
		Velocity = projectile.Velocity,
		BeamPath = projectile._beamSpan,
		BeamClipped = projectile._beamSpanClipped,
		BeamPreviousId = if projectile.Beam then projectile.Beam.PreviousId or 0 else nil,
		ServerTime = if projectile.Beam then workspace:GetServerTimeNow() else nil,
		GlobalScale = if projectile.Beam then Heartbeat.GetGlobalTimeScale() else nil,
		TimeScale = if projectile.Beam then projectile._lastStreamedTimeScale else nil,
		Lifetime = if projectile.Beam then math.max(projectile.Lifetime-projectile.Age, 0) else nil,
	}
	local interest = interests[projectile.Id]
	return { Range = projectile.VisualRange, Position = projectile.Position, Payload = payload,
		Recipients = if projectile.VisualRange < math.huge then interest and interest.Observers or {} else nil }
end

-- Sends this frame's bounce snaps plus a bounded round-robin slice of the
-- queued homing poses, as one ProjMove event per recipient.
function Replication.flushMoveBatch()
	local batch: { Entry } = {}
	local now = workspace:GetServerTimeNow()
	local sent: { [number]: boolean } = {}
	local lastBounce = math.min(#pendingBounces, pendingBounceHead+MAX_POSES_PER_FRAME-1)
	for index = pendingBounceHead, lastBounce do
		local bounce = pendingBounces[index]
		local projectile = bounce.Projectile
		local payload: Protocol.MovePayload = {
			Id = projectile.Id,
			Position = projectile.Position,
			Velocity = projectile.Velocity,
			Bounced = if bounce.Corrected then nil else true,
			Corrected = bounce.Corrected,
			BeamPreviousId = if projectile.Beam then projectile.Beam.PreviousId or 0 else nil,
			ServerTime = if projectile.Beam then now else nil,
			GlobalScale = if projectile.Beam then Heartbeat.GetGlobalTimeScale() else nil,
			TimeScale = if projectile.Beam then projectile._lastStreamedTimeScale else nil,
			BeamPath = projectile._beamSpan,
			BeamClipped = projectile._beamSpanClipped,
			Lifetime = if projectile.Beam then math.max(projectile.Lifetime-projectile.Age, 0) else nil,
			Point = bounce.Point,
			Normal = bounce.Normal,
		}
		local interest = interests[projectile.Id]
		sent[projectile.Id] = true
		if projectile.Beam then beamStats.Updates += 1 end
		if not projectile.Dead then rememberBeam(projectile, now) end
		table.insert(batch, { Range = projectile.VisualRange, Position = projectile.Position, Payload = payload,
			Recipients = if projectile.VisualRange < math.huge then interest and interest.Observers or {} else nil })
	end
	pendingBounces, pendingBounceHead = compact(pendingBounces, lastBounce+1)

	local due = {}
	for _, projectile in poseCandidates do
		if projectile.Beam then beamStats.Candidates += 1 end
		if not projectile.Dead and not sent[projectile.Id]
			and (not projectile.Beam or beamDue(projectile, now)) then table.insert(due, projectile) end
	end
	table.clear(poseCandidates)
	local candidateCount = #due
	if candidateCount > 0 then
		local updateCount = math.min(candidateCount, math.max(MAX_POSES_PER_FRAME-#batch, 0))
		if poseCursor > candidateCount then
			poseCursor = (poseCursor - 1) % candidateCount + 1
		end
		for offset = 0, updateCount - 1 do
			local projectile = due[(poseCursor + offset - 1) % candidateCount + 1]
			table.insert(batch, poseEntry(projectile))
			if projectile.Beam then beamStats.Updates += 1 end
			rememberBeam(projectile, now)
		end
		poseCursor = (poseCursor + updateCount - 1) % candidateCount + 1
	else
		poseCursor = 1
	end

	if Replication.DebugSync and #batch > 0 then
		moveStats.batches += 1
		moveStats.entries += #batch
	end
	fanOut(Channels.Move, batch)
end

-- Once-a-second ProjMove rate summary (see DebugSync) -- real time, not
-- dilated, so the reporting cadence stays steady even mid-freeze.
task.spawn(function()
	while true do
		task.wait(1)
		if Replication.DebugSync and moveStats.batches > 0 then
			print(`[Relativity][sync] ProjMove rate: {moveStats.batches} batches/s, {moveStats.entries} projectile-updates/s`)
		end
		moveStats.batches = 0
		moveStats.entries = 0
	end
end)

return Replication
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">RewindHit</string>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
	Projectile/RewindHit.luau
	Lag-compensated ("rewound") entity hit detection -- the authoritative hit
	check for any shot fired with RewindSeconds > 0 (see Shooter.server.luau),
	which in practice is almost every real networked shot.

	RewindHit.check only answers "which entity, if any, does this segment hit
	from the shooter's point of view"; resolving what the hit does (pierce,
	destroy, events) is Raycast.resolveEntityHit's job.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Entity = require(Shared:WaitForChild("Entity"))
local ChunkManager = require(Shared:WaitForChild("ChunkManager"))
local SafeMath = require(Shared:WaitForChild("SafeMath"))

local Math = require(script.Parent.Math)
local Types = require(script.Parent.Types)

type State = Types.State

type Candidate = {
	entity: Types.EntityLike,
	point: Vector3,
	distAlong: number,
	hurtbox: Types.Hurtbox,
}

local RewindHit = {}

-- Reused by every check (the server step is single-threaded, and each check
-- drains it before returning) to avoid per-substep allocation churn.
local candidates: { Candidate } = {}

local function byDistance(a: Candidate, b: Candidate): boolean
	return a.distAlong < b.distAlong
end

-- Lag-compensated entity check for one movement substep. Only meaningful while
-- passing through a chunk that contains entities (see `highRes` in init.luau's
-- Step) and only for shots that carry a positive RewindSeconds. Builds its
-- hurtbox whitelist directly from the (loaded) chunk(s) the segment touches --
-- not a radius sweep -- so a projectile only ever considers entities actually
-- in a loaded chunk it's in, per-shooter-desync.
--
-- Two memoization/deferral choices preserve the exact "nearest in-range entity
-- with a clear LOS to `from`" semantics while cutting redundant work:
--  - The rewind instant (os.clock() - RewindSeconds) is pinned for the whole
--    Step (see init.luau), and each entity's rewound position is memoized in
--    projectile._rewindCache, so an entity rewinds once per frame rather than
--    once per substep.
--  - LOS verification is deferred: in-range candidates are sorted nearest
--    first and LOS-checked in that order, so the raycast count is the rank of
--    the nearest clear candidate rather than every candidate.
-- Returns entity, contact point, surface normal, hurtbox -- or nil.
function RewindHit.check(
	projectile: State,
	from: Vector3,
	to: Vector3
): (Types.EntityLike?, Vector3?, Vector3?, Types.Hurtbox?)
	local whitelist: { [Types.EntityLike]: boolean } = {}
	for _, position in { from, to } do
		local chunk = ChunkManager.GetChunk(position)
		if chunk and ChunkManager.IsChunkActive(chunk) then
			for entity in chunk.Entities do
				whitelist[entity] = true
			end
		end
	end

	-- Each entity is tested against BOTH its rewound Head and Body spheres --
	-- Head is checked first and wins outright if in range (the two spheres
	-- are independent, not required to nest -- see Entity.luau).
	local filter = projectile.Filter
	local cache = projectile._rewindCache
	for entity in whitelist do
		if entity ~= projectile.Source and not projectile._ignore[entity] and (not filter or filter(entity)) then
			local rewound = cache[entity]
			if not rewound then
				rewound = {
					Body = entity:GetBodyPositionAt(projectile._rewindTime),
					Head = entity:GetHeadPositionAt(projectile._rewindTime),
				}
				cache[entity] = rewound
			end

			local head = rewound.Head
			local matchedHead = false
			if head then
				local closest, distance = Math.closestPointOnSegment(head, from, to)
				if distance <= entity.HeadRadius + projectile.Radius then
					local candidate: Candidate = {
						entity = entity,
						point = closest,
						distAlong = (closest - from).Magnitude,
						hurtbox = "Head",
					}
					table.insert(candidates, candidate)
					matchedHead = true
				end
			end
			if not matchedHead then
				local closest, distance = Math.closestPointOnSegment(rewound.Body, from, to)
				if distance <= entity.HitboxRadius + projectile.Radius then
					local candidate: Candidate = {
						entity = entity,
						point = closest,
						distAlong = (closest - from).Magnitude,
						hurtbox = "Body",
					}
					table.insert(candidates, candidate)
				end
			end
		end
	end

	table.sort(candidates, byDistance)

	for _, candidate in candidates do
		-- line-of-sight: real geometry must not block the shot before it would
		-- reach this point, so stale rewound data can never be used to hit
		-- someone through a wall. The hit instance must not belong to the
		-- candidate itself, so a target's own body can't block hitting it.
		local los = workspace:Raycast(from, candidate.point - from, projectile._rayParams)
		local blocked = los ~= nil
			and (los.Position - from).Magnitude < candidate.distAlong - 0.5
			and Entity.Get(los.Instance) ~= candidate.entity
		if not blocked then
			table.clear(candidates)
			return candidate.entity,
				candidate.point,
				SafeMath.direction(from - candidate.point, Vector3.yAxis),
				candidate.hurtbox
		end
	end

	table.clear(candidates)
	return nil, nil, nil, nil
end

return RewindHit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Types</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Projectile/Types.luau
	Shared type definitions for the server projectile modules. No runtime
	behaviour. Entity.luau and Signal.luau are not strictly typed, so the
	parts of them this system relies on are described structurally here.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ProjectileMotion = require(Shared:WaitForChild("ProjectileMotion"))
local Protocol = require(Shared:WaitForChild("ProjectileProtocol"))

export type Acceleration = ProjectileMotion.Acceleration
export type VisualSpec = Protocol.VisualSpec

export type Hurtbox = "Head" | "Body"

export type EntityLike = {
	Instance: Instance?,
	TimeScale: number?,
	IsDestroyed: boolean,
	Health: number,
	HeadRadius: number,
	HitboxRadius: number,
	GetPosition: (self: any) -> Vector3,
	GetHeadPosition: (self: any) -> Vector3?,
	GetBodyPositionAt: (self: any, time: number) -> Vector3,
	GetHeadPositionAt: (self: any, time: number) -> Vector3?,
	HasTag: (self: any, tag: string) -> boolean,
}

export type Connection = {
	Disconnect: (self: any) -> (),
}

export type Signal<T> = {
	Connect: (self: any, fn: (T) -> ()) -> Connection,
	Fire: (self: any, value: T) -> (),
	Destroy: (self: any) -> (),
}

export type HomingTarget = EntityLike | Instance | Vector3

-- A world contact: a RaycastResult converted to a plain table, or a
-- synthetic contact (lag-compensated hit, bounce, expiry).
export type Contact = {
	Position: Vector3,
	Normal: Vector3,
	Instance: Instance?,
	Distance: number?,
}

-- Payload of projectile.OnHit -- see the "Events" section in init.luau.
export type HitInfo = {
	CFrame: CFrame,
	Part: Instance?,
	Entity: EntityLike?,
	Hurtbox: Hurtbox?,
}

-- Payload of projectile.OnDestroy.
export type DestroyInfo = {
	Position: Vector3,
	Normal: Vector3,
	Kind: string?,
}

-- Caller-facing homing options. Every field is optional and unvalidated.
export type HomingOptions = {
	Target: HomingTarget?,
	TargetTag: string?,
	TargetTags: { string }?,
	AcquireRadius: number?,
	Retarget: boolean?,
	ReacquireRate: number?,
	AcquireInterval: number?,
	Permalock: boolean?,
	TurnRate: number?,
	Delay: number?,
}

-- Validated homing settings (see Config.normalizeHoming).
export type Homing = {
	Target: HomingTarget?,
	TargetTag: string?,
	TargetTags: { string }?,
	AcquireRadius: number?,
	Retarget: boolean,
	ReacquireRate: number,
	AcquireInterval: number,
	Permalock: boolean,
	TurnRate: number,
	Delay: number,
}

-- Caller-facing Projectile.new config -- see the module doc comment in
-- init.luau for what each field means. Every value is treated as untrusted
-- and normalized by Config.normalize before use.
export type Config = {
	Origin: Vector3?,
	Direction: Vector3?,
	TargetPosition: Vector3?,
	Speed: number?,
	Acceleration: Acceleration?,
	AccelerationDirection: Vector3?,
	MinSpeed: number?,
	MaxSpeed: number?,
	Lifetime: number?,
	MaxRealLifetime: number?,
	TimeScale: number?,
	Damage: number?,
	Source: EntityLike?,
	-- `{ any }` rather than `{ Instance }`: table types are invariant, so a
	-- caller's `{ Model }` would not type-check. Non-Instances are dropped
	-- by Config.normalize.
	IgnoreInstances: { any }?,
	Filter: ((entity: EntityLike) -> boolean)?,
	Gravity: Acceleration?,
	Radius: number?,
	Bounces: number?,
	Restitution: number?,
	Penetration: number?,
	MaxPierces: number?,
	PierceFalloff: number?,
	Homing: HomingOptions?,
	Visualize: boolean?,
	VisualRange: number?,
	Model: Instance?,
	Visual: VisualSpec?,
	VisualScale: number?,
	Beam: { Length: number?, ChannelId: number?, PreviousId: number? }?, -- linked sustained stream
	DestroyDelay: number?,
	WaitForParticles: boolean?,
	WaitForTrails: boolean?,
	ActivateParticlesOnCreate: boolean?,
	OnBounce: ((projectile: any, contact: Contact) -> ())?,
	RewindSeconds: number?,
	Spread: number?, -- Projectile.Burst only
}

-- Live projectile state. Public (PascalCase) fields are readable and
-- writable by abilities; underscore fields are internal bookkeeping.
export type State = {
	Id: number,
	Position: Vector3,
	Velocity: Vector3,
	Speed: number,
	Acceleration: Acceleration,
	AccelerationDirection: Vector3?,
	MinSpeed: number,
	MaxSpeed: number,
	Gravity: Acceleration,
	Radius: number,

	Lifetime: number,
	Age: number,
	MaxRealLifetime: number,
	TimeScale: number,

	Damage: number,
	DamageMultiplier: number,
	Source: EntityLike?,
	IgnoreInstances: { Instance }?,
	Filter: ((entity: EntityLike) -> boolean)?,

	BouncesLeft: number,
	Restitution: number,
	Penetration: number,
	PiercesLeft: number,
	PierceFalloff: number,

	Homing: Homing?,
	HomingDelay: number,
	HomingTarget: HomingTarget?,
	ReacquireTimer: number,

	Visualize: boolean,
	VisualRange: number,
	Model: Instance?,
	Visual: VisualSpec?,
	VisualScale: number,
	Beam: { Length: number, ChannelId: number?, PreviousId: number? }?,
	DestroyDelay: number,
	WaitForParticles: boolean,
	WaitForTrails: boolean,
	ActivateParticlesOnCreate: boolean,

	OnHit: Signal<HitInfo>,
	OnDestroy: Signal<DestroyInfo>,
	OnBounce: ((projectile: any, contact: Contact) -> ())?,

	RewindSeconds: number,
	Dead: boolean,

	_spawnRealTime: number,
	_acquireTimer: number,
	_ignore: { [EntityLike]: boolean },
	_rewindTime: number,
	_rewindCache: { [EntityLike]: { Body: Vector3, Head: Vector3? } },
	_simulationDebt: number,
	_rayParams: RaycastParams,
	_spawnStreamed: boolean,
	_streamedSynced: boolean,
	_lastStreamedTimeScale: number,
	_beamOrigin: Vector3?,
	_beamTurns: { Vector3 }?,
	_beamPrevious: any?,
	_beamBodyHit: boolean?,
	_beamSpan: { Vector3 }?,
	_beamSpanClipped: boolean?,
	_beamJoiner: boolean?, -- independently simulated/colliding subdivision
	_beamJoinerWorldStop: boolean?,
	_beamReserveChildren: ((number) -> boolean)?,
	_beamBindChild: ((any, number) -> ())?,
	_beamScaleEnergy: ((number) -> ())?,
}

-- What a hit resolver decided:
--  "pass"        keeps flying on the same trajectory (pierce, penetration,
--                or nudging past an ignored/rewound-away entity)
--  "bounce"      reflected; the client is re-baselined by a bounce snap
--  "destroy"     the caller must Destroy() with the returned kind
--  "fallthrough" entity filtered out; resolve as world geometry instead
export type Verdict = "pass" | "bounce" | "destroy" | "fallthrough"

-- ModuleScripts must return exactly one non-nil value.
return {}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">ProjectileParallel</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Parallel, read-only projectile math coordinator.

	Actors compute acceleration/curvature hints and bounded homing target scores
	from immutable snapshots.
	This module alone consumes their SharedTable results and publishes hints to
	the authoritative projectile loop. Workers never mutate projectile objects,
	active arrays, entities, signals, Instances, or replication state.
]]

local SharedTableRegistry = game:GetService("SharedTableRegistry")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChunkManager = require(Shared:WaitForChild("ChunkManager"))
local Entity = require(Shared:WaitForChild("Entity"))

local ProjectileParallel = {}

local MIN_PARALLEL_PROJECTILES = 128
local HINT_MAX_AGE_FRAMES = 120
local HOMING_HINT_MAX_AGE_FRAMES = 4

type Worker = {
	actor: Actor,
	input: SharedTable,
	output: SharedTable,
	homingInput: SharedTable,
	homingOutput: SharedTable,
	generation: number,
	pending: any?,
}

local workers: { Worker } = {}
local knownActors: { [Actor]: boolean } = {}
local hints: { [number]: any } = {}
local homingHints: { [number]: any } = {}
local frame = 0
local parallelEnabled = false
local stats = {
	BatchesDispatched = 0,
	ItemsDispatched = 0,
	BatchesCompleted = 0,
	ItemsCompleted = 0,
	BusyWorkers = 0,
	HintHits = 0,
	HintMisses = 0,
	HomingJobsDispatched = 0,
	HomingCandidatesTested = 0,
	HomingHintHits = 0,
	HomingHintMisses = 0,
}

local function refreshWorkers()
	local folder = script.Parent:FindFirstChild("ProjectileActors")
	if not folder then return end
	for _, child in folder:GetChildren() do
		if child:IsA("Actor") and not knownActors[child] then
			local id = tonumber(string.match(child.Name, "(%d+)$"))
			if id then
				knownActors[child] = true
				table.insert(workers, {
					actor = child,
					input = SharedTableRegistry:GetSharedTable(`RelativityProjectileInput{id}`),
					output = SharedTableRegistry:GetSharedTable(`RelativityProjectileOutput{id}`),
					homingInput = SharedTableRegistry:GetSharedTable(`RelativityProjectileHomingInput{id}`),
					homingOutput = SharedTableRegistry:GetSharedTable(`RelativityProjectileHomingOutput{id}`),
					generation = 0,
					pending = nil,
				})
			end
		end
	end
	table.sort(workers, function(a, b) return a.actor.Name < b.actor.Name end)
end

function ProjectileParallel.Collect()
	refreshWorkers()
	for _, worker in workers do
		local pending = worker.pending
		if pending and worker.output.done == pending.generation then
			for index, snapshot in pending.snapshots do
				local base = (index - 1) * 4
				local id = worker.output[base + 1]
				if id == snapshot.Id then
					hints[id] = {
						Velocity = worker.output[base + 2],
						AccelerationVector = worker.output[base + 3],
						CurvatureDt = worker.output[base + 4],
						Acceleration = snapshot.Acceleration,
						AccelerationDirection = snapshot.AccelerationDirection,
						Gravity = snapshot.Gravity,
						Frame = pending.frame,
					}
				end
			end
			if worker.homingOutput.done == pending.generation then
				for index, job in pending.homingJobs do
					local base = (index - 1) * 2
					if worker.homingOutput[base + 1] == job.Id then
						local bestIndex = worker.homingOutput[base + 2]
						homingHints[job.Id] = {
							Target = if bestIndex and bestIndex > 0 then job.Candidates[bestIndex] else false,
							Origin = job.Origin,
							Radius = job.Radius,
							Frame = pending.frame,
						}
					end
				end
			end
			stats.BatchesCompleted += 1
			stats.ItemsCompleted += #pending.snapshots
			worker.pending = nil
		end
	end
end

local function homingEligible(projectile: any, homing: any, entity: any): boolean
	if entity == projectile.Source or entity.IsDestroyed then return false end
	if projectile.Filter and not projectile.Filter(entity) then return false end
	if homing.TargetTags then
		for _, tag in homing.TargetTags do if entity:HasTag(tag) then return true end end
		return false
	elseif homing.TargetTag then
		return entity:HasTag(homing.TargetTag)
	end
	return true
end

local function buildHomingJob(projectile: any)
	local homing = projectile.Homing
	if not homing or not (homing.AcquireRadius or homing.TargetTag or homing.TargetTags) then return nil end
	local target = projectile.HomingTarget
	local targetGone = target == nil
	if typeof(target) == "Instance" then
		targetGone = target.Parent == nil
	elseif typeof(target) == "table" then
		targetGone = target.IsDestroyed == true
	end
	local dueRetarget = target ~= nil and not homing.Permalock and homing.Retarget and projectile.ReacquireTimer <= 1 / 30
	if not targetGone and not dueRetarget then return nil end
	local origin = projectile.Position
	local radius = homing.AcquireRadius or 1e9
	local function eligible(entity) return homingEligible(projectile, homing, entity) end
	local candidates
	if homing.AcquireRadius then
		candidates = ChunkManager.GetEntityCandidatesInRadius(origin, homing.AcquireRadius, { Filter = eligible })
	else
		local source = homing.TargetTag and Entity.GetTagged(homing.TargetTag) or Entity.GetAll()
		candidates = {}
		for _, entity in source do if eligible(entity) then table.insert(candidates, entity) end end
	end
	local positions = table.create(#candidates)
	for index, entity in candidates do positions[index] = entity:GetPosition() end
	return { Id = projectile.Id, Origin = origin, Radius = radius, Candidates = candidates, Positions = positions }
end

function ProjectileParallel.GetHint(projectile: any)
	local hint = hints[projectile.Id]
	if hint
		and hint.Velocity == projectile.Velocity
		and hint.Acceleration == projectile.Acceleration
		and hint.AccelerationDirection == projectile.AccelerationDirection
		and hint.Gravity == projectile.Gravity
	then
		stats.HintHits += 1
		return hint
	end
	stats.HintMisses += 1
	return nil
end

-- Returns (ready, target). A ready result may intentionally contain nil when
-- the parallel search found no valid target. Eligibility and radius are
-- revalidated here on the authoritative thread before a target is accepted.
function ProjectileParallel.ConsumeHomingHint(projectile: any): (boolean, any?)
	local hint = homingHints[projectile.Id]
	if not hint then stats.HomingHintMisses += 1; return false, nil end
	homingHints[projectile.Id] = nil
	if frame - hint.Frame > HOMING_HINT_MAX_AGE_FRAMES then
		stats.HomingHintMisses += 1
		return false, nil
	end
	local target = hint.Target
	if target == false then stats.HomingHintHits += 1; return true, nil end
	local homing = projectile.Homing
	if not homing or not homingEligible(projectile, homing, target) then
		stats.HomingHintMisses += 1
		return false, nil
	end
	local position = target:GetPosition()
	if homing.AcquireRadius and (position - projectile.Position).Magnitude > homing.AcquireRadius then
		stats.HomingHintMisses += 1
		return false, nil
	end
	stats.HomingHintHits += 1
	return true, target
end

function ProjectileParallel.ShouldDeferHoming(): boolean
	return parallelEnabled
end

function ProjectileParallel.Dispatch(projectiles: { any }, totalActiveCount: number?)
	frame += 1
	refreshWorkers()
	local scaleCount = totalActiveCount or #projectiles
	parallelEnabled = scaleCount >= MIN_PARALLEL_PROJECTILES and #workers > 0
	if scaleCount < MIN_PARALLEL_PROJECTILES or #workers == 0 then
		if scaleCount == 0 then table.clear(hints); table.clear(homingHints) end
		return
	end

	local available = {}
	for _, worker in workers do
		if not worker.pending then
			table.insert(available, worker)
		else
			stats.BusyWorkers += 1
		end
	end
	if #available == 0 then return end

	local partitions = table.create(#available)
	for index = 1, #available do partitions[index] = {} end
	for index, projectile in projectiles do
		table.insert(partitions[(index - 1) % #available + 1], projectile)
	end

	for index, worker in available do
		local list = partitions[index]
		if #list == 0 then continue end
		worker.generation += 1
		local snapshots = table.create(#list)
		local homingJobs = {}
		for itemIndex, projectile in list do
			local base = (itemIndex - 1) * 5
			worker.input[base + 1] = projectile.Id
			worker.input[base + 2] = projectile.Velocity
			worker.input[base + 3] = projectile.Acceleration
			worker.input[base + 4] = projectile.AccelerationDirection or false
			worker.input[base + 5] = projectile.Gravity
			snapshots[itemIndex] = {
				Id = projectile.Id,
				Acceleration = projectile.Acceleration,
				AccelerationDirection = projectile.AccelerationDirection,
				Gravity = projectile.Gravity,
			}
			local homingJob = buildHomingJob(projectile)
			if homingJob then table.insert(homingJobs, homingJob) end
		end
		local cursor = 1
		for _, job in homingJobs do
			worker.homingInput[cursor] = job.Id
			worker.homingInput[cursor + 1] = job.Origin
			worker.homingInput[cursor + 2] = job.Radius
			worker.homingInput[cursor + 3] = #job.Positions
			cursor += 4
			for _, position in job.Positions do worker.homingInput[cursor] = position; cursor += 1 end
			stats.HomingCandidatesTested += #job.Positions
		end
		worker.pending = { generation = worker.generation, snapshots = snapshots, homingJobs = homingJobs, frame = frame }
		worker.actor:SendMessage("ComputeProjectileHints", worker.generation, #list, #homingJobs)
		stats.BatchesDispatched += 1
		stats.ItemsDispatched += #list
		stats.HomingJobsDispatched += #homingJobs
	end

	if frame % HINT_MAX_AGE_FRAMES == 0 then
		for id, hint in hints do
			if frame - hint.Frame > HINT_MAX_AGE_FRAMES then hints[id] = nil end
		end
		for id, hint in homingHints do
			if frame - hint.Frame > HOMING_HINT_MAX_AGE_FRAMES then homingHints[id] = nil end
		end
	end
end

function ProjectileParallel.GetStats()
	return table.clone(stats)
end

return ProjectileParallel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">ProjectileQuota</string>
          <string name="Source"><![CDATA[--!strict
-- Shared live-projectile budget for weapons and compiled spells.

local Players = game:GetService("Players")

local ProjectileQuota = {}
-- Head packets AND independently hitting beamlets share this budget. The
-- old 150 ceiling could admit a head but reject its required joiners during
-- ordinary sustain, leaving real gaps. Allow the requested 10k-scale loads;
-- spawn/render/network per-frame caps remain separate and unchanged.
ProjectileQuota.Maximum = 15000

local active: { [Player]: number } = {}

function ProjectileQuota.Get(player: Player): number
	return active[player] or 0
end

function ProjectileQuota.TryAcquire(player: Player, count: number?): boolean
	local amount = math.max(math.floor(count or 1), 0)
	if amount == 0 then
		return true
	end
	local current = active[player] or 0
	if current + amount > ProjectileQuota.Maximum then
		return false
	end
	active[player] = current + amount
	return true
end

function ProjectileQuota.Release(player: Player, count: number?)
	local amount = math.max(math.floor(count or 1), 0)
	active[player] = math.max((active[player] or 0) - amount, 0)
end

Players.PlayerRemoving:Connect(function(player)
	active[player] = nil
end)

return ProjectileQuota
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="59">
        <Properties>
          <string name="Name">ProjectileWorkerBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Creates a small Actor pool, then each clone performs read-only math in a
-- parallel message callback. Results are written to per-worker SharedTables.

local SharedTableRegistry = game:GetService("SharedTableRegistry")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local actor = script:GetActor()
if not actor then
	local folder = script.Parent:FindFirstChild("ProjectileActors")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "ProjectileActors"
		folder.Parent = script.Parent
	end
	for index = 1, 4 do
		local inputKey = `RelativityProjectileInput{index}`
		local outputKey = `RelativityProjectileOutput{index}`
		local homingInputKey = `RelativityProjectileHomingInput{index}`
		local homingOutputKey = `RelativityProjectileHomingOutput{index}`
		if not SharedTableRegistry:GetSharedTable(inputKey) then
			SharedTableRegistry:SetSharedTable(inputKey, SharedTable.new())
		end
		if not SharedTableRegistry:GetSharedTable(outputKey) then
			SharedTableRegistry:SetSharedTable(outputKey, SharedTable.new())
		end
		if not SharedTableRegistry:GetSharedTable(homingInputKey) then
			SharedTableRegistry:SetSharedTable(homingInputKey, SharedTable.new())
		end
		if not SharedTableRegistry:GetSharedTable(homingOutputKey) then
			SharedTableRegistry:SetSharedTable(homingOutputKey, SharedTable.new())
		end
	end
	if #folder:GetChildren() == 0 then
		for index = 1, 4 do
			local workerActor = Instance.new("Actor")
			workerActor.Name = `ProjectileWorker{index}`
			local workerScript = script:Clone()
			workerScript.Name = "Worker"
			workerScript.Parent = workerActor
			workerActor.Parent = folder
		end
	end
	return
end

local workerId = assert(tonumber(string.match(actor.Name, "(%d+)$")), "Projectile worker requires a numeric suffix")
local ProjectileMotion = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ProjectileMotion"))
local input = SharedTableRegistry:GetSharedTable(`RelativityProjectileInput{workerId}`)
local output = SharedTableRegistry:GetSharedTable(`RelativityProjectileOutput{workerId}`)
local homingInput = SharedTableRegistry:GetSharedTable(`RelativityProjectileHomingInput{workerId}`)
local homingOutput = SharedTableRegistry:GetSharedTable(`RelativityProjectileHomingOutput{workerId}`)

actor:BindToMessageParallel("ComputeProjectileHints", function(generation: number, count: number, homingCount: number)
	for index = 1, count do
		local inputBase = (index - 1) * 5
		local outputBase = (index - 1) * 4
		local id = input[inputBase + 1]
		local velocity = input[inputBase + 2]
		local acceleration = input[inputBase + 3]
		local direction = input[inputBase + 4]
		local gravity = input[inputBase + 5]
		if direction == false then direction = nil end
		local accelerationVector = ProjectileMotion.GetAcceleration(velocity, acceleration, direction, gravity)
		output[outputBase + 1] = id
		output[outputBase + 2] = velocity
		output[outputBase + 3] = accelerationVector
		output[outputBase + 4] = ProjectileMotion.GetCurvatureStepDt(velocity, accelerationVector, 0.35)
	end
	local cursor = 1
	for jobIndex = 1, homingCount do
		local id = homingInput[cursor]
		local origin = homingInput[cursor + 1]
		local radius = homingInput[cursor + 2]
		local candidateCount = homingInput[cursor + 3]
		cursor += 4
		local bestIndex = 0
		local bestDistanceSq = radius * radius
		for candidateIndex = 1, candidateCount do
			local position = homingInput[cursor]
			cursor += 1
			local offset = position - origin
			local distanceSq = offset:Dot(offset)
			if distanceSq <= bestDistanceSq then
				bestDistanceSq = distanceSq
				bestIndex = candidateIndex
			end
		end
		local outputBase = (jobIndex - 1) * 2
		homingOutput[outputBase + 1] = id
		homingOutput[outputBase + 2] = bestIndex
	end
	homingOutput.done = generation
	output.done = generation
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">Ragdoll</string>
          <string name="Source"><![CDATA[---@module Easy Ragdoll by theonlyflare

--- Services ---
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChunkManager = require(Shared.ChunkManager)

--- Module ---
local RagdollModule = {}

--- Constants ---
-- Names of instances created by the ragdoll system, used for cleanup.
local RAGDOLL_INSTANCE_NAMES = {
	["RagdollAttachment"] = true,
	["RagdollConstraint"] = true,
	["ColliderPart"] = true, -- Keep this for cleanup in case old ragdolls had them
	["RagdollTimeAttachment"] = true,
	["RagdollTimeGravity"] = true,
}

local SCALE_EPSILON = 1e-4
local trackedRagdolls = {}
local originalRigSettings = setmetatable({}, { __mode = "k" })

local function getRoot(character: Model): BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = humanoid and humanoid.RootPart or character.PrimaryPart
	return if root and root:IsA("BasePart") then root else nil
end

local function getScale(character: Model): number
	local root = getRoot(character)
	if not root then
		return 1
	end
	return ChunkManager.GetEffectiveTimeScaleAt(root.Position)
end

local function getParts(character: Model): { BasePart }
	local parts = {}
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") and not descendant.Anchored then
			table.insert(parts, descendant)
		end
	end
	return parts
end

local function getGravityForce(part: BasePart): VectorForce
	local existing = part:FindFirstChild("RagdollTimeGravity")
	if existing and existing:IsA("VectorForce") then
		return existing
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = "RagdollTimeAttachment"
	attachment.Parent = part

	local force = Instance.new("VectorForce")
	force.Name = "RagdollTimeGravity"
	force.Attachment0 = attachment
	force.ApplyAtCenterOfMass = true
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.Parent = part
	return force
end

local function removeTracking(character: Model)
	local state = trackedRagdolls[character]
	if not state then
		return
	end
	trackedRagdolls[character] = nil
	if state.AncestryConnection then
		state.AncestryConnection:Disconnect()
	end
end

local function beginTracking(character: Model)
	if trackedRagdolls[character] then
		return
	end

	local scale = getScale(character)
	local state = {
		Scale = scale,
		Parts = getParts(character),
		FrozenVelocity = {},
	}
	trackedRagdolls[character] = state

	-- Existing motion becomes dilated as soon as the body ragdolls. New pushes
	-- should use SetRootVelocity below so they are expressed in world-time units.
	for _, part in state.Parts do
		part.AssemblyLinearVelocity *= scale
		part.AssemblyAngularVelocity *= scale
		local force = getGravityForce(part)
		force.Force = Vector3.new(0, part.AssemblyMass * workspace.Gravity * (1 - scale * scale), 0)
	end

	state.AncestryConnection = character.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			removeTracking(character)
		end
	end)
end

-- Native rigid-body physics always advances in real time. Keep ragdoll velocity
-- proportional to local time and cancel the portion of engine gravity that
-- should not occur. Gravity uses scale^2 because both velocity and elapsed time
-- are dilated: x(realTime) = x(worldTime * scale).
RunService.Heartbeat:Connect(function()
	for character, state in trackedRagdolls do
		if not character.Parent then
			removeTracking(character)
			continue
		end

		local scale = getScale(character)
		local previousScale = state.Scale
		if math.abs(scale - previousScale) > SCALE_EPSILON then
			for _, part in state.Parts do
				if not part.Parent then
					continue
				end
				if previousScale > SCALE_EPSILON then
					local canonicalLinear = part.AssemblyLinearVelocity / previousScale
					local canonicalAngular = part.AssemblyAngularVelocity / previousScale
					state.FrozenVelocity[part] = {
						Linear = canonicalLinear,
						Angular = canonicalAngular,
					}
					part.AssemblyLinearVelocity = canonicalLinear * scale
					part.AssemblyAngularVelocity = canonicalAngular * scale
				else
					local frozen = state.FrozenVelocity[part]
					if frozen then
						part.AssemblyLinearVelocity = frozen.Linear * scale
						part.AssemblyAngularVelocity = frozen.Angular * scale
					end
				end
			end
			state.Scale = scale
		end

		for _, part in state.Parts do
			if not part.Parent then
				continue
			end
			local force = getGravityForce(part)
			force.Force = Vector3.new(0, part.AssemblyMass * workspace.Gravity * (1 - scale * scale), 0)
			if scale <= SCALE_EPSILON then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
end)

--- Helper Functions ---

--[[
	@param character: Model -- The character model to ragdoll.
	@param humanoid: Humanoid -- The humanoid object within the character.
	@brief Converts Motor6D joints into BallSocketConstraints to enable ragdolling.
	This process involves disabling existing Motor6D joints and replacing them
	with physics-based constraints.
]]
local function replaceJoints(character: Model, humanoid: Humanoid)
	local animateScript = character:FindFirstChild("Animate")
	local motors = {}
	for _, joint in character:GetDescendants() do
		if joint:IsA("Motor6D") then motors[joint] = joint.Enabled end
	end
	originalRigSettings[character] = {
		RequiresNeck = humanoid.RequiresNeck,
		BreakJointsOnDeath = humanoid.BreakJointsOnDeath,
		AutoRotate = humanoid.AutoRotate,
		GettingUp = humanoid:GetStateEnabled(Enum.HumanoidStateType.GettingUp),
		AnimateEnabled = animateScript and animateScript:IsA("LocalScript") and animateScript.Enabled,
		Motors = motors,
	}
	-- Necessary for Ragdolling to function properly
	humanoid.BreakJointsOnDeath = false
	-- Disable the neck requirement BEFORE disconnecting the neck joint.
	humanoid.RequiresNeck = false

	-- Disable the 'Animate' script to stop character animations
	if animateScript and animateScript:IsA("LocalScript") then
		animateScript.Enabled = false
	end

	-- Stop all playing animations on the humanoid's animator
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in animator:GetPlayingAnimationTracks() do
			track:Stop()
		end
	end

	-- Iterate through all descendants to find Motor6D joints
	for _, motor: Motor6D in pairs(character:GetDescendants()) do
		if motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then -- Ensure parts exist for the Motor6D
			motor.Enabled = false -- Disable the Motor6D to allow physics to take over

			-- Create attachments for the BallSocketConstraint
			local attachment0 = Instance.new("Attachment")
			local attachment1 = Instance.new("Attachment")

			-- Set Attachment CFrames based on Motor6D's C0 and C1
			attachment0.CFrame = motor.C0
			attachment1.CFrame = motor.C1

			attachment0.Name = "RagdollAttachment"
			attachment1.Name = "RagdollAttachment"

			-- Create the BallSocketConstraint
			local ballSocketConstraint = Instance.new("BallSocketConstraint")
			ballSocketConstraint.Attachment0 = attachment0
			ballSocketConstraint.Attachment1 = attachment1
			ballSocketConstraint.Name = "RagdollConstraint"

			-- Generic BallSocketConstraint properties. These can be fine-tuned
			-- for specific joints for more realistic ragdoll behavior.
			ballSocketConstraint.Radius = 0.15
			ballSocketConstraint.LimitsEnabled = true
			ballSocketConstraint.TwistLimitsEnabled = true -- Allow some twist, but with limits
			ballSocketConstraint.MaxFrictionTorque = 0 -- No friction at the joint
			ballSocketConstraint.Restitution = 0 -- No bounce at the joint
			ballSocketConstraint.UpperAngle = 90
			ballSocketConstraint.TwistLowerAngle = -45
			ballSocketConstraint.TwistUpperAngle = 45

			-- Apply specific overrides for certain joints for better control
			if motor.Name:find("Neck") then
				ballSocketConstraint.UpperAngle = 45
				ballSocketConstraint.TwistLowerAngle = -70
				ballSocketConstraint.TwistUpperAngle = 70
			elseif motor.Name:find("Hip") then
				ballSocketConstraint.UpperAngle = 60
				ballSocketConstraint.TwistLowerAngle = -30
				ballSocketConstraint.TwistUpperAngle = 30
			elseif motor.Name:find("Shoulder") then
				ballSocketConstraint.UpperAngle = 75
				ballSocketConstraint.TwistLowerAngle = -60
				ballSocketConstraint.TwistUpperAngle = 60
			end

			-- Parent the attachments and constraint
			attachment0.Parent = motor.Part0
			attachment1.Parent = motor.Part1
			ballSocketConstraint.Parent = motor.Parent
		end
	end

	humanoid.AutoRotate = false -- Disabling AutoRotate prevents the Character rotating in first person or Shift-Lock
	character:SetAttribute("LastRag", tick()) -- Used for anti-cheats to prevent flying Ragdolls from getting flagged
end

--[[
	@param character: Model -- The character model to unragdoll.
	@param humanoid: Humanoid -- The humanoid object within the character.
	@brief Destroys all Ragdoll-related instances (attachments, constraints, colliders)
	and re-enables the original Motor6D's to restore normal character animation.
]]
local function resetJoints(character: Model, humanoid: Humanoid)
	-- Do not unragdoll if the humanoid is dead
	if humanoid.Health < 1 then return end
	local original = originalRigSettings[character]

	for _, instance in pairs(character:GetDescendants()) do
		-- Destroy instances created by the ragdoll system
		if RAGDOLL_INSTANCE_NAMES[instance.Name] then
			instance:Destroy()
		end

		-- Re-enable original Motor6D joints
		if instance:IsA("Motor6D") then
			instance.Enabled = if original and original.Motors[instance] ~= nil then original.Motors[instance] else true
		end
	end

	-- Restore the neck requirement only after its joint is connected again.
	humanoid.RequiresNeck = if original then original.RequiresNeck else true
	humanoid.BreakJointsOnDeath = if original then original.BreakJointsOnDeath else humanoid.BreakJointsOnDeath
	humanoid.AutoRotate = if original then original.AutoRotate else true
	humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, if original then original.GettingUp else true)

	-- Re-enable the 'Animate' script
	local animateScript = character:FindFirstChild("Animate")
	if animateScript and animateScript:IsA("LocalScript") then
		animateScript.Enabled = if original then original.AnimateEnabled == true else true
	end
	originalRigSettings[character] = nil
end

--[[
	@param character: Model -- The character model to push.
	@param magnitude: number -- The magnitude of the push to apply.
	@brief Applies an impulse to the character's HumanoidRootPart or Torso.
]]
local function applyPush(character: Model, magnitude: number)
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if rootPart and rootPart:IsA("BasePart") then
		-- Apply impulse in the opposite direction of the character's forward vector
		rootPart:ApplyImpulse(rootPart.CFrame.LookVector * -magnitude * getScale(character))
	end
end

--- Module Functions ---

--[[
	@param character: Model -- The character model to apply or remove ragdoll from.
	@param value: boolean -- True to ragdoll, false to unragdoll.
	@param applyPushOnRagdoll: boolean? -- Optional: Whether to apply a push when ragdolling. Defaults to false.
	@param pushMagnitude: number? -- Optional: The magnitude of the push if applyPushOnRagdoll is true. Defaults to 100.
	@brief Toggles the ragdoll state of the given character, with an option to apply an extra push.
]]
function RagdollModule.SetRagdoll(character: Model, value: boolean, applyPushOnRagdoll: boolean?, pushMagnitude: number?)
	-- Validate inputs
	if not character then
		warn("RagdollModule.SetRagdoll: No character provided.")
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		warn("RagdollModule.SetRagdoll: Character does not have a Humanoid.")
		return
	end

	-- Set default optional parameters
	applyPushOnRagdoll = applyPushOnRagdoll or false
	pushMagnitude = pushMagnitude or 100

	if value then -- Ragdoll the character
		-- Repeated requests must not create duplicate constraints or overwrite
		-- the pre-stun settings with the already-ragdolled state.
		if not trackedRagdolls[character] then
			replaceJoints(character, humanoid)
			beginTracking(character)
		end
		
		--> Check to see if the module is being called from client/server
		if RunService:IsClient() then
			humanoid:ChangeState(Enum.HumanoidStateType.Ragdoll)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
			
		elseif RunService:IsServer() then
			local root = getRoot(character)
			if root and root:CanSetNetworkOwnership() then
				root:SetNetworkOwner(nil)
			end
			
			humanoid:ChangeState(Enum.HumanoidStateType.Ragdoll)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
		end

		-- Apply push only if explicitly requested
		if applyPushOnRagdoll then
			applyPush(character, pushMagnitude)
		end
	else -- Unragdoll the character
		-- A corpse remains a ragdoll, not a permanently stunned living entity.
		-- Keep dilation tracking too: removing it would strand gravity forces.
		if humanoid.Health <= 0 or not trackedRagdolls[character] then return end
		removeTracking(character)
		resetJoints(character, humanoid)
		
		if RunService:IsClient() then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			
		elseif RunService:IsServer() then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			
			-- Fix network ownership for players
			local player: Player? = Players:GetPlayerFromCharacter(character)
			local root = getRoot(character)
			if player and root and root:CanSetNetworkOwnership() then
				root:SetNetworkOwner(player)
			end
		end
	end
end

-- Sets a launch velocity in undilated world-time units. Writing the assembly
-- properties directly would bypass the ragdoll controller until a zone change.
function RagdollModule.SetRootVelocity(character: Model, linearVelocity: Vector3, angularVelocity: Vector3?)
	local root = getRoot(character)
	if not root then
		return
	end
	local state = trackedRagdolls[character]
	local scale = if state then state.Scale else getScale(character)
	local angular = angularVelocity or root.AssemblyAngularVelocity
	root.AssemblyLinearVelocity = linearVelocity * scale
	root.AssemblyAngularVelocity = angular * scale
	if state then
		state.FrozenVelocity[root] = {
			Linear = linearVelocity,
			Angular = angular,
		}
	end
end

-- Return the module
return RagdollModule
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="61">
        <Properties>
          <string name="Name">Shooter</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Shooter (server authority)
	Generic weapon dispatcher: receives fire/reload requests from clients
	(VisualOffload "FireBullet"/"ReloadWeapon"/"WeaponEquip") and spawns
	bullets through the Projectile system on behalf of whichever weapon
	module (see Weapons/init.luau) matches the firing player's equipped
	Tool. This file owns ZERO weapon-specific numbers -- every stat, the
	fire rate, the magazine size, and any custom hit/destroy behavior come
	from that weapon's own Weapons/<Name>.luau module. Adding a new weapon
	never means editing this file.

	Because Projectile steps on the dilated Heartbeat, these bullets slow down with
	the global time ratio and inside slow chunks for free -- and, per-shooter, live
	with that player's own personal time ratio (Projectile.luau reads Source.
	TimeScale every tick, so a shooter dragging their ratio mid-flight speeds up
	or slows down bullets already in the air).

	Anti-exploit, defense in depth (VisualOffload's remote is reachable directly by
	any client, bypassing ShooterController's own throttling entirely):
	 - MIN_FIRE_INTERVAL is a hard per-(player, tool) rate limit floor enforced
	   here regardless of how fast (or how directly) the remote is fired, no
	   matter what FireRate a weapon module claims -- a misconfigured weapon
	   can never fire faster than this.
	 - ProjectileQuota caps the combined number of a player's weapon and spell
	   projectiles, so swapping casting systems cannot bypass the live-shot limit.
	 - A shot is only accepted while the firing player's character has one of the
	   Weapons registry's tools equipped (see Weapons/init.luau).
	 - The bullet's Model and every gameplay stat are looked up server-side from
	   the equipped tool's weapon module, NEVER taken from client-sent data -- a
	   client-supplied Model Instance or stat table would be an easy exploit
	   vector (clone-and-broadcast via ProjSpawn, or simply lying about damage).
	 - A weapon with a Magazine can't be fired while empty or mid-reload.
	 - The spawn Origin is resolved entirely server-side too (see
	   resolveMuzzleOrigin below): the equipped Tool's "Tip" Attachment if one
	   exists, else the character's Head -- never taken from the client at
	   all, so there's no origin-spoofing surface to clamp/sanity-check in the
	   first place. Only the aim TargetPoint comes from the client (needed --
	   only it knows where the player is aiming), which just steers direction,
	   not where the bullet spawns.
	 - data.Config (from the client's ShooterConfigGui debug panel) is only
	   ever read inside Studio (see applyStudioDebugOverrides/RunService:
	   IsStudio() below) -- a live client's Config table is completely
	   ignored, so this is a Studio iteration convenience, not a trust hole.

	Lag compensation: each shot carries RewindSeconds, half the firing player's
	current network ping, clamped to MAX_REWIND. Projectile.luau uses this to check
	nearby entities against their position as of (now - RewindSeconds) instead of
	their live position while the bullet is near entities -- see Projectile.luau's
	top-of-file doc comment for the full behavior.

	Also handles "StressTestFire": a dev/benchmarking request that spawns many
	projectiles in one go, bypassing the per-shot rate limit (which throttles
	per-click requests, not a single "spawn N" request) -- see the client's N
	keybind in ShooterController.luau. Restricted to Studio (see the
	RunService:IsStudio() guard below) since spawning thousands of projectiles
	per request is itself an exploit vector if left reachable in a live game. Use
	Heartbeat.GetStats().AvgFrameTime to read the actual per-frame cost while a
	batch is in flight.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Heartbeat = require(Shared.Heartbeat)
local Entity = require(Shared.Entity)
local Projectile = require(script.Parent.Projectile)
local ProjectileQuota = require(script.Parent.ProjectileQuota)
local SafeMath = require(Shared.SafeMath)
local VisualOffload = require(Shared.VisualOffload)
local Weapons = require(script.Parent.Weapons)
local WeaponsShared = require(script.Parent.Weapons.Shared)

-- Server-owned mapping of weapon name -> the Model clients render for that
-- weapon's bullets, resolved once at startup from each WeaponDef.Model.
-- NEVER trust a client-sent Model reference (a remote can carry an Instance
-- argument, and a client could point it at literally anything replicated to
-- them -- another player's rig, a chunk of terrain, a LocalScript buried
-- somewhere else in the game -- which the server would then clone and
-- broadcast onto every observer via ProjSpawn). A weapon with no asset found
-- just falls back to the default Visual ball.
local Effects = ReplicatedStorage:FindFirstChild("Effects")
local PROJECTILE_MODELS: { [string]: Instance } = {}
for toolName, weapon in Weapons do
	PROJECTILE_MODELS[toolName] = Effects and Effects:FindFirstChild(weapon.Model)
end

local MIN_FIRE_INTERVAL = 0.1 -- absolute floor (seconds, real time), regardless of a weapon's own FireRate -- 10/sec hard cap
local MAX_REWIND = 0.4 -- seconds; stays safely under Entity.HistoryWindow (0.5s)
local MUZZLE_SPAWN_OFFSET = 3 -- studs spawned ahead of the resolved origin, along the aim direction, so a bullet never immediately hits its own shooter
local TIP_ATTACHMENT_NAME = "Tip"
local DEFAULT_VISUAL = { Shape = "Ball", Size = Vector3.one * 0.4, Color = Color3.fromRGB(120, 220, 255) }

local lastFire: { [Tool]: number } = {}

type WeaponState = {
	Magazine: number,
	Reserve: number,
	Reloading: boolean,
}

-- Ammo/reload state, keyed by Tool INSTANCE (not player or weapon name).
-- Every weapon Tool is a private per-player copy cloned from StarterPack --
-- never shared/contested between players -- and Roblox destroys/reclones it
-- fresh on every respawn, so keying by instance means ammo naturally resets
-- on death for free; the only bookkeeping needed is clearing the entry when
-- THIS instance goes away (see tool.Destroying below), not on any
-- per-player respawn hook.
local weaponState: { [Tool]: WeaponState } = {}

-- Clamp a client-supplied number into a trusted range (anti-cheat + sanity).
local function num(value: any, default: number, min: number, max: number): number
	if typeof(value) ~= "number" or value ~= value then
		return default
	end
	return math.clamp(value, min, max)
end

-- Studio-only debug override (see ShooterConfigGui.luau on the client): the
-- fields a dev can live-tune from that panel while testing, each clamped to
-- a sane range and only applied if actually present -- unset fields keep
-- whatever the equipped weapon's own Stats/Homing already say. NEVER read
-- outside Studio (see the IsStudio guard at the call site below), so a live
-- client's Config table is never touched at all -- this doesn't reopen the
-- client-trust gap the per-weapon schema was built to close, it's purely a
-- Studio iteration convenience layered on top of it.
local STUDIO_DEBUG_STAT_FIELDS = {
	{ key = "Speed", min = 10, max = math.huge },
	{ key = "Acceleration", min = -math.huge, max = math.huge },
	{ key = "MinSpeed", min = 0, max = math.huge },
	{ key = "MaxSpeed", min = 0, max = math.huge },
	{ key = "Damage", min = 0, max = math.huge },
	{ key = "Lifetime", min = 0.1, max = math.huge },
	{ key = "Gravity", min = 0, max = math.huge },
	{ key = "Radius", min = 0, max = math.huge },
	{ key = "Bounces", min = 0, max = math.huge, integer = true },
	{ key = "Restitution", min = 0, max = math.huge },
	{ key = "Penetration", min = 0, max = math.huge },
	{ key = "PierceFalloff", min = 0, max = math.huge },
}

local function applyStudioDebugOverrides(projectileConfig: { [string]: any }, cfg: { [string]: any })
	for _, field in STUDIO_DEBUG_STAT_FIELDS do
		local raw = cfg[field.key]
		if typeof(raw) == "number" and raw == raw then
			local value = math.clamp(raw, field.min, field.max)
			projectileConfig[field.key] = if field.integer then math.floor(value) else value
		end
	end
	if typeof(cfg.Pierces) == "number" then
		projectileConfig.MaxPierces = math.floor(num(cfg.Pierces, 0, 0, math.huge))
	end
	if cfg.Homing == true then
		-- Replaces the weapon's own static Homing (if any) for this shot --
		-- lets a dev toggle homing on/off live regardless of what the
		-- weapon module declares.
		projectileConfig.Homing = {
			AcquireRadius = num(cfg.AcquireRadius, 60, 0, math.huge),
			TargetTags = { "Enemy", "Player" },
			Retarget = true,
			ReacquireRate = 0.3,
			Permalock = cfg.Permalock == true,
			TurnRate = math.rad(num(cfg.TurnRate, 140, 0, math.huge)),
			Delay = 0.05,
		}
	end
end

-- Finds which registered weapon (if any) the player's character has
-- equipped right now. Returns the Tool instance and its WeaponDef, or nil,
-- nil if none is equipped -- closes the gap where an exploiter fires a
-- weapon remote directly without ever equipping anything.
local function findEquippedWeapon(character: Model): (Tool?, Weapons.WeaponDef?)
	for toolName, weapon in Weapons do
		local candidate = character:FindFirstChild(toolName)
		if candidate and candidate:IsA("Tool") then
			return candidate, weapon
		end
	end
	return nil, nil
end

-- Where a shot spawns from: the equipped weapon's own "Tip" Attachment if
-- it has one (searched recursively, so it can live under a muzzle model
-- nested inside the Tool), else the character's Head, else the root part
-- (only reachable if a character somehow has no Head at all). Entirely
-- server-resolved from the server's own scene graph -- never trusts
-- anything client-sent, unlike the old client-supplied Origin this replaces.
local function resolveMuzzleOrigin(tool: Tool, character: Model, root: BasePart): Vector3
	local tip = tool:FindFirstChild(TIP_ATTACHMENT_NAME, true)
	if tip and tip:IsA("Attachment") then
		return tip.WorldPosition
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head.Position
	end
	return root.Position
end

-- Lazily creates (full magazine) or returns this tool's ammo state. Only
-- called for weapons that actually have a Magazine (callers check first).
local function getWeaponState(tool: Tool, weapon: Weapons.WeaponDef): WeaponState
	local state = weaponState[tool]
	if state then
		return state
	end
	local magazine = assert(weapon.Magazine, "getWeaponState called on a weapon with no Magazine")
	state = { Magazine = magazine.Size, Reserve = magazine.Reserve, Reloading = false }
	weaponState[tool] = state
	tool.Destroying:Once(function()
		weaponState[tool] = nil
	end)
	return state
end

local function pushAmmoSync(player: Player, tool: Tool, state: WeaponState)
	VisualOffload.FireClient(player, "AmmoSync", {
		ToolName = tool.Name,
		Magazine = state.Magazine,
		Reserve = state.Reserve,
		Reloading = state.Reloading,
	})
end

VisualOffload.On("FireBullet", function(data, player)
	if not player or typeof(data) ~= "table" then
		return
	end

	-- A NaN aim has no recoverable direction, so reject it; +-inf components
	-- clamp to SafeMath.Limit so an absurd aim still fires the way it points.
	local rawTarget = data.TargetPoint
	if typeof(rawTarget) ~= "Vector3" or SafeMath.hasNaN(rawTarget) then
		return
	end
	local targetPoint = SafeMath.vector(rawTarget, Vector3.zero)

	local character = player.Character
	local root = character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))
	if not root then
		return
	end

	local tool, weapon = findEquippedWeapon(character)
	if not tool or not weapon then
		return
	end

	-- Origin is entirely server-resolved (see the module doc comment and
	-- resolveMuzzleOrigin above); direction is derived from it toward the
	-- client's aimed TargetPoint, so shots still converge exactly where the
	-- player clicked regardless of which origin was used. Resolved before
	-- any state changes below so a degenerate aim (target on top of the
	-- origin) bails out without consuming ammo/cooldown or playing OnFire.
	local origin = resolveMuzzleOrigin(tool, character, root)
	local toTarget = targetPoint - origin
	if toTarget.Magnitude < 1e-3 then
		return
	end
	local direction = SafeMath.direction(toTarget, Vector3.zAxis)

	-- rate limit: a hard per-(player, tool) cap independent of client input
	-- (the remote is reachable directly -- see the module doc comment
	-- above), floored regardless of what the weapon's own FireRate claims.
	local cooldown = math.max(1 / weapon.FireRate, MIN_FIRE_INTERVAL)
	local now = os.clock()
	if lastFire[tool] and now - lastFire[tool] < cooldown then
		return
	end

	-- ammo: reject (without consuming the fire-rate cooldown above) while
	-- empty or mid-reload; otherwise consume one round and sync the client.
	local state: WeaponState? = nil
	if weapon.Magazine then
		state = getWeaponState(tool, weapon)
		if state.Reloading or state.Magazine <= 0 then
			return
		end
	end
	-- Shared with compiled spells, so swapping systems cannot double the
	-- player's live-projectile allowance.
	if not ProjectileQuota.TryAcquire(player, 1) then
		return
	end
	if lastFire[tool] == nil then
		-- lastFire is keyed by Tool instance, same as weaponState -- clean
		-- it up on the same signal so a long session doesn't accumulate an
		-- entry per (now-destroyed) Tool instance across every respawn.
		tool.Destroying:Once(function()
			lastFire[tool] = nil
		end)
	end
	lastFire[tool] = now
	if state then
		state.Magazine -= 1
		pushAmmoSync(player, tool, state)
	end

	-- Shot is fully accepted at this point -- fire the weapon's cosmetic
	-- hook (muzzle flash, fire sound, etc.) now, before the projectile
	-- itself spawns, passing the same origin/direction the projectile will
	-- actually use so the effect always lands on the real bullet path. See
	-- the OnFire doc comment in Weapons/init.luau.
	if weapon.OnFire then
		weapon.OnFire(tool, origin, direction)
	end

	local shooter = Entity.Get(character) -- may be nil if the character isn't registered

	-- lag compensation: how far back (real seconds) this shooter's view was
	-- desynced when they fired, half their round-trip ping, clamped.
	local ok, ping = pcall(function()
		return player:GetNetworkPing()
	end)
	local rewindSeconds = (ok and typeof(ping) == "number" and ping == ping) and math.clamp(ping / 2, 0, MAX_REWIND) or 0

	-- Seed the projectile config from the weapon's own stat sheet (cloned so
	-- Projectile can never mutate the module's canonical table), then layer
	-- the fields only the server ever controls on top.
	local projectileConfig = table.clone(weapon.Stats)
	projectileConfig.Origin = origin + direction * MUZZLE_SPAWN_OFFSET
	projectileConfig.Direction = direction
	projectileConfig.Source = shooter
	-- Belt-and-suspenders against self-hits: shooter (the Entity) may still
	-- be nil for a shot fired in the brief window before
	-- PlayerManager.server.luau registers this character on CharacterAdded
	-- -- IgnoreInstances excludes the raw character model from the raycast
	-- regardless, so a self-hit can't happen even during that race.
	projectileConfig.IgnoreInstances = { character }
	projectileConfig.RewindSeconds = rewindSeconds
	projectileConfig.Visualize = true -- server = logic only; clients render
	projectileConfig.VisualRange = 800
	projectileConfig.Visual = DEFAULT_VISUAL -- fallback ball, only used if Model resolution above failed
	-- Chosen server-side from the validated equipped tool, never from client
	-- data (see PROJECTILE_MODELS above) -- a client-supplied Model
	-- reference would be an easy exploit vector.
	projectileConfig.Model = PROJECTILE_MODELS[tool.Name]
	if weapon.Homing then
		-- Fresh clone per shot -- handing Projectile the module's own
		-- canonical Homing table would let it become shared/mutated state
		-- across every shot this weapon ever fires (the exact footgun
		-- Projectile.Burst has with a shallow table.clone(config)).
		projectileConfig.Homing = table.clone(weapon.Homing)
	end
	if RunService:IsStudio() and typeof(data.Config) == "table" then
		applyStudioDebugOverrides(projectileConfig, data.Config)
	end

	local ctx: WeaponsShared.FireContext = {
		Player = player,
		Shooter = shooter,
		Tool = tool,
		Projectile = nil :: any, -- filled in immediately below
	}

	-- counted against ProjectileQuota above; OnDestroy fires
	-- exactly once per projectile on every removal path (entity hit, world
	-- hit, dilated lifetime expiry, or the real-time MaxRealLifetime safety
	-- cap -- see Projectile.luau's Step/Destroy), so this always balances the
	-- increment below. OnHit is NOT exactly-once (piercing/bouncing/
	-- penetrating fire it without removing the projectile), which is exactly
	-- why this uses OnDestroy instead. The real-time cap matters here
	-- specifically: a shooter who freezes their own personal time with shots
	-- in flight would otherwise have those shots sit in the quota
	-- forever, silently eating into their shared projectile budget.
	local proj = Projectile.new(projectileConfig)
	ctx.Projectile = proj

	proj.OnDestroy:Connect(function(destroyInfo)
		-- Unconditional bookkeeping -- never skippable by a weapon's own
		-- OnDestroyFunction, or the concurrency cap silently breaks.
		ProjectileQuota.Release(player, 1)
		if weapon.OnDestroyFunction then
			weapon.OnDestroyFunction(ctx, destroyInfo)
		end
	end)

	-- If the weapon defines its own OnHitFunction it FULLY REPLACES default
	-- damage-dealing for this weapon's hits (see the WeaponDef schema in
	-- Weapons/init.luau) -- it can call WeaponsShared.DealDefaultDamage
	-- itself to opt back into standard damage before adding custom effects.
	proj.OnHit:Connect(function(hit)
		if weapon.OnHitFunction then
			weapon.OnHitFunction(ctx, hit)
		else
			WeaponsShared.DealDefaultDamage(ctx, hit)
		end
	end)
end)

VisualOffload.On("ReloadWeapon", function(_data, player)
	if not player then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local tool, weapon = findEquippedWeapon(character)
	if not tool or not weapon or not weapon.Magazine then
		return
	end
	local magazine = weapon.Magazine
	local state = getWeaponState(tool, weapon)
	if state.Reloading or state.Reserve <= 0 or state.Magazine >= magazine.Size then
		return
	end

	state.Reloading = true
	pushAmmoSync(player, tool, state)

	task.delay(magazine.ReloadTime, function()
		-- The tool (or its state entry) may be gone by the time this fires
		-- (unequipped/respawned/left) -- weaponState[tool] would already be
		-- nil via tool.Destroying in that case, `state` here is still the
		-- same table reference so writes are harmless even if orphaned.
		local reload = math.min(magazine.Size - state.Magazine, state.Reserve)
		state.Magazine += reload
		state.Reserve -= reload
		state.Reloading = false
		if player.Parent and weaponState[tool] == state then
			pushAmmoSync(player, tool, state)
		end
	end)
end)

VisualOffload.On("WeaponEquip", function(data, player)
	if not player or typeof(data) ~= "table" or typeof(data.ToolName) ~= "string" then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local weapon = Weapons[data.ToolName]
	local tool = character:FindFirstChild(data.ToolName)
	if not weapon or not weapon.Magazine or not tool or not tool:IsA("Tool") then
		return
	end
	-- Lets the client learn correct starting ammo the instant a weapon is
	-- equipped, instead of waiting for the first shot (a future HUD's entry
	-- point -- see AmmoState.luau on the client).
	pushAmmoSync(player, tool, getWeaponState(tool, weapon))
end)

-- Dev/benchmarking only: spawns Count projectiles immediately in one request,
-- bypassing the per-shot rate limit above (that throttles per-click requests;
-- this is a single request asking for N spawns, not N separate clicks). Damage is forced to
-- 0 so a stress test never kills the Dummy or otherwise interferes with real
-- gameplay mid-benchmark. Has its own, longer cooldown so repeated presses don't
-- compound into an ever-growing pile. Restricted to Studio (see the IsStudio
-- guard below): spawning up to MAX_STRESS_COUNT projectiles per request is
-- itself an "ungodly amounts of projectiles" vector if any client could reach
-- it in a live game, so this never runs outside of testing.
local MAX_STRESS_COUNT = 50000
local STRESS_COOLDOWN = 0.2
local lastStressTest: { [Player]: number } = {}

local function randomDirection(): Vector3
	local theta = math.random() * 2 * math.pi
	local z = math.random() * 2 - 1
	local r = math.sqrt(1 - z * z)
	return Vector3.new(r * math.cos(theta), z, r * math.sin(theta))
end

VisualOffload.On("StressTestFire", function(data, player)
	if not player or not RunService:IsStudio() then
		return
	end

	local now = os.clock()
	if lastStressTest[player] and now - lastStressTest[player] < STRESS_COOLDOWN then
		return
	end
	lastStressTest[player] = now

	local character = player.Character
	local root = character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))
	if not root then
		return
	end

	local requestedCount = typeof(data) == "table" and data.Count or nil
	local count = math.floor(num(requestedCount, 500, 1, MAX_STRESS_COUNT))
	local shooter = Entity.Get(character)

	for _ = 1, count do
		local direction = randomDirection()
		Projectile.new({
			Origin = root.Position + direction * 3,
			Direction = direction,
			Speed = 220,
			Lifetime = 4,
			Damage = 0, -- pure load test; never affects real gameplay/entities
			Source = shooter,
			IgnoreInstances = { character },
			Visualize = true,
			VisualRange = 8000,
			Visual = { Shape = "Ball", Size = Vector3.one * 0.4, Color = Color3.fromRGB(255, 140, 60) },
			Homing = {
				AcquireRadius = num(60, 60, 0, 300),
				TargetTags = { "Enemy", "Player" },
				Retarget = true,
				ReacquireRate = 0.3,
				Permalock = true,
				TurnRate = math.rad(num(140, 140, 0, 360)),
				Delay = 0.05,
			},
		})
	end

	print(`[Relativity] stress test: spawned {count} projectiles for {player.Name}`)

	-- Real frame-cost data while the batch is in flight (Heartbeat.GetStats() is
	-- shared module state, so this reads the actual live loop -- not a
	-- disconnected/isolated snapshot).
	task.spawn(function()
		for _ = 1, 6 do
			task.wait(0.5)
			local stats = Heartbeat.GetStats()
			print(
				`[Relativity] stress test stats: {stats.ConnectionCount} connections, avg frame cost {string.format("%.3f", stats.AvgFrameTime * 1000)} ms`
			)
		end
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	lastStressTest[player] = nil
	-- lastFire/weaponState are keyed by Tool instance, not Player -- they
	-- self-clean via tool.Destroying when the character/backpack is torn
	-- down, so nothing to do here for those.
end)

print("[Relativity] shooter online")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">SpellRuntime</string>
          <string name="Source"><![CDATA[--!strict
--[[
	SpellRuntime.luau
	Executes a compiled spell circle (see shared/SpellCompiler.luau) on the
	server. SpellService handles the cast request, mana and cooldown; this
	module turns energy into magic.

	Flow: every Mana Well pushes its energy along its flow wire. Transforms
	set the element, If routes all of it one way, Divide splits it, and a
	Vessel gives it form: Orb, Bullet and Beam fire projectiles (Projectile.luau),
	Explosion is an instant area blast. Sustain emits overlapping Beam packets
	from live aim, sharing the cast's energy over its duration. Quantity multiplies
	a vessel into a Fan, Ring or Stream of copies sharing the energy; each
	Stream copy re-aims from the caster's live hand/cursor (see
	CastRequest.live). Values (sensors/logic) are evaluated on demand and memoized per
	evaluation context. A context is one moment in the world: the cast
	itself, or a trigger firing (where Here is the vessel's position and
	Struck Entity is what set it off).

	Triggers reserve their Share of each copy's energy when it is fired and
	release it at most once: On Impact / On Expire ride the projectile's
	OnDestroy (or the end of a beam), On Timer / On Proximity are polled by
	one Heartbeat loop.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChunkManager = require(Shared:WaitForChild("ChunkManager"))
local Entity = require(Shared:WaitForChild("Entity"))
local VisualOffload = require(Shared:WaitForChild("VisualOffload"))
local Heartbeat = require(Shared:WaitForChild("Heartbeat"))
local SpellRunes = require(Shared:WaitForChild("SpellRunes"))
local StatusEffectSys = require(Shared:WaitForChild("StatusEffectSys"))
local Projectile = require(script.Parent:WaitForChild("Projectile"))
local ProjectileQuota = require(script.Parent:WaitForChild("ProjectileQuota"))
local BeamHandler = require(script.Parent:WaitForChild("BeamProjectileHandler"))

local SpellRuntime = {}

local CAST_SPAWN_OFFSET = 3 -- studs in front of the caster's head
local TRIGGER_SPAWN_OFFSET = 0.75 -- studs off the trigger point
local PROXIMITY_CHECK_INTERVAL = 0.05 -- real seconds between proximity scans
local VISUAL_RANGE = 800
local SUSTAIN_INTERVAL = BeamHandler.Interval
local PIERCE_FALLOFF = 0.15

export type Context = {
	player: Player,
	caster: any,
	character: Model,
	origin: Vector3, -- "Here"
	cursorPoint: Vector3,
	cursorEntity: any?,
	struck: any?,
	heading: Vector3, -- direction for vessels with no aim
	focus: Vector3?, -- default aim point for triggered vessels (proximity target)
	isCast: boolean,
	spawnOffset: number,
	memo: { [string]: any },
	-- Cast time only: the caster's current (origin, cursor), for Stream copies.
	live: (() -> (Vector3?, Vector3?))?,
}

--------------------------------------------------------------------------------
-- Values
--------------------------------------------------------------------------------

local function alive(entity: any): boolean
	return typeof(entity) == "table" and not entity.IsDestroyed and (entity.Health == nil or entity.Health > 0)
end

local function asPoint(value: any): Vector3?
	if typeof(value) == "Vector3" then
		return value
	end
	if alive(value) then
		return value:GetPosition()
	end
	return nil
end

local function matchesFilter(entity: any, filter: string): boolean
	if filter == "Any" then
		return true
	end
	return entity:HasTag(filter)
end

local function nearestEntity(from: Vector3, radius: number, filter: string, exclude: any): any?
	local best, bestDistance = nil, math.huge
	for _, entity in ChunkManager.GetEntitiesInRadius(from, radius) do
		if entity ~= exclude and alive(entity) and matchesFilter(entity, filter) then
			local distance = (entity:GetPosition() - from).Magnitude
			if distance < bestDistance then
				best, bestDistance = entity, distance
			end
		end
	end
	return best
end

local evaluate: (compiled: any, ctx: Context, id: string, port: string) -> any

-- Value arriving at `port` of rune `id`, or nil when unwired.
local function input(compiled: any, ctx: Context, id: string, port: string): any
	local links = compiled.inputs[id][port]
	local link = links and links[1]
	if not link then
		return nil
	end
	return evaluate(compiled, ctx, link.from, link.port)
end

local function number(value: any): number
	return if typeof(value) == "number" and value == value then value else 0
end

local MATH = {
	["+"] = function(a, b) return a + b end,
	["-"] = function(a, b) return a - b end,
	["×"] = function(a, b) return a * b end,
	["÷"] = function(a, b) return if b == 0 then 0 else a / b end,
	min = math.min,
	max = math.max,
}
local COMPARE = {
	["<"] = function(a, b) return a < b end,
	["≤"] = function(a, b) return a <= b end,
	["="] = function(a, b) return math.abs(a - b) < 1e-6 end,
	["≠"] = function(a, b) return math.abs(a - b) >= 1e-6 end,
	["≥"] = function(a, b) return a >= b end,
	[">"] = function(a, b) return a > b end,
}

local function compute(compiled: any, ctx: Context, id: string, port: string): any
	local rune = compiled.runes[id]
	local params = rune.params
	local kind = rune.rune
	if kind == "Caster" then
		return ctx.caster
	elseif kind == "Cursor" then
		if port == "point" then return ctx.cursorPoint end
		return if alive(ctx.cursorEntity) then ctx.cursorEntity else nil
	elseif kind == "Target" then
		-- Aim: its input, else the mouse (at cast time) / the trigger's focus.
		local point = asPoint(input(compiled, ctx, id, "point"))
		if point then return point end
		return if ctx.isCast then ctx.cursorPoint else (ctx.focus or ctx.cursorPoint)
	elseif kind == "Here" then
		return ctx.origin
	elseif kind == "Struck" then
		return if alive(ctx.struck) then ctx.struck else nil
	elseif kind == "Nearest" then
		local from = asPoint(input(compiled, ctx, id, "from")) or ctx.origin
		return nearestEntity(from, params.Radius, params.Filter, ctx.caster)
	elseif kind == "Distance" then
		local a = asPoint(input(compiled, ctx, id, "a"))
		local b = asPoint(input(compiled, ctx, id, "b"))
		return if a and b then (a - b).Magnitude else math.huge
	elseif kind == "Health" then
		local entity = input(compiled, ctx, id, "entity")
		if not alive(entity) then return 0 end
		if params.Mode == "Percent" then
			return if entity.MaxHealth and entity.MaxHealth > 0 then entity.Health / entity.MaxHealth * 100 else 0
		end
		return entity.Health or 0
	elseif kind == "Exists" then
		return alive(input(compiled, ctx, id, "entity"))
	elseif kind == "IsPlayer" then
		local entity = input(compiled, ctx, id, "entity")
		return alive(entity) and entity.Instance ~= nil and Players:GetPlayerFromCharacter(entity.Instance) ~= nil
	elseif kind == "Number" then
		return params.Value
	elseif kind == "Math" then
		return MATH[params.Op](number(input(compiled, ctx, id, "a")), number(input(compiled, ctx, id, "b")))
	elseif kind == "Compare" then
		return COMPARE[params.Op](number(input(compiled, ctx, id, "a")), number(input(compiled, ctx, id, "b")))
	elseif kind == "And" then
		return input(compiled, ctx, id, "a") == true and input(compiled, ctx, id, "b") == true
	elseif kind == "Or" then
		return input(compiled, ctx, id, "a") == true or input(compiled, ctx, id, "b") == true
	elseif kind == "Not" then
		return input(compiled, ctx, id, "a") ~= true
	elseif kind == "Select" then
		local chosen = if input(compiled, ctx, id, "cond") == true then "a" else "b"
		return asPoint(input(compiled, ctx, id, chosen))
	end
	return nil
end

local NONE = table.freeze({}) -- memoized "no value" (nil can't be stored)

evaluate = function(compiled: any, ctx: Context, id: string, port: string): any
	local key = `{id}.{port}`
	local cached = ctx.memo[key]
	if cached == nil then
		cached = compute(compiled, ctx, id, port)
		ctx.memo[key] = if cached == nil then NONE else cached
	end
	return if cached == NONE then nil else cached
end

--------------------------------------------------------------------------------
-- Damage
--------------------------------------------------------------------------------

local function deal(caster: any, target: any, amount: number, info: any)
	if amount <= 0 then return end
	if alive(caster) and caster.DealDamage then
		caster:DealDamage(target, amount, info)
	else
		target:TakeDamage(amount, info)
	end
end

-- Damages `target` (before headshot scaling) and applies the element's
-- secondary effect sized from `energy`, the damage energy this hit carried.
local function strike(ctx: Context, target: any, amount: number, hurtbox: string?, position: Vector3, element: string, energy: number)
	if not alive(target) or target == ctx.caster then
		return
	end
	if hurtbox == "Head" then
		amount *= target.HeadshotMultiplier
	end
	deal(ctx.caster, target, amount, {
		Type = "Spell",
		Element = element,
		Source = ctx.caster,
		Position = position,
		Hurtbox = hurtbox,
	})
	local elementDef = SpellRunes.Elements[element]
	if elementDef.BurnRatio and alive(target) then
		local effect = StatusEffectSys:ApplyEffect(target, "Burn", elementDef.BurnDuration, energy * elementDef.BurnRatio)
		if effect then
			effect.Source = ctx.caster
		end
	elseif elementDef.StunPerEnergy and alive(target) then
		StatusEffectSys:ApplyEffect(target, "Stun", math.min(energy * elementDef.StunPerEnergy, elementDef.StunMax))
	end
end

-- Same analytic head check the projectile raycasts use (see Raycast._resolveHit).
local function hurtboxAt(entity: any, position: Vector3): string
	local head = entity:GetHeadPosition()
	if head and (position - head).Magnitude <= entity.HeadRadius then
		return "Head"
	end
	return "Body"
end

--------------------------------------------------------------------------------
-- Flow
--------------------------------------------------------------------------------

type Watch = {
	projectile: any,
	compiled: any,
	ctx: Context,
	trigger: string,
	energy: number,
	element: string,
	nextCheck: number,
}
local watches: { Watch } = {}

function SpellRuntime.IsSustaining(player: Player): boolean
	return BeamHandler.IsActive(player)
end

local runFlow: (compiled: any, ctx: Context, fromId: string, port: string, energy: number, element: string?) -> ()

local function headingOf(projectile: any, fallback: Vector3): Vector3
	local velocity = projectile.Velocity
	return if velocity.Magnitude > 1e-3 then velocity.Unit else fallback
end

-- Runs the sub-circle hanging off a trigger from eventPoint. heading is the
-- vessel's travel direction at that moment; On Impact reflects it off the
-- surface so what it fires ricochets unless aimed.
local function fireTrigger(compiled: any, parent: Context, triggerId: string, energy: number, element: string, eventPoint: Vector3, heading: Vector3, normal: Vector3?, struck: any?)
	if normal and compiled.runes[triggerId].rune == "OnImpact" then
		heading = heading - 2 * heading:Dot(normal) * normal
	end
	local ctx: Context = {
		player = parent.player,
		caster = parent.caster,
		character = parent.character,
		origin = eventPoint + (normal or Vector3.zero) * 0.5,
		cursorPoint = parent.cursorPoint,
		cursorEntity = parent.cursorEntity,
		struck = struck,
		heading = heading,
		focus = if alive(struck) then struck:GetPosition() else nil,
		isCast = false,
		spawnOffset = TRIGGER_SPAWN_OFFSET,
		memo = {},
	}
	runFlow(compiled, ctx, triggerId, "out", energy, element)
end

-- Stats for one vessel after its modifiers. Evaluated once per firing, so a
-- Stream's later copies reuse the cast-time Homing lock.
local function vesselStats(compiled: any, ctx: Context, id: string): any
	local base = SpellRunes.Vessels[compiled.runes[id].rune]
	local tables = SpellRunes.ModifierTables
	local stats = {
		speed = base.Speed,
		radius = base.Radius,
		lifetime = base.Lifetime,
		range = base.Range,
		scale = base.Scale or 1,
		gravity = 0,
		bounces = 0,
		pierces = 0,
		homing = nil :: any,
		quantity = nil :: any,
		sustain = nil :: number?,
	}
	for _, modId in compiled.vessels[id].mods do
		local mod = compiled.runes[modId]
		local params = mod.params
		local level = params.Level
		local kind = mod.rune
		if kind == "Speed" and stats.speed then
			stats.speed *= tables.Speed[level]
		elseif kind == "Size" then
			stats.radius *= tables.Size[level]
			stats.scale *= tables.Size[level]
		elseif kind == "Gravity" then
			stats.gravity = tables.Gravity[level]
		elseif kind == "Bounce" then
			stats.bounces = level
		elseif kind == "Pierce" then
			stats.pierces = level
		elseif kind == "Range" then
			if stats.lifetime then stats.lifetime *= tables.Range[level] end
			if stats.range then stats.range *= tables.Range[level] end
		elseif kind == "Quantity" then
			stats.quantity = params
		elseif kind == "Sustain" then
			stats.sustain = tables.Sustain[level]
		elseif kind == "Homing" then
			local lock = input(compiled, ctx, modId, "entity")
			stats.homing = {
				lock = if alive(lock) and lock ~= ctx.caster then lock else nil,
				radius = tables.HomingRadius[level],
				filter = params.Filter,
				turnRate = math.rad(tables.HomingTurn[level]),
			}
		end
	end
	return stats
end

-- Aim: whatever is wired into the vessel's Aim port, else the cursor (at cast
-- time) / the trigger's focus, else straight ahead.
local function aimDirection(compiled: any, ctx: Context, id: string): Vector3
	local aim = asPoint(input(compiled, ctx, id, "aim"))
	if not aim then
		aim = if ctx.isCast then ctx.cursorPoint else ctx.focus
	end
	if aim and (aim - ctx.origin).Magnitude > 1e-3 then
		return (aim - ctx.origin).Unit
	end
	return ctx.heading
end

-- One direction per copy a Quantity rune asks for: a Fan spreads Spread
-- degrees across the aim, a Ring circles the aim at Spread/2 off-axis, and a
-- Stream repeats the aim (its copies are staggered in time instead).
local function spreadDirections(direction: Vector3, quantity: any): { Vector3 }
	local count = if quantity then quantity.Count else 1
	if count <= 1 or quantity.Pattern == "Stream" then
		return table.create(count, direction)
	end
	local up = if math.abs(direction.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local basis = CFrame.lookAt(Vector3.zero, direction, up)
	local spread = math.rad(quantity.Spread)
	local directions = table.create(count)
	for index = 1, count do
		if quantity.Pattern == "Ring" then
			local roll = (index - 1) / count * math.pi * 2
			directions[index] = (basis * CFrame.Angles(0, 0, roll) * CFrame.Angles(spread / 2, 0, 0)).LookVector
		else
			local t = (index - 1) / (count - 1) - 0.5
			directions[index] = (basis * CFrame.Angles(0, -t * spread, 0)).LookVector
		end
	end
	return directions
end

type Shot = {
	compiled: any,
	ctx: Context,
	id: string,
	vessel: string,
	element: string,
	info: any,
	stats: any,
	perCopy: number, -- energy one copy carries (triggers take shares of this)
	damageEnergy: number, -- the part of it spent on hits
	impact: number, -- damage per damage-energy (element x vessel)
	channelId: number?,
}

-- All flying vessels use the same swept-radius simulation and trigger pipeline.
local function launch(shot: Shot, direction: Vector3)
	local ctx = shot.ctx
	if not ProjectileQuota.TryAcquire(ctx.player, 1) then
		return -- over the live-projectile budget: this copy fizzles
	end
	local stats, element, compiled = shot.stats, shot.element, shot.compiled
	local elementDef = SpellRunes.Elements[element]
	local caster = ctx.caster
	local homing = stats.homing and {
		Target = stats.homing.lock,
		AcquireRadius = stats.homing.radius,
		TargetTag = if stats.homing.filter ~= "Any" then stats.homing.filter else nil,
		Retarget = true,
		ReacquireRate = 0.3,
		TurnRate = stats.homing.turnRate,
		Delay = if shot.vessel == "Beam" then 0 else 0.05,
	}
	local projectile = (if shot.vessel == "Beam" then BeamHandler.Launch else Projectile.new)({
		Origin = ctx.origin + direction * ctx.spawnOffset,
		Direction = direction,
		Speed = stats.speed,
		Radius = stats.radius,
		Lifetime = stats.lifetime,
		Gravity = stats.gravity,
		Bounces = stats.bounces,
		Restitution = 0.7,
		MaxPierces = stats.pierces,
		PierceFalloff = PIERCE_FALLOFF,
		Damage = shot.damageEnergy * shot.impact,
		Source = caster,
		IgnoreInstances = { ctx.character },
		Filter = function(entity)
			return entity ~= caster and not entity.IsDestroyed and entity.Health > 0
		end,
		Homing = homing,
		Visualize = true,
		VisualRange = VISUAL_RANGE,
		VisualScale = stats.scale,
		Beam = if shot.vessel == "Beam" then { Length = if stats.sustain then math.max(24, stats.speed * SUSTAIN_INTERVAL * 2) else 24, ChannelId = shot.channelId } else nil,
		-- Built procedurally on the client -- see VisualModel's styled visuals.
		Visual = { Style = shot.vessel, Color = elementDef.Color, Core = elementDef.Core },
	})

	-- Reusable synchronous binding for both emitted packets and subdivisions.
	-- Each fork receives a fraction of the UNFIRED trigger/damage energy.
	local bind: (any, number, any?) -> ()
	bind = function(projectile, damageEnergy, triggerAmounts)
		local lastStruck = nil
		local boundWatches = {}
		projectile.OnHit:Connect(function(hit)
			if hit.Entity then
				lastStruck = hit.Entity
				local multiplier = projectile.DamageMultiplier
				strike(ctx, hit.Entity, projectile.Damage * multiplier, hit.Hurtbox, hit.CFrame.Position, element, damageEnergy * multiplier)
			end
		end)
		local destroyTriggers = {}
		for _, triggerId in shot.info.triggers do
			local trigger = compiled.runes[triggerId]
			local watch: Watch = {
				projectile = projectile,
				compiled = compiled,
				ctx = ctx,
				trigger = triggerId,
				energy = if triggerAmounts then (triggerAmounts[triggerId] or 0) else shot.perCopy * trigger.params.Share / 100,
				element = element,
				nextCheck = 0,
			}
			table.insert(boundWatches, watch)
			if trigger.rune == "OnImpact" or trigger.rune == "OnExpire" then
				table.insert(destroyTriggers, watch)
			else
				table.insert(watches, watch)
			end
		end
		local released = false
		projectile.OnDestroy:Connect(function(result)
			if not released then
				released = true
				ProjectileQuota.Release(ctx.player, 1)
			end
			for _, watch in destroyTriggers do
				local kind = compiled.runes[watch.trigger].rune
				local heading = headingOf(projectile, ctx.heading)
				if kind == "OnImpact" and (result.Kind == "entity" or result.Kind == "world") then
					fireTrigger(compiled, ctx, watch.trigger, watch.energy, element, result.Position, heading, result.Normal, if result.Kind == "entity" then lastStruck else nil)
				elseif kind == "OnExpire" and result.Kind == nil then
					fireTrigger(compiled, ctx, watch.trigger, watch.energy, element, result.Position, heading, nil, nil)
				end
			end
		end)
		projectile._beamReserveChildren = function(count)
			return ProjectileQuota.TryAcquire(ctx.player, count)
		end
		projectile._beamBindChild = function(child, share)
			local amounts = {}
			for _, watch in boundWatches do amounts[watch.trigger] = watch.energy * share end
			bind(child, damageEnergy * share, amounts)
		end
		projectile._beamScaleEnergy = function(share)
			damageEnergy *= share
			projectile.Damage *= share
			for _, watch in boundWatches do watch.energy *= share end
		end
	end
	bind(projectile, shot.damageEnergy, nil)
end

-- A fresh cast-time context from the caster's live hand and cursor, so each
-- Stream copy aims where you're pointing now. Values are re-evaluated too
-- (fresh memo): an Aim fed by Nearest Entity re-targets per copy.
local function liveContext(ctx: Context): Context
	if not ctx.isCast or not ctx.live then
		return ctx
	end
	local origin, cursor = ctx.live()
	local fresh = table.clone(ctx)
	fresh.origin = origin or ctx.origin
	fresh.cursorPoint = cursor or ctx.cursorPoint
	local offset = fresh.cursorPoint - fresh.origin
	fresh.heading = if offset.Magnitude > 1e-3 then offset.Unit else ctx.heading
	fresh.memo = {}
	return fresh
end

local function emitSustain(parent: Shot, index: number, share: number, channelId: number)
	local shot = table.clone(parent)
	shot.channelId = channelId
	shot.ctx = liveContext(shot.ctx)
	shot.perCopy *= share
	shot.damageEnergy *= share
	local directions = spreadDirections(aimDirection(shot.compiled, shot.ctx, shot.id), shot.stats.quantity)
	launch(shot, directions[index])
end

-- Explosion: damages every living entity (never the caster) in the radius,
-- full at the centre down to half at the edge, then broadcasts the blast for
-- the client-side visual. Centre: the At input, else Here -- which at cast
-- time is your hand, so a cast-time blast goes to the cursor instead
-- (clamped to MaxCastRange).
local function explode(shot: Shot)
	local ctx, compiled = shot.ctx, shot.compiled
	local base = SpellRunes.Vessels.Explosion
	local center = asPoint(input(compiled, ctx, shot.id, "aim"))
	if not center then
		center = if ctx.isCast then ctx.cursorPoint else ctx.origin
	end
	if ctx.isCast then
		local offset = center - ctx.origin
		if offset.Magnitude > base.MaxCastRange then
			center = ctx.origin + offset.Unit * base.MaxCastRange
		end
	end
	local radius = shot.stats.radius
	for _, entity in ChunkManager.GetEntitiesInRadius(center, radius) do
		if entity ~= ctx.caster and alive(entity) then
			local position = entity:GetPosition()
			local falloff = 1 - 0.5 * math.clamp((position - center).Magnitude / radius, 0, 1)
			strike(ctx, entity, shot.damageEnergy * shot.impact * falloff, "Body", position, shot.element, shot.damageEnergy * falloff)
		end
	end
	VisualOffload.Fire("SpellExplosion", {
		Position = center,
		Radius = radius,
		Color = SpellRunes.Elements[shot.element].Color,
	})
end


local function fireVessel(compiled: any, ctx: Context, id: string, energy: number, element: string)
	local info = compiled.vessels[id]
	local vessel = compiled.runes[id].rune
	local stats = vesselStats(compiled, ctx, id)
	local perCopy = energy * (1 - info.modCost) / info.count
	local shot: Shot = {
		compiled = compiled,
		ctx = ctx,
		id = id,
		vessel = vessel,
		element = element,
		info = info,
		stats = stats,
		perCopy = perCopy,
		damageEnergy = perCopy * (1 - info.triggerShare),
		impact = SpellRunes.Elements[element].Impact * SpellRunes.Vessels[vessel].Impact,
	}
	if vessel == "Explosion" then
		explode(shot)
		return
	end
	local stream = stats.quantity and stats.quantity.Pattern == "Stream"
	if vessel == "Beam" and stats.sustain then
		for index = 1, info.count do
			BeamHandler.Start({
				Player = ctx.player, Character = ctx.character, Caster = ctx.caster,
				Duration = stats.sustain,
				Speed = stats.speed,
				Delay = if stream then (index - 1) * stats.quantity.Interval else 0,
				Origin = function() return liveContext(ctx).origin end,
				Emit = function(share, channelId) emitSustain(shot, index, share, channelId) end,
			})
		end
		return
	end
	for index, direction in spreadDirections(aimDirection(compiled, ctx, id), stats.quantity) do
		if stream and index > 1 then
			task.delay((index - 1) * stats.quantity.Interval, function()
				-- Re-aim each later copy from where the caster is pointing now.
				local liveShot = table.clone(shot)
				liveShot.ctx = liveContext(ctx)
				if liveShot.ctx.character.Parent and (not liveShot.ctx.caster or alive(liveShot.ctx.caster)) then
					launch(liveShot, aimDirection(compiled, liveShot.ctx, id))
				end
			end)
		else
			launch(shot, direction)
		end
	end
end

runFlow = function(compiled: any, ctx: Context, fromId: string, port: string, energy: number, element: string?)
	local links = compiled.outputs[fromId][port]
	local link = links and links[1]
	if not link or energy <= 0 then
		return -- an unwired flow output fizzles
	end
	local id = link.to
	local rune = compiled.runes[id]
	local def = SpellRunes.Runes[rune.rune]
	if def.Element then
		runFlow(compiled, ctx, id, "out", energy, def.Element)
	elseif rune.rune == "If" then
		local taken = if input(compiled, ctx, id, "cond") == true then "yes" else "no"
		runFlow(compiled, ctx, id, taken, energy, element)
	elseif rune.rune == "Divide" then
		local share = rune.params.Share / 100
		runFlow(compiled, ctx, id, "a", energy * share, element)
		runFlow(compiled, ctx, id, "b", energy * (1 - share), element)
	elseif def.Vessel and element then
		fireVessel(compiled, ctx, id, energy, element)
	end
end

--------------------------------------------------------------------------------
-- Public
--------------------------------------------------------------------------------

export type CastRequest = {
	player: Player,
	caster: any,
	character: Model,
	origin: Vector3,
	cursorPoint: Vector3,
	cursorEntity: any?,
	live: (() -> (Vector3?, Vector3?))?, -- current (origin, cursor); see liveContext
}

-- Runs every Mana Well's flow. Mana is charged by the caller.
function SpellRuntime.Cast(compiled: any, request: CastRequest)
	BeamHandler.BeginCast(request.player)
	local offset = request.cursorPoint - request.origin
	local ctx: Context = {
		player = request.player,
		caster = request.caster,
		character = request.character,
		origin = request.origin,
		cursorPoint = request.cursorPoint,
		cursorEntity = request.cursorEntity,
		struck = nil,
		heading = if offset.Magnitude > 1e-3 then offset.Unit else Vector3.zAxis,
		focus = nil,
		isCast = true,
		spawnOffset = CAST_SPAWN_OFFSET,
		memo = {},
		live = request.live,
	}
	for _, rootId in compiled.manaRoots do
		runFlow(compiled, ctx, rootId, "out", compiled.runes[rootId].params.Amount, nil)
	end
end

-- Timer / proximity triggers. Age is the projectile's own dilated clock, so a
-- timer inside a slow zone burns slower, like everything else.
Heartbeat.Connect(function()
	local now = os.clock()
	for index = #watches, 1, -1 do
		local watch = watches[index]
		local projectile = watch.projectile
		local trigger = watch.compiled.runes[watch.trigger]
		if watch.energy <= 0 then table.remove(watches, index); continue end
		local fired, struck = false, nil
		if projectile.Dead then
			table.remove(watches, index)
			continue
		end
		if trigger.rune == "OnTimer" then
			fired = projectile.Age >= trigger.params.Delay
		elseif trigger.rune == "OnProximity" and now >= watch.nextCheck then
			watch.nextCheck = now + PROXIMITY_CHECK_INTERVAL
			struck = nearestEntity(projectile.Position, trigger.params.Radius, trigger.params.Filter, watch.ctx.caster)
			fired = struck ~= nil
		end
		if fired then
			table.remove(watches, index)
			local energy = watch.energy
			watch.energy = 0 -- do not duplicate a spent trigger when later subdividing
			fireTrigger(watch.compiled, watch.ctx, watch.trigger, energy, watch.element, projectile.Position, headingOf(projectile, watch.ctx.heading), nil, struck)
			if trigger.params.Detonate then
				projectile:Destroy({ Position = projectile.Position, Normal = Vector3.yAxis }, "detonate")
			end
		end
	end
end, { Name = "SpellRuntime.Triggers", Priority = 6 })


return SpellRuntime
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="63">
        <Properties>
          <string name="Name">SpellService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server-authoritative spell-card commands and casting. The circle itself is
-- executed by SpellRuntime; this script owns remotes, mana and cooldowns.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Entity = require(Shared:WaitForChild("Entity"))
local SafeMath = require(Shared:WaitForChild("SafeMath"))
local SpellCompiler = require(Shared:WaitForChild("SpellCompiler"))
local SpellStore = require(script.Parent:WaitForChild("SpellStore"))
local SpellRuntime = require(script.Parent:WaitForChild("SpellRuntime"))
local BeamHandler = require(script.Parent:WaitForChild("BeamProjectileHandler"))
local RunService = game:GetService("RunService")

local MANA = 10_000_000_000_000
local CAST_INTERVAL = 0.25
local COMMAND_INTERVAL = 0.15

local remoteFolder = ReplicatedStorage:FindFirstChild("SpellRemotes") or Instance.new("Folder")
remoteFolder.Name = "SpellRemotes"
remoteFolder.Parent = ReplicatedStorage

local command = remoteFolder:FindFirstChild("SpellCommand") or Instance.new("RemoteFunction")
command.Name = "SpellCommand"
command.Parent = remoteFolder

local cast = remoteFolder:FindFirstChild("SpellCast") or Instance.new("RemoteEvent")
cast.Name = "SpellCast"
cast.Parent = remoteFolder

local channel = remoteFolder:FindFirstChild("SpellChannel") or Instance.new("RemoteEvent")
channel.Name = "SpellChannel"
channel.Parent = remoteFolder
channel.OnServerEvent:Connect(function(player: Player, action: any)
	if action == "Stop" then BeamHandler.Stop(player)
	elseif action == "KeepAlive" then BeamHandler.KeepAlive(player) end
end)

-- While the tool is held the client streams its cursor here (unreliable,
-- ~20 Hz) so Stream copies can re-aim mid-cast. Only positions newer than
-- LIVE_AIM_MAX_AGE are trusted; otherwise the click's cursor is used.
local aimRemote = remoteFolder:FindFirstChild("SpellAim") or Instance.new("UnreliableRemoteEvent")
aimRemote.Name = "SpellAim"
aimRemote.Parent = remoteFolder
local LIVE_AIM_MAX_AGE = 0.5
local liveAim: { [Player]: { position: Vector3, time: number } } = {}

local function validPoint(value: any): boolean
	return typeof(value) == "Vector3"
		and value.X == value.X and value.Y == value.Y and value.Z == value.Z
		and math.abs(value.X) < 1e6 and math.abs(value.Y) < 1e6 and math.abs(value.Z) < 1e6
end

aimRemote.OnServerEvent:Connect(function(player: Player, position: any)
	local character = player.Character
	local tool = character and character:FindFirstChild("SpellAssembler")
	local now = os.clock()
	local previous = liveAim[player]
	if tool and tool:IsA("Tool") and validPoint(position) and (not previous or now - previous.time >= 0.025) then
		liveAim[player] = { position = position, time = now }
	end
end)

local lastCast: { [Player]: number } = {}
local lastCommand: { [Player]: number } = {}

local function onPlayer(player: Player)
	player:SetAttribute("MaxMana", MANA)
	player:SetAttribute("Mana", MANA)
end

for _, player in Players:GetPlayers() do onPlayer(player) end
Players.PlayerAdded:Connect(onPlayer)

local function response(ok: boolean, state: any?, errors: any?, message: string?)
	return { ok = ok, state = state, errors = errors, message = message }
end

local function integerSlot(value: any): number?
	if typeof(value) ~= "number" or value ~= value or value % 1 ~= 0 or value < 1 or value > 5 then
		return nil
	end
	return value
end

local function truncateCharacters(text: string, maximum: number): string
	local length = utf8.len(text)
	if not length or length <= maximum then
		return text
	end
	local boundary = utf8.offset(text, maximum + 1)
	return boundary and string.sub(text, 1, boundary - 1) or text
end

local function filterName(player: Player, raw: any): (string?, string?)
	local name = typeof(raw) == "string" and raw or "Untitled Spell"
	name = string.gsub(name, "^%s+", "")
	name = string.gsub(name, "%s+$", "")
	name = truncateCharacters(name, 24)
	if name == "" then name = "Untitled Spell" end
	-- Local Studio test cards never reach production/player-visible storage.
	-- Authentication failure must not prevent offline editor testing.
	if RunService:IsStudio() then return name, nil end
	local ok, filtered = pcall(function()
		local result = TextService:FilterStringAsync(name, player.UserId)
		return result:GetNonChatStringForUserAsync(player.UserId)
	end)
	if not ok or typeof(filtered) ~= "string" or filtered == "" then
		return nil, "The spell name could not be filtered. Try another name."
	end
	return truncateCharacters(filtered, 24), nil
end

local function handleCommand(player: Player, action: any, payload: any)
	if typeof(action) ~= "string" then
		return response(false, nil, nil, "Invalid spell command.")
	end
	local now = os.clock()
	if lastCommand[player] and now - lastCommand[player] < COMMAND_INTERVAL then
		return response(false, SpellStore.GetState(player), nil, "Please wait before sending another spell command.")
	end
	lastCommand[player] = now
	if action == "GetState" then
		return response(true, SpellStore.GetState(player))
	end
	if typeof(payload) ~= "table" then
		return response(false, SpellStore.GetState(player), nil, "Invalid spell command payload.")
	end
	local slot = integerSlot(payload.slot)
	if not slot then
		return response(false, SpellStore.GetState(player), nil, "Choose a card slot from 1 to 5.")
	end

	if action == "SaveCard" then
		local compiled, errors, normalized = SpellCompiler.Compile(payload.graph)
		if not compiled or not normalized then
			return response(false, SpellStore.GetState(player), errors, "The circle is invalid.")
		end
		local name, nameError = filterName(player, payload.name or normalized.name)
		if not name then
			return response(false, SpellStore.GetState(player), nil, nameError)
		end
		normalized.name = name
		local ok, err, state = SpellStore.PutSlot(player, slot, name, normalized)
		return response(ok, state or SpellStore.GetState(player), nil, err or "Spell card saved.")
	elseif action == "DeleteCard" then
		local ok, err, state = SpellStore.DeleteSlot(player, slot)
		return response(ok, state or SpellStore.GetState(player), nil, err or "Spell card deleted.")
	elseif action == "SetActive" then
		BeamHandler.Stop(player)
		local ok, err, state = SpellStore.SetActive(player, slot)
		return response(ok, state or SpellStore.GetState(player), nil, err or "Spell card equipped.")
	end
	return response(false, SpellStore.GetState(player), nil, "Unknown spell command.")
end

local commandBusy: { [Player]: boolean } = {}
command.OnServerInvoke = function(player: Player, action: any, payload: any)
	if commandBusy[player] then return response(false, nil, nil, "A spell command is already in progress.") end
	commandBusy[player] = true
	local ok, result = pcall(handleCommand, player, action, payload)
	commandBusy[player] = nil
	if not ok then
		warn(`[SpellService] command failed: {tostring(result)}`)
		return response(false, nil, nil, "The spell command could not be completed.")
	end
	return result
end

local function equippedAssembler(player: Player): Tool?
	local character = player.Character
	local tool = character and character:FindFirstChild("SpellAssembler")
	return if tool and tool:IsA("Tool") then tool else nil
end

local function aimedEntity(character: Model, origin: Vector3, targetPoint: Vector3)
	local offset = targetPoint - origin
	if offset.Magnitude < 1e-3 then return nil end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true
	local result = workspace:Raycast(origin, offset * 1.05, params)
	return result and Entity.Get(result.Instance) or nil
end

-- Saved graphs are immutable records (PutSlot stores a fresh copy), so the
-- compiled plan can be cached per record instead of recompiling every cast.
local compiledCache: { [any]: any } = setmetatable({}, { __mode = "k" }) :: any

local function compiledFor(record: any): any?
	local cached = compiledCache[record]
	if cached == nil then
		cached = SpellCompiler.Compile(record.graph) or false
		compiledCache[record] = cached
	end
	return cached or nil
end

cast.OnServerEvent:Connect(function(player: Player, rawTarget: any)
	-- A NaN aim has no recoverable direction, so reject it; +-inf components
	-- clamp to SafeMath.Limit so an absurd aim still fires the way it points.
	if typeof(rawTarget) ~= "Vector3" or SafeMath.hasNaN(rawTarget) then
		return
	end
	local targetPoint = SafeMath.vector(rawTarget, Vector3.zero)
	local tool = equippedAssembler(player)
	local character = player.Character
	local root = character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))
	if not tool or not character or not root or not root:IsA("BasePart") then
		return
	end
	local record = SpellStore.GetActive(player)
	if not record then return end
	local compiled = compiledFor(record)
	if not compiled then return end

	local now = os.clock()
	if lastCast[player] and now - lastCast[player] < CAST_INTERVAL then return end
	if SpellRuntime.IsSustaining(player) then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	local mana = player:GetAttribute("Mana")
	if typeof(mana) ~= "number" or mana < compiled.manaCost then return end
	lastCast[player] = now
	player:SetAttribute("Mana", mana - compiled.manaCost)

	local head = character:FindFirstChild("Head")
	local origin = if head and head:IsA("BasePart") then head.Position else root.Position
	liveAim[player] = { position = targetPoint, time = os.clock() }
	local ok, err = pcall(SpellRuntime.Cast, compiled, {
		player = player,
		caster = Entity.Get(character),
		character = character,
		origin = origin,
		cursorPoint = targetPoint,
		cursorEntity = aimedEntity(character, origin, targetPoint),
		live = function()
			local headNow = character:FindFirstChild("Head")
			local aim = liveAim[player]
			local fresh = aim and os.clock() - aim.time <= LIVE_AIM_MAX_AGE
			return if headNow and headNow:IsA("BasePart") then headNow.Position else nil,
				if fresh then aim.position else nil
		end,
	})
	if not ok then
		warn(`[SpellService] cast failed: {tostring(err)}`)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	commandBusy[player] = nil
	liveAim[player] = nil
	lastCast[player] = nil
	lastCommand[player] = nil
end)

print("[Relativity] spell service online")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">SpellStore</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Dedicated persistence/cache for assembled spell cards. This intentionally
	does not share the legacy Player DataStore, so neither system can overwrite
	the other's schema.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")

local SpellCompiler = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SpellCompiler"))

local STORE_NAME = "RelativitySpellCards_v1"
local SCHEMA_VERSION = 3 -- never silently discard cards that no longer compile
local SAVE_INTERVAL = 60
local RETRY_DELAYS = { 1, 2, 4 }

local store = DataStoreService:GetDataStore(STORE_NAME)
local SpellStore = {}

type Entry = {
	loaded: boolean,
	available: boolean,
	sessionOnly: boolean,
	dirty: boolean,
	saving: boolean,
	error: string?,
	data: any,
	localRevision: number,
	persistedRevision: number,
}

local entries: { [Player]: Entry } = {}

local function blankData()
	return {
		schemaVersion = SCHEMA_VERSION,
		activeSlot = nil,
		slots = {},
		updatedAt = os.time(),
		revision = 0,
	}
end

local function copy(value: any, depth: number?): any
	if typeof(value) ~= "table" then
		return value
	end
	local level = depth or 0
	if level > 8 then
		return nil
	end
	local result = {}
	for key, child in value do
		result[copy(key, level + 1)] = copy(child, level + 1)
	end
	return result
end

local function sanitizeLoaded(raw: any)
	local data = blankData()
	if typeof(raw) ~= "table" then
		return data
	end
	local rawSlots = typeof(raw.slots) == "table" and raw.slots or {}
	for slot = 1, 5 do
		local record = rawSlots[tostring(slot)] or rawSlots[slot]
		if typeof(record) == "table" then
			local compiled, errors, normalized = SpellCompiler.Compile(record.graph)
			if compiled and normalized then
				normalized.name = typeof(record.name) == "string" and string.sub(record.name, 1, 96) or compiled.name
				data.slots[tostring(slot)] = {
					name = normalized.name,
					graph = normalized,
					savedAt = typeof(record.savedAt) == "number" and record.savedAt or 0,
				}
			else
				data.slots[tostring(slot)] = {
					name = typeof(record.name) == "string" and string.sub(record.name, 1, 96) or "Unrecognized spell",
					graph = copy(record.graph), savedAt = record.savedAt or 0, invalid = true,
					error = errors[1] and errors[1].message or "This saved graph cannot be compiled.",
				}
			end
		end
	end
	local active = raw.activeSlot
	if typeof(active) == "number" and active % 1 == 0 and data.slots[tostring(active)] then
		data.activeSlot = active
	end
	data.updatedAt = typeof(raw.updatedAt) == "number" and raw.updatedAt or 0
	data.revision = typeof(raw.revision) == "number" and raw.revision or 0
	return data
end

local function studioBridge(): BindableFunction
	local bridge = ServerStorage:WaitForChild("RelativityStudioSpellStore", 3)
	assert(bridge and bridge:IsA("BindableFunction") and bridge:GetAttribute("Ready"),
		"Local Studio spell plugin is not loaded. Reopen Studio after installing RelativitySpellCards.rbxm.")
	return bridge :: BindableFunction
end

local function keyFor(player: Player): string
	return `player_{player.UserId}`
end

local function withRetries(operation: () -> any): (boolean, any)
	local lastError
	for attempt = 1, #RETRY_DELAYS + 1 do
		local ok, result = pcall(operation)
		if ok then
			return true, result
		end
		lastError = result
		if attempt <= #RETRY_DELAYS then
			task.wait(RETRY_DELAYS[attempt])
		end
	end
	return false, lastError
end

local function publicState(entry: Entry)
	return {
		available = entry.available,
		sessionOnly = entry.sessionOnly,
		error = entry.error,
		activeSlot = entry.data.activeSlot,
		slots = copy(entry.data.slots),
		dirty = entry.dirty,
		saving = entry.saving,
		storageMode = if RunService:IsStudio() then "StudioLocal" else "DataStore",
	}
end

function SpellStore.Load(player: Player)
	if entries[player] then
		return
	end
	local entry: Entry = {
		loaded = false,
		available = false,
		sessionOnly = false,
		dirty = false,
		saving = false,
		error = nil,
		data = blankData(),
		localRevision = 0,
		persistedRevision = 0,
	}
	entries[player] = entry
	local ok, result
	if RunService:IsStudio() then
		ok, result = pcall(function() return studioBridge():Invoke("Load", player.UserId) end)
	else
		ok, result = withRetries(function() return store:GetAsync(keyFor(player)) end)
	end
	if entries[player] ~= entry then
		return
	end
	if ok and result ~= nil then
		if typeof(result) ~= "table" or (result.slots ~= nil and typeof(result.slots) ~= "table") then
			ok, result = false, "Stored spell book is malformed; refusing to overwrite it."
		elseif result.revision ~= nil and (typeof(result.revision) ~= "number" or result.revision ~= result.revision
			or result.revision < 0 or result.revision % 1 ~= 0 or result.revision >= 1e15) then
			ok, result = false, "Stored spell revision is malformed; refusing to overwrite it."
		end
		if ok and result.schemaVersion ~= nil and (typeof(result.schemaVersion) ~= "number"
			or result.schemaVersion % 1 ~= 0 or result.schemaVersion < 1) then
			ok, result = false, "Stored spell schema is malformed; refusing to overwrite it."
		end
		if ok and result.slots then
			for slot, record in result.slots do
				local index = tonumber(slot)
				if not index or index % 1 ~= 0 or index < 1 or index > 5 or typeof(record) ~= "table" then
					ok, result = false, "Stored spell slot is malformed; refusing to overwrite it."
					break
				end
			end
		end
	end
	if ok and typeof(result) == "table" and typeof(result.schemaVersion) == "number" and result.schemaVersion > SCHEMA_VERSION then
		ok, result = false, "A newer spell-card schema exists; this server must not overwrite it."
	end
	if ok then
		entry.data = sanitizeLoaded(result)
		entry.persistedRevision = entry.data.revision
		entry.available = true
	else
		entry.error = if RunService:IsStudio() then tostring(result) else "Spell cards could not be loaded; saving is disabled to protect existing data."
		warn(`[SpellStore] load failed for {player.UserId}: {tostring(result)}`)
	end
	entry.loaded = true
end

function SpellStore.WaitForLoad(player: Player, timeout: number?): boolean
	local started = os.clock()
	while player.Parent and (not entries[player] or not entries[player].loaded) do
		if timeout and os.clock() - started >= timeout then
			return false
		end
		task.wait()
	end
	return entries[player] ~= nil and entries[player].loaded
end

function SpellStore.GetState(player: Player)
	SpellStore.WaitForLoad(player, 15)
	local entry = entries[player]
	-- A newly loaded local plugin may become available after this player's
	-- startup load. Retry only the failed Studio load, never replace a live
	-- in-session book or silently retry production failures on every request.
	local bridge = RunService:IsStudio() and ServerStorage:FindFirstChild("RelativityStudioSpellStore")
	if entry and entry.loaded and not entry.available and not entry.dirty and bridge and bridge:GetAttribute("Ready") then
		entries[player] = nil
		SpellStore.Load(player)
		entry = entries[player]
	end
	if not entry then
		return { available = false, sessionOnly = false, error = "Spell state is unavailable.", slots = {} }
	end
	return publicState(entry)
end

function SpellStore.GetActive(player: Player)
	local entry = entries[player]
	if not entry or not entry.loaded or not entry.available or not entry.data.activeSlot then
		return nil
	end
	return entry.data.slots[tostring(entry.data.activeSlot)]
end

function SpellStore.Save(player: Player): (boolean, string?)
	local entry = entries[player]
	if not entry or not entry.loaded or not entry.available then
		return false, entry and entry.error or "Spell data has not loaded."
	end
	if entry.saving then
		return false, "A spell save is already in progress."
	end
	entry.saving = true
	entry.data.updatedAt = os.time()
	local snapshot = copy(entry.data)
	local localRevision = entry.localRevision
	local expectedRevision = entry.persistedRevision
	snapshot.revision = expectedRevision + 1
	snapshot.saveId = HttpService:GenerateGUID(false)
	local ok, result
	if RunService:IsStudio() then
		ok, result = pcall(function() return studioBridge():Invoke("Save", player.UserId, snapshot, expectedRevision) end)
	else
		ok, result = withRetries(function()
			return store:UpdateAsync(keyFor(player), function(old)
				if old ~= nil and typeof(old) ~= "table" then return nil end
				-- Idempotent retry if the first write succeeded but its response
				-- failed. Otherwise reject an older server overwriting a new one.
				if typeof(old) == "table" and old.saveId == snapshot.saveId then return old end
				if typeof(old) == "table" and typeof(old.schemaVersion) == "number" and old.schemaVersion > SCHEMA_VERSION then return nil end
				local revision = typeof(old) == "table" and old.revision or 0
				if revision ~= expectedRevision then return nil end
				return snapshot
			end)
		end)
	end
	entry.saving = false
	if ok and typeof(result) == "table" then
		entry.persistedRevision = snapshot.revision
		entry.data.revision = snapshot.revision
		entry.dirty = entry.localRevision ~= localRevision
		entry.error = nil
		return true, nil
	end
	entry.dirty = true
	entry.error = if ok then "Spell cards changed in another session. Rejoin before saving; no stored data was overwritten."
		else "Spell save failed; the in-session copy is still available."
	if RunService:IsStudio() and not ok then entry.error = tostring(result) end
	if ok then entry.available = false end
	warn(`[SpellStore] save failed for {player.UserId}: {tostring(result)}`)
	return false, entry.error
end

function SpellStore.PutSlot(player: Player, slot: number, name: string, graph: any)
	local entry = entries[player]
	if not entry or not entry.loaded or not entry.available then
		return false, entry and entry.error or "Spell data has not loaded."
	end
	if slot % 1 ~= 0 or slot < 1 or slot > 5 then
		return false, "Slot must be from 1 to 5."
	end
	if entry.saving then return false, "A spell save is already in progress." end
	local compiled, errors, normalized = SpellCompiler.Compile(graph)
	if not compiled then return false, errors[1] and errors[1].message or "Invalid spell graph." end
	entry.data.slots[tostring(slot)] = { name = name, graph = copy(normalized), savedAt = os.time() }
	entry.localRevision += 1
	entry.dirty = true
	local ok, err = SpellStore.Save(player)
	return ok, err, publicState(entry)
end

function SpellStore.DeleteSlot(player: Player, slot: number)
	local entry = entries[player]
	if not entry or not entry.loaded or not entry.available then
		return false, entry and entry.error or "Spell data has not loaded."
	end
	if slot % 1 ~= 0 or slot < 1 or slot > 5 then
		return false, "Slot must be from 1 to 5."
	end
	if entry.saving then return false, "A spell save is already in progress." end
	entry.data.slots[tostring(slot)] = nil
	if entry.data.activeSlot == slot then
		entry.data.activeSlot = nil
	end
	entry.dirty = true
	entry.localRevision += 1
	local ok, err = SpellStore.Save(player)
	return ok, err, publicState(entry)
end

function SpellStore.SetActive(player: Player, slot: number)
	local entry = entries[player]
	if not entry or not entry.loaded or not entry.available then
		return false, entry and entry.error or "Spell data has not loaded."
	end
	if slot % 1 ~= 0 or slot < 1 or slot > 5 or not entry.data.slots[tostring(slot)] then
		return false, "That spell card does not exist."
	end
	if entry.saving then return false, "A spell save is already in progress." end
	if entry.data.slots[tostring(slot)].invalid then return false, "This saved spell no longer compiles; its original graph has been preserved." end
	entry.data.activeSlot = slot
	entry.dirty = true
	entry.localRevision += 1
	local ok, err = SpellStore.Save(player)
	return ok, err, publicState(entry)
end

local function onPlayer(player: Player)
	task.spawn(SpellStore.Load, player)
end

for _, player in Players:GetPlayers() do
	onPlayer(player)
end
Players.PlayerAdded:Connect(onPlayer)

Players.PlayerRemoving:Connect(function(player)
	local entry = entries[player]
	if entry and entry.loaded and entry.available and entry.dirty then
		SpellStore.Save(player)
	end
	entries[player] = nil
end)

task.spawn(function()
	while true do
		task.wait(SAVE_INTERVAL)
		for player, entry in entries do
			if player.Parent and entry.loaded and entry.available and entry.dirty and not entry.saving then
				task.spawn(SpellStore.Save, player)
			end
		end
	end
end)

game:BindToClose(function()
	local remaining = 0
	for player, entry in entries do
		if entry.loaded and entry.available and entry.dirty and not entry.sessionOnly then
			remaining += 1
			task.spawn(function()
				SpellStore.Save(player)
				remaining -= 1
			end)
		end
	end
	local deadline = os.clock() + 10
	while remaining > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)

return SpellStore
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="65">
        <Properties>
          <string name="Name">StatusEffects</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	StatusEffects (server)
	Registers the shared status effect DEFINITIONS this game actually uses
	with StatusEffectSys (see src/shared/StatusEffectSys.luau for the
	generic duration/stack engine) -- this is the one place that knows what
	each named effect actually DOES; callers elsewhere just reference it by
	name (e.g. Weapons/Railgun.luau's OnHitFunction calls
	StatusEffectSys:ApplyEffect(entity, "Stun", duration)).

	StatusEffectSys.Register just populates an in-memory table, so this
	script must run before anything applies an effect by name -- in
	practice that's guaranteed, since every top-level server Script's main
	chunk finishes running well before a player can equip/fire a weapon.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local StatusEffectSys = require(Shared.StatusEffectSys)
local Ragdoll = require(script.Parent.Ragdoll)

-- Stun: ragdolls the entity's character for the effect's Duration, then
-- restores normal Motor6D-driven animation the instant it expires --
-- however it ends (natural countdown, an early StatusEffectSys:
-- RemoveEffect, or a fresh ApplyEffect extending it -- see
-- StatusEffectSys's own doc comment on stacking), OnExpire covers all of
-- those uniformly, so this never needs its own timer. Reapplying while
-- already active just ADDS to the remaining duration (stock
-- StatusEffectSys stacking behavior) -- handy for chaining stun-locks from
-- repeated hits.
StatusEffectSys.Register("Stun", {
	OnApply = function(entity)
		local character = entity.Instance
		if character and character:IsA("Model") then
			Ragdoll.SetRagdoll(character, true)
		end
	end,
	OnExpire = function(entity)
		local character = entity.Instance
		if character and character:IsA("Model") then
			Ragdoll.SetRagdoll(character, false)
		end
	end,
})

-- Burn: Potency is the damage still to be dealt and Duration the time left
-- to deal it, so each tick deals its proportional share and the final tick
-- deals the remainder. Reapplying stacks both (stock stacking), extending the
-- burn and adding to the pool. effect.Source (set by the applier -- see
-- SpellRuntime's Fire element) gets the kill credit.
StatusEffectSys.Register("Burn", {
	TickInterval = 0.5,
	OnTick = function(entity, effect, interval)
		local amount = effect.Potency * math.min(interval / math.max(effect.Duration, interval), 1)
		effect.Potency -= amount
		local info = { Type = "Burn", Element = "Fire", Source = effect.Source }
		local source = effect.Source
		if source and not source.IsDestroyed and source.DealDamage then
			source:DealDamage(entity, amount, info)
		else
			entity:TakeDamage(amount, info)
		end
	end,
})

print("[Relativity] status effects registered")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	Weapons (server)
	Registry of every server-authoritative weapon module, keyed by Tool name.
	Shooter.server.luau is a generic dispatcher driven entirely by this
	table -- it never hardcodes a weapon name. Adding a new shooting weapon:
	hand-place its Tool in StarterPack, add a ToolControllers/<Name>.luau
	client controller (see ToolControllers/_ShootingWeapon.luau -- most
	weapons can just re-export it), and drop a new
	Weapons/<Name>.luau module in this folder returning a WeaponDef (see the
	type below) -- Shooter.server.luau picks it up automatically.

	This replaces the old src/shared/ShooterTool.luau: nothing outside this
	dispatcher ever needs to enumerate weapon names (the client matches tool
	-> controller purely by ModuleScript name via ToolManager.luau), so the
	registry lives server-only now instead of shared.
]]

local WeaponsShared = require(script.Shared)

export type WeaponDef = {
	-- ReplicatedStorage.Effects child name for this weapon's bullet visual.
	Model: string,

	-- Seeds Projectile.new(config) directly -- any field from Projectile's
	-- own config schema is valid here (see src/server/Projectile/init.luau);
	-- omitted fields fall back to Projectile's own defaults.
	Stats: { [string]: any },

	-- Optional -- same shape as Projectile's Homing config sub-table.
	Homing: { [string]: any }?,

	-- Shots/sec. Converted to a per-(Player, Tool) cooldown by the
	-- dispatcher; still floored by MIN_FIRE_INTERVAL regardless of what a
	-- weapon declares (defense in depth -- see Shooter.server.luau).
	FireRate: number,

	-- nil = infinite ammo, no reload ever offered. Present = tracked per
	-- (Player, Tool instance) by the dispatcher.
	Magazine: { Size: number, Reserve: number, ReloadTime: number }?,

	-- Optional. Called once per ACCEPTED shot (fire-rate/ammo checks already
	-- passed), before the projectile spawns -- purely cosmetic (muzzle
	-- flash, fire sound, recoil kick, etc.), never gameplay. Runs
	-- SERVER-SIDE and is passed the equipped Tool instance plus the exact
	-- Origin/Direction the projectile itself is about to spawn with (see
	-- resolveMuzzleOrigin in Shooter.server.luau), so a muzzle effect can
	-- place itself directly on the bullet's actual path instead of relying
	-- on the Tool's own (possibly stale/third-person) transform. CAUTION on
	-- what actually shows from server code: property changes and new
	-- instances replicate (so Sound:Play() works -- Playing is a property),
	-- but METHOD calls like ParticleEmitter:Emit() do NOT -- particle
	-- bursts must be broadcast to clients instead; fire a VisualOffload
	-- channel handled in src/client/WeaponEffects.luau (see Railgun.luau's
	-- "MuzzleBlast" for the pattern).
	OnFire: ((tool: Tool, origin: Vector3, direction: Vector3) -> ())?,

	-- Optional. FULLY REPLACES default damage-dealing for this weapon's
	-- hits when present -- the dispatcher does not auto-apply damage if
	-- this exists. Call WeaponsShared.DealDefaultDamage(ctx, hit) from
	-- inside here to opt back into standard damage before adding custom
	-- effects (chain damage, status effects, VFX, etc.).
	OnHitFunction: ((WeaponsShared.FireContext, WeaponsShared.Hit) -> ())?,

	-- Optional, purely additive -- there's no default destroy-time gameplay
	-- behavior to replace (only internal bookkeeping, which always runs
	-- regardless -- see Shooter.server.luau's OnDestroy handling).
	OnDestroyFunction: ((WeaponsShared.FireContext, { Position: Vector3, Normal: Vector3, Kind: string? }) -> ())?,
}

local Weapons: { [string]: WeaponDef } = {}

for _, child in script:GetChildren() do
	if child:IsA("ModuleScript") and child.Name ~= "Shared" then
		Weapons[child.Name] = require(child) :: WeaponDef
	end
end

return Weapons
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">Pheonix</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	Weapons/Railgun.luau
	First "real" weapon on the new per-weapon schema: a real fire rate and a
	tracked magazine (see Shooter.server.luau's ammo bookkeeping). Stats
	below are a starting point -- TUNE ME by feel in Studio, just edit this
	file and Rojo will live-sync it.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VisualOffload = require(ReplicatedStorage:WaitForChild("Shared").VisualOffload)

-- How far along the shot's own path (origin + direction * this) the muzzle
-- blast effect is placed -- NOT relative to the Tool's transform, so the
-- effect always lines up with the actual projectile path even if the Tool's
-- third-person pose doesn't match the shooter's first-person aim.
local BLAST_DISTANCE = 8

-- Muzzle flash. The actual clone/position/emit work happens CLIENT-side
-- (see src/client/WeaponEffects.luau's "MuzzleBlast" handler) -- this just
-- broadcasts the shot. It HAS to be client-side: ParticleEmitter:Emit() is
-- a method call, and method calls never replicate -- an earlier version
-- called Emit() right here on the server and nothing ever showed on any
-- client (only property changes and new instances replicate; a Sound:Play()
-- works from the server because Playing is a property, but Emit does not).
-- The Flash template instance is sent by reference; the Tool lives in the
-- shooter's character, so it's replicated to everyone who could see the
-- shot anyway.
local function emitMuzzleBlast(tool: Tool, origin: Vector3, direction: Vector3)
	local template = tool:FindFirstChild("Flash")
	if not template then
		return
	end
	VisualOffload.Fire("MuzzleBlast", {
		Template = template,
		Origin = origin,
		Direction = direction,
		Distance = BLAST_DISTANCE,
	}) 
end

return {
	Model = "Rocket", -- ReplicatedStorage.Effects.RailgunRod

	Stats = {
		Speed = 250,
		Acceleration = 0,
		MinSpeed = 0,
		MaxSpeed = 10000,
		Damage = 750,
		Lifetime = 3,
		Gravity = 25,
		Radius = 0.2,
		Bounces = 3,
		Restitution = 0,
		Penetration = 0,
		MaxPierces = 3,
		PierceFalloff = 0.15,
	},

	FireRate = 2, -- shots/sec

	Magazine = {
		Size = math.huge,
		Reserve = math.huge,
		ReloadTime = 2.2, -- seconds
	},

	OnFire = emitMuzzleBlast,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Railgun</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	Weapons/Railgun.luau
	First "real" weapon on the new per-weapon schema: a real fire rate and a
	tracked magazine (see Shooter.server.luau's ammo bookkeeping). Stats
	below are a starting point -- TUNE ME by feel in Studio, just edit this
	file and Rojo will live-sync it. On hit, also applies the shared "Stun"
	status effect (ragdoll -- see StatusEffects.server.luau /
	src/server/Ragdoll/init.luau) plus a hard fling along the bullet's own
	travel direction -- see onRailgunHit below.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualOffload = require(Shared.VisualOffload)
local StatusEffectSys = require(Shared.StatusEffectSys)
local Ragdoll = require(script.Parent.Parent.Ragdoll)
local WeaponsShared = require(script.Parent.Shared)

-- How far along the shot's own path (origin + direction * this) the muzzle
-- blast effect is placed -- NOT relative to the Tool's transform, so the
-- effect always lines up with the actual projectile path even if the Tool's
-- third-person pose doesn't match the shooter's first-person aim.
local BLAST_DISTANCE = 8

-- Muzzle flash. The actual clone/position/emit work happens CLIENT-side
-- (see src/client/WeaponEffects.luau's "MuzzleBlast" handler) -- this just
-- broadcasts the shot. It HAS to be client-side: ParticleEmitter:Emit() is
-- a method call, and method calls never replicate -- an earlier version
-- called Emit() right here on the server and nothing ever showed on any
-- client (only property changes and new instances replicate; a Sound:Play()
-- works from the server because Playing is a property, but Emit does not).
-- The Flash template instance is sent by reference; the Tool lives in the
-- shooter's character, so it's replicated to everyone who could see the
-- shot anyway.
local function emitMuzzleBlast(tool: Tool, origin: Vector3, direction: Vector3)
	local template = tool:FindFirstChild("Flash")
	if not template then
		return
	end
	VisualOffload.Fire("MuzzleBlast", {
		Template = template,
		Origin = origin,
		Direction = direction,
		Distance = BLAST_DISTANCE,
	})
end

local STUN_DURATION = 10 -- seconds a hit entity is ragdolled for (see StatusEffects.server.luau's "Stun")
local FLING_FORCE = 500 -- studs/s of instantaneous velocity kick along the shot's travel direction
local FLING_UP_RATIO = 0.4 -- fraction of FLING_FORCE added straight up, for a launch arc instead of a flat shove
local FLING_SPIN_FORCE = 25 -- rad/s; max per-axis magnitude of the random tumble applied alongside the fling

-- On hit: deals the weapon's own damage (OnHitFunction FULLY REPLACES the
-- dispatcher's default damage-dealing -- see the WeaponDef schema in
-- Weapons/init.luau -- so this calls the shared helper explicitly to opt
-- back into standard damage), then stuns (ragdolls) the target and gives it
-- a hard fling along the bullet's own travel direction. World/wall hits
-- (hit.Entity == nil) only deal damage -- nothing to stun or fling.
local function onRailgunHit(ctx: WeaponsShared.FireContext, hit: WeaponsShared.Hit)
	WeaponsShared.DealDefaultDamage(ctx, hit)

	local entity = hit.Entity
	if not entity then
		return
	end

	StatusEffectSys:ApplyEffect(entity, "Stun", STUN_DURATION)

	-- Fling AFTER the stun above: Stun's OnApply ragdolls synchronously (see
	-- StatusEffects.server.luau), so by this point the target's Motor6Ds are
	-- disabled. SetRootVelocity converts this world-time launch into the
	-- ragdoll's current local time before native physics takes over.
	local humanoid = entity.Humanoid
	local rootPart = humanoid and humanoid.RootPart
	if rootPart then
		local direction = ctx.Projectile.Velocity
		if direction.Magnitude > 1e-3 then
			local linearVelocity = direction.Unit * FLING_FORCE + Vector3.new(0, FLING_FORCE * FLING_UP_RATIO, 0)
			-- Random tumble so every fling reads as a chaotic ragdoll hit
			-- instead of a perfectly clean launch -- the connected limbs
			-- (via the Stun ragdoll's BallSocketConstraints) get dragged
			-- along with the spinning root part over subsequent physics
			-- steps, same as the linear kick above.
			local angularVelocity = Vector3.new(
				(math.random() * 2 - 1) * FLING_SPIN_FORCE,
				(math.random() * 2 - 1) * FLING_SPIN_FORCE,
				(math.random() * 2 - 1) * FLING_SPIN_FORCE
			)
			Ragdoll.SetRootVelocity(entity.Instance, linearVelocity, angularVelocity)
		end
	end
end

return {
	Model = "RailgunRod", -- ReplicatedStorage.Effects.RailgunRod

	Stats = {
		Speed = 1250,
		Acceleration = 0,
		MinSpeed = 0,
		MaxSpeed = 10000,
		Damage = 750,
		Lifetime = 3,
		Gravity = 0,
		Radius = 0.2,
		Bounces = 0,
		Restitution = 0,
		Penetration = 1000,
		MaxPierces = 3,
		PierceFalloff = 0.15,
	},

	FireRate = 2, -- shots/sec

	Magazine = {
		Size = math.huge,
		Reserve = math.huge,
		ReloadTime = 2.2, -- seconds
	},

	OnFire = emitMuzzleBlast,
	OnHitFunction = onRailgunHit,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">Shared</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	Weapons/Shared.luau
	Small helpers shared by the weapon dispatcher (Shooter.server.luau) and
	individual weapon modules. Kept separate from init.luau (the registry)
	so a weapon module's own OnHitFunction can require this directly without
	pulling in (or risk circularly requiring) the registry itself.
]]

local WeaponsShared = {}

export type FireContext = {
	Player: Player,
	Shooter: any?, -- Entity? -- may be nil if the character wasn't registered yet
	Tool: Tool,
	Projectile: any, -- the live Projectile instance this hit/destroy came from
}

export type Hit = {
	CFrame: CFrame,
	Part: BasePart,
	Entity: any?,
	Hurtbox: ("Head" | "Body")?,
}

-- The default damage-dealing behavior every weapon gets unless it defines
-- its own OnHitFunction (see the WeaponDef schema in Weapons/init.luau).
-- Also callable from a custom OnHitFunction that wants standard damage PLUS
-- extra effects, so weapon authors never have to reimplement this by hand.
-- Reads proj.Damage * proj.DamageMultiplier -- DamageMultiplier already
-- reflects PierceFalloff from any earlier pierce on THIS projectile by the
-- time OnHit fires for a given hit. hit.Hurtbox applies the target's own
-- HeadshotMultiplier on top.
function WeaponsShared.DealDefaultDamage(ctx: FireContext, hit: Hit)
	if not hit.Entity then
		return
	end
	local proj = ctx.Projectile
	local damage = proj.Damage * proj.DamageMultiplier
	if hit.Hurtbox == "Head" then
		damage *= hit.Entity.HeadshotMultiplier
	end
	if damage <= 0 then
		return
	end
	local info = { Type = "Projectile", Source = ctx.Shooter, Position = hit.CFrame.Position, Hurtbox = hit.Hurtbox }
	if ctx.Shooter and ctx.Shooter.DealDamage then
		ctx.Shooter:DealDamage(hit.Entity, damage, info)
	else
		hit.Entity:TakeDamage(damage, info)
	end
end

return WeaponsShared
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">TimeBlaster</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	Weapons/TimeBlaster.luau
	The dev/debug tuning weapon -- unlimited ammo, fire rate capped only by
	the dispatcher's global MIN_FIRE_INTERVAL floor (see Shooter.server.luau)
	the same as every other weapon. Stats match this weapon's old hardcoded
	defaults from before the per-weapon module split, so behavior is
	unchanged for existing testers. Tune by editing this file directly --
	Rojo live-syncs on save, no in-game panel needed anymore.
]]

return {
	Model = "Bullet2", -- ReplicatedStorage.Effects.Model

	Stats = {
		Speed = 220,
		Acceleration = 0,
		MinSpeed = 0,
		MaxSpeed = 1000,
		Damage = 20,
		Lifetime = 4,
		Gravity = 0,
		Radius = 0,
		Bounces = 0,
		Restitution = 0.5,
		Penetration = 0,
		MaxPierces = 0,
		PierceFalloff = 0.2,
	},

	-- Matches the dispatcher's MIN_FIRE_INTERVAL (0.1s) exactly, so this
	-- weapon's own FireRate never adds any extra restriction beyond the
	-- global anti-spam floor -- unlimited in practice, same as before.
	FireRate = 10,

	Magazine = nil, -- infinite ammo, no reload
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="71">
        <Properties>
          <string name="Name">example</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server bootstrap.
	 - Enables chunk / global time-scale replication so clients mirror dilation
	   (the true world-level Heartbeat scale, if anything ever sets one --
	   distinct from the per-player ratio below).
	 - Owns each player's own personal time ratio: a client requests a value
	   through the VisualOffload "RequestPersonalTimeScale" channel, the server
	   clamps it, applies it ONLY to that player's Entity (Entity:SetTimeScale --
	   see Entity.luau), and replies with the clamped value on
	   "PersonalTimeScale" to that player alone (never broadcast -- it's
	   personal, it should never affect or even be visible to anyone else). The
	   ratio is also stashed on a PersonalTimeScale player Attribute so
	   PlayerManager.server.luau can reapply it to each new character on
	   respawn.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local ChunkManager = require(Shared.ChunkManager)
local Entity = require(Shared.Entity)
local VisualOffload = require(Shared.VisualOffload)
local Projectile = require(script.Parent.Projectile)

ChunkManager.EnableReplication()

-- Clients can toggle projectile raycast visualization (B key by default).
VisualOffload.On("SetProjectileDebug", function(enabled)
	Projectile.SetDebugRays(enabled == true)
end)

-- Clients can toggle ProjSpawn/ProjSync/ProjHit + ProjMove-rate server console
-- logging (V key by default) -- see Projectile.SetDebugSync's doc comment.
VisualOffload.On("SetProjectileSyncDebug", function(enabled)
	Projectile.SetDebugSync(enabled == true)
end)

-- Bounds for a player's own controllable personal time ratio.
local MIN_RATIO = 0
local MAX_RATIO = 3

VisualOffload.On("RequestPersonalTimeScale", function(value, player)
	if not player or typeof(value) ~= "number" or value ~= value then -- reject nil / NaN
		return
	end
	local clamped = math.clamp(value, MIN_RATIO, MAX_RATIO)

	-- persisted so PlayerManager.server.luau can reapply it to the next
	-- character this player spawns (a fresh Entity otherwise starts at 1x)
	player:SetAttribute("PersonalTimeScale", clamped)

	local entity = Entity.Get(player.Character)
	if entity then
		entity:SetTimeScale(clamped)
	end

	-- reply only to the requesting player -- this is personal, not global
	VisualOffload.FireClient(player, "PersonalTimeScale", clamped)
	print(`[Relativity] {player.Name} set personal time ratio -> x{clamped}`)
end)

-- Optional: freeze simulation in chunks with no players nearby.
-- ChunkManager.ConfigureAutoLoad({ Enabled = true, Radius = 256, Interval = 0.5 })

print("[Relativity] server systems online")
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="72">
    <Properties>
      <string name="Name">SoundService</string>
