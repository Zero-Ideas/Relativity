-- Studio-only, transient checks. Does not modify spell cards or saved data.
local RunService = game:GetService("RunService")
assert(RunService:IsStudio(), "Studio only")
local player = game.Players:GetPlayers()[1] or game.Players.PlayerAdded:Wait()
local Resources = require(game.ServerScriptService.Server.PlayerResources)
local Entity = require(game.ReplicatedStorage.Shared.Entity)
local character = player.Character or player.CharacterAdded:Wait()
local entity = Entity.Get(character)
assert(entity, "Character entity missing")
local oldMana, oldStamina = player:GetAttribute("Mana"), player:GetAttribute("Stamina")
local oldScale = entity.TimeScale
local ok, err = pcall(function()
	entity:SetTimeScale(0)
	player:SetAttribute("Mana", 100)
	player:SetAttribute("Stamina", 100)
	assert(Resources.Consume(player, "Mana", 25))
	assert(player:GetAttribute("Mana") == 75)
	assert(not Resources.Consume(player, "Mana", 76))
	assert(not Resources.Consume(player, "Mana", -1))
	assert(not Resources.Consume(player, "Stamina", 0 / 0))
	assert(not Resources.Consume(player, "Health", 1))
	assert(Resources.Consume(player, "Stamina", 60))
	assert(player:GetAttribute("Stamina") == 40)
	task.wait(0.3)
	assert(player:GetAttribute("Mana") == 75, "Mana regenerated while frozen")
	assert(player:GetAttribute("Stamina") == 40, "Stamina regenerated while frozen")
	entity:SetTimeScale(1)
	task.wait(0.4)
	assert(player:GetAttribute("Mana") > 75, "Mana did not regenerate")
	assert(player:GetAttribute("Stamina") > 40, "Stamina did not regenerate")
end)
entity:SetTimeScale(oldScale)
player:SetAttribute("Mana", oldMana)
player:SetAttribute("Stamina", oldStamina)
assert(ok, err)
print("[PlayerResourcesRegression] PASS: costs, invalid requests, regeneration, freeze")
