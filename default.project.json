{
  "name": "Relativity",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

	"StarterPack": {
	  "$ignoreUnknownInstances": true,
	  "DummySpawner": {
		"$className": "Tool",
		"$properties": {
		  "CanBeDropped": false,
		  "RequiresHandle": false,
		  "ToolTip": "Click to spawn; E selects/deselects; click to move; R removes selected or clears all"
		},
		"$attributes": { "DummyHealth": 1000, "DummyModel": "Dummy" }
	  },
	  "SpellAssembler": {
		"$className": "Tool",
		"$properties": {
		  "CanBeDropped": false,
		  "ManualActivationOnly": false,
		  "RequiresHandle": false,
		  "ToolTip": "Assemble and cast spell cards"
		}
	  }
	},

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            2048,
            20,
            2048
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
