      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Ragdoll</string>
          <string name="Source"><![CDATA[---@module Easy Ragdoll by theonlyflare

--- Services ---
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChunkManager = require(Shared.ChunkManager)

--- Module ---
local RagdollModule = {}

--- Constants ---
-- Names of instances created by the ragdoll system, used for cleanup.
local RAGDOLL_INSTANCE_NAMES = {
	["RagdollAttachment"] = true,
	["RagdollConstraint"] = true,
	["ColliderPart"] = true, -- Keep this for cleanup in case old ragdolls had them
	["RagdollTimeAttachment"] = true,
	["RagdollTimeGravity"] = true,
}

local SCALE_EPSILON = 1e-4
local trackedRagdolls = {}

local function getRoot(character: Model): BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = humanoid and humanoid.RootPart or character.PrimaryPart
	return if root and root:IsA("BasePart") then root else nil
end

local function getScale(character: Model): number
	local root = getRoot(character)
	if not root then
		return 1
	end
	return ChunkManager.GetEffectiveTimeScaleAt(root.Position)
end

local function getParts(character: Model): { BasePart }
	local parts = {}
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") and not descendant.Anchored then
			table.insert(parts, descendant)
		end
	end
	return parts
end

local function getGravityForce(part: BasePart): VectorForce
	local existing = part:FindFirstChild("RagdollTimeGravity")
	if existing and existing:IsA("VectorForce") then
		return existing
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = "RagdollTimeAttachment"
	attachment.Parent = part

	local force = Instance.new("VectorForce")
	force.Name = "RagdollTimeGravity"
	force.Attachment0 = attachment
	force.ApplyAtCenterOfMass = true
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.Parent = part
	return force
end

local function removeTracking(character: Model)
	local state = trackedRagdolls[character]
	if not state then
		return
	end
	trackedRagdolls[character] = nil
	if state.AncestryConnection then
		state.AncestryConnection:Disconnect()
	end
end

local function beginTracking(character: Model)
	if trackedRagdolls[character] then
		return
	end

	local scale = getScale(character)
	local state = {
		Scale = scale,
		Parts = getParts(character),
		FrozenVelocity = {},
	}
	trackedRagdolls[character] = state

	-- Existing motion becomes dilated as soon as the body ragdolls. New pushes
	-- should use SetRootVelocity below so they are expressed in world-time units.
	for _, part in state.Parts do
		part.AssemblyLinearVelocity *= scale
		part.AssemblyAngularVelocity *= scale
		local force = getGravityForce(part)
		force.Force = Vector3.new(0, part.AssemblyMass * workspace.Gravity * (1 - scale * scale), 0)
	end

	state.AncestryConnection = character.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			removeTracking(character)
		end
	end)
end

-- Native rigid-body physics always advances in real time. Keep ragdoll velocity
-- proportional to local time and cancel the portion of engine gravity that
-- should not occur. Gravity uses scale^2 because both velocity and elapsed time
-- are dilated: x(realTime) = x(worldTime * scale).
RunService.Heartbeat:Connect(function()
	for character, state in trackedRagdolls do
		if not character.Parent then
			removeTracking(character)
			continue
		end

		local scale = getScale(character)
		local previousScale = state.Scale
		if math.abs(scale - previousScale) > SCALE_EPSILON then
			for _, part in state.Parts do
				if not part.Parent then
					continue
				end
				if previousScale > SCALE_EPSILON then
					local canonicalLinear = part.AssemblyLinearVelocity / previousScale
					local canonicalAngular = part.AssemblyAngularVelocity / previousScale
					state.FrozenVelocity[part] = {
						Linear = canonicalLinear,
						Angular = canonicalAngular,
					}
					part.AssemblyLinearVelocity = canonicalLinear * scale
					part.AssemblyAngularVelocity = canonicalAngular * scale
				else
					local frozen = state.FrozenVelocity[part]
					if frozen then
						part.AssemblyLinearVelocity = frozen.Linear * scale
						part.AssemblyAngularVelocity = frozen.Angular * scale
					end
				end
			end
			state.Scale = scale
		end

		for _, part in state.Parts do
			if not part.Parent then
				continue
			end
			local force = getGravityForce(part)
			force.Force = Vector3.new(0, part.AssemblyMass * workspace.Gravity * (1 - scale * scale), 0)
			if scale <= SCALE_EPSILON then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
end)

--- Helper Functions ---

--[[
	@param character: Model -- The character model to ragdoll.
	@param humanoid: Humanoid -- The humanoid object within the character.
	@brief Converts Motor6D joints into BallSocketConstraints to enable ragdolling.
	This process involves disabling existing Motor6D joints and replacing them
	with physics-based constraints.
]]
local function replaceJoints(character: Model, humanoid: Humanoid)
	-- Necessary for Ragdolling to function properly
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = true

	-- Disable the 'Animate' script to stop character animations
	local animateScript = character:FindFirstChild("Animate")
	if animateScript and animateScript:IsA("LocalScript") then
		animateScript.Enabled = false
	end

	-- Stop all playing animations on the humanoid's animator
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in animator:GetPlayingAnimationTracks() do
			track:Stop()
		end
	end

	-- Iterate through all descendants to find Motor6D joints
	for _, motor: Motor6D in pairs(character:GetDescendants()) do
		if motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then -- Ensure parts exist for the Motor6D
			motor.Enabled = false -- Disable the Motor6D to allow physics to take over

			-- Create attachments for the BallSocketConstraint
			local attachment0 = Instance.new("Attachment")
			local attachment1 = Instance.new("Attachment")

			-- Set Attachment CFrames based on Motor6D's C0 and C1
			attachment0.CFrame = motor.C0
			attachment1.CFrame = motor.C1

			attachment0.Name = "RagdollAttachment"
			attachment1.Name = "RagdollAttachment"

			-- Create the BallSocketConstraint
			local ballSocketConstraint = Instance.new("BallSocketConstraint")
			ballSocketConstraint.Attachment0 = attachment0
			ballSocketConstraint.Attachment1 = attachment1
			ballSocketConstraint.Name = "RagdollConstraint"

			-- Generic BallSocketConstraint properties. These can be fine-tuned
			-- for specific joints for more realistic ragdoll behavior.
			ballSocketConstraint.Radius = 0.15
			ballSocketConstraint.LimitsEnabled = true
			ballSocketConstraint.TwistLimitsEnabled = true -- Allow some twist, but with limits
			ballSocketConstraint.MaxFrictionTorque = 0 -- No friction at the joint
			ballSocketConstraint.Restitution = 0 -- No bounce at the joint
			ballSocketConstraint.UpperAngle = 90
			ballSocketConstraint.TwistLowerAngle = -45
			ballSocketConstraint.TwistUpperAngle = 45

			-- Apply specific overrides for certain joints for better control
			if motor.Name:find("Neck") then
				ballSocketConstraint.UpperAngle = 45
				ballSocketConstraint.TwistLowerAngle = -70
				ballSocketConstraint.TwistUpperAngle = 70
			elseif motor.Name:find("Hip") then
				ballSocketConstraint.UpperAngle = 60
				ballSocketConstraint.TwistLowerAngle = -30
				ballSocketConstraint.TwistUpperAngle = 30
			elseif motor.Name:find("Shoulder") then
				ballSocketConstraint.UpperAngle = 75
				ballSocketConstraint.TwistLowerAngle = -60
				ballSocketConstraint.TwistUpperAngle = 60
			end

			-- Parent the attachments and constraint
			attachment0.Parent = motor.Part0
			attachment1.Parent = motor.Part1
			ballSocketConstraint.Parent = motor.Parent
		end
	end

	humanoid.AutoRotate = false -- Disabling AutoRotate prevents the Character rotating in first person or Shift-Lock
	character:SetAttribute("LastRag", tick()) -- Used for anti-cheats to prevent flying Ragdolls from getting flagged
end

--[[
	@param character: Model -- The character model to unragdoll.
	@param humanoid: Humanoid -- The humanoid object within the character.
	@brief Destroys all Ragdoll-related instances (attachments, constraints, colliders)
	and re-enables the original Motor6D's to restore normal character animation.
]]
local function resetJoints(character: Model, humanoid: Humanoid)
	-- Do not unragdoll if the humanoid is dead
	if humanoid.Health < 1 then return end

	for _, instance in pairs(character:GetDescendants()) do
		-- Destroy instances created by the ragdoll system
		if RAGDOLL_INSTANCE_NAMES[instance.Name] then
			instance:Destroy()
		end

		-- Re-enable original Motor6D joints
		if instance:IsA("Motor6D") then
			instance.Enabled = true
		end
	end

	humanoid.AutoRotate = true

	-- Re-enable the 'Animate' script
	local animateScript = character:FindFirstChild("Animate")
	if animateScript and animateScript:IsA("LocalScript") then
		animateScript.Enabled = true
	end
end

--[[
	@param character: Model -- The character model to push.
	@param magnitude: number -- The magnitude of the push to apply.
	@brief Applies an impulse to the character's HumanoidRootPart or Torso.
]]
local function applyPush(character: Model, magnitude: number)
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if rootPart and rootPart:IsA("BasePart") then
		-- Apply impulse in the opposite direction of the character's forward vector
		rootPart:ApplyImpulse(rootPart.CFrame.LookVector * -magnitude * getScale(character))
	end
end

--- Module Functions ---

--[[
	@param character: Model -- The character model to apply or remove ragdoll from.
	@param value: boolean -- True to ragdoll, false to unragdoll.
	@param applyPushOnRagdoll: boolean? -- Optional: Whether to apply a push when ragdolling. Defaults to false.
	@param pushMagnitude: number? -- Optional: The magnitude of the push if applyPushOnRagdoll is true. Defaults to 100.
	@brief Toggles the ragdoll state of the given character, with an option to apply an extra push.
]]
function RagdollModule.SetRagdoll(character: Model, value: boolean, applyPushOnRagdoll: boolean?, pushMagnitude: number?)
	-- Validate inputs
	if not character then
		warn("RagdollModule.SetRagdoll: No character provided.")
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		warn("RagdollModule.SetRagdoll: Character does not have a Humanoid.")
		return
	end

	-- Set default optional parameters
	applyPushOnRagdoll = applyPushOnRagdoll or false
	pushMagnitude = pushMagnitude or 100

	if value then -- Ragdoll the character
		replaceJoints(character, humanoid)
		beginTracking(character)
		
		--> Check to see if the module is being called from client/server
		if RunService:IsClient() then
			humanoid:ChangeState(Enum.HumanoidStateType.Ragdoll)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
			
		elseif RunService:IsServer() then
			local root = getRoot(character)
			if root then
				root:SetNetworkOwner(nil)
			end
			
			humanoid:ChangeState(Enum.HumanoidStateType.Ragdoll)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
		end

		-- Apply push only if explicitly requested
		if applyPushOnRagdoll then
			applyPush(character, pushMagnitude)
		end
	else -- Unragdoll the character
		removeTracking(character)
		resetJoints(character, humanoid)
		
		if RunService:IsClient() then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			
		elseif RunService:IsServer() then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			
			-- Fix network ownership for players
			local player: Player? = Players:GetPlayerFromCharacter(character)
			local root = getRoot(character)
			if player and root then
				root:SetNetworkOwner(player)
			end
		end
	end
end

-- Sets a launch velocity in undilated world-time units. Writing the assembly
-- properties directly would bypass the ragdoll controller until a zone change.
function RagdollModule.SetRootVelocity(character: Model, linearVelocity: Vector3, angularVelocity: Vector3?)
	local root = getRoot(character)
	if not root then
		return
	end
	local state = trackedRagdolls[character]
	local scale = if state then state.Scale else getScale(character)
	local angular = angularVelocity or root.AssemblyAngularVelocity
	root.AssemblyLinearVelocity = linearVelocity * scale
	root.AssemblyAngularVelocity = angular * scale
	if state then
		state.FrozenVelocity[root] = {
			Linear = linearVelocity,
			Angular = angular,
		}
	end
end

-- Return the module
return RagdollModule
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="47">
        <Properties>
          <string name="Name">Shooter</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Shooter (server authority)
	Generic weapon dispatcher: receives fire/reload requests from clients
	(VisualOffload "FireBullet"/"ReloadWeapon"/"WeaponEquip") and spawns
	bullets through the Projectile system on behalf of whichever weapon
	module (see Weapons/init.luau) matches the firing player's equipped
	Tool. This file owns ZERO weapon-specific numbers -- every stat, the
	fire rate, the magazine size, and any custom hit/destroy behavior come
	from that weapon's own Weapons/<Name>.luau module. Adding a new weapon
	never means editing this file.

	Because Projectile steps on the dilated Heartbeat, these bullets slow down with
	the global time ratio and inside slow chunks for free -- and, per-shooter, live
	with that player's own personal time ratio (Projectile.luau reads Source.
	TimeScale every tick, so a shooter dragging their ratio mid-flight speeds up
	or slows down bullets already in the air).

	Anti-exploit, defense in depth (VisualOffload's remote is reachable directly by
	any client, bypassing ShooterController's own throttling entirely):
	 - MIN_FIRE_INTERVAL is a hard per-(player, tool) rate limit floor enforced
	   here regardless of how fast (or how directly) the remote is fired, no
	   matter what FireRate a weapon module claims -- a misconfigured weapon
	   can never fire faster than this.
	 - ProjectileQuota caps the combined number of a player's weapon and spell
	   projectiles, so swapping casting systems cannot bypass the live-shot limit.
	 - A shot is only accepted while the firing player's character has one of the
	   Weapons registry's tools equipped (see Weapons/init.luau).
	 - The bullet's Model and every gameplay stat are looked up server-side from
	   the equipped tool's weapon module, NEVER taken from client-sent data -- a
	   client-supplied Model Instance or stat table would be an easy exploit
	   vector (clone-and-broadcast via ProjSpawn, or simply lying about damage).
	 - A weapon with a Magazine can't be fired while empty or mid-reload.
	 - The spawn Origin is resolved entirely server-side too (see
	   resolveMuzzleOrigin below): the equipped Tool's "Tip" Attachment if one
	   exists, else the character's Head -- never taken from the client at
	   all, so there's no origin-spoofing surface to clamp/sanity-check in the
	   first place. Only the aim TargetPoint comes from the client (needed --
	   only it knows where the player is aiming), which just steers direction,
	   not where the bullet spawns.
	 - data.Config (from the client's ShooterConfigGui debug panel) is only
	   ever read inside Studio (see applyStudioDebugOverrides/RunService:
	   IsStudio() below) -- a live client's Config table is completely
	   ignored, so this is a Studio iteration convenience, not a trust hole.

	Lag compensation: each shot carries RewindSeconds, half the firing player's
	current network ping, clamped to MAX_REWIND. Projectile.luau uses this to check
	nearby entities against their position as of (now - RewindSeconds) instead of
	their live position while the bullet is near entities -- see Projectile.luau's
	top-of-file doc comment for the full behavior.

	Also handles "StressTestFire": a dev/benchmarking request that spawns many
	projectiles in one go, bypassing the per-shot rate limit (which throttles
	per-click requests, not a single "spawn N" request) -- see the client's N
	keybind in ShooterController.luau. Restricted to Studio (see the
	RunService:IsStudio() guard below) since spawning thousands of projectiles
	per request is itself an exploit vector if left reachable in a live game. Use
	Heartbeat.GetStats().AvgFrameTime to read the actual per-frame cost while a
	batch is in flight.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Heartbeat = require(Shared.Heartbeat)
local Entity = require(Shared.Entity)
local Projectile = require(script.Parent.Projectile)
local ProjectileQuota = require(script.Parent.ProjectileQuota)
local VisualOffload = require(Shared.VisualOffload)
local Weapons = require(script.Parent.Weapons)
local WeaponsShared = require(script.Parent.Weapons.Shared)

-- Server-owned mapping of weapon name -> the Model clients render for that
-- weapon's bullets, resolved once at startup from each WeaponDef.Model.
-- NEVER trust a client-sent Model reference (a remote can carry an Instance
-- argument, and a client could point it at literally anything replicated to
-- them -- another player's rig, a chunk of terrain, a LocalScript buried
-- somewhere else in the game -- which the server would then clone and
-- broadcast onto every observer via ProjSpawn). A weapon with no asset found
-- just falls back to the default Visual ball.
local Effects = ReplicatedStorage:FindFirstChild("Effects")
local PROJECTILE_MODELS: { [string]: Instance } = {}
for toolName, weapon in Weapons do
	PROJECTILE_MODELS[toolName] = Effects and Effects:FindFirstChild(weapon.Model)
end

local MIN_FIRE_INTERVAL = 0.1 -- absolute floor (seconds, real time), regardless of a weapon's own FireRate -- 10/sec hard cap
local MAX_REWIND = 0.4 -- seconds; stays safely under Entity.HistoryWindow (0.5s)
local MUZZLE_SPAWN_OFFSET = 3 -- studs spawned ahead of the resolved origin, along the aim direction, so a bullet never immediately hits its own shooter
local TIP_ATTACHMENT_NAME = "Tip"
local DEFAULT_VISUAL = { Shape = "Ball", Size = Vector3.one * 0.4, Color = Color3.fromRGB(120, 220, 255) }

local lastFire: { [Tool]: number } = {}

type WeaponState = {
	Magazine: number,
	Reserve: number,
	Reloading: boolean,
}

-- Ammo/reload state, keyed by Tool INSTANCE (not player or weapon name).
-- Every weapon Tool is a private per-player copy cloned from StarterPack --
-- never shared/contested between players -- and Roblox destroys/reclones it
-- fresh on every respawn, so keying by instance means ammo naturally resets
-- on death for free; the only bookkeeping needed is clearing the entry when
-- THIS instance goes away (see tool.Destroying below), not on any
-- per-player respawn hook.
local weaponState: { [Tool]: WeaponState } = {}

-- Clamp a client-supplied number into a trusted range (anti-cheat + sanity).
local function num(value: any, default: number, min: number, max: number): number
	if typeof(value) ~= "number" or value ~= value then
		return default
	end
	return math.clamp(value, min, max)
end

-- Studio-only debug override (see ShooterConfigGui.luau on the client): the
-- fields a dev can live-tune from that panel while testing, each clamped to
-- a sane range and only applied if actually present -- unset fields keep
-- whatever the equipped weapon's own Stats/Homing already say. NEVER read
-- outside Studio (see the IsStudio guard at the call site below), so a live
-- client's Config table is never touched at all -- this doesn't reopen the
-- client-trust gap the per-weapon schema was built to close, it's purely a
-- Studio iteration convenience layered on top of it.
local STUDIO_DEBUG_STAT_FIELDS = {
	{ key = "Speed", min = 10, max = math.huge },
	{ key = "Acceleration", min = -math.huge, max = math.huge },
	{ key = "MinSpeed", min = 0, max = math.huge },
	{ key = "MaxSpeed", min = 0, max = math.huge },
	{ key = "Damage", min = 0, max = math.huge },
	{ key = "Lifetime", min = 0.1, max = math.huge },
	{ key = "Gravity", min = 0, max = math.huge },
	{ key = "Radius", min = 0, max = math.huge },
	{ key = "Bounces", min = 0, max = math.huge, integer = true },
	{ key = "Restitution", min = 0, max = math.huge },
	{ key = "Penetration", min = 0, max = math.huge },
	{ key = "PierceFalloff", min = 0, max = math.huge },
}

local function applyStudioDebugOverrides(projectileConfig: { [string]: any }, cfg: { [string]: any })
	for _, field in STUDIO_DEBUG_STAT_FIELDS do
		local raw = cfg[field.key]
		if typeof(raw) == "number" and raw == raw then
			local value = math.clamp(raw, field.min, field.max)
			projectileConfig[field.key] = if field.integer then math.floor(value) else value
		end
	end
	if typeof(cfg.Pierces) == "number" then
		projectileConfig.MaxPierces = math.floor(num(cfg.Pierces, 0, 0, math.huge))
	end
	if cfg.Homing == true then
		-- Replaces the weapon's own static Homing (if any) for this shot --
		-- lets a dev toggle homing on/off live regardless of what the
		-- weapon module declares.
		projectileConfig.Homing = {
			AcquireRadius = num(cfg.AcquireRadius, 60, 0, math.huge),
			TargetTags = { "Enemy", "Player" },
			Retarget = true,
			ReacquireRate = 0.3,
			Permalock = cfg.Permalock == true,
			TurnRate = math.rad(num(cfg.TurnRate, 140, 0, math.huge)),
			Delay = 0.05,
		}
	end
end

-- Finds which registered weapon (if any) the player's character has
-- equipped right now. Returns the Tool instance and its WeaponDef, or nil,
-- nil if none is equipped -- closes the gap where an exploiter fires a
-- weapon remote directly without ever equipping anything.
local function findEquippedWeapon(character: Model): (Tool?, Weapons.WeaponDef?)
	for toolName, weapon in Weapons do
		local candidate = character:FindFirstChild(toolName)
		if candidate and candidate:IsA("Tool") then
			return candidate, weapon
		end
	end
	return nil, nil
end

-- Where a shot spawns from: the equipped weapon's own "Tip" Attachment if
-- it has one (searched recursively, so it can live under a muzzle model
-- nested inside the Tool), else the character's Head, else the root part
-- (only reachable if a character somehow has no Head at all). Entirely
-- server-resolved from the server's own scene graph -- never trusts
-- anything client-sent, unlike the old client-supplied Origin this replaces.
local function resolveMuzzleOrigin(tool: Tool, character: Model, root: BasePart): Vector3
	local tip = tool:FindFirstChild(TIP_ATTACHMENT_NAME, true)
	if tip and tip:IsA("Attachment") then
		return tip.WorldPosition
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head.Position
	end
	return root.Position
end

-- Lazily creates (full magazine) or returns this tool's ammo state. Only
-- called for weapons that actually have a Magazine (callers check first).
local function getWeaponState(tool: Tool, weapon: Weapons.WeaponDef): WeaponState
	local state = weaponState[tool]
	if state then
		return state
	end
	local magazine = assert(weapon.Magazine, "getWeaponState called on a weapon with no Magazine")
	state = { Magazine = magazine.Size, Reserve = magazine.Reserve, Reloading = false }
	weaponState[tool] = state
	tool.Destroying:Once(function()
		weaponState[tool] = nil
	end)
	return state
end

local function pushAmmoSync(player: Player, tool: Tool, state: WeaponState)
	VisualOffload.FireClient(player, "AmmoSync", {
		ToolName = tool.Name,
		Magazine = state.Magazine,
		Reserve = state.Reserve,
		Reloading = state.Reloading,
	})
end

VisualOffload.On("FireBullet", function(data, player)
	if not player or typeof(data) ~= "table" then
		return
	end

	local targetPoint = data.TargetPoint
	if typeof(targetPoint) ~= "Vector3" then
		return
	end

	local character = player.Character
	local root = character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))
	if not root then
		return
	end

	local tool, weapon = findEquippedWeapon(character)
	if not tool or not weapon then
		return
	end

	-- Origin is entirely server-resolved (see the module doc comment and
	-- resolveMuzzleOrigin above); direction is derived from it toward the
	-- client's aimed TargetPoint, so shots still converge exactly where the
	-- player clicked regardless of which origin was used. Resolved before
	-- any state changes below so a degenerate aim (target on top of the
	-- origin) bails out without consuming ammo/cooldown or playing OnFire.
	local origin = resolveMuzzleOrigin(tool, character, root)
	local toTarget = targetPoint - origin
	if toTarget.Magnitude < 1e-3 then
		return
	end
	local direction = toTarget.Unit

	-- rate limit: a hard per-(player, tool) cap independent of client input
	-- (the remote is reachable directly -- see the module doc comment
	-- above), floored regardless of what the weapon's own FireRate claims.
	local cooldown = math.max(1 / weapon.FireRate, MIN_FIRE_INTERVAL)
	local now = os.clock()
	if lastFire[tool] and now - lastFire[tool] < cooldown then
		return
	end

	-- ammo: reject (without consuming the fire-rate cooldown above) while
	-- empty or mid-reload; otherwise consume one round and sync the client.
	local state: WeaponState? = nil
	if weapon.Magazine then
		state = getWeaponState(tool, weapon)
		if state.Reloading or state.Magazine <= 0 then
			return
		end
	end
	-- Shared with compiled spells, so swapping systems cannot double the
	-- player's live-projectile allowance.
	if not ProjectileQuota.TryAcquire(player, 1) then
		return
	end
	if lastFire[tool] == nil then
		-- lastFire is keyed by Tool instance, same as weaponState -- clean
		-- it up on the same signal so a long session doesn't accumulate an
		-- entry per (now-destroyed) Tool instance across every respawn.
		tool.Destroying:Once(function()
			lastFire[tool] = nil
		end)
	end
	lastFire[tool] = now
	if state then
		state.Magazine -= 1
		pushAmmoSync(player, tool, state)
	end

	-- Shot is fully accepted at this point -- fire the weapon's cosmetic
	-- hook (muzzle flash, fire sound, etc.) now, before the projectile
	-- itself spawns, passing the same origin/direction the projectile will
	-- actually use so the effect always lands on the real bullet path. See
	-- the OnFire doc comment in Weapons/init.luau.
	if weapon.OnFire then
		weapon.OnFire(tool, origin, direction)
	end

	local shooter = Entity.Get(character) -- may be nil if the character isn't registered

	-- lag compensation: how far back (real seconds) this shooter's view was
	-- desynced when they fired, half their round-trip ping, clamped.
	local ok, ping = pcall(function()
		return player:GetNetworkPing()
	end)
	local rewindSeconds = (ok and typeof(ping) == "number" and ping == ping) and math.clamp(ping / 2, 0, MAX_REWIND) or 0

	-- Seed the projectile config from the weapon's own stat sheet (cloned so
	-- Projectile can never mutate the module's canonical table), then layer
	-- the fields only the server ever controls on top.
	local projectileConfig = table.clone(weapon.Stats)
	projectileConfig.Origin = origin + direction * MUZZLE_SPAWN_OFFSET
	projectileConfig.Direction = direction
	projectileConfig.Source = shooter
	-- Belt-and-suspenders against self-hits: shooter (the Entity) may still
	-- be nil for a shot fired in the brief window before
	-- PlayerManager.server.luau registers this character on CharacterAdded
	-- -- IgnoreInstances excludes the raw character model from the raycast
	-- regardless, so a self-hit can't happen even during that race.
	projectileConfig.IgnoreInstances = { character }
	projectileConfig.RewindSeconds = rewindSeconds
	projectileConfig.Visualize = true -- server = logic only; clients render
	projectileConfig.VisualRange = 800
	projectileConfig.Visual = DEFAULT_VISUAL -- fallback ball, only used if Model resolution above failed
	-- Chosen server-side from the validated equipped tool, never from client
	-- data (see PROJECTILE_MODELS above) -- a client-supplied Model
	-- reference would be an easy exploit vector.
	projectileConfig.Model = PROJECTILE_MODELS[tool.Name]
	if weapon.Homing then
		-- Fresh clone per shot -- handing Projectile the module's own
		-- canonical Homing table would let it become shared/mutated state
		-- across every shot this weapon ever fires (the exact footgun
		-- Projectile.Burst has with a shallow table.clone(config)).
		projectileConfig.Homing = table.clone(weapon.Homing)
	end
	if RunService:IsStudio() and typeof(data.Config) == "table" then
		applyStudioDebugOverrides(projectileConfig, data.Config)
	end

	local ctx: WeaponsShared.FireContext = {
		Player = player,
		Shooter = shooter,
		Tool = tool,
		Projectile = nil :: any, -- filled in immediately below
	}

	-- counted against ProjectileQuota above; OnDestroy fires
	-- exactly once per projectile on every removal path (entity hit, world
	-- hit, dilated lifetime expiry, or the real-time MaxRealLifetime safety
	-- cap -- see Projectile.luau's Step/Destroy), so this always balances the
	-- increment below. OnHit is NOT exactly-once (piercing/bouncing/
	-- penetrating fire it without removing the projectile), which is exactly
	-- why this uses OnDestroy instead. The real-time cap matters here
	-- specifically: a shooter who freezes their own personal time with shots
	-- in flight would otherwise have those shots sit in the quota
	-- forever, silently eating into their shared projectile budget.
	local proj = Projectile.new(projectileConfig)
	ctx.Projectile = proj

	proj.OnDestroy:Connect(function(destroyInfo)
		-- Unconditional bookkeeping -- never skippable by a weapon's own
		-- OnDestroyFunction, or the concurrency cap silently breaks.
		ProjectileQuota.Release(player, 1)
		if weapon.OnDestroyFunction then
			weapon.OnDestroyFunction(ctx, destroyInfo)
		end
	end)

	-- If the weapon defines its own OnHitFunction it FULLY REPLACES default
	-- damage-dealing for this weapon's hits (see the WeaponDef schema in
	-- Weapons/init.luau) -- it can call WeaponsShared.DealDefaultDamage
	-- itself to opt back into standard damage before adding custom effects.
	proj.OnHit:Connect(function(hit)
		if weapon.OnHitFunction then
			weapon.OnHitFunction(ctx, hit)
		else
			WeaponsShared.DealDefaultDamage(ctx, hit)
		end
	end)
end)

VisualOffload.On("ReloadWeapon", function(_data, player)
	if not player then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local tool, weapon = findEquippedWeapon(character)
	if not tool or not weapon or not weapon.Magazine then
		return
	end
	local magazine = weapon.Magazine
	local state = getWeaponState(tool, weapon)
	if state.Reloading or state.Reserve <= 0 or state.Magazine >= magazine.Size then
		return
	end

	state.Reloading = true
	pushAmmoSync(player, tool, state)

	task.delay(magazine.ReloadTime, function()
		-- The tool (or its state entry) may be gone by the time this fires
		-- (unequipped/respawned/left) -- weaponState[tool] would already be
		-- nil via tool.Destroying in that case, `state` here is still the
		-- same table reference so writes are harmless even if orphaned.
		local reload = math.min(magazine.Size - state.Magazine, state.Reserve)
		state.Magazine += reload
		state.Reserve -= reload
		state.Reloading = false
		if player.Parent and weaponState[tool] == state then
			pushAmmoSync(player, tool, state)
		end
	end)
end)

VisualOffload.On("WeaponEquip", function(data, player)
	if not player or typeof(data) ~= "table" or typeof(data.ToolName) ~= "string" then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local weapon = Weapons[data.ToolName]
	local tool = character:FindFirstChild(data.ToolName)
	if not weapon or not weapon.Magazine or not tool or not tool:IsA("Tool") then
		return
	end
	-- Lets the client learn correct starting ammo the instant a weapon is
	-- equipped, instead of waiting for the first shot (a future HUD's entry
	-- point -- see AmmoState.luau on the client).
	pushAmmoSync(player, tool, getWeaponState(tool, weapon))
end)

-- Dev/benchmarking only: spawns Count projectiles immediately in one request,
-- bypassing the per-shot rate limit above (that throttles per-click requests;
-- this is a single request asking for N spawns, not N separate clicks). Damage is forced to
-- 0 so a stress test never kills the Dummy or otherwise interferes with real
-- gameplay mid-benchmark. Has its own, longer cooldown so repeated presses don't
-- compound into an ever-growing pile. Restricted to Studio (see the IsStudio
-- guard below): spawning up to MAX_STRESS_COUNT projectiles per request is
-- itself an "ungodly amounts of projectiles" vector if any client could reach
-- it in a live game, so this never runs outside of testing.
local MAX_STRESS_COUNT = 50000
local STRESS_COOLDOWN = 1
local lastStressTest: { [Player]: number } = {}

local function randomDirection(): Vector3
	local theta = math.random() * 2 * math.pi
	local z = math.random() * 2 - 1
	local r = math.sqrt(1 - z * z)
	return Vector3.new(r * math.cos(theta), z, r * math.sin(theta))
end

VisualOffload.On("StressTestFire", function(data, player)
	if not player or not RunService:IsStudio() then
		return
	end

	local now = os.clock()
	if lastStressTest[player] and now - lastStressTest[player] < STRESS_COOLDOWN then
		return
	end
	lastStressTest[player] = now

	local character = player.Character
	local root = character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))
	if not root then
		return
	end

	local requestedCount = typeof(data) == "table" and data.Count or nil
	local count = math.floor(num(requestedCount, 500, 1, MAX_STRESS_COUNT))
	local shooter = Entity.Get(character)

	for _ = 1, count do
		local direction = randomDirection()
		Projectile.new({
			Origin = root.Position + direction * 3,
			Direction = direction,
			Speed = 220,
			Lifetime = 4,
			Damage = 0, -- pure load test; never affects real gameplay/entities
			Source = shooter,
			IgnoreInstances = { character },
			Visualize = true,
			VisualRange = 8000,
			Visual = { Shape = "Ball", Size = Vector3.one * 0.4, Color = Color3.fromRGB(255, 140, 60) },
			Homing = {
				AcquireRadius = num(60, 60, 0, 300),
				TargetTags = { "Enemy", "Player" },
				Retarget = true,
				ReacquireRate = 0.3,
				Permalock = true,
				TurnRate = math.rad(num(140, 140, 0, 360)),
				Delay = 0.05,
			},
		})
	end

	print(`[Relativity] stress test: spawned {count} projectiles for {player.Name}`)

	-- Real frame-cost data while the batch is in flight (Heartbeat.GetStats() is
	-- shared module state, so this reads the actual live loop -- not a
	-- disconnected/isolated snapshot).
	task.spawn(function()
		for _ = 1, 6 do
			task.wait(0.5)
			local stats = Heartbeat.GetStats()
			print(
				`[Relativity] stress test stats: {stats.ConnectionCount} connections, avg frame cost {string.format("%.3f", stats.AvgFrameTime * 1000)} ms`
			)
		end
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	lastStressTest[player] = nil
	-- lastFire/weaponState are keyed by Tool instance, not Player -- they
	-- self-clean via tool.Destroying when the character/backpack is torn
	-- down, so nothing to do here for those.
end)

print("[Relativity] shooter online")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="48">
        <Properties>
          <string name="Name">SpellService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server-authoritative spell-card commands and Fire Projectile execution.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Entity = require(Shared:WaitForChild("Entity"))
local SpellCompiler = require(Shared:WaitForChild("SpellCompiler"))
local Projectile = require(script.Parent:WaitForChild("Projectile"))
local ProjectileQuota = require(script.Parent:WaitForChild("ProjectileQuota"))
local SpellStore = require(script.Parent:WaitForChild("SpellStore"))

local MANA = 10_000_000_000_000
local CAST_INTERVAL = 0.25
local COMMAND_INTERVAL = 0.15
local SPAWN_OFFSET = 3

local remoteFolder = ReplicatedStorage:FindFirstChild("SpellRemotes") or Instance.new("Folder")
remoteFolder.Name = "SpellRemotes"
remoteFolder.Parent = ReplicatedStorage

local command = remoteFolder:FindFirstChild("SpellCommand") or Instance.new("RemoteFunction")
command.Name = "SpellCommand"
command.Parent = remoteFolder

local cast = remoteFolder:FindFirstChild("SpellCast") or Instance.new("RemoteEvent")
cast.Name = "SpellCast"
cast.Parent = remoteFolder

local lastCast: { [Player]: number } = {}
local lastCommand: { [Player]: number } = {}

local function onPlayer(player: Player)
	player:SetAttribute("MaxMana", MANA)
	player:SetAttribute("Mana", MANA)
end

for _, player in Players:GetPlayers() do onPlayer(player) end
Players.PlayerAdded:Connect(onPlayer)

local function response(ok: boolean, state: any?, errors: any?, message: string?)
	return { ok = ok, state = state, errors = errors, message = message }
end

local function integerSlot(value: any): number?
	if typeof(value) ~= "number" or value ~= value or value % 1 ~= 0 or value < 1 or value > 5 then
		return nil
	end
	return value
end

local function truncateCharacters(text: string, maximum: number): string
	local length = utf8.len(text)
	if not length or length <= maximum then
		return text
	end
	local boundary = utf8.offset(text, maximum + 1)
	return boundary and string.sub(text, 1, boundary - 1) or text
end

local function filterName(player: Player, raw: any): (string?, string?)
	local name = typeof(raw) == "string" and raw or "Fire Projectile"
	name = string.gsub(name, "^%s+", "")
	name = string.gsub(name, "%s+$", "")
	name = truncateCharacters(name, 24)
	if name == "" then name = "Fire Projectile" end
	local ok, filtered = pcall(function()
		local result = TextService:FilterStringAsync(name, player.UserId)
		return result:GetNonChatStringForUserAsync(player.UserId)
	end)
	if not ok or typeof(filtered) ~= "string" or filtered == "" then
		return nil, "The spell name could not be filtered. Try another name."
	end
	return truncateCharacters(filtered, 24), nil
end

command.OnServerInvoke = function(player: Player, action: any, payload: any)
	if typeof(action) ~= "string" then
		return response(false, nil, nil, "Invalid spell command.")
	end
	local now = os.clock()
	if lastCommand[player] and now - lastCommand[player] < COMMAND_INTERVAL then
		return response(false, SpellStore.GetState(player), nil, "Please wait before sending another spell command.")
	end
	lastCommand[player] = now
	if action == "GetState" then
		return response(true, SpellStore.GetState(player))
	end
	if typeof(payload) ~= "table" then
		return response(false, SpellStore.GetState(player), nil, "Invalid spell command payload.")
	end
	local slot = integerSlot(payload.slot)
	if not slot then
		return response(false, SpellStore.GetState(player), nil, "Choose a card slot from 1 to 5.")
	end

	if action == "SaveCard" then
		local compiled, errors, normalized = SpellCompiler.Compile(payload.graph)
		if not compiled or not normalized then
			return response(false, SpellStore.GetState(player), errors, "The circle is invalid.")
		end
		local name, nameError = filterName(player, payload.name or normalized.name)
		if not name then
			return response(false, SpellStore.GetState(player), nil, nameError)
		end
		normalized.name = name
		local ok, err, state = SpellStore.PutSlot(player, slot, name, normalized)
		return response(ok, state or SpellStore.GetState(player), nil, err or "Spell card saved.")
	elseif action == "DeleteCard" then
		local ok, err, state = SpellStore.DeleteSlot(player, slot)
		return response(ok, state or SpellStore.GetState(player), nil, err or "Spell card deleted.")
	elseif action == "SetActive" then
		local ok, err, state = SpellStore.SetActive(player, slot)
		return response(ok, state or SpellStore.GetState(player), nil, err or "Spell card equipped.")
	end
	return response(false, SpellStore.GetState(player), nil, "Unknown spell command.")
end

local function equippedAssembler(player: Player): Tool?
	local character = player.Character
	local tool = character and character:FindFirstChild("SpellAssembler")
	return if tool and tool:IsA("Tool") then tool else nil
end

local function damageHit(shooter: any, projectile: any, hit: any)
	local target = hit.Entity
	if not target or target.IsDestroyed or target.Health <= 0 then
		return
	end
	local amount = projectile.Damage * projectile.DamageMultiplier
	if hit.Hurtbox == "Head" then
		amount *= target.HeadshotMultiplier
	end
	if amount <= 0 then return end
	local info = {
		Type = "Projectile",
		Element = "Fire",
		Source = shooter,
		Position = hit.CFrame.Position,
		Hurtbox = hit.Hurtbox,
	}
	if shooter and shooter.DealDamage then
		shooter:DealDamage(target, amount, info)
	else
		target:TakeDamage(amount, info)
	end
end

local function aimedEntity(character: Model, origin: Vector3, targetPoint: Vector3)
	local offset = targetPoint - origin
	if offset.Magnitude < 1e-3 then return nil end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true
	local result = workspace:Raycast(origin, offset, params)
	return result and Entity.Get(result.Instance) or nil
end

local function evaluateCondition(predicate: number, target: any, shooter: any, origin: Vector3): boolean
	if predicate == 1 then return target ~= nil end
	if predicate == 2 then return target ~= nil and not target.IsDestroyed and target.Health > 0 end
	if predicate == 3 then return target ~= nil and target ~= shooter end
	if predicate == 4 then
		return target ~= nil and target.Instance ~= nil and Players:GetPlayerFromCharacter(target.Instance) ~= nil
	end
	if predicate == 5 then
		return target ~= nil and not target.IsDestroyed and (target:GetPosition() - origin).Magnitude <= 75
	end
	return false
end

cast.OnServerEvent:Connect(function(player: Player, targetPoint: any)
	if typeof(targetPoint) ~= "Vector3"
		or targetPoint.X ~= targetPoint.X
		or targetPoint.Y ~= targetPoint.Y
		or targetPoint.Z ~= targetPoint.Z
		or math.abs(targetPoint.X) == math.huge
		or math.abs(targetPoint.Y) == math.huge
		or math.abs(targetPoint.Z) == math.huge
	then
		return
	end
	local tool = equippedAssembler(player)
	local character = player.Character
	local root = character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))
	if not tool or not character or not root or not root:IsA("BasePart") then
		return
	end
	local record = SpellStore.GetActive(player)
	if not record then return end
	local compiled = SpellCompiler.Compile(record.graph)
	if not compiled then return end

	local head = character:FindFirstChild("Head")
	local baseOrigin = if head and head:IsA("BasePart") then head.Position else root.Position
	local offset = targetPoint - baseOrigin
	if offset.Magnitude < 1e-3 then return end
	local shooter = Entity.Get(character)
	local execution = compiled.execution
	local branch
	if execution.kind == "Conditional" then
		local target = aimedEntity(character, baseOrigin, targetPoint)
		branch = if evaluateCondition(execution.predicate, target, shooter, baseOrigin) then execution.trueBranch else execution.falseBranch
	else
		branch = execution.branch
	end
	if not branch then return end

	local now = os.clock()
	if lastCast[player] and now - lastCast[player] < CAST_INTERVAL then return end
	local mana = player:GetAttribute("Mana")
	if typeof(mana) ~= "number" or mana < compiled.manaCost then return end
	if not ProjectileQuota.TryAcquire(player, branch.count) then return end

	local direction = offset.Unit
	lastCast[player] = now
	player:SetAttribute("Mana", mana - compiled.manaCost)

	local stats = table.clone(branch.stats)
	stats.Origin = baseOrigin + direction * SPAWN_OFFSET
	stats.Direction = direction
	stats.Source = shooter
	stats.IgnoreInstances = { character }
	stats.Filter = function(entity)
		return entity ~= shooter and not entity.IsDestroyed and entity.Health > 0
	end
	stats.Visualize = true
	stats.VisualRange = 800
	stats.Visual = { Shape = "Ball", Size = Vector3.one * 0.75, Color = Color3.fromRGB(255, 105, 35) }
	local effects = ReplicatedStorage:FindFirstChild("Effects")
	stats.Model = effects and effects:FindFirstChild("firbal")
	stats.Spread = branch.spread
	if branch.homing then stats.Homing = table.clone(branch.homing) end

	local ok, projectiles = pcall(Projectile.Burst, stats, branch.count)
	if not ok then
		ProjectileQuota.Release(player, branch.count)
		player:SetAttribute("Mana", mana)
		lastCast[player] = nil
		warn(`[SpellService] projectile spawn failed: {tostring(projectiles)}`)
		return
	end
	for _, projectile in projectiles do
		local released = false
		projectile.OnDestroy:Connect(function()
			if not released then
				released = true
				ProjectileQuota.Release(player, 1)
			end
		end)
		projectile.OnHit:Connect(function(hit)
			damageHit(shooter, projectile, hit)
		end)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	lastCast[player] = nil
	lastCommand[player] = nil
end)

print("[Relativity] spell service online")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">SpellStore</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Dedicated persistence/cache for assembled spell cards. This intentionally
	does not share the legacy Player DataStore, so neither system can overwrite
	the other's schema.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SpellCompiler = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SpellCompiler"))

local STORE_NAME = "RelativitySpellCards_v1"
local SCHEMA_VERSION = 2
local SAVE_INTERVAL = 60
local RETRY_DELAYS = { 1, 2, 4 }

local store = DataStoreService:GetDataStore(STORE_NAME)
local SpellStore = {}

type Entry = {
	loaded: boolean,
	available: boolean,
	sessionOnly: boolean,
	dirty: boolean,
	saving: boolean,
	error: string?,
	data: any,
}

local entries: { [Player]: Entry } = {}

local function blankData()
	return {
		schemaVersion = SCHEMA_VERSION,
		activeSlot = nil,
		slots = {},
		updatedAt = os.time(),
	}
end

local function copy(value: any, depth: number?): any
	if typeof(value) ~= "table" then
		return value
	end
	local level = depth or 0
	if level > 8 then
		return nil
	end
	local result = {}
	for key, child in value do
		result[copy(key, level + 1)] = copy(child, level + 1)
	end
	return result
end

local function sanitizeLoaded(raw: any)
	local data = blankData()
	if typeof(raw) ~= "table" then
		return data
	end
	local rawSlots = typeof(raw.slots) == "table" and raw.slots or {}
	for slot = 1, 5 do
		local record = rawSlots[tostring(slot)] or rawSlots[slot]
		if typeof(record) == "table" then
			local compiled, _, normalized = SpellCompiler.Compile(record.graph)
			if compiled and normalized then
				normalized.name = typeof(record.name) == "string" and string.sub(record.name, 1, 96) or compiled.name
				data.slots[tostring(slot)] = {
					name = normalized.name,
					graph = normalized,
					savedAt = typeof(record.savedAt) == "number" and record.savedAt or 0,
				}
			end
		end
	end
	local active = raw.activeSlot
	if typeof(active) == "number" and active % 1 == 0 and data.slots[tostring(active)] then
		data.activeSlot = active
	end
	data.updatedAt = typeof(raw.updatedAt) == "number" and raw.updatedAt or 0
	return data
end

local function keyFor(player: Player): string
	return `player_{player.UserId}`
end

local function withRetries(operation: () -> any): (boolean, any)
	local lastError
	for attempt = 1, #RETRY_DELAYS + 1 do
		local ok, result = pcall(operation)
		if ok then
			return true, result
		end
		lastError = result
		if attempt <= #RETRY_DELAYS then
			task.wait(RETRY_DELAYS[attempt])
		end
	end
	return false, lastError
end

local function publicState(entry: Entry)
	return {
		available = entry.available,
		sessionOnly = entry.sessionOnly,
		error = entry.error,
		activeSlot = entry.data.activeSlot,
		slots = copy(entry.data.slots),
	}
end

function SpellStore.Load(player: Player)
	if entries[player] then
		return
	end
	local entry: Entry = {
		loaded = false,
		available = false,
		sessionOnly = false,
		dirty = false,
		saving = false,
		error = nil,
		data = blankData(),
	}
	entries[player] = entry
	if RunService:IsStudio() then
		entry.loaded = true
		entry.available = true
		entry.sessionOnly = true
		entry.error = "Studio session-only mode; production spell cards are untouched."
		warn("[SpellStore] Studio session-only mode; skipping DataStore access.")
		return
	end

	local ok, result = withRetries(function()
		return store:GetAsync(keyFor(player))
	end)
	if entries[player] ~= entry then
		return
	end
	if ok then
		entry.data = sanitizeLoaded(result)
		entry.available = true
	else
		entry.error = "Spell cards could not be loaded; saving is disabled to protect existing data."
		warn(`[SpellStore] load failed for {player.UserId}: {tostring(result)}`)
	end
	entry.loaded = true
end

function SpellStore.WaitForLoad(player: Player, timeout: number?): boolean
	local started = os.clock()
	while player.Parent and (not entries[player] or not entries[player].loaded) do
		if timeout and os.clock() - started >= timeout then
			return false
		end
		task.wait()
	end
	return entries[player] ~= nil and entries[player].loaded
end

function SpellStore.GetState(player: Player)
	SpellStore.WaitForLoad(player, 15)
	local entry = entries[player]
	if not entry then
		return { available = false, sessionOnly = false, error = "Spell state is unavailable.", slots = {} }
	end
	return publicState(entry)
end

function SpellStore.GetActive(player: Player)
	local entry = entries[player]
	if not entry or not entry.loaded or not entry.available or not entry.data.activeSlot then
		return nil
	end
	return entry.data.slots[tostring(entry.data.activeSlot)]
end

function SpellStore.Save(player: Player): (boolean, string?)
	local entry = entries[player]
	if not entry or not entry.loaded or not entry.available then
		return false, entry and entry.error or "Spell data has not loaded."
	end
	if entry.sessionOnly then
		entry.dirty = false
		return true, entry.error
	end
	if entry.saving then
		return false, "A spell save is already in progress."
	end
	entry.saving = true
	entry.data.updatedAt = os.time()
	local snapshot = copy(entry.data)
	local ok, result = withRetries(function()
		return store:UpdateAsync(keyFor(player), function(_old)
			return snapshot
		end)
	end)
	entry.saving = false
	if ok then
		entry.dirty = false
		entry.error = nil
		return true, nil
	end
	entry.dirty = true
	entry.error = "Spell save failed; the in-session copy is still available."
	warn(`[SpellStore] save failed for {player.UserId}: {tostring(result)}`)
	return false, entry.error
end

function SpellStore.PutSlot(player: Player, slot: number, name: string, graph: any)
	local entry = entries[player]
	if not entry or not entry.loaded or not entry.available then
		return false, entry and entry.error or "Spell data has not loaded."
	end
	if slot % 1 ~= 0 or slot < 1 or slot > 5 then
		return false, "Slot must be from 1 to 5."
	end
	entry.data.slots[tostring(slot)] = { name = name, graph = copy(graph), savedAt = os.time() }
	entry.dirty = true
	local ok, err = SpellStore.Save(player)
	return ok, err, publicState(entry)
end

function SpellStore.DeleteSlot(player: Player, slot: number)
	local entry = entries[player]
	if not entry or not entry.loaded or not entry.available then
		return false, entry and entry.error or "Spell data has not loaded."
	end
	if slot % 1 ~= 0 or slot < 1 or slot > 5 then
		return false, "Slot must be from 1 to 5."
	end
	entry.data.slots[tostring(slot)] = nil
	if entry.data.activeSlot == slot then
		entry.data.activeSlot = nil
	end
	entry.dirty = true
	local ok, err = SpellStore.Save(player)
	return ok, err, publicState(entry)
end

function SpellStore.SetActive(player: Player, slot: number)
	local entry = entries[player]
	if not entry or not entry.loaded or not entry.available then
		return false, entry and entry.error or "Spell data has not loaded."
	end
	if slot % 1 ~= 0 or slot < 1 or slot > 5 or not entry.data.slots[tostring(slot)] then
		return false, "That spell card does not exist."
	end
	entry.data.activeSlot = slot
	entry.dirty = true
	local ok, err = SpellStore.Save(player)
	return ok, err, publicState(entry)
end

local function onPlayer(player: Player)
	task.spawn(SpellStore.Load, player)
end

for _, player in Players:GetPlayers() do
	onPlayer(player)
end
Players.PlayerAdded:Connect(onPlayer)

Players.PlayerRemoving:Connect(function(player)
	local entry = entries[player]
	if entry and entry.loaded and entry.available and entry.dirty then
		SpellStore.Save(player)
	end
	entries[player] = nil
end)

task.spawn(function()
	while true do
		task.wait(SAVE_INTERVAL)
		for player, entry in entries do
			if player.Parent and entry.loaded and entry.available and entry.dirty and not entry.saving then
				task.spawn(SpellStore.Save, player)
			end
		end
	end
end)

game:BindToClose(function()
	local remaining = 0
	for player, entry in entries do
		if entry.loaded and entry.available and entry.dirty and not entry.sessionOnly then
			remaining += 1
			task.spawn(function()
				SpellStore.Save(player)
				remaining -= 1
			end)
		end
	end
	local deadline = os.clock() + 10
	while remaining > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)

return SpellStore
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="50">
        <Properties>
          <string name="Name">StatusEffects</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	StatusEffects (server)
	Registers the shared status effect DEFINITIONS this game actually uses
	with StatusEffectSys (see src/shared/StatusEffectSys.luau for the
	generic duration/stack engine) -- this is the one place that knows what
	each named effect actually DOES; callers elsewhere just reference it by
	name (e.g. Weapons/Railgun.luau's OnHitFunction calls
	StatusEffectSys:ApplyEffect(entity, "Stun", duration)).

	StatusEffectSys.Register just populates an in-memory table, so this
	script must run before anything applies an effect by name -- in
	practice that's guaranteed, since every top-level server Script's main
	chunk finishes running well before a player can equip/fire a weapon.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local StatusEffectSys = require(Shared.StatusEffectSys)
local Ragdoll = require(script.Parent.Ragdoll)

-- Stun: ragdolls the entity's character for the effect's Duration, then
-- restores normal Motor6D-driven animation the instant it expires --
-- however it ends (natural countdown, an early StatusEffectSys:
-- RemoveEffect, or a fresh ApplyEffect extending it -- see
-- StatusEffectSys's own doc comment on stacking), OnExpire covers all of
-- those uniformly, so this never needs its own timer. Reapplying while
-- already active just ADDS to the remaining duration (stock
-- StatusEffectSys stacking behavior) -- handy for chaining stun-locks from
-- repeated hits.
StatusEffectSys.Register("Stun", {
	OnApply = function(entity)
		local character = entity.Instance
		if character and character:IsA("Model") then
			Ragdoll.SetRagdoll(character, true)
		end
	end,
	OnExpire = function(entity)
		local character = entity.Instance
		if character and character:IsA("Model") then
			Ragdoll.SetRagdoll(character, false)
		end
	end,
})

print("[Relativity] status effects registered")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	Weapons (server)
	Registry of every server-authoritative weapon module, keyed by Tool name.
	Shooter.server.luau is a generic dispatcher driven entirely by this
	table -- it never hardcodes a weapon name. Adding a new shooting weapon:
	hand-place its Tool in StarterPack, add a ToolControllers/<Name>.luau
	client controller (see ToolControllers/_ShootingWeapon.luau -- most
	weapons can just re-export it), and drop a new
	Weapons/<Name>.luau module in this folder returning a WeaponDef (see the
	type below) -- Shooter.server.luau picks it up automatically.

	This replaces the old src/shared/ShooterTool.luau: nothing outside this
	dispatcher ever needs to enumerate weapon names (the client matches tool
	-> controller purely by ModuleScript name via ToolManager.luau), so the
	registry lives server-only now instead of shared.
]]

local WeaponsShared = require(script.Shared)

export type WeaponDef = {
	-- ReplicatedStorage.Effects child name for this weapon's bullet visual.
	Model: string,

	-- Seeds Projectile.new(config) directly -- any field from Projectile's
	-- own config schema is valid here (see src/server/Projectile/init.luau);
	-- omitted fields fall back to Projectile's own defaults.
	Stats: { [string]: any },

	-- Optional -- same shape as Projectile's Homing config sub-table.
	Homing: { [string]: any }?,

	-- Shots/sec. Converted to a per-(Player, Tool) cooldown by the
	-- dispatcher; still floored by MIN_FIRE_INTERVAL regardless of what a
	-- weapon declares (defense in depth -- see Shooter.server.luau).
	FireRate: number,

	-- nil = infinite ammo, no reload ever offered. Present = tracked per
	-- (Player, Tool instance) by the dispatcher.
	Magazine: { Size: number, Reserve: number, ReloadTime: number }?,

	-- Optional. Called once per ACCEPTED shot (fire-rate/ammo checks already
	-- passed), before the projectile spawns -- purely cosmetic (muzzle
	-- flash, fire sound, recoil kick, etc.), never gameplay. Runs
	-- SERVER-SIDE and is passed the equipped Tool instance plus the exact
	-- Origin/Direction the projectile itself is about to spawn with (see
	-- resolveMuzzleOrigin in Shooter.server.luau), so a muzzle effect can
	-- place itself directly on the bullet's actual path instead of relying
	-- on the Tool's own (possibly stale/third-person) transform. CAUTION on
	-- what actually shows from server code: property changes and new
	-- instances replicate (so Sound:Play() works -- Playing is a property),
	-- but METHOD calls like ParticleEmitter:Emit() do NOT -- particle
	-- bursts must be broadcast to clients instead; fire a VisualOffload
	-- channel handled in src/client/WeaponEffects.luau (see Railgun.luau's
	-- "MuzzleBlast" for the pattern).
	OnFire: ((tool: Tool, origin: Vector3, direction: Vector3) -> ())?,

	-- Optional. FULLY REPLACES default damage-dealing for this weapon's
	-- hits when present -- the dispatcher does not auto-apply damage if
	-- this exists. Call WeaponsShared.DealDefaultDamage(ctx, hit) from
	-- inside here to opt back into standard damage before adding custom
	-- effects (chain damage, status effects, VFX, etc.).
	OnHitFunction: ((WeaponsShared.FireContext, WeaponsShared.Hit) -> ())?,

	-- Optional, purely additive -- there's no default destroy-time gameplay
	-- behavior to replace (only internal bookkeeping, which always runs
	-- regardless -- see Shooter.server.luau's OnDestroy handling).
	OnDestroyFunction: ((WeaponsShared.FireContext, { Position: Vector3, Normal: Vector3, Kind: string? }) -> ())?,
}

local Weapons: { [string]: WeaponDef } = {}

for _, child in script:GetChildren() do
	if child:IsA("ModuleScript") and child.Name ~= "Shared" then
		Weapons[child.Name] = require(child) :: WeaponDef
	end
end

return Weapons
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Pheonix</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	Weapons/Railgun.luau
	First "real" weapon on the new per-weapon schema: a real fire rate and a
	tracked magazine (see Shooter.server.luau's ammo bookkeeping). Stats
	below are a starting point -- TUNE ME by feel in Studio, just edit this
	file and Rojo will live-sync it.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VisualOffload = require(ReplicatedStorage:WaitForChild("Shared").VisualOffload)

-- How far along the shot's own path (origin + direction * this) the muzzle
-- blast effect is placed -- NOT relative to the Tool's transform, so the
-- effect always lines up with the actual projectile path even if the Tool's
-- third-person pose doesn't match the shooter's first-person aim.
local BLAST_DISTANCE = 8

-- Muzzle flash. The actual clone/position/emit work happens CLIENT-side
-- (see src/client/WeaponEffects.luau's "MuzzleBlast" handler) -- this just
-- broadcasts the shot. It HAS to be client-side: ParticleEmitter:Emit() is
-- a method call, and method calls never replicate -- an earlier version
-- called Emit() right here on the server and nothing ever showed on any
-- client (only property changes and new instances replicate; a Sound:Play()
-- works from the server because Playing is a property, but Emit does not).
-- The Flash template instance is sent by reference; the Tool lives in the
-- shooter's character, so it's replicated to everyone who could see the
-- shot anyway.
local function emitMuzzleBlast(tool: Tool, origin: Vector3, direction: Vector3)
	local template = tool:FindFirstChild("Flash")
	if not template then
		return
	end
	VisualOffload.Fire("MuzzleBlast", {
		Template = template,
		Origin = origin,
		Direction = direction,
		Distance = BLAST_DISTANCE,
	}) 
end

return {
	Model = "Rocket", -- ReplicatedStorage.Effects.RailgunRod

	Stats = {
		Speed = 250,
		Acceleration = 0,
		MinSpeed = 0,
		MaxSpeed = 10000,
		Damage = 750,
		Lifetime = 3,
		Gravity = 25,
		Radius = 0.2,
		Bounces = 3,
		Restitution = 0,
		Penetration = 0,
		MaxPierces = 3,
		PierceFalloff = 0.15,
	},

	FireRate = 2, -- shots/sec

	Magazine = {
		Size = math.huge,
		Reserve = math.huge,
		ReloadTime = 2.2, -- seconds
	},

	OnFire = emitMuzzleBlast,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Railgun</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	Weapons/Railgun.luau
	First "real" weapon on the new per-weapon schema: a real fire rate and a
	tracked magazine (see Shooter.server.luau's ammo bookkeeping). Stats
	below are a starting point -- TUNE ME by feel in Studio, just edit this
	file and Rojo will live-sync it. On hit, also applies the shared "Stun"
	status effect (ragdoll -- see StatusEffects.server.luau /
	src/server/Ragdoll/init.luau) plus a hard fling along the bullet's own
	travel direction -- see onRailgunHit below.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualOffload = require(Shared.VisualOffload)
local StatusEffectSys = require(Shared.StatusEffectSys)
local Ragdoll = require(script.Parent.Parent.Ragdoll)
local WeaponsShared = require(script.Parent.Shared)

-- How far along the shot's own path (origin + direction * this) the muzzle
-- blast effect is placed -- NOT relative to the Tool's transform, so the
-- effect always lines up with the actual projectile path even if the Tool's
-- third-person pose doesn't match the shooter's first-person aim.
local BLAST_DISTANCE = 8

-- Muzzle flash. The actual clone/position/emit work happens CLIENT-side
-- (see src/client/WeaponEffects.luau's "MuzzleBlast" handler) -- this just
-- broadcasts the shot. It HAS to be client-side: ParticleEmitter:Emit() is
-- a method call, and method calls never replicate -- an earlier version
-- called Emit() right here on the server and nothing ever showed on any
-- client (only property changes and new instances replicate; a Sound:Play()
-- works from the server because Playing is a property, but Emit does not).
-- The Flash template instance is sent by reference; the Tool lives in the
-- shooter's character, so it's replicated to everyone who could see the
-- shot anyway.
local function emitMuzzleBlast(tool: Tool, origin: Vector3, direction: Vector3)
	local template = tool:FindFirstChild("Flash")
	if not template then
		return
	end
	VisualOffload.Fire("MuzzleBlast", {
		Template = template,
		Origin = origin,
		Direction = direction,
		Distance = BLAST_DISTANCE,
	})
end

local STUN_DURATION = 10 -- seconds a hit entity is ragdolled for (see StatusEffects.server.luau's "Stun")
local FLING_FORCE = 250 -- studs/s of instantaneous velocity kick along the shot's travel direction
local FLING_UP_RATIO = 0.4 -- fraction of FLING_FORCE added straight up, for a launch arc instead of a flat shove
local FLING_SPIN_FORCE = 25 -- rad/s; max per-axis magnitude of the random tumble applied alongside the fling

-- On hit: deals the weapon's own damage (OnHitFunction FULLY REPLACES the
-- dispatcher's default damage-dealing -- see the WeaponDef schema in
-- Weapons/init.luau -- so this calls the shared helper explicitly to opt
-- back into standard damage), then stuns (ragdolls) the target and gives it
-- a hard fling along the bullet's own travel direction. World/wall hits
-- (hit.Entity == nil) only deal damage -- nothing to stun or fling.
local function onRailgunHit(ctx: WeaponsShared.FireContext, hit: WeaponsShared.Hit)
	WeaponsShared.DealDefaultDamage(ctx, hit)

	local entity = hit.Entity
	if not entity then
		return
	end

	StatusEffectSys:ApplyEffect(entity, "Stun", STUN_DURATION)

	-- Fling AFTER the stun above: Stun's OnApply ragdolls synchronously (see
	-- StatusEffects.server.luau), so by this point the target's Motor6Ds are
	-- disabled. SetRootVelocity converts this world-time launch into the
	-- ragdoll's current local time before native physics takes over.
	local humanoid = entity.Humanoid
	local rootPart = humanoid and humanoid.RootPart
	if rootPart then
		local direction = ctx.Projectile.Velocity
		if direction.Magnitude > 1e-3 then
			local linearVelocity = direction.Unit * FLING_FORCE + Vector3.new(0, FLING_FORCE * FLING_UP_RATIO, 0)
			-- Random tumble so every fling reads as a chaotic ragdoll hit
			-- instead of a perfectly clean launch -- the connected limbs
			-- (via the Stun ragdoll's BallSocketConstraints) get dragged
			-- along with the spinning root part over subsequent physics
			-- steps, same as the linear kick above.
			local angularVelocity = Vector3.new(
				(math.random() * 2 - 1) * FLING_SPIN_FORCE,
				(math.random() * 2 - 1) * FLING_SPIN_FORCE,
				(math.random() * 2 - 1) * FLING_SPIN_FORCE
			)
			Ragdoll.SetRootVelocity(entity.Instance, linearVelocity, angularVelocity)
		end
	end
end

return {
	Model = "RailgunRod", -- ReplicatedStorage.Effects.RailgunRod

	Stats = {
		Speed = 1250,
		Acceleration = 0,
		MinSpeed = 0,
		MaxSpeed = 10000,
		Damage = 750,
		Lifetime = 3,
		Gravity = 0,
		Radius = 0.2,
		Bounces = 0,
		Restitution = 0,
		Penetration = 1000,
		MaxPierces = 3,
		PierceFalloff = 0.15,
	},

	FireRate = 2, -- shots/sec

	Magazine = {
		Size = math.huge,
		Reserve = math.huge,
		ReloadTime = 2.2, -- seconds
	},

	OnFire = emitMuzzleBlast,
	OnHitFunction = onRailgunHit,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Shared</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	Weapons/Shared.luau
	Small helpers shared by the weapon dispatcher (Shooter.server.luau) and
	individual weapon modules. Kept separate from init.luau (the registry)
	so a weapon module's own OnHitFunction can require this directly without
	pulling in (or risk circularly requiring) the registry itself.
]]

local WeaponsShared = {}

export type FireContext = {
	Player: Player,
	Shooter: any?, -- Entity? -- may be nil if the character wasn't registered yet
	Tool: Tool,
	Projectile: any, -- the live Projectile instance this hit/destroy came from
}

export type Hit = {
	CFrame: CFrame,
	Part: BasePart,
	Entity: any?,
	Hurtbox: ("Head" | "Body")?,
}

-- The default damage-dealing behavior every weapon gets unless it defines
-- its own OnHitFunction (see the WeaponDef schema in Weapons/init.luau).
-- Also callable from a custom OnHitFunction that wants standard damage PLUS
-- extra effects, so weapon authors never have to reimplement this by hand.
-- Reads proj.Damage * proj.DamageMultiplier -- DamageMultiplier already
-- reflects PierceFalloff from any earlier pierce on THIS projectile by the
-- time OnHit fires for a given hit. hit.Hurtbox applies the target's own
-- HeadshotMultiplier on top.
function WeaponsShared.DealDefaultDamage(ctx: FireContext, hit: Hit)
	if not hit.Entity then
		return
	end
	local proj = ctx.Projectile
	local damage = proj.Damage * proj.DamageMultiplier
	if hit.Hurtbox == "Head" then
		damage *= hit.Entity.HeadshotMultiplier
	end
	if damage <= 0 then
		return
	end
	local info = { Type = "Projectile", Source = ctx.Shooter, Position = hit.CFrame.Position, Hurtbox = hit.Hurtbox }
	if ctx.Shooter and ctx.Shooter.DealDamage then
		ctx.Shooter:DealDamage(hit.Entity, damage, info)
	else
		hit.Entity:TakeDamage(damage, info)
	end
end

return WeaponsShared
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">TimeBlaster</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	Weapons/TimeBlaster.luau
	The dev/debug tuning weapon -- unlimited ammo, fire rate capped only by
	the dispatcher's global MIN_FIRE_INTERVAL floor (see Shooter.server.luau)
	the same as every other weapon. Stats match this weapon's old hardcoded
	defaults from before the per-weapon module split, so behavior is
	unchanged for existing testers. Tune by editing this file directly --
	Rojo live-syncs on save, no in-game panel needed anymore.
]]

return {
	Model = "Bullet2", -- ReplicatedStorage.Effects.Model

	Stats = {
		Speed = 220,
		Acceleration = 0,
		MinSpeed = 0,
		MaxSpeed = 1000,
		Damage = 20,
		Lifetime = 4,
		Gravity = 0,
		Radius = 0,
		Bounces = 0,
		Restitution = 0.5,
		Penetration = 0,
		MaxPierces = 0,
		PierceFalloff = 0.2,
	},

	-- Matches the dispatcher's MIN_FIRE_INTERVAL (0.1s) exactly, so this
	-- weapon's own FireRate never adds any extra restriction beyond the
	-- global anti-spam floor -- unlimited in practice, same as before.
	FireRate = 10,

	Magazine = nil, -- infinite ammo, no reload
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="56">
        <Properties>
          <string name="Name">example</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server bootstrap.
	 - Enables chunk / global time-scale replication so clients mirror dilation
	   (the true world-level Heartbeat scale, if anything ever sets one --
	   distinct from the per-player ratio below).
	 - Owns each player's own personal time ratio: a client requests a value
	   through the VisualOffload "RequestPersonalTimeScale" channel, the server
	   clamps it, applies it ONLY to that player's Entity (Entity:SetTimeScale --
	   see Entity.luau), and replies with the clamped value on
	   "PersonalTimeScale" to that player alone (never broadcast -- it's
	   personal, it should never affect or even be visible to anyone else). The
	   ratio is also stashed on a PersonalTimeScale player Attribute so
	   PlayerManager.server.luau can reapply it to each new character on
	   respawn.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local ChunkManager = require(Shared.ChunkManager)
local Entity = require(Shared.Entity)
local VisualOffload = require(Shared.VisualOffload)
local Projectile = require(script.Parent.Projectile)

ChunkManager.EnableReplication()

-- Clients can toggle projectile raycast visualization (B key by default).
VisualOffload.On("SetProjectileDebug", function(enabled)
	Projectile.SetDebugRays(enabled == true)
end)

-- Clients can toggle ProjSpawn/ProjSync/ProjHit + ProjMove-rate server console
-- logging (V key by default) -- see Projectile.SetDebugSync's doc comment.
VisualOffload.On("SetProjectileSyncDebug", function(enabled)
	Projectile.SetDebugSync(enabled == true)
end)

-- Bounds for a player's own controllable personal time ratio.
local MIN_RATIO = 0
local MAX_RATIO = 3

VisualOffload.On("RequestPersonalTimeScale", function(value, player)
	if not player or typeof(value) ~= "number" or value ~= value then -- reject nil / NaN
		return
	end
	local clamped = math.clamp(value, MIN_RATIO, MAX_RATIO)

	-- persisted so PlayerManager.server.luau can reapply it to the next
	-- character this player spawns (a fresh Entity otherwise starts at 1x)
	player:SetAttribute("PersonalTimeScale", clamped)

	local entity = Entity.Get(player.Character)
	if entity then
		entity:SetTimeScale(clamped)
	end

	-- reply only to the requesting player -- this is personal, not global
	VisualOffload.FireClient(player, "PersonalTimeScale", clamped)
	print(`[Relativity] {player.Name} set personal time ratio -> x{clamped}`)
end)

-- Optional: freeze simulation in chunks with no players nearby.
-- ChunkManager.ConfigureAutoLoad({ Enabled = true, Radius = 256, Interval = 0.5 })

print("[Relativity] server systems online")
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="57">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPack" referent="58">
    <Properties>
      <string name="Name">StarterPack</string>
    </Properties>
    <Item class="Tool" referent="59">
      <Properties>
        <string name="Name">SpellAssembler</string>
        <bool name="CanBeDropped">false</bool>
        <bool name="ManualActivationOnly">false</bool>
        <bool name="NeedsPivotMigration">false</bool>
        <bool name="RequiresHandle">false</bool>
        <string name="ToolTip">Assemble and cast spell cards</string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="60">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="61">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="62">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client bootstrap: enables projectile visual rendering, receives chunk/global
	time-scale replication, and starts the client-side dilation systems
	(movement, chunk overlay, and the personal time-ratio panel). Also starts
	ToolManager, which swaps in each equipped tool's controller module (see
	ToolManager.luau and ToolControllers/) -- e.g. firing input only listens
	while a registered weapon (TimeBlaster, Railgun, ...) is equipped, driven
	entirely by that tool's ToolControllers/<Name>.luau.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local ChunkManager = require(Shared.ChunkManager)
local ProjectileClient = require(Shared.ProjectileClient)
local Entity = require(Shared.Entity)

-- Client-local systems (sibling ModuleScripts of this LocalScript).
local MovementController = require(script.MovementController)
local ChunkVisualizer = require(script.ChunkVisualizer)
local TimeControlGui = require(script.TimeControlGui)
local ToolManager = require(script.ToolManager)
-- These two self-register their VisualOffload listeners at require time
-- (no .start()) -- see AmmoState.luau (ammo cache for a future HUD) and
-- WeaponEffects.luau (server-broadcast one-shot weapon VFX like the
-- muzzle blast).
local _AmmoState = require(script.AmmoState)
local _WeaponEffects = require(script.WeaponEffects)

ChunkManager.EnableReplication()
ProjectileClient.EnableClientRendering()
Entity.EnableHurtboxRendering() -- draws hurtboxes when Entity.ShowHurtboxes is true
Entity.EnableHurtboxHistoryRendering() -- draws the history trail when Entity.ShowHurtboxHistory is true

MovementController.start()
ChunkVisualizer.start()
TimeControlGui.start()
ToolManager.start()

-- Optional: custom impact VFX for offloaded projectiles.
-- ProjectileClient.SetImpactHandler(function(position, normal, model)
-- 	local effect = ReplicatedStorage.Effects.Impact:Clone()
-- 	effect.Position = position
-- 	effect.Parent = workspace
-- 	task.delay(1, effect.Destroy, effect)
-- end)

print("[Relativity] client render systems online")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">AmmoState</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	AmmoState (client)
	Caches the latest ammo/reload state the server pushes over the "AmmoSync"
	VisualOffload channel (see Shooter.server.luau's pushAmmoSync -- fired on
	equip, every shot, and every reload transition) and re-exposes it as a
	Signal so a future HUD can just connect and render, without needing to
	know anything about VisualOffload/remotes itself. Purely a cache -- no
	input, no authority; a weapon with no Magazine (e.g. TimeBlaster) simply
	never gets an entry here.

	API:
	 AmmoState.Get(toolName: string) -> { Magazine: number, Reserve: number, Reloading: boolean }?
	 AmmoState.Changed:Connect(fn(toolName: string, state)) -- fires on every sync
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualOffload = require(Shared.VisualOffload)
local Signal = require(Shared.Signal)

local AmmoState = {}

AmmoState.Changed = Signal.new()

local state: { [string]: { Magazine: number, Reserve: number, Reloading: boolean } } = {}

function AmmoState.Get(toolName: string)
	local entry = state[toolName]
	if not entry then
		return nil
	end
	return table.clone(entry)
end

VisualOffload.On("AmmoSync", function(data)
	if typeof(data) ~= "table" or typeof(data.ToolName) ~= "string" then
		return
	end
	local entry = { Magazine = data.Magazine, Reserve = data.Reserve, Reloading = data.Reloading == true }
	state[data.ToolName] = entry
	AmmoState.Changed:Fire(data.ToolName, table.clone(entry))
end)

return AmmoState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">ChunkVisualizer</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	ChunkVisualizer.luau  (client)
	Draws a translucent box over every chunk whose TimeScale differs from 1, so
	you can see the dilation field at a glance. Colour encodes the local time
	rate: blue = slow (< 1x), red/orange = fast (> 1x). A floating label shows
	the exact multiplier.

	Chunk scales arrive on the client via ChunkManager.EnableReplication(), so
	this just reconciles a pool of parts against ChunkManager.GetAllChunks()
	each refresh. Toggle with the V key (or ChunkVisualizer.setEnabled).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChunkManager = require(Shared.ChunkManager)

local ChunkVisualizer = {}

local REFRESH_INTERVAL = 0.25
local BOX_HEIGHT = 64 -- visual height for 2D (XZ) chunking
local started = false
local enabled = true

local folder: Folder? = nil
local parts: { [Vector3]: BasePart } = {} -- keyed by chunk.Key

-- Slow (0x) -> cyan, normal (1x) -> green-ish, fast (>1x) -> red.
local function colorForScale(scale: number): Color3
	if scale < 1 then
		-- 0 -> deep blue, 1 -> teal
		return Color3.fromRGB(40, 120, 255):Lerp(Color3.fromRGB(60, 220, 200), math.clamp(scale, 0, 1))
	else
		-- 1 -> amber, >=2 -> red
		return Color3.fromRGB(255, 200, 60):Lerp(Color3.fromRGB(255, 70, 60), math.clamp(scale - 1, 0, 1))
	end
end

local function makeBox(key: Vector3): BasePart
	local size = ChunkManager.ChunkSize
	local box = Instance.new("Part")
	box.Name = `Chunk_{key.X}_{key.Y}_{key.Z}`
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.CastShadow = false
	box.Material = Enum.Material.ForceField
	box.Transparency = 0.7
	box.Size = Vector3.new(size, ChunkManager.UseY and size or BOX_HEIGHT, size)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Label"
	billboard.Size = UDim2.fromOffset(80, 24)
	billboard.AlwaysOnTop = true
	billboard.Parent = box
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextStrokeTransparency = 0.4
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = billboard

	box.Parent = folder
	return box
end

local function positionFor(key: Vector3): Vector3
	local size = ChunkManager.ChunkSize
	local origin = key * size
	local halfHeight = (ChunkManager.UseY and size or BOX_HEIGHT) / 2
	return Vector3.new(origin.X + size / 2, ChunkManager.UseY and origin.Y + size / 2 or halfHeight, origin.Z + size / 2)
end

local function clearAll()
	for _, box in parts do
		box:Destroy()
	end
	table.clear(parts)
end

local function refresh()
	if not enabled then
		return
	end

	local seen: { [Vector3]: boolean } = {}
	for _, chunk in ChunkManager.GetAllChunks() do
		if chunk.TimeScale ~= 1 then
			seen[chunk.Key] = true
			local box = parts[chunk.Key]
			if not box then
				box = makeBox(chunk.Key)
				box.Position = positionFor(chunk.Key)
				parts[chunk.Key] = box
			end
			local color = colorForScale(chunk.TimeScale)
			box.Color = color
			local label = box:FindFirstChild("Label")
			local text = label and label:FindFirstChildWhichIsA("TextLabel")
			if text then
				text.Text = string.format("x%.2f", chunk.TimeScale)
			end
		end
	end

	-- drop boxes for chunks that returned to normal or vanished
	for key, box in parts do
		if not seen[key] then
			box:Destroy()
			parts[key] = nil
		end
	end
end

function ChunkVisualizer.setEnabled(value: boolean)
	enabled = value
	if folder then
		folder.Parent = value and workspace or nil
	end
	if not value then
		clearAll()
	end
end

function ChunkVisualizer.toggle()
	ChunkVisualizer.setEnabled(not enabled)
end

function ChunkVisualizer.start()
	if started then
		return
	end
	started = true

	folder = Instance.new("Folder")
	folder.Name = "ChunkVisualizer"
	folder.Parent = workspace

	-- Refresh on a real-time loop (NOT the dilated Heartbeat) so the overlay
	-- stays responsive even when the world is frozen (global scale 0).
	task.spawn(function()
		while started do
			refresh()
			task.wait(REFRESH_INTERVAL)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.V then
			ChunkVisualizer.toggle()
		end
	end)
end

return ChunkVisualizer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">DilationBubbleGui</string>
            <string name="Source"><![CDATA[--!optimize 2
-- Studio-only configuration panel for the DilationBubble test tool.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VisualOffload = require(ReplicatedStorage:WaitForChild("Shared").VisualOffload)

local DilationBubbleGui = {}

local fields = {
	{ Key = "Scale", Label = "Time scale", Min = 0, Max = 3, Value = 0.25 },
	{ Key = "Radius", Label = "Radius", Min = 8, Max = 256, Value = 64 },
	{ Key = "Duration", Label = "Duration (s)", Min = 0.25, Max = 30, Value = 8 },
}

local started = false
local screenGui: ScreenGui? = nil

function DilationBubbleGui.GetConfig()
	local result = {}
	for _, field in fields do
		result[field.Key] = field.Value
	end
	return result
end

function DilationBubbleGui.SetVisible(visible: boolean)
	if screenGui then
		screenGui.Enabled = visible
	end
end

local function build()
	local screen = Instance.new("ScreenGui")
	screen.Name = "DilationBubbleGui"
	screen.ResetOnSpawn = false
	screen.Enabled = false
	screen.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	screenGui = screen

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0, 0.5)
	panel.Position = UDim2.new(0, 12, 0.5, 0)
	panel.Size = UDim2.fromOffset(250, 210)
	panel.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
	panel.BackgroundTransparency = 0.08
	panel.BorderSizePixel = 0
	panel.Parent = screen
	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 10)
	panelCorner.Parent = panel

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(14, 9)
	title.Size = UDim2.new(1, -28, 0, 22)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 15
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.fromRGB(235, 240, 255)
	title.Text = "Dilation Bubble (Studio)"
	title.Parent = panel

	local help = Instance.new("TextLabel")
	help.BackgroundTransparency = 1
	help.Position = UDim2.fromOffset(14, 31)
	help.Size = UDim2.new(1, -28, 0, 28)
	help.Font = Enum.Font.Gotham
	help.TextSize = 12
	help.TextWrapped = true
	help.TextXAlignment = Enum.TextXAlignment.Left
	help.TextColor3 = Color3.fromRGB(165, 175, 195)
	help.Text = "Equip, then click the world to place a zone."
	help.Parent = panel

	for index, field in fields do
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Position = UDim2.fromOffset(14, 62 + (index - 1) * 32)
		row.Size = UDim2.new(1, -28, 0, 26)
		row.Parent = panel

		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(0.55, 0, 1, 0)
		label.Font = Enum.Font.Gotham
		label.TextSize = 13
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = Color3.fromRGB(210, 216, 230)
		label.Text = field.Label
		label.Parent = row

		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(1, 0.5)
		box.Position = UDim2.new(1, 0, 0.5, 0)
		box.Size = UDim2.new(0.4, 0, 0, 23)
		box.BackgroundColor3 = Color3.fromRGB(38, 42, 56)
		box.BorderSizePixel = 0
		box.ClearTextOnFocus = false
		box.Font = Enum.Font.GothamMedium
		box.TextSize = 13
		box.TextColor3 = Color3.fromRGB(235, 240, 255)
		box.Text = tostring(field.Value)
		box.Parent = row
		local boxCorner = Instance.new("UICorner")
		boxCorner.CornerRadius = UDim.new(0, 5)
		boxCorner.Parent = box

		box.FocusLost:Connect(function()
			local value = tonumber(box.Text)
			if value and value == value then
				field.Value = math.clamp(value, field.Min, field.Max)
			end
			box.Text = tostring(field.Value)
		end)
	end

	local clear = Instance.new("TextButton")
	clear.Position = UDim2.fromOffset(14, 166)
	clear.Size = UDim2.new(1, -28, 0, 30)
	clear.BackgroundColor3 = Color3.fromRGB(116, 54, 74)
	clear.BorderSizePixel = 0
	clear.Font = Enum.Font.GothamBold
	clear.TextSize = 13
	clear.TextColor3 = Color3.fromRGB(255, 235, 240)
	clear.Text = "Clear My Bubbles"
	clear.Parent = panel
	local clearCorner = Instance.new("UICorner")
	clearCorner.CornerRadius = UDim.new(0, 6)
	clearCorner.Parent = clear
	clear.Activated:Connect(function()
		VisualOffload.Fire("DilationBubbleTest", { Action = "Clear" })
	end)
end

function DilationBubbleGui.Start()
	if started or not RunService:IsStudio() then
		return
	end
	started = true
	build()
end

return DilationBubbleGui
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="66">
          <Properties>
            <string name="Name">MapGenToggleDebug</string>
            <string name="Source"><![CDATA[--[[
	MapGenToggleDebug.client.luau
	Press G to show/hide the MapGen debug overlay (tinted regions, room size
	labels) against the real built geometry from MapGen.Builder. Fires a
	RemoteEvent so the server -- which owns the Visualizer instance -- can
	reparent the shared debug folder for everyone.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local event = ReplicatedStorage:WaitForChild("MapGenToggleDebug")

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.G then
		event:FireServer()
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">MovementController</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	MovementController.luau  (client)
	Makes the local character move in dilated time. Roblox's own character
	physics run in real time, so on their own WalkSpeed/JumpPower would ignore
	chunk time scales and the player's own personal time ratio. This controller
	re-derives the character's motion from the same clock every other system
	uses:

	    effScale = worldScale * chunk scale under the character * personalScale

	worldScale is the true Heartbeat global time scale (a dev/world-level knob,
	1 unless something explicitly changes it) and personalScale is this
	player's own ratio, set via SetPersonalTimeScale -- TimeControlGui calls
	that directly for instant feedback and it's the only thing the slider
	actually drives. Because only the *local* character is touched here (each
	client owns/predicts its own, per Roblox's network ownership model),
	personalScale only ever affects this player's own movement on every
	client's screen -- other players see it via ordinary Humanoid property
	replication, but their own movement is driven by their own client's own
	personalScale, so one player's dial can never affect anyone else's.

	Each frame it:
	  • scales WalkSpeed by effScale            (walking slows with time)
	  • scales the jump impulse by effScale      (jumps launch slower)
	  • applies a custom-gravity VectorForce so the character's *net* downward
	    acceleration becomes g₀ · effScale²      (falls float in slow time)

	The effScale² on gravity is the physically correct scaling: with jump
	velocity scaled by effScale and gravity by effScale², jump height is
	preserved but the whole arc plays out in dilated time. At effScale = 0 the
	upward force exactly cancels gravity, so the character freezes in place.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Heartbeat = require(Shared.Heartbeat)
local ChunkManager = require(Shared.ChunkManager)

local MovementController = {}

local player = Players.LocalPlayer
local started = false
local personalScale = 1

type CharacterState = {
	humanoid: Humanoid,
	root: BasePart,
	force: VectorForce,
	baseWalkSpeed: number,
	baseJumpPower: number?,
	baseJumpHeight: number?,
}

local state: CharacterState? = nil

local function teardown()
	if state and state.force then
		state.force:Destroy()
	end
	state = nil
end

local function setup(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not humanoid or not root then
		return
	end

	-- A VectorForce (in world space, at the center of mass) supplies the
	-- gravity *correction*: real gravity always pulls with g₀; we add an
	-- upward force so the remainder matches g₀ · effScale².
	local attachment = root:FindFirstChild("MovementGravityAttachment") :: Attachment?
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "MovementGravityAttachment"
		attachment.Parent = root
	end

	local force = Instance.new("VectorForce")
	force.Name = "MovementGravityForce"
	force.Attachment0 = attachment
	force.ApplyAtCenterOfMass = true
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.Force = Vector3.zero
	force.Parent = root

	state = {
		humanoid = humanoid,
		root = root,
		force = force,
		baseWalkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16,
		baseJumpPower = humanoid.UseJumpPower and humanoid.JumpPower or nil,
		baseJumpHeight = (not humanoid.UseJumpPower) and humanoid.JumpHeight or nil,
	}
end

local function step()
	local current = state
	if not current then
		return
	end
	local humanoid, root = current.humanoid, current.root
	if humanoid.Health <= 0 or not root.Parent then
		return
	end

	local effScale = Heartbeat.GetGlobalTimeScale() * ChunkManager.GetTimeScaleAt(root.Position) * personalScale

	-- Horizontal movement dilation.
	humanoid.WalkSpeed = current.baseWalkSpeed * effScale

	-- Jump impulse dilation (velocity scales with effScale).
	if current.baseJumpPower then
		humanoid.JumpPower = current.baseJumpPower * effScale
	elseif current.baseJumpHeight then
		humanoid.JumpHeight = current.baseJumpHeight * effScale * effScale
	end

	-- Custom gravity: net downward accel should be g₀ · effScale².
	-- Roblox already applies g₀, so add upward (mass · g₀ · (1 − effScale²)).
	local g0 = workspace.Gravity
	local mass = root.AssemblyMass
	current.force.Force = Vector3.new(0, mass * g0 * (1 - effScale * effScale), 0)
end

-- This player's own time ratio (see TimeControlGui.luau), independent of the
-- shared Heartbeat global scale -- see the module doc comment.
function MovementController.SetPersonalTimeScale(scale: number)
	personalScale = math.max(scale, 0)
end

function MovementController.GetPersonalTimeScale(): number
	return personalScale
end

function MovementController.start()
	if started then
		return
	end
	started = true

	local function onCharacter(character)
		teardown()
		task.defer(setup, character)
	end

	if player.Character then
		onCharacter(player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)
	player.CharacterRemoving:Connect(teardown)

	Heartbeat.Connect(step, { Name = "MovementController", Priority = 20 })
end

return MovementController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">ShooterConfigGui</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	ShooterConfigGui (client)
	A Studio-only debug side panel to tune the bullets ShooterController
	fires: speed, damage, gravity, bounces, pierces, homing, etc. It just
	holds a config table; ShooterController reads getConfig() when firing
	and sends it to the server ONLY while RunService:IsStudio() is true (see
	Shooter.server.luau's applyStudioDebugOverrides) -- a live client's
	config is never read at all. Every weapon's REAL stats live server-side
	in its own Weapons/<Name>.luau module (see src/server/Weapons/); this
	panel is purely a live-iteration convenience layered on top of that
	while testing in Studio, not a source of truth.

	getConfig() ONLY returns fields you've actually edited (see `touched`
	below), never the full field set with its baked-in defaults -- every
	field here defaults to a plausible-looking number (e.g. Speed = 220),
	and if those were always sent/applied regardless of whether you touched
	them, firing ANY weapon in Studio would silently clobber that weapon's
	real Stats with this panel's unrelated defaults (this happened: Railgun
	fired at this panel's default Speed instead of its own). Untouched
	fields fall through entirely, so a weapon you've never opened this panel
	for behaves exactly as its own module declares.

	The panel is built once but stays hidden until setVisible(true) is called
	-- any shooting weapon's ToolControllers/<Name>.luau (via the shared
	_ShootingWeapon.luau) calls that from its Equip/Unequip (see
	ToolManager.luau), so the menu only comes up while one of those tools is
	actually equipped.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ShooterConfigGui = {}

-- Field spec: order + metadata drives both the UI and the defaults.
-- kind "number" -> TextBox (clamped to min/max), "bool" -> toggle button.
local FIELDS = {
	{ key = "Speed", label = "Speed", kind = "number", min = 10, max = math.huge, default = 220 },
	{ key = "Acceleration", label = "Acceleration", kind = "number", min = -math.huge, max = math.huge, default = 0 },
	{ key = "MinSpeed", label = "Min speed", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "MaxSpeed", label = "Max speed", kind = "number", min = 0, max = math.huge, default = 1000 },
	{ key = "Damage", label = "Damage", kind = "number", min = 0, max = math.huge, default = 20 },
	{ key = "Lifetime", label = "Lifetime (s)", kind = "number", min = 0.1, max = math.huge, default = 4 },
	{ key = "Gravity", label = "Gravity", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "Radius", label = "Radius (sphere)", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "Bounces", label = "Bounces", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "Restitution", label = "Restitution", kind = "number", min = 0, max = math.huge, default = 0.5 },
	{ key = "Penetration", label = "Penetration (studs)", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "Pierces", label = "Pierces", kind = "number", min = 0, max = math.huge, default = 0 },
	{ key = "PierceFalloff", label = "Pierce falloff", kind = "number", min = 0, max = math.huge, default = 0.2 },
	{ key = "Homing", label = "Homing", kind = "bool", default = false },
	{ key = "Permalock", label = "Permalock", kind = "bool", default = false },
	{ key = "TurnRate", label = "Turn rate (deg)", kind = "number", min = 0, max = math.huge, default = 140 },
	{ key = "AcquireRadius", label = "Acquire radius", kind = "number", min = 0, max = math.huge, default = 60 },
}

local config = {}
for _, field in FIELDS do
	config[field.key] = field.default
end

-- Which fields the dev has actually edited in THIS session -- see the
-- module doc comment. Set true only from a field's own edit handler below.
local touched: { [string]: boolean } = {}

local started = false
local screenGui: ScreenGui? = nil

function ShooterConfigGui.getConfig()
	local result = {}
	for key in touched do
		result[key] = config[key]
	end
	return result
end

-- Shown only while a shooting weapon tool is equipped (see ToolManager.luau
-- / ToolControllers/_ShootingWeapon.luau). No-ops if the panel hasn't been
-- built yet.
function ShooterConfigGui.setVisible(visible: boolean)
	if screenGui then
		screenGui.Enabled = visible
	end
end

local function makeRow(parent: Instance, field, layoutOrder: number)
	local row = Instance.new("Frame")
	row.Name = field.key
	row.Size = UDim2.new(1, 0, 0, 26)
	row.BackgroundTransparency = 1
	row.LayoutOrder = layoutOrder
	row.Parent = parent

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(0.58, 0, 1, 0)
	label.Font = Enum.Font.Gotham
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = Color3.fromRGB(210, 216, 230)
	label.Text = field.label
	label.Parent = row

	if field.kind == "number" then
		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(1, 0.5)
		box.Position = UDim2.new(1, 0, 0.5, 0)
		box.Size = UDim2.new(0.4, 0, 0, 22)
		box.BackgroundColor3 = Color3.fromRGB(38, 42, 56)
		box.BorderSizePixel = 0
		box.Font = Enum.Font.GothamMedium
		box.TextSize = 13
		box.TextColor3 = Color3.fromRGB(235, 240, 255)
		box.ClearTextOnFocus = false
		box.Text = tostring(config[field.key])
		box.Parent = row
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = box

		box.FocusLost:Connect(function()
			local n = tonumber(box.Text)
			if n then
				n = math.clamp(n, field.min, field.max)
				config[field.key] = n
				touched[field.key] = true
			end
			box.Text = tostring(config[field.key])
		end)
	else -- bool
		local toggle = Instance.new("TextButton")
		toggle.AnchorPoint = Vector2.new(1, 0.5)
		toggle.Position = UDim2.new(1, 0, 0.5, 0)
		toggle.Size = UDim2.new(0.4, 0, 0, 22)
		toggle.BorderSizePixel = 0
		toggle.Font = Enum.Font.GothamMedium
		toggle.TextSize = 13
		toggle.Parent = row
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = toggle

		local function render()
			local on = config[field.key] == true
			toggle.Text = on and "ON" or "OFF"
			toggle.BackgroundColor3 = on and Color3.fromRGB(70, 170, 90) or Color3.fromRGB(60, 64, 78)
			toggle.TextColor3 = Color3.fromRGB(240, 245, 255)
		end
		render()
		toggle.Activated:Connect(function()
			config[field.key] = not config[field.key]
			touched[field.key] = true
			render()
		end)
	end
end

local function build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local screen = Instance.new("ScreenGui")
	screen.Name = "ShooterConfigGui"
	screen.ResetOnSpawn = false
	screen.Enabled = false -- hidden until a shooting weapon tool is equipped
	screen.Parent = playerGui
	screenGui = screen

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(1, 0.5)
	panel.Position = UDim2.new(1, -12, 0.5, 0)
	panel.Size = UDim2.fromOffset(240, 400)
	panel.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
	panel.BackgroundTransparency = 0.1
	panel.BorderSizePixel = 0
	panel.Parent = screen
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = panel

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(14, 8)
	title.Size = UDim2.new(1, -28, 0, 22)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 15
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.fromRGB(235, 240, 255)
	title.Text = "Shooter Settings (Studio only)"
	title.Parent = panel

	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromOffset(12, 36)
	list.Size = UDim2.new(1, -24, 1, -48)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 4
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	for i, field in FIELDS do
		makeRow(list, field, i)
	end
end

-- Never builds outside Studio: the server ignores a live client's Config
-- entirely (see Shooter.server.luau), so showing this panel to real players
-- in a published game would just be confusing clutter with zero effect.
function ShooterConfigGui.start()
	if started or not RunService:IsStudio() then
		return
	end
	started = true
	build()
end

return ShooterConfigGui
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">ShooterController</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	ShooterController (client)
	Click to fire. Sends where the player is AIMING (a world point found via a
	camera ray through the cursor) to the server, which spawns the actual
	bullet via the Projectile system. Purely an input forwarder — no
	authority here. Where the shot actually SPAWNS from (a weapon's "Tip"
	Attachment if it has one, else the character's Head) is resolved entirely
	server-side (see Shooter.server.luau's resolveMuzzleOrigin) — the client
	never sends an origin at all, only the aimed-at point, so the server can
	converge the shot exactly where the player clicked regardless of which
	origin it ends up using.

	start()/stop() are called by any shooting weapon's ToolControllers/
	<Name>.luau Equip/Unequip (see _ShootingWeapon.luau) -- this only
	listens for input while one of those tools is actually equipped. The
	server enforces this independently for FireBullet/ReloadWeapon/
	StressTestFire (see Shooter.server.luau, which validates against the
	Weapons registry), so this is about not listening for input at all
	while no shooting tool is equipped, not about security. Every weapon's
	REAL numbers live server-side in its own Weapons/<Name>.luau module;
	tuning them means editing that file, not this panel. In Studio only,
	ShooterConfigGui's live-tunable overrides are also sent along (see
	Shooter.server.luau's applyStudioDebugOverrides) -- a live client never
	sends or has this read at all.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualOffload = require(Shared.VisualOffload)
local ShooterConfigGui = require(script.Parent.ShooterConfigGui)

local ShooterController = {}

local player = Players.LocalPlayer
local COOLDOWN = 0.1 -- matches Shooter.server.luau's MIN_FIRE_INTERVAL floor; the server enforces its own copy regardless
local lastFire = 0
local debugRays = false -- matches the server default; toggle with B
local debugSync = false -- prints ProjSpawn/ProjSync/ProjHit + a ProjMove rate summary server-side; toggle with V
local inputConnection: RBXScriptConnection? = nil

local AIM_RANGE = 5000

local function fire()
	local character = player.Character
	local camera = workspace.CurrentCamera
	if not character or not camera then
		return
	end

	-- find the WORLD POINT under the cursor (camera ray -> first surface).
	local screenPos = UserInputService:GetMouseLocation()
	local camRay = camera:ViewportPointToRay(screenPos.X, screenPos.Y)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true
	local hit = workspace:Raycast(camRay.Origin, camRay.Direction * AIM_RANGE, params)
	local targetPoint = hit and hit.Position or (camRay.Origin + camRay.Direction * AIM_RANGE)

	-- Every gameplay number (Model/Speed/Damage/etc.) AND the spawn origin
	-- itself come from the server (see Shooter.server.luau) -- this only
	-- ever sends the aimed-at world point, plus (Studio only) the debug
	-- panel's overrides, which a live server never even looks at.
	local payload = { TargetPoint = targetPoint }
	if RunService:IsStudio() then
		payload.Config = ShooterConfigGui.getConfig()
	end
	VisualOffload.Fire("FireBullet", payload)
end

local function reload()
	VisualOffload.Fire("ReloadWeapon", {})
end

-- Load-testing the projectile system means spawning many projectiles AT ONCE, not
-- firing many separate player shots -- Shooter.server.luau's MIN_FIRE_INTERVAL floor
-- (10/sec) exists to rate-limit real clicking and would silently drop almost all of a tight
-- client-side firing loop. This sends ONE request asking the server to spawn N
-- projectiles directly, bypassing that per-click gate entirely (see StressTestFire
-- in Shooter.server.luau). Press N to fire a stress-test batch.
local STRESS_TEST_COUNT = 10000

local function stressTest()
	VisualOffload.Fire("StressTestFire", { Count = STRESS_TEST_COUNT })
end

function ShooterController.start()
	if inputConnection then
		return
	end

	inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return -- click was consumed by the GUI (e.g. the time slider)
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local now = os.clock()
			if now - lastFire >= COOLDOWN then
				lastFire = now
				fire()
			end
		elseif input.KeyCode == Enum.KeyCode.B then
			-- toggle raycast hit-detection visualization (server owns the flag)
			debugRays = not debugRays
			VisualOffload.Fire("SetProjectileDebug", debugRays)
		elseif input.KeyCode == Enum.KeyCode.N then
			stressTest()
		elseif input.KeyCode == Enum.KeyCode.R then
			reload()
		elseif input.KeyCode == Enum.KeyCode.V then
			-- toggle ProjSpawn/ProjSync/ProjHit + ProjMove-rate server console logging
			debugSync = not debugSync
			VisualOffload.Fire("SetProjectileSyncDebug", debugSync)
		end
	end)
end

function ShooterController.stop()
	if inputConnection then
		inputConnection:Disconnect()
		inputConnection = nil
	end
end

return ShooterController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">SpellAssemblerGui</string>
            <string name="Source"><![CDATA[--!strict
-- Structured magic-circle editor and card interface. The Tool controller is
-- deliberately only one launcher; any future menu can call Open/Close/Cast.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local SpellCompiler = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SpellCompiler"))
local remotes = ReplicatedStorage:WaitForChild("SpellRemotes")
local command = remotes:WaitForChild("SpellCommand") :: RemoteFunction
local castRemote = remotes:WaitForChild("SpellCast") :: RemoteEvent

local SpellAssemblerGui = {}

local COLORS = {
	background = Color3.fromRGB(12, 10, 22),
	panel = Color3.fromRGB(24, 20, 39),
	panel2 = Color3.fromRGB(35, 29, 54),
	line = Color3.fromRGB(174, 113, 255),
	text = Color3.fromRGB(238, 230, 255),
	muted = Color3.fromRGB(162, 151, 184),
	good = Color3.fromRGB(92, 220, 147),
	bad = Color3.fromRGB(255, 92, 112),
	selected = Color3.fromRGB(111, 72, 165),
}

local equippedTool: Tool? = nil
local gui: ScreenGui? = nil
local main: Frame? = nil
local mini: Frame? = nil
local canvas: Frame? = nil
local regionLayer: Frame? = nil
local nodeLayer: Frame? = nil
local edgeLayer: Frame? = nil
local palette: ScrollingFrame? = nil
local inspector: Frame? = nil
local errorLabel: TextLabel? = nil
local statusLabel: TextLabel? = nil
local nameBox: TextBox? = nil
local saveButton: TextButton? = nil
local activeLabel: TextLabel? = nil
local tierHolder: Frame? = nil
local cardButtons: { TextButton } = {}

local graph = SpellCompiler.CreateDefaultGraph()
local serverState: any = { slots = {}, activeSlot = nil }
local selectedSlot = 1
local selectedNodeId: string? = nil
local pendingFrom: any = nil -- { id: string, branch: "true"|"false"? }
local compiled: any = nil
local validationErrors: { string } = {}
local draggingNode: string? = nil
local draggingRegion: any = nil
local editingRegions = false
local paletteDragRune: string? = nil
local visible = false

local function deepCopy(value: any): any
	if typeof(value) ~= "table" then return value end
	local result = {}
	for key, child in value do result[deepCopy(key)] = deepCopy(child) end
	return result
end

local function corner(parent: Instance, radius: number?)
	local item = Instance.new("UICorner")
	item.CornerRadius = UDim.new(0, radius or 8)
	item.Parent = parent
end

local function stroke(parent: Instance, color: Color3?, thickness: number?)
	local item = Instance.new("UIStroke")
	item.Color = color or COLORS.line
	item.Thickness = thickness or 1
	item.Transparency = 0.25
	item.Parent = parent
	return item
end

local function textButton(parent: Instance, text: string): TextButton
	local button = Instance.new("TextButton")
	button.AutoButtonColor = true
	button.BackgroundColor3 = COLORS.panel2
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamMedium
	button.Text = text
	button.TextColor3 = COLORS.text
	button.TextSize = 13
	button.Parent = parent
	corner(button, 7)
	stroke(button, Color3.fromRGB(118, 83, 168), 1)
	return button
end

local function label(parent: Instance, text: string, size: number?): TextLabel
	local item = Instance.new("TextLabel")
	item.BackgroundTransparency = 1
	item.Font = Enum.Font.Gotham
	item.Text = text
	item.TextColor3 = COLORS.text
	item.TextSize = size or 13
	item.TextWrapped = true
	item.Parent = parent
	return item
end

local function connect(signal: RBXScriptSignal, fn: (...any) -> ())
	-- Destroying a rebuilt node/edge disconnects its Instance signals. The
	-- persistent GUI/input signals intentionally live for the client session.
	signal:Connect(fn)
end

local function nodeById(id: string): any?
	for _, node in graph.nodes do if node.id == id then return node end end
	return nil
end

local function nodeByRune(runeId: string): any?
	for _, node in graph.nodes do if node.runeId == runeId then return node end end
	return nil
end

local function removeNode(id: string)
	for index = #graph.nodes, 1, -1 do
		if graph.nodes[index].id == id then table.remove(graph.nodes, index) end
	end
	for index = #graph.edges, 1, -1 do
		local edge = graph.edges[index]
		if edge.from == id or edge.to == id then table.remove(graph.edges, index) end
	end
	if selectedNodeId == id then selectedNodeId = nil end
	if pendingFrom and pendingFrom.id == id then pendingFrom = nil end
end

local function clampToRegion(runeId: string, screenPosition: Vector2): { x: number, y: number }
	local targetCanvas = canvas :: Frame
	local absolute = targetCanvas.AbsolutePosition
	local size = targetCanvas.AbsoluteSize
	local x = math.clamp((screenPosition.X - absolute.X) / math.max(size.X, 1), 0, 1)
	local y = math.clamp((screenPosition.Y - absolute.Y) / math.max(size.Y, 1), 0, 1)
	local rune = SpellCompiler.Runes[runeId]
	local best, bestDistance
	for _, region in graph.regions or {} do
		if region.kind == rune.Region then
			local nearestX = math.clamp(x, region.x, region.x + region.w)
			local nearestY = math.clamp(y, region.y, region.y + region.h)
			local distance = (Vector2.new(nearestX, nearestY) - Vector2.new(x, y)).Magnitude
			if not bestDistance or distance < bestDistance then best, bestDistance = region, distance end
		end
	end
	if not best then return { x = x, y = y } end
	local paddingX = math.min(0.025, best.w * 0.2)
	local paddingY = math.min(0.025, best.h * 0.2)
	return { x = math.clamp(x, best.x + paddingX, best.x + best.w - paddingX), y = math.clamp(y, best.y + paddingY, best.y + best.h - paddingY) }
end

local refresh: () -> ()

local function addEdge(fromId: string, toId: string, branch: string?)
	if branch then
		-- A branch label has one destination. Reconnecting it replaces its old
		-- edge instead of leaving an ambiguous fork behind.
		for index = #graph.edges, 1, -1 do
			local edge = graph.edges[index]
			if edge.from == fromId and edge.branch == branch then table.remove(graph.edges, index) end
		end
	end
	for _, edge in graph.edges do
		if edge.from == fromId and edge.to == toId and edge.branch == branch then return end
	end
	if #graph.edges < SpellCompiler.MaxEdges then
		table.insert(graph.edges, { from = fromId, to = toId, branch = branch })
	end
end

local function addRune(runeId: string, screenPosition: Vector2?)
	local existing = nodeByRune(runeId)
	if existing and (runeId == "Mana" or runeId == "Fire" or runeId == "Condition") then selectedNodeId = existing.id; refresh(); return end
	if #graph.nodes >= SpellCompiler.MaxNodes then return end
	local rune = SpellCompiler.Runes[runeId]
	local region
	for _, candidate in graph.regions or {} do if candidate.kind == rune.Region then region = candidate; break end end
	local position = if screenPosition then clampToRegion(runeId, screenPosition) elseif region then {
		x = region.x + region.w * (0.35 + (#graph.nodes % 3) * 0.15), y = region.y + region.h * (0.35 + (#graph.nodes % 2) * 0.25),
	} else { x = 0.5, y = 0.5 }
	local baseId = string.lower(runeId)
	local id, suffix = baseId, 2
	while nodeById(id) do id = baseId .. tostring(suffix); suffix += 1 end
	table.insert(graph.nodes, { id = id, runeId = runeId, tier = rune.Tiered and 1 or nil, position = position })
	selectedNodeId = id
	refresh()
end

local function invoke(action: string, payload: any?): any
	local ok, result = pcall(command.InvokeServer, command, action, payload)
	if not ok then
		return { ok = false, message = "The spell service did not respond." }
	end
	return result
end

local function updateCards()
	for slot, button in cardButtons do
		local record = serverState.slots and (serverState.slots[tostring(slot)] or serverState.slots[slot])
		local active = serverState.activeSlot == slot
		button.Text = `{slot}. {record and record.name or "Empty"}{active and "  ◆" or ""}`
		button.BackgroundColor3 = if selectedSlot == slot then COLORS.selected else COLORS.panel2
	end
	local active = serverState.activeSlot and serverState.slots and (serverState.slots[tostring(serverState.activeSlot)] or serverState.slots[serverState.activeSlot])
	if activeLabel then activeLabel.Text = `Active: {active and active.name or "None"}` end
end

local REGION_COLORS = {
	Input = Color3.fromRGB(70, 157, 215),
	Transform = Color3.fromRGB(218, 96, 73),
	Vessel = Color3.fromRGB(151, 83, 210),
	Output = Color3.fromRGB(210, 70, 91),
	Modifier = Color3.fromRGB(105, 82, 153),
}

local function drawRegions()
	local layer = regionLayer :: Frame
	for _, child in layer:GetChildren() do child:Destroy() end
	for _, region in graph.regions or {} do
		local color = REGION_COLORS[region.kind] or COLORS.line
		local area = Instance.new("Frame")
		area.Name = region.id
		area.Position = UDim2.fromScale(region.x, region.y)
		area.Size = UDim2.fromScale(region.w, region.h)
		area.BackgroundColor3 = color
		area.BackgroundTransparency = if editingRegions then 0.78 else 0.9
		area.BorderSizePixel = 0
		area.ZIndex = 1
		area.Parent = layer
		corner(area, 10)
		stroke(area, color, if editingRegions then 2 else 1)
		local title = textButton(area, string.upper(region.kind) .. " AREA")
		title.BackgroundTransparency = 1
		title.Size = UDim2.new(1, -8, 0, 25)
		title.Position = UDim2.fromOffset(4, 2)
		title.TextSize = 10
		title.ZIndex = 2
		title.AutoButtonColor = editingRegions
		if editingRegions then
			connect(title.InputBegan, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingRegion = { id = region.id, mode = "move", start = input.Position, x = region.x, y = region.y, w = region.w, h = region.h }
				end
			end)
			local handle = textButton(area, "↘")
			handle.AnchorPoint = Vector2.new(1, 1)
			handle.Position = UDim2.fromScale(1, 1)
			handle.Size = UDim2.fromOffset(25, 25)
			handle.ZIndex = 3
			connect(handle.InputBegan, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingRegion = { id = region.id, mode = "resize", start = input.Position, x = region.x, y = region.y, w = region.w, h = region.h }
				end
			end)
		end
	end
end

local function drawEdges()
	local layer = edgeLayer :: Frame
	for _, child in layer:GetChildren() do child:Destroy() end
	local targetCanvas = canvas :: Frame
	for index, edge in graph.edges do
		local fromNode = nodeById(edge.from)
		local toNode = nodeById(edge.to)
		if fromNode and toNode then
			local a = Vector2.new(fromNode.position.x * targetCanvas.AbsoluteSize.X, fromNode.position.y * targetCanvas.AbsoluteSize.Y)
			local b = Vector2.new(toNode.position.x * targetCanvas.AbsoluteSize.X, toNode.position.y * targetCanvas.AbsoluteSize.Y)
			local delta = b - a
			local line = Instance.new("TextButton")
			line.Name = `Edge{index}`
			line.Text = ""
			line.AutoButtonColor = false
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
			line.Size = UDim2.fromOffset(delta.Magnitude, 5)
			line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
			line.BackgroundColor3 = if edge.branch == "true" then COLORS.good elseif edge.branch == "false" then COLORS.bad else COLORS.line
			line.BackgroundTransparency = 0.2
			line.BorderSizePixel = 0
			line.ZIndex = 2
			line.Parent = layer
			if edge.branch then
				line.Text = if edge.branch == "true" then "T" else "F"
				line.TextColor3 = COLORS.text
				line.TextSize = 11
			end
			connect(line.Activated, function()
				if graph.edges[index] == edge then table.remove(graph.edges, index) else
					local found = table.find(graph.edges, edge)
					if found then table.remove(graph.edges, found) end
				end
				refresh()
			end)
		end
	end
end

local function showInspector()
	local holder = tierHolder :: Frame
	for _, child in holder:GetChildren() do if not child:IsA("UIListLayout") then child:Destroy() end end
	local node = selectedNodeId and nodeById(selectedNodeId)
	if not node then
		local hint = label(holder, "Select a rune to change its tier.", 12)
		hint.Size = UDim2.new(1, 0, 0, 38)
		hint.TextColor3 = COLORS.muted
		return
	end
	local rune = SpellCompiler.Runes[node.runeId]
	local heading = label(holder, rune.DisplayName, 15)
	heading.Size = UDim2.new(1, 0, 0, 26)
	if node.runeId == "Condition" then
		heading.Text = `Condition: {SpellCompiler.ConditionNames[node.tier] or "Unknown"}`
		heading.TextSize = 12
	end
	if rune.Tiered then
		for tier = 1, 5 do
			local button = textButton(holder, ({ "I", "II", "III", "IV", "V" })[tier])
			button.Size = UDim2.new(0.18, -2, 0, 30)
			button.BackgroundColor3 = if node.tier == tier then rune.Color else COLORS.panel2
			connect(button.Activated, function() node.tier = tier; refresh() end)
		end
	end
	local remove = textButton(holder, "Remove rune")
	remove.Size = UDim2.new(1, 0, 0, 30)
	remove.BackgroundColor3 = Color3.fromRGB(99, 38, 54)
	connect(remove.Activated, function() removeNode(node.id); refresh() end)
end

local function drawNodes()
	local layer = nodeLayer :: Frame
	for _, child in layer:GetChildren() do child:Destroy() end
	local invalid = compiled == nil
	for _, node in graph.nodes do
		local rune = SpellCompiler.Runes[node.runeId]
		local frame = Instance.new("Frame")
		frame.Name = node.id
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(node.position.x, node.position.y)
		frame.Size = UDim2.fromOffset(92, 42)
		frame.BackgroundColor3 = if selectedNodeId == node.id then rune.Color:Lerp(Color3.new(1, 1, 1), 0.18) else rune.Color:Lerp(COLORS.background, 0.5)
		frame.BorderSizePixel = 0
		frame.ZIndex = 4
		frame.Parent = layer
		corner(frame, 10)
		stroke(frame, if invalid then COLORS.bad else rune.Color, if selectedNodeId == node.id then 2 else 1)

		local title = Instance.new("TextButton")
		title.BackgroundTransparency = 1
		title.Size = UDim2.new(1, -18, 1, 0)
		title.Position = UDim2.fromOffset(9, 0)
		title.Font = Enum.Font.GothamBold
		title.Text = rune.DisplayName .. (rune.Tiered and ` {({ "I", "II", "III", "IV", "V" })[node.tier]}` or "")
		title.TextColor3 = COLORS.text
		title.TextSize = 11
		title.ZIndex = 5
		title.Parent = frame
		connect(title.Activated, function() selectedNodeId = node.id; refresh() end)
		connect(title.InputBegan, function(input)
			if not editingRegions and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				draggingNode = node.id
				selectedNodeId = node.id
			end
		end)

		if rune.Kind ~= "Input" and rune.Kind ~= "Modifier" then
			local inputPort = textButton(frame, "◀")
			inputPort.Size = UDim2.fromOffset(22, 22)
			inputPort.AnchorPoint = Vector2.new(0.5, 0.5)
			inputPort.Position = UDim2.fromScale(0, 0.5)
			inputPort.ZIndex = 6
			connect(inputPort.Activated, function()
				if pendingFrom and pendingFrom.id ~= node.id then addEdge(pendingFrom.id, node.id, pendingFrom.branch) end
				pendingFrom = nil
				refresh()
			end)
		end
		if rune.Kind ~= "Output" then
			if node.runeId == "Condition" then
				for index, branch in { "true", "false" } do
					local active = pendingFrom and pendingFrom.id == node.id and pendingFrom.branch == branch
					local outputPort = textButton(frame, if active then "●" else (branch == "true" and "T" or "F"))
					outputPort.Size = UDim2.fromOffset(22, 20)
					outputPort.AnchorPoint = Vector2.new(0.5, 0.5)
					outputPort.Position = UDim2.fromScale(1, if index == 1 then 0.25 else 0.75)
					outputPort.BackgroundColor3 = if branch == "true" then Color3.fromRGB(45, 120, 75) else Color3.fromRGB(130, 45, 60)
					outputPort.ZIndex = 6
					connect(outputPort.Activated, function()
						pendingFrom = if active then nil else { id = node.id, branch = branch }
						refresh()
					end)
				end
			else
				local active = pendingFrom and pendingFrom.id == node.id
				local outputPort = textButton(frame, if active then "●" else "▶")
				outputPort.Size = UDim2.fromOffset(22, 22)
				outputPort.AnchorPoint = Vector2.new(0.5, 0.5)
				outputPort.Position = UDim2.fromScale(1, 0.5)
				outputPort.ZIndex = 6
				connect(outputPort.Activated, function()
					pendingFrom = if active then nil else { id = node.id }
					refresh()
				end)
			end
		end
	end
end

refresh = function()
	compiled, validationErrors = SpellCompiler.Compile(graph)
	if errorLabel then
		if compiled then
			errorLabel.Text = `Valid spell  •  Mana {compiled.manaCost}  •  up to {compiled.maxProjectiles} projectile{compiled.maxProjectiles == 1 and "" or "s"}`
			errorLabel.TextColor3 = COLORS.good
		else
			errorLabel.Text = table.concat(validationErrors, "\n", 1, math.min(#validationErrors, 4))
			errorLabel.TextColor3 = COLORS.bad
		end
	end
	if saveButton then
		saveButton.Active = compiled ~= nil
		saveButton.AutoButtonColor = compiled ~= nil
		saveButton.BackgroundColor3 = if compiled then Color3.fromRGB(79, 121, 88) else Color3.fromRGB(67, 55, 72)
	end
	drawRegions()
	drawEdges()
	drawNodes()
	showInspector()
	updateCards()
end

local function setStatus(message: string, good: boolean?)
	if statusLabel then
		statusLabel.Text = message
		statusLabel.TextColor3 = if good == true then COLORS.good elseif good == false then COLORS.bad else COLORS.muted
	end
end

local function saveCard()
	if not compiled then return end
	setStatus("Saving card…")
	local result = invoke("SaveCard", { slot = selectedSlot, name = nameBox and nameBox.Text, graph = graph })
	if result.state then serverState = result.state end
	setStatus(result.message or (result.ok and "Card saved." or "Save failed."), result.ok)
	updateCards()
end

local function loadSlot(slot: number)
	selectedSlot = slot
	local record = serverState.slots and (serverState.slots[tostring(slot)] or serverState.slots[slot])
	if record and record.graph then
		graph = deepCopy(record.graph)
		if nameBox then nameBox.Text = record.name end
		selectedNodeId = nil
		pendingFrom = nil
	end
	refresh()
end

local function buildGui()
	if gui then return end
	local screen = Instance.new("ScreenGui")
	screen.Name = "SpellAssemblerGui"
	screen.IgnoreGuiInset = true
	screen.ResetOnSpawn = false
	screen.DisplayOrder = 80
	screen.Enabled = false
	screen.Parent = player:WaitForChild("PlayerGui")
	gui = screen

	local root = Instance.new("Frame")
	root.Name = "Editor"
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromScale(0.94, 0.9)
	root.BackgroundColor3 = COLORS.background
	root.BackgroundTransparency = 0.04
	root.BorderSizePixel = 0
	root.Parent = screen
	corner(root, 16)
	stroke(root, COLORS.line, 2)
	main = root

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MinSize = Vector2.new(760, 520)
	sizeConstraint.MaxSize = Vector2.new(1450, 900)
	sizeConstraint.Parent = root

	local header = label(root, "MAGIC CIRCLE ASSEMBLER", 20)
	header.Font = Enum.Font.GothamBold
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.Position = UDim2.fromOffset(20, 10)
	header.Size = UDim2.new(1, -180, 0, 36)

	local close = textButton(root, "Minimize")
	close.Position = UDim2.new(1, -116, 0, 10)
	close.Size = UDim2.fromOffset(96, 32)
	connect(close.Activated, SpellAssemblerGui.Close)
	local layout = textButton(root, "Edit areas")
	layout.Position = UDim2.new(1, -222, 0, 10)
	layout.Size = UDim2.fromOffset(96, 32)
	connect(layout.Activated, function()
		editingRegions = not editingRegions
		layout.Text = if editingRegions then "Finish areas" else "Edit areas"
		draggingNode = nil
		refresh()
	end)

	local left = Instance.new("Frame")
	left.Position = UDim2.fromOffset(16, 54)
	left.Size = UDim2.new(0, 172, 1, -142)
	left.BackgroundColor3 = COLORS.panel
	left.BorderSizePixel = 0
	left.Parent = root
	corner(left, 10)
	local paletteTitle = label(left, "RUNES  •  drag into an area", 12)
	paletteTitle.Size = UDim2.new(1, -12, 0, 32)
	paletteTitle.Position = UDim2.fromOffset(6, 3)
	paletteTitle.TextColor3 = COLORS.muted

	local scroll = Instance.new("ScrollingFrame")
	scroll.Position = UDim2.fromOffset(8, 38)
	scroll.Size = UDim2.new(1, -16, 1, -46)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.Parent = left
	palette = scroll
	local paletteLayout = Instance.new("UIListLayout")
	paletteLayout.Padding = UDim.new(0, 6)
	paletteLayout.Parent = scroll

	local right = Instance.new("Frame")
	right.AnchorPoint = Vector2.new(1, 0)
	right.Position = UDim2.new(1, -16, 0, 54)
	right.Size = UDim2.new(0, 235, 1, -142)
	right.BackgroundColor3 = COLORS.panel
	right.BorderSizePixel = 0
	right.Parent = root
	corner(right, 10)
	inspector = right

	local center = Instance.new("Frame")
	center.Position = UDim2.fromOffset(198, 54)
	center.Size = UDim2.new(1, -459, 1, -142)
	center.BackgroundTransparency = 1
	center.Parent = root
	local ratio = Instance.new("UIAspectRatioConstraint")
	ratio.AspectRatio = 1
	ratio.DominantAxis = Enum.DominantAxis.Height
	ratio.Parent = center
	canvas = center

	local regions = Instance.new("Frame")
	regions.Name = "Areas"
	regions.Size = UDim2.fromScale(1, 1)
	regions.BackgroundTransparency = 1
	regions.ZIndex = 1
	regions.Parent = center
	regionLayer = regions
	local edges = Instance.new("Frame")
	edges.Name = "Edges"
	edges.Size = UDim2.fromScale(1, 1)
	edges.BackgroundTransparency = 1
	edges.ZIndex = 2
	edges.Parent = center
	edgeLayer = edges
	local nodes = Instance.new("Frame")
	nodes.Name = "Nodes"
	nodes.Size = UDim2.fromScale(1, 1)
	nodes.BackgroundTransparency = 1
	nodes.ZIndex = 3
	nodes.Parent = center
	nodeLayer = nodes

	local nameTitle = label(right, "CARD NAME", 11)
	nameTitle.Position = UDim2.fromOffset(10, 8)
	nameTitle.Size = UDim2.new(1, -20, 0, 22)
	nameTitle.TextColor3 = COLORS.muted
	local box = Instance.new("TextBox")
	box.Position = UDim2.fromOffset(10, 31)
	box.Size = UDim2.new(1, -20, 0, 34)
	box.BackgroundColor3 = COLORS.panel2
	box.BorderSizePixel = 0
	box.ClearTextOnFocus = false
	box.Font = Enum.Font.Gotham
	box.PlaceholderText = "Fire Projectile"
	box.Text = graph.name
	box.TextColor3 = COLORS.text
	box.TextSize = 13
	box.Parent = right
	corner(box, 7)
	nameBox = box

	local tierTitle = label(right, "SELECTED RUNE", 11)
	tierTitle.Position = UDim2.fromOffset(10, 76)
	tierTitle.Size = UDim2.new(1, -20, 0, 22)
	tierTitle.TextColor3 = COLORS.muted
	local tiers = Instance.new("Frame")
	tiers.Position = UDim2.fromOffset(10, 100)
	tiers.Size = UDim2.new(1, -20, 0, 126)
	tiers.BackgroundTransparency = 1
	tiers.Parent = right
	tierHolder = tiers
	local tierLayout = Instance.new("UIListLayout")
	tierLayout.FillDirection = Enum.FillDirection.Horizontal
	tierLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	tierLayout.VerticalAlignment = Enum.VerticalAlignment.Top
	tierLayout.Wraps = true
	tierLayout.Padding = UDim.new(0, 5)
	tierLayout.Parent = tiers

	local errors = label(right, "", 11)
	errors.Position = UDim2.fromOffset(10, 232)
	errors.Size = UDim2.new(1, -20, 1, -282)
	errors.TextXAlignment = Enum.TextXAlignment.Left
	errors.TextYAlignment = Enum.TextYAlignment.Top
	errorLabel = errors
	local status = label(right, "", 11)
	status.AnchorPoint = Vector2.new(0, 1)
	status.Position = UDim2.new(0, 10, 1, -42)
	status.Size = UDim2.new(1, -20, 0, 36)
	statusLabel = status

	local save = textButton(right, "Save to selected card")
	save.AnchorPoint = Vector2.new(0, 1)
	save.Position = UDim2.new(0, 10, 1, -6)
	save.Size = UDim2.new(1, -20, 0, 34)
	saveButton = save
	connect(save.Activated, saveCard)

	local footer = Instance.new("Frame")
	footer.Position = UDim2.new(0, 16, 1, -78)
	footer.Size = UDim2.new(1, -32, 0, 64)
	footer.BackgroundColor3 = COLORS.panel
	footer.BorderSizePixel = 0
	footer.Parent = root
	corner(footer, 10)
	local cardLayout = Instance.new("UIListLayout")
	cardLayout.FillDirection = Enum.FillDirection.Horizontal
	cardLayout.Padding = UDim.new(0, 7)
	cardLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	cardLayout.Parent = footer
	local newButton = textButton(footer, "New")
	newButton.Size = UDim2.fromOffset(62, 42)
	connect(newButton.Activated, function()
		graph = SpellCompiler.CreateDefaultGraph()
		selectedNodeId, pendingFrom = nil, nil
		if nameBox then nameBox.Text = graph.name end
		refresh()
	end)
	for slot = 1, 5 do
		local button = textButton(footer, tostring(slot))
		button.Size = UDim2.new(0.135, 0, 0, 42)
		cardButtons[slot] = button
		connect(button.Activated, function() loadSlot(slot) end)
	end
	local use = textButton(footer, "Use")
	use.Size = UDim2.fromOffset(64, 42)
	use.BackgroundColor3 = Color3.fromRGB(65, 108, 89)
	connect(use.Activated, function()
		setStatus("Equipping card…")
		local result = invoke("SetActive", { slot = selectedSlot })
		if result.state then serverState = result.state end
		setStatus(result.message or "", result.ok)
		updateCards()
		if result.ok then SpellAssemblerGui.Close() end
	end)
	local delete = textButton(footer, "Delete")
	delete.Size = UDim2.fromOffset(68, 42)
	delete.BackgroundColor3 = Color3.fromRGB(95, 42, 55)
	connect(delete.Activated, function()
		local result = invoke("DeleteCard", { slot = selectedSlot })
		if result.state then serverState = result.state end
		setStatus(result.message or "", result.ok)
		updateCards()
	end)

	local compact = Instance.new("Frame")
	compact.Name = "Compact"
	compact.AnchorPoint = Vector2.new(1, 1)
	compact.Position = UDim2.new(1, -18, 1, -18)
	compact.Size = UDim2.fromOffset(300, 52)
	compact.BackgroundColor3 = COLORS.panel
	compact.BorderSizePixel = 0
	compact.Visible = false
	compact.Parent = screen
	corner(compact, 10)
	stroke(compact)
	mini = compact
	local active = label(compact, "Active: None", 12)
	active.Position = UDim2.fromOffset(10, 5)
	active.Size = UDim2.new(1, -132, 1, -10)
	active.TextXAlignment = Enum.TextXAlignment.Left
	activeLabel = active
	local edit = textButton(compact, "Edit [E]")
	edit.Position = UDim2.new(1, -120, 0, 8)
	edit.Size = UDim2.fromOffset(62, 36)
	connect(edit.Activated, SpellAssemblerGui.Open)
	local castButton = textButton(compact, "Cast")
	castButton.Position = UDim2.new(1, -54, 0, 8)
	castButton.Size = UDim2.fromOffset(46, 36)
	castButton.BackgroundColor3 = Color3.fromRGB(120, 55, 42)
	connect(castButton.Activated, SpellAssemblerGui.Cast)

	for _, runeId in SpellCompiler.RuneOrder do
		local rune = SpellCompiler.Runes[runeId]
		local button = textButton(scroll, rune.DisplayName .. (rune.Tiered and "  I–V" or ""))
		button.Size = UDim2.new(1, -4, 0, 36)
		button.BackgroundColor3 = rune.Color:Lerp(COLORS.background, 0.55)
		connect(button.Activated, function() addRune(runeId) end)
		connect(button.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				paletteDragRune = runeId
			end
		end)
	end

	connect(UserInputService.InputChanged, function(input)
		if draggingRegion and canvas and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local region
			for _, candidate in graph.regions or {} do if candidate.id == draggingRegion.id then region = candidate; break end end
			if region then
				local canvasSize = canvas.AbsoluteSize
				local delta = input.Position - draggingRegion.start
				local dx, dy = delta.X / math.max(canvasSize.X, 1), delta.Y / math.max(canvasSize.Y, 1)
				if draggingRegion.mode == "move" then
					region.x = math.clamp(draggingRegion.x + dx, 0, 1 - region.w)
					region.y = math.clamp(draggingRegion.y + dy, 0, 1 - region.h)
				else
					region.w = math.clamp(draggingRegion.w + dx, 0.06, 1 - region.x)
					region.h = math.clamp(draggingRegion.h + dy, 0.06, 1 - region.y)
				end
				refresh()
			end
		elseif draggingNode and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local node = nodeById(draggingNode)
			if node then node.position = clampToRegion(node.runeId, input.Position); refresh() end
		end
	end)
	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if paletteDragRune and canvas then
				local p, s = canvas.AbsolutePosition, canvas.AbsoluteSize
				if input.Position.X >= p.X and input.Position.X <= p.X + s.X and input.Position.Y >= p.Y and input.Position.Y <= p.Y + s.Y then
					addRune(paletteDragRune, input.Position)
				end
			end
			draggingNode = nil
			draggingRegion = nil
			paletteDragRune = nil
		end
	end)
	connect(UserInputService.InputBegan, function(input, processed)
		if processed or not equippedTool then return end
		if input.KeyCode == Enum.KeyCode.E then
			SpellAssemblerGui.Toggle()
		elseif input.KeyCode == Enum.KeyCode.Delete and visible and selectedNodeId then
			removeNode(selectedNodeId)
			refresh()
		end
	end)
	connect(center:GetPropertyChangedSignal("AbsoluteSize"), function() if gui and gui.Enabled then drawEdges() end end)
	refresh()
end

function SpellAssemblerGui.Open()
	buildGui()
	visible = true
	(gui :: ScreenGui).Enabled = true
	(main :: Frame).Visible = true
	(mini :: Frame).Visible = false
	refresh()
end

function SpellAssemblerGui.Close()
	if not gui then return end
	visible = false
	(main :: Frame).Visible = false
	(mini :: Frame).Visible = equippedTool ~= nil
	updateCards()
end

function SpellAssemblerGui.Toggle()
	if visible then SpellAssemblerGui.Close() else SpellAssemblerGui.Open() end
end

function SpellAssemblerGui.Cast()
	if not equippedTool or visible or not serverState.activeSlot then return end
	local mouse = player:GetMouse()
	castRemote:FireServer(mouse.Hit.Position)
end

function SpellAssemblerGui.Equip(tool: Tool)
	equippedTool = tool
	buildGui()
	setStatus("Loading spell cards…")
	local result = invoke("GetState")
	if result.state then serverState = result.state end
	if result.state and result.state.error then setStatus(result.state.error, result.state.sessionOnly) else setStatus(result.message or "Cards loaded.", result.ok) end
	updateCards()
	SpellAssemblerGui.Open()
end

function SpellAssemblerGui.Unequip(tool: Tool)
	if equippedTool ~= tool then return end
	equippedTool = nil
	visible = false
	if gui then gui.Enabled = false end
end

return SpellAssemblerGui
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">TimeControlGui</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	TimeControlGui.luau  (client)
	A small on-screen panel to scrub YOUR OWN personal time ratio -- it only
	ever affects this player's own movement and the bullets they fire, live,
	even ones already in flight (see MovementController.SetPersonalTimeScale
	and Projectile.luau's Step, which reads Source.TimeScale every tick), never
	the world or anyone else. Dragging the slider (or clicking a preset) does
	two things:
	  • applies the ratio locally right away (MovementController.
	    SetPersonalTimeScale) so the client feels responsive, and
	  • requests it from the server (VisualOffload "RequestPersonalTimeScale"),
	    which is authoritative, clamps it, applies it to this player's Entity,
	    and replies with the clamped value on "PersonalTimeScale" (to this
	    player only -- nobody else needs to know it).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualOffload = require(Shared.VisualOffload)
local MovementController = require(script.Parent.MovementController)

local TimeControlGui = {}

local MIN_RATIO = 0
local MAX_RATIO = 3
local PRESETS = { 0, 0.25, 0.5, 1, 2 }

local started = false
local dragging = false
local currentRatio = 1

-- throttle network sends during a drag (local apply stays instant)
local SEND_INTERVAL = 0.05
local lastSent = 0
local pendingSend: number? = nil

-- built lazily in start()
local track: Frame
local fill: Frame
local handle: Frame
local valueLabel: TextLabel

local function ratioToAlpha(ratio: number): number
	return math.clamp((ratio - MIN_RATIO) / (MAX_RATIO - MIN_RATIO), 0, 1)
end

local function render(ratio: number)
	local alpha = ratioToAlpha(ratio)
	fill.Size = UDim2.new(alpha, 0, 1, 0)
	handle.Position = UDim2.new(alpha, 0, 0.5, 0)
	valueLabel.Text = string.format("Your Time  x%.2f", ratio)
end

-- Throttled request to the authoritative server. Coalesces rapid drag updates
-- and always flushes the final value (see the flush loop in start()).
local function requestServer(ratio: number)
	local now = os.clock()
	if now - lastSent >= SEND_INTERVAL then
		lastSent = now
		pendingSend = nil
		VisualOffload.Fire("RequestPersonalTimeScale", ratio)
	else
		pendingSend = ratio
	end
end

-- Apply locally + tell the server. `fromNetwork` avoids echoing the server's
-- own reply back at it.
local function applyRatio(ratio: number, fromNetwork: boolean?)
	ratio = math.clamp(ratio, MIN_RATIO, MAX_RATIO)
	currentRatio = ratio
	render(ratio)
	if not fromNetwork then
		MovementController.SetPersonalTimeScale(ratio) -- instant local feedback
		requestServer(ratio)
	end
end

local function alphaFromInput(inputX: number): number
	local left = track.AbsolutePosition.X
	local width = track.AbsoluteSize.X
	if width <= 0 then
		return 0
	end
	return math.clamp((inputX - left) / width, 0, 1)
end

local function setFromInput(inputX: number)
	local alpha = alphaFromInput(inputX)
	applyRatio(MIN_RATIO + alpha * (MAX_RATIO - MIN_RATIO))
end

local function build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local screen = Instance.new("ScreenGui")
	screen.Name = "TimeControlGui"
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.Parent = playerGui

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.Position = UDim2.new(0.5, 0, 1, -16)
	panel.Size = UDim2.fromOffset(360, 92)
	panel.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
	panel.BackgroundTransparency = 0.1
	panel.BorderSizePixel = 0
	panel.Parent = screen
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = panel
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.Parent = panel

	valueLabel = Instance.new("TextLabel")
	valueLabel.Name = "Value"
	valueLabel.BackgroundTransparency = 1
	valueLabel.Size = UDim2.new(1, 0, 0, 20)
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.TextSize = 15
	valueLabel.TextColor3 = Color3.fromRGB(235, 240, 255)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Left
	valueLabel.Parent = panel

	-- slider track
	track = Instance.new("Frame")
	track.Name = "Track"
	track.Position = UDim2.new(0, 0, 0, 30)
	track.Size = UDim2.new(1, 0, 0, 8)
	track.BackgroundColor3 = Color3.fromRGB(45, 50, 65)
	track.BorderSizePixel = 0
	track.Parent = panel
	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track

	fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(0.33, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(90, 170, 255)
	fill.BorderSizePixel = 0
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	handle = Instance.new("Frame")
	handle.Name = "Handle"
	handle.AnchorPoint = Vector2.new(0.5, 0.5)
	handle.Position = UDim2.new(0.33, 0, 0.5, 0)
	handle.Size = UDim2.fromOffset(18, 18)
	handle.BackgroundColor3 = Color3.fromRGB(235, 240, 255)
	handle.BorderSizePixel = 0
	handle.ZIndex = 2
	handle.Parent = track
	local handleCorner = Instance.new("UICorner")
	handleCorner.CornerRadius = UDim.new(1, 0)
	handleCorner.Parent = handle

	-- preset buttons
	local presetRow = Instance.new("Frame")
	presetRow.Name = "Presets"
	presetRow.BackgroundTransparency = 1
	presetRow.Position = UDim2.new(0, 0, 0, 48)
	presetRow.Size = UDim2.new(1, 0, 0, 24)
	presetRow.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	layout.Padding = UDim.new(0, 6)
	layout.Parent = presetRow

	for _, preset in PRESETS do
		local button = Instance.new("TextButton")
		button.Name = `Preset_{preset}`
		button.Size = UDim2.fromOffset(62, 24)
		button.BackgroundColor3 = Color3.fromRGB(38, 42, 56)
		button.BorderSizePixel = 0
		button.Font = Enum.Font.GothamMedium
		button.TextSize = 13
		button.TextColor3 = Color3.fromRGB(220, 226, 240)
		button.Text = preset == 0 and "Freeze" or string.format("x%.2g", preset)
		button.Parent = presetRow
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, 6)
		bc.Parent = button
		button.Activated:Connect(function()
			applyRatio(preset)
		end)
	end

	-- drag handling
	local function beginDrag(input)
		dragging = true
		setFromInput(input.Position.X)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			beginDrag(input)
		end
	end)
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			beginDrag(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromInput(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

function TimeControlGui.start()
	if started then
		return
	end
	started = true

	build()
	applyRatio(MovementController.GetPersonalTimeScale(), true)

	-- flush any coalesced send shortly after the last drag update
	task.spawn(function()
		while started do
			if pendingSend and os.clock() - lastSent >= SEND_INTERVAL then
				local value = pendingSend
				pendingSend = nil
				lastSent = os.clock()
				VisualOffload.Fire("RequestPersonalTimeScale", value)
			end
			task.wait(SEND_INTERVAL)
		end
	end)

	-- reconcile against the server's authoritative (possibly clamped) value;
	-- this only ever targets this player (see example/init.server.luau), never
	-- broadcast, since it's personal
	VisualOffload.On("PersonalTimeScale", function(scale)
		if not dragging and typeof(scale) == "number" then
			applyRatio(scale, true)
		end
	end)
end

return TimeControlGui
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="72">
          <Properties>
            <string name="Name">ToolControllers</string>
          </Properties>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">DilationBubble</string>
              <string name="Source"><![CDATA[--!optimize 2
-- Client controller for the Studio-only DilationBubble test tool.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VisualOffload = require(ReplicatedStorage:WaitForChild("Shared").VisualOffload)
local Gui = require(script.Parent.Parent.DilationBubbleGui)

local Controller = {}
local activationConnection: RBXScriptConnection? = nil

function Controller.Equip(tool: Tool, _character: Model)
	if activationConnection then
		activationConnection:Disconnect()
	end
	Gui.Start()
	Gui.SetVisible(true)
	local mouse = Players.LocalPlayer:GetMouse()
	activationConnection = tool.Activated:Connect(function()
		local config = Gui.GetConfig()
		VisualOffload.Fire("DilationBubbleTest", {
			Action = "Create",
			Position = mouse.Hit.Position,
			Scale = config.Scale,
			Radius = config.Radius,
			Duration = config.Duration,
		})
	end)
end

function Controller.Unequip(_tool: Tool, _character: Model)
	if activationConnection then
		activationConnection:Disconnect()
		activationConnection = nil
	end
	Gui.SetVisible(false)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">Pheonix</string>
              <string name="Source"><![CDATA[--!optimize 2
-- Railgun tool controller. Matched by Tool.Name == "Railgun" (see
-- ToolManager.luau). Plain shooting weapon -- see _ShootingWeapon.luau.
-- Fires the RailgunRod effect because "Railgun" is registered in
-- src/server/Weapons/Railgun.luau (-> ReplicatedStorage.Effects.RailgunRod).
return require(script.Parent._ShootingWeapon)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">Railgun</string>
              <string name="Source"><![CDATA[--!optimize 2
-- Railgun tool controller. Matched by Tool.Name == "Railgun" (see
-- ToolManager.luau). Plain shooting weapon -- see _ShootingWeapon.luau.
-- Fires the RailgunRod effect because "Railgun" is registered in
-- src/server/Weapons/Railgun.luau (-> ReplicatedStorage.Effects.RailgunRod).
return require(script.Parent._ShootingWeapon)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">SpellAssembler</string>
              <string name="Source"><![CDATA[-- Thin Tool launcher; SpellAssemblerGui can later be opened by any menu.

local controller = require(script.Parent.Parent.SpellAssemblerGui)
local activation: RBXScriptConnection? = nil

return {
	Equip = function(tool: Tool, _character: Model)
		if activation then activation:Disconnect() end
		activation = tool.Activated:Connect(controller.Cast)
		controller.Equip(tool)
	end,
	Unequip = function(tool: Tool, _character: Model)
		if activation then activation:Disconnect(); activation = nil end
		controller.Unequip(tool)
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">TimeBlaster</string>
              <string name="Source"><![CDATA[--!optimize 2
-- TimeBlaster tool controller. Matched by Tool.Name == "TimeBlaster" (see
-- ToolManager.luau). Plain shooting weapon -- see _ShootingWeapon.luau.
return require(script.Parent._ShootingWeapon)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">_ShootingWeapon</string>
              <string name="Source"><![CDATA[--!optimize 2
--[[
	ToolControllers/_ShootingWeapon.luau
	Shared Equip/Unequip body for every plain shooting weapon (see
	Weapons/init.luau on the server for the per-weapon stat sheet/behavior
	side of this). Leading underscore is deliberate: ToolManager.luau
	matches a controller to a Tool purely by exact Tool.Name ==
	ModuleScript.Name, and no Tool is ever named "_ShootingWeapon", so this
	file is inert as a controller on its own -- other controller modules
	require and re-export it instead, e.g.:

		-- ToolControllers/Railgun.luau
		return require(script.Parent._ShootingWeapon)

	A weapon only needs its own dedicated controller file (instead of
	re-exporting this) if it needs behavior beyond "start the generic
	fire/viewmodel pipeline" -- e.g. a melee weapon, or one with a unique
	client-side windup/charge visual.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualOffload = require(Shared.VisualOffload)

local client = script.Parent.Parent
local ShooterController = require(client.ShooterController)
local Viewmodel = require(client.Viewmodel)
local ShooterConfigGui = require(client.ShooterConfigGui)

local ShootingWeapon = {}

function ShootingWeapon.Equip(tool: Tool, character: Model)
	ShooterConfigGui.start() -- idempotent; no-ops outside Studio -- see ShooterConfigGui.luau
	ShooterConfigGui.setVisible(true)
	ShooterController.start()
	Viewmodel.Equip(tool, character)
	-- Lets the server sync starting ammo immediately (see Shooter.server.
	-- luau's "WeaponEquip" handler) instead of waiting for the first shot --
	-- a no-op server-side for weapons with no Magazine.
	VisualOffload.Fire("WeaponEquip", { ToolName = tool.Name })
end

function ShootingWeapon.Unequip(tool: Tool, character: Model)
	ShooterConfigGui.setVisible(false)
	ShooterController.stop()
	Viewmodel.Unequip(tool, character)
end

return ShootingWeapon
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">ToolManager</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	ToolManager (client)
	Generalized tool-controller swapper: any tool that wants custom client
	behavior gets a ModuleScript in ToolControllers/ named EXACTLY like the
	Tool instance (e.g. "TimeBlaster" -> ToolControllers/TimeBlaster.luau).
	Whenever a tool with a matching controller becomes equipped, this calls
	that controller's Equip(tool, character); when it's unequipped (or a
	death/respawn cuts it off without a clean Unequipped), it calls
	Unequip(tool, character). This is the ONLY thing that knows tools exist --
	individual controllers (ShooterController, Viewmodel, etc.) know
	nothing about equip state; they're just started/stopped by their
	controller module. A tool with no matching module is ignored entirely --
	this only drives custom per-tool client behavior, not equipping itself,
	so plain vanilla tools work exactly as Roblox already handles them.

	Controller module contract (see ToolControllers/TimeBlaster.luau):
	  return {
	    Equip = function(tool: Tool, character: Model) ... end,
	    Unequip = function(tool: Tool, character: Model) ... end,
	  }

	Watches Player:GetDescendants()/DescendantAdded rather than just Backpack:
	Roblox replaces the Player's Backpack instance with a fresh one sometime
	after initial join/spawn (confirmed by tracing Player.ChildAdded/
	ChildRemoved in a real Play session), so a listener bound to the original
	Backpack instance silently stops seeing anything once it's swapped.
	DescendantAdded on the Player itself isn't tied to any one container's
	identity, so it keeps working across that swap (and across a tool moving
	between Backpack and Character on every equip/unequip).

	(Also note: Humanoid has no Equipped/Unequipped event -- only Tool does.)
]]

local Players = game:GetService("Players")

local ToolControllers = script.Parent:WaitForChild("ToolControllers")

local ToolManager = {}

local player = Players.LocalPlayer
local started = false
local watched: { [Tool]: boolean } = {}
local current: { tool: Tool, controller: any }? = nil

-- false is a valid cached "no controller for this name" result, distinct
-- from nil (not looked up yet) -- see getController.
local controllerCache: { [string]: any } = {}

local function getController(name: string): any?
	local cached = controllerCache[name]
	if cached ~= nil then
		if cached == false then
			return nil
		end
		return cached
	end

	local module = ToolControllers:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		controllerCache[name] = false
		return nil
	end

	local ok, controller = pcall(require, module)
	if not ok then
		warn(`[ToolManager] failed to require controller "{name}": {controller}`)
		controllerCache[name] = false
		return nil
	end
	controllerCache[name] = controller
	return controller
end

local function onEquipped(tool: Tool)
	local controller = getController(tool.Name)
	if not controller then
		return
	end

	if current and current.tool ~= tool then
		-- defensive: Tool.Unequipped on the previous tool should already have
		-- cleared `current`, but never leave two controllers active at once
		local ok, err = pcall(current.controller.Unequip, current.tool, current.tool.Parent)
		if not ok then
			warn(`[ToolManager] "{current.tool.Name}".Unequip errored: {err}`)
		end
	end

	current = { tool = tool, controller = controller }
	local ok, err = pcall(controller.Equip, tool, tool.Parent)
	if not ok then
		warn(`[ToolManager] "{tool.Name}".Equip errored: {err}`)
	end
end

local function onUnequipped(tool: Tool)
	if not current or current.tool ~= tool then
		return
	end
	local controller = current.controller
	current = nil
	local ok, err = pcall(controller.Unequip, tool, tool.Parent)
	if not ok then
		warn(`[ToolManager] "{tool.Name}".Unequip errored: {err}`)
	end
end

local function watchTool(instance: Instance)
	if not instance:IsA("Tool") or watched[instance] then
		return
	end
	watched[instance] = true

	-- the tool may already be sitting equipped in the character by the time
	-- we discover it (e.g. a respawn that re-equips instantly)
	local parent = instance.Parent
	if parent and parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then
		onEquipped(instance)
	end

	instance.Equipped:Connect(function()
		onEquipped(instance)
	end)
	instance.Unequipped:Connect(function()
		onUnequipped(instance)
	end)
end

function ToolManager.start()
	if started then
		return
	end
	started = true

	for _, descendant in player:GetDescendants() do
		watchTool(descendant)
	end
	player.DescendantAdded:Connect(watchTool)

	-- defensive: make sure a controller never stays "active" across a death
	-- that doesn't cleanly fire Tool.Unequipped
	player.CharacterRemoving:Connect(function()
		if current then
			onUnequipped(current.tool)
		end
	end)
end

return ToolManager
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">Viewmodel</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	Viewmodel (client, purely cosmetic)
	FIRST-PERSON-ONLY procedural viewmodel: while a weapon Tool is equipped
	AND the camera is in first person, the weapon is placed relative to the
	CAMERA every frame (with procedural sway/bob/breathing -- see
	Sway.luau), and the local player's own arms telescope out to hold it at
	its named grip Attachments (see ArmRig.luau). No keyframed
	AnimationTracks anywhere in this system -- everything is computed live,
	every frame. Outside first person nothing is touched at all: the
	character holds the tool with Roblox's stock grip/animations, and
	leaving first person restores everything.

	WHY THE CAMERA DRIVES THE WEAPON (and not the other way around): the
	Tool is welded to the Right Arm by Roblox's auto-created "RightGrip"
	Weld, so an earlier version that aimed the arms at the tool's live
	attachment positions was chasing its own output -- posing the arm moved
	the tool, which moved the target, which re-posed the arm, diverging
	into visible spazzing. Here the kinematic chain is solved from a single
	root, once per frame, with no read-back:
	    camera -> grip frame (sway * WEAPON_CAMERA_OFFSET, an upright
	              camera-aligned "virtual hand")
	           -> desired Handle CFrame (grip frame * Tool.Grip:Inverse() --
	              see WEAPON ORIENTATION below)
	           -> desired grip points (attachment offsets captured at equip)
	           -> arm poses (ArmRig.PoseArm, returns the PREDICTED arm CFrame)
	           -> RightGrip weld C0 solved so the Handle lands exactly on
	              the desired CFrame.
	This is also what animates the weapon itself: sway/bob/breathing move
	the gun, and the arms follow it.

	This directly poses the REAL arm parts, not a separate fake viewmodel
	clone rig: Roblox never replicates a client's own cosmetic property
	writes (CFrame/Size/Motor6D.Transform/Weld.C0) back to the server or to
	other clients, so this is visible ONLY to the local player. Other
	players keep seeing this character's normal third-person body. This
	intentionally supersedes an old Studio-only "EasyFirstPerson" script
	(never in source control) that took the fake-clone-rig approach --
	remove that script from StarterCharacterScripts in Studio so the two
	don't fight over the arms in first person.

	WEAPON ORIENTATION -- Tool.Grip is respected, not overwritten: Roblox's
	own hold places the Handle as gripFrame * Grip:Inverse(), where the grip
	frame is an upright frame aligned with the character's look direction
	(that's exactly what Grip means -- how the handle sits in the hand --
	and it's what Studio grip-editor plugins edit). The camera frame uses
	the same convention (-Z forward, +Y up), so composing our camera-derived
	grip frame with the SAME Grip:Inverse() reproduces the designer's
	intended weapon orientation in first person. Grip is read live every
	frame, so tweaking it (via the Grip properties or a grip editor plugin)
	updates the viewmodel immediately, even mid-Play. For a viewmodel-ONLY
	adjustment on top (rotate/nudge the weapon in the hand without touching
	the third-person Grip), set a CFrame attribute named
	"ViewmodelGripOffset" on the Tool -- it's applied in grip-frame space,
	so e.g. CFrame.Angles(0, math.rad(10), 0) yaws the weapon in the hand.

	Weapon setup contract: the Tool must have a "Handle" BasePart, and marks
	where each hand grips with named Attachment instances (searched for
	recursively under the Tool):
	 - RightGripAttachment -- required for ANY weapon, one- or two-handed;
	   the right hand is always the primary grip.
	 - LeftGripAttachment -- optional; only two-handed weapons need it. Its
	   absence just means the left arm is left alone (one-handed weapon).
	 - Sight + SightEnd -- optional pair; enables aim-down-sights. While
	   aiming (right mouse button held, or Viewmodel.SetAiming(true) from
	   code), the weapon eases (a real TweenService tween, see ADS_IN_TIME/
	   ADS_OUT_TIME/ADS_EASING_STYLE) from the hip hold to a pose where Sight
	   sits DEAD-CENTER on screen, ADS_SIGHT_DISTANCE studs in front of
	   the camera, with the Sight -> SightEnd line aligned to the look
	   direction. Only the POSITIONS of the two attachments matter (put
	   Sight at the rear of the sight picture, SightEnd farther forward
	   along the exact line the player should look down) -- their
	   ORIENTATIONS are deliberately ignored, so a mis-rotated attachment
	   can't skew the aimed grip; aimed roll comes from the weapon's own
	   Grip up. A weapon with a Sight but no SightEnd falls back to aiming
	   along the Sight's own LookVector (orientation and all -- the old
	   contract). Weapons with neither attachment simply never ADS.
	Attachment offsets are captured relative to the Handle ONCE at equip --
	per-frame code deliberately never reads att.WorldCFrame (that's the
	feedback loop described above).

	API:
	 Viewmodel.Equip(tool: Tool, character: Model)   -- call from a
	   ToolControllers/<Name>.luau's Equip(tool, character). No-op if the
	   tool has no Handle or no RightGripAttachment.
	 Viewmodel.Unequip(tool: Tool, character: Model) -- call from Unequip;
	   restores the rig/weld exactly as Equip found them. Safe to call even
	   if the character/parts were since destroyed, or if Equip never
	   actually activated for this tool -- both are silent no-ops.
]]

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local ArmRig = require(script.ArmRig)
local Sway = require(script.Sway)

type ArmSide = ArmRig.ArmSide
type ArmCache = ArmRig.ArmCache

local Viewmodel = {}

Viewmodel.RIGHT_GRIP_NAME = "RightGripAttachment"
Viewmodel.LEFT_GRIP_NAME = "LeftGripAttachment"
Viewmodel.SIGHT_NAME = "Sight"
Viewmodel.SIGHT_END_NAME = "SightEnd"

-- Camera-local virtual SHOULDER anchor positions, one per arm, read EVERY
-- frame: where each arm's two-bone elbow solve hangs from, relative to the
-- (swayed) camera -- +X right, -Y down, +Z behind the view plane. Placed at
-- forearm/elbow height BELOW the eye line so the rendered forearm visibly
-- rises from low on the screen (and follows the camera's pitch); anchoring
-- at the character's real shoulder socket made the arms appear to originate
-- up at shoulder height instead of at the IK-solved elbow. See
-- ArmRig.PoseArm's anchorPos.
Viewmodel.RightShoulderOffset = Vector3.new(0.9, -1.5, 0.2)
Viewmodel.LeftShoulderOffset = Vector3.new(-0.9, -1.5, 0.2)

-- Dynamic arm offsets, one per arm, read EVERY frame -- reassign these at
-- runtime (from anywhere) to repose the arms live, e.g. for lowered or
-- sprint poses. Each is a CFrame: the POSITION shifts the virtual shoulder
-- anchor (camera-local, on top of the ShoulderOffset above), the ROTATION
-- swings the whole posed forearm around the grip point -- the hand stays
-- planted on the weapon. See ArmRig.PoseArm.
Viewmodel.RightElbowOffset = ArmRig.DEFAULT_ELBOW_OFFSET :: CFrame
Viewmodel.LeftElbowOffset = ArmRig.DEFAULT_ELBOW_OFFSET :: CFrame

-- Camera-local IK pole vectors, one per arm, read EVERY frame: which way
-- each virtual elbow bends when the arm isn't straight -- down and OUTWARD
-- (right elbow to the right, left to the left), like real elbows on a
-- shouldered weapon. See ArmRig.PoseArm's poleDir.
Viewmodel.RightElbowPole = Vector3.new(1, -0.8, 0.4)
Viewmodel.LeftElbowPole = Vector3.new(-1, -0.8, 0.4)

-- Where the GRIP FRAME (the "virtual hand" the weapon is held by -- the
-- Handle itself then sits at grip * Tool.Grip:Inverse(), see the module doc
-- comment) sits relative to the (swayed) camera: right of center, below eye
-- line, pushed forward -- the classic FPS hold. TUNE ME by feel in Studio;
-- this is the global knob for the hold pose across ALL weapons -- per-weapon
-- adjustments belong in Tool.Grip or the ViewmodelGripOffset attribute.
local WEAPON_CAMERA_OFFSET = CFrame.new(1.1, -1.1, -2.2)

-- Optional per-Tool CFrame attribute: extra viewmodel-only offset composed
-- into the grip frame (does not affect third-person holding at all).
local GRIP_OFFSET_ATTRIBUTE = "ViewmodelGripOffset"

-- ADS ("aim down sights") tuning -- see the Sight bullet in the module doc
-- comment for the full behavior/contract.
local ADS_SIGHT_DISTANCE = 1.2 -- studs from the camera to the Sight while fully aimed
local ADS_SWAY_FACTOR = 0.75 -- fraction of sway/bob suppressed at full ADS (steadier aim)
-- Hip <-> ADS blend is a real TweenService tween (see the AdsValue/AdsTween
-- fields below) so it eases in/out with a proper curve instead of an
-- asymptotic per-frame chase -- a fresh tween is only started when `aiming`
-- actually FLIPS (see the Stepped loop), not recreated every frame.
local ADS_IN_TIME = 0.18 -- seconds, hip -> aimed
local ADS_OUT_TIME = 0.12 -- seconds, aimed -> hip (snappier so you can react faster)
local ADS_EASING_STYLE = Enum.EasingStyle.Quad

-- Camera-to-focus distance at/below which we treat the camera as first
-- person. Roblox's own first-person camera pins the camera essentially onto
-- the focus (distance ~0); ordinary third-person zoom is well above 1.
local FIRST_PERSON_MAX_DISTANCE = 1

type PosedHand = {
	AttRel: CFrame, -- grip attachment's offset from the Handle, captured at equip
	Arm: ArmSide,
	Cache: ArmCache,
	TransparencyConnection: RBXScriptConnection,
}

type ActiveEntry = {
	Connection: RBXScriptConnection,
	Right: PosedHand,
	Left: PosedHand?,
	Sway: Sway.Sway,
	Handle: BasePart,
	Posed: boolean,
	SightRel: CFrame?, -- handle-local ADS sight frame, built at equip (nil = weapon can't ADS)
	-- Smooth hip (0) <-> fully-aimed (1) blend, driven by TweenService: read
	-- AdsValue.Value each frame; AdsTarget is the last target a tween was
	-- STARTED toward (so the Stepped loop only creates a new tween on an
	-- actual flip, not every frame); AdsTween is that in-flight tween, kept
	-- so a rapid re-toggle can smoothly retarget instead of stacking tweens.
	AdsValue: NumberValue,
	AdsTarget: number,
	AdsTween: Tween?,
	-- Original C0 per RightGrip Weld INSTANCE -- Roblox destroys/recreates
	-- the weld across equips, so keying by instance means we can never
	-- "restore" a stale C0 onto a fresh weld we never modified.
	OriginalWeldC0: { [Weld]: CFrame },
}

-- Keyed by Tool instance rather than a single slot -- Roblox only ever lets
-- one Tool be equipped at a time in practice, but keying this way means a
-- rapid unequip-then-equip-a-different-tool before the first Tool's
-- Unequipped fully lands can never cross-restore the wrong cache onto the
-- wrong tool.
local active: { [Tool]: ActiveEntry } = {}

-- Recursion guard for the LocalTransparencyModifier forcing below.
local forcingTransparency = false

-- Whether the player is currently TRYING to aim (the smooth per-tool tweened
-- blend lives on each entry as AdsValue -- see the ActiveEntry type). Driven
-- by the right mouse button below; other input schemes (touch buttons,
-- gamepad triggers) can call Viewmodel.SetAiming instead.
local aiming = false

function Viewmodel.SetAiming(isAiming: boolean)
	aiming = isAiming
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		aiming = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	-- Deliberately no gameProcessed check: releasing the button must ALWAYS
	-- unaim, even if the release landed over UI.
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		aiming = false
	end
end)

local function findGripAttachment(tool: Tool, name: string): Attachment?
	local found = tool:FindFirstChild(name, true)
	if found and found:IsA("Attachment") then
		return found
	end
	return nil
end

-- In first person the engine sets LocalTransparencyModifier = 1 on limbs
-- every frame to hide them; the whole point of a viewmodel is visible arms,
-- so while posed we pin it back to 0 the instant the engine touches it.
local function watchTransparency(entry: ActiveEntry, part: BasePart): RBXScriptConnection
	return part:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
		if forcingTransparency or not entry.Posed then
			return
		end
		forcingTransparency = true
		part.LocalTransparencyModifier = 0
		forcingTransparency = false
	end)
end

local function findGripWeld(entry: ActiveEntry): Weld?
	-- Roblox parents the auto-created tool weld under the Right Arm, named
	-- "RightGrip". Re-found every frame rather than cached: the engine
	-- destroys and recreates it across (un)equips.
	local weld = entry.Right.Arm.Arm:FindFirstChild("RightGrip")
	if weld and weld:IsA("Weld") then
		return weld
	end
	return nil
end

-- Puts everything back to stock (arms, joint, tool weld). Idempotent; called
-- both when leaving first person (tool stays equipped, Roblox's normal
-- third-person hold takes over) and from Unequip.
local function unpose(entry: ActiveEntry)
	if not entry.Posed then
		return
	end
	entry.Posed = false
	ArmRig.Restore(entry.Right.Arm, entry.Right.Cache)
	if entry.Left then
		ArmRig.Restore(entry.Left.Arm, entry.Left.Cache)
	end
	local weld = findGripWeld(entry)
	if weld then
		local originalC0 = entry.OriginalWeldC0[weld]
		if originalC0 then
			weld.C0 = originalC0
		end
	end
	-- LocalTransparencyModifier is left alone: the engine rewrites it every
	-- frame from camera distance, so it self-corrects the moment we stop
	-- pinning it (the watch connections gate on entry.Posed).
end

function Viewmodel.Equip(tool: Tool, character: Model)
	if active[tool] then
		return -- already active (defensive; ToolManager shouldn't double-fire)
	end

	local handle = tool:FindFirstChild("Handle")
	if not (handle and handle:IsA("BasePart")) then
		return -- no Handle, nothing to place relative to the camera
	end
	local rightGrip = findGripAttachment(tool, Viewmodel.RIGHT_GRIP_NAME)
	if not rightGrip then
		-- No grip marked at all -- nothing for this system to do; leave the
		-- Tool to Roblox's default Grip/weld behavior untouched.
		return
	end
	local rightArm = ArmRig.Find(character, "Right")
	if not rightArm then
		return -- not an R6 rig, or missing parts; nothing safe to do
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	-- Capture grip offsets relative to the Handle ONCE -- see the module
	-- doc comment on why per-frame WorldCFrame reads are forbidden.
	local handleInverse = handle.CFrame:Inverse()

	-- ADS sight frame, handle-local (see the Sight/SightEnd contract in the
	-- module doc comment): position from Sight, aim axis from the
	-- Sight -> SightEnd line -- attachment ORIENTATION is deliberately
	-- ignored when SightEnd exists, so a mis-rotated Sight can't skew the
	-- aimed grip. Roll comes from the weapon's own Grip up (the handle-local
	-- direction that points up in the hip grip frame -- see WEAPON
	-- ORIENTATION), so aiming never rolls the weapon relative to its hip
	-- hold. A lone Sight (no SightEnd) keeps the old full-CFrame contract.
	local sightRel: CFrame? = nil
	local sight = findGripAttachment(tool, Viewmodel.SIGHT_NAME)
	if sight then
		local sightCF = handleInverse * sight.WorldCFrame
		sightRel = sightCF
		local sightEnd = findGripAttachment(tool, Viewmodel.SIGHT_END_NAME)
		if sightEnd then
			local aimAxis = (handleInverse * sightEnd.WorldCFrame).Position - sightCF.Position
			if aimAxis.Magnitude > 1e-3 then
				local axis = aimAxis.Unit
				local upHint = tool.Grip.UpVector
				if math.abs(upHint:Dot(axis)) > 0.99 then
					upHint = sightCF.UpVector -- aim axis runs along the weapon's up; any stable hint works
				end
				if math.abs(upHint:Dot(axis)) > 0.99 then
					upHint = if math.abs(axis.Y) < 0.9 then Vector3.yAxis else Vector3.xAxis
				end
				sightRel = CFrame.lookAt(sightCF.Position, sightCF.Position + aimAxis, upHint)
			end
		end
	end

	local entry = {
		Right = nil :: any,
		Left = nil :: PosedHand?,
		Sway = Sway.new(),
		Handle = handle,
		Posed = false,
		SightRel = sightRel,
		-- Never parented -- TweenService tweens a plain Instance's property
		-- fine without one; this is purely an internal number holder.
		AdsValue = Instance.new("NumberValue"),
		AdsTarget = 0,
		AdsTween = nil,
		OriginalWeldC0 = {},
	} :: ActiveEntry
	entry.Right = {
		AttRel = handleInverse * rightGrip.WorldCFrame,
		Arm = rightArm,
		Cache = ArmRig.Capture(rightArm),
		TransparencyConnection = watchTransparency(entry, rightArm.Arm),
	}

	local leftGrip = findGripAttachment(tool, Viewmodel.LEFT_GRIP_NAME)
	if leftGrip then
		local leftArm = ArmRig.Find(character, "Left")
		if leftArm then
			entry.Left = {
				AttRel = handleInverse * leftGrip.WorldCFrame,
				Arm = leftArm,
				Cache = ArmRig.Capture(leftArm),
				TransparencyConnection = watchTransparency(entry, leftArm.Arm),
			}
		end
	end

	-- Stepped, NOT RenderStepped: the animation system writes every
	-- Motor6D.Transform right before Stepped fires, so this is the one spot
	-- where our Transform override deterministically lands last (see
	-- ArmRig.luau). NOTE Stepped's dt is the SECOND argument.
	entry.Connection = RunService.Stepped:Connect(function(_runningTime: number, dt: number)
		if not (handle.Parent and rightArm.Torso.Parent) then
			-- The tool/character was destroyed out from under us -- clean up
			-- via Unequip's own restore path rather than erroring every frame.
			Viewmodel.Unequip(tool, character)
			return
		end

		local camera = Workspace.CurrentCamera
		local isFirstPerson = camera ~= nil
			and (camera.CFrame.Position - camera.Focus.Position).Magnitude <= FIRST_PERSON_MAX_DISTANCE

		if not isFirstPerson then
			unpose(entry) -- no-op if already unposed
			return
		end
		entry.Posed = true

		-- Smooth hip <-> ADS blend (only weapons with a Sight ever aim). A
		-- new tween is only started when the target actually flips -- eases
		-- from wherever AdsValue currently sits (mid-tween or settled) to
		-- the new target, so rapid re-toggling retargets smoothly instead of
		-- snapping or stacking tweens.
		local adsTarget = if aiming and entry.SightRel then 1 else 0
		if entry.AdsTarget ~= adsTarget then
			entry.AdsTarget = adsTarget
			if entry.AdsTween then
				entry.AdsTween:Cancel()
			end
			local duration = if adsTarget > 0.5 then ADS_IN_TIME else ADS_OUT_TIME
			local tween = TweenService:Create(
				entry.AdsValue,
				TweenInfo.new(duration, ADS_EASING_STYLE, Enum.EasingDirection.Out),
				{ Value = adsTarget }
			)
			entry.AdsTween = tween
			tween:Play()
		end
		local ads = entry.AdsValue.Value

		local swayCFrame = entry.Sway:Update(dt, humanoid)
		if ads > 1e-3 then
			-- Steady the weapon while aiming (fade most of the sway/bob out).
			swayCFrame = CFrame.identity:Lerp(swayCFrame, 1 - ADS_SWAY_FACTOR * ads)
		end

		-- Root of the whole chain: the camera-relative grip frame, then the
		-- Handle placed in it exactly the way Tool.Grip says it sits in a
		-- hand (see WEAPON ORIENTATION in the module doc comment). Grip is
		-- read live so grip edits show up immediately.
		local swayedCamera = camera.CFrame * swayCFrame
		local gripFrame = swayedCamera * WEAPON_CAMERA_OFFSET
		local extraOffset = tool:GetAttribute(GRIP_OFFSET_ATTRIBUTE)
		if typeof(extraOffset) == "CFrame" then
			gripFrame = gripFrame * extraOffset
		end
		local desiredHandle = gripFrame * tool.Grip:Inverse()

		local sightRel = entry.SightRel
		if sightRel and ads > 1e-3 then
			-- ADS pose: solve the Handle CFrame that puts the sight frame
			-- (built at equip from Sight/SightEnd -- see the module doc
			-- comment) dead-center, ADS_SIGHT_DISTANCE in front of the
			-- (swayed) camera and rotation-aligned with it, then blend the
			-- hip pose toward it. The arms + weld all follow desiredHandle,
			-- so the hands ride the weapon up to the eye automatically.
			local adsHandle = swayedCamera * CFrame.new(0, 0, -ADS_SIGHT_DISTANCE) * sightRel:Inverse()
			desiredHandle = desiredHandle:Lerp(adsHandle, ads)
		end

		-- Pole vectors are defined camera-locally (so elbows keep bending
		-- down-and-out relative to the view) and resolved to world here.
		-- The camera CFrame is also passed so each arm over-stretches its
		-- near (cut) end behind the view plane -- never visible on screen.
		-- Each arm's virtual shoulder anchor hangs from the (swayed) camera
		-- at forearm height (ShoulderOffset + the dynamic ElbowOffset's
		-- position shift) -- see the field comments above / ArmRig.PoseArm.
		local predictedRightArm = ArmRig.PoseArm(
			entry.Right.Arm,
			entry.Right.Cache,
			desiredHandle * entry.Right.AttRel,
			Viewmodel.RightElbowOffset,
			camera.CFrame:VectorToWorldSpace(Viewmodel.RightElbowPole),
			camera.CFrame,
			swayedCamera:PointToWorldSpace(Viewmodel.RightShoulderOffset + Viewmodel.RightElbowOffset.Position)
		)
		local left = entry.Left
		if left then
			ArmRig.PoseArm(
				left.Arm,
				left.Cache,
				desiredHandle * left.AttRel,
				Viewmodel.LeftElbowOffset,
				camera.CFrame:VectorToWorldSpace(Viewmodel.LeftElbowPole),
				camera.CFrame,
				swayedCamera:PointToWorldSpace(Viewmodel.LeftShoulderOffset + Viewmodel.LeftElbowOffset.Position)
			)
		end

		-- Actually move the tool: solve the engine's own RightGrip weld
		-- (Handle = Arm.CFrame * C0 * C1:Inverse()) so the Handle lands
		-- exactly on desiredHandle, using the arm CFrame we JUST solved
		-- (reading Arm.CFrame back would be a frame stale).
		local weld = findGripWeld(entry)
		if weld then
			if entry.OriginalWeldC0[weld] == nil then
				entry.OriginalWeldC0[weld] = weld.C0
			end
			weld.C0 = predictedRightArm:Inverse() * desiredHandle * weld.C1
		end

		-- Keep the posed arms visible (the watch connections catch the
		-- engine's own writes; this catches the very first posed frame).
		entry.Right.Arm.Arm.LocalTransparencyModifier = 0
		if left then
			left.Arm.Arm.LocalTransparencyModifier = 0
		end
	end)

	active[tool] = entry
end

function Viewmodel.Unequip(tool: Tool, _character: Model)
	local entry = active[tool]
	if not entry then
		return
	end
	active[tool] = nil
	entry.Connection:Disconnect()
	unpose(entry)
	entry.Right.TransparencyConnection:Disconnect()
	if entry.Left then
		entry.Left.TransparencyConnection:Disconnect()
	end
	if entry.AdsTween then
		entry.AdsTween:Cancel()
	end
	entry.AdsValue:Destroy()
end

return Viewmodel
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">ArmRig</string>
              <string name="Source"><![CDATA[--!optimize 2
--[[
	Viewmodel/ArmRig.luau
	R6-specific single-segment arm stretch. Confirmed via live inspection
	that this project's player characters are R6 (Torso -[Shoulder
	Motor6D]-> "Right Arm"/"Left Arm" -- ONE block part, no elbow/wrist and
	no separate Hand part at all). Stretches that single Arm part
	("telescoping" -- there's no elbow to bend anyway) from a fixed
	body-relative pivot to reach an arbitrary target grip CFrame.

	HOW THE JOINT IS DRIVEN -- Motor6D.Transform, never C0/C1:
	A Motor6D places its child as
	    Part1.CFrame = Part0.CFrame * C0 * Transform * C1:Inverse()
	and the `Transform` term is REWRITTEN BY THE ANIMATION SYSTEM every
	frame, right before RunService.Stepped fires. An earlier version of
	this file wrote Shoulder.C0 per frame instead -- the running idle/walk
	AnimationTracks kept stacking their own Transform on top of our moved
	C0, so the two systems fought each other and the arms visibly spazzed
	out. (Measured live: with animations running, Torso*C0*C1:Inverse()
	differs from the real Arm CFrame by ~1 stud -- that difference IS the
	animation's Transform.) The fix: leave C0/C1 alone entirely and write
	`Transform` itself from a Stepped callback, which runs AFTER the
	animator's write each frame, so our value simply wins while posed --
	no fighting, and Restore just zeroes Transform and the animator
	seamlessly takes back over next frame.

	Because we solve the full formula for Transform (given the world-space
	Arm CFrame we want), C1 cancels out exactly -- so unlike the old C0
	approach, C1's perpendicular seating offset needs no special quadratic
	handling. The only geometry that matters:
	 - The virtual shoulder anchor the two-bone elbow solve hangs from:
	   normally a caller-supplied CAMERA-hung point (PoseArm's anchorPos --
	   see Viewmodel.RightShoulderOffset), falling back to the rig's real
	   shoulder socket (Torso.CFrame * C0).Position -- see FOREARM below.
	 - The grip point sits GRIP_INSET studs in from the arm's far tip
	   along the bone axis (the "half a stud inside the hand" rule -- R6
	   has no separate Hand part, so the inset applies to the Arm itself).
	 - The socket sits DistFromTop studs down from the arm's near tip
	   (measured from the rig's own C1 axial offset at Capture time), so
	   the stretched arm still visually "hangs from" the shoulder.
	So the base stretched length is simply
	    L = |gripPos - elbowPos| + DistFromTop + GRIP_INSET
	(then possibly extended further to hide the near tip off-screen -- see
	PoseArm's hideNearTipFrom) and the arm's center sits (L/2 - GRIP_INSET)
	back from the grip along the bone direction. Any length works: the grip
	end always lands exactly on target, extra length only pushes the unseen
	near end further back.

	THE ARM IS TREATED AS A FOREARM, WITH A TWO-BONE IK ELBOW: a whole
	2-stud arm pivoting rigidly at a fixed point reads as a stiff,
	straight-armed point -- and glitches badly looking down, when the grip
	drops far below the fixed pivot and the brick swings near-vertical. So
	PoseArm runs the standard two-segment viewmodel solve instead: a
	virtual BICEP (VIRTUAL_BICEP_LENGTH, never rendered) from the virtual
	shoulder anchor to an elbow, a virtual FOREARM (VIRTUAL_FOREARM_LENGTH)
	from that elbow to the grip, elbow position solved by law of cosines and
	bent toward a caller-supplied pole vector -- and then renders ONLY the
	forearm segment with the single R6 brick. The bicep's whole job is
	deciding where the elbow is, so the forearm's angle changes naturally
	as the grip moves (looking down bends the elbow instead of producing a
	vertical full-arm point). When the grip is out of reach the forearm
	segment stretches to cover the difference, keeping the solve valid at
	any distance. The driven joint is still the Shoulder Motor6D (R6 has
	no elbow joint) -- the "elbow" exists only in the math. On top of the
	IK, PoseArm's elbowOffset parameter (dynamic, per-frame) shifts the
	virtual shoulder anchor (position) and/or swings the posed forearm
	around the planted hand (rotation).

	BONE AXIS: the arm's long dimension is local Y (Size = (1, 2, 1),
	confirmed live) and hangs DOWN (local -Y) from the shoulder at rest,
	so the pose aims local -Y from the socket toward the grip.
]]

local GRIP_INSET = 0.5 -- studs inward from the arm's far tip -- see module doc comment
local RESIZE_AXIS = Vector3.yAxis -- the arm's long (bone) dimension, for Size

-- Cross-section thickness (studs) the posed arm is forced to in first
-- person, overriding the rig's native (1, _, 1) girth -- purely cosmetic,
-- doesn't affect the IK/length solve above. Applied on both non-bone axes
-- (X and Z) in the resize step below.
local ARM_THICKNESS = 0.75

-- Two-bone IK segment lengths (studs): the virtual bicep (shoulder ->
-- elbow, never rendered) and the virtual forearm (elbow -> grip; the
-- rendered brick's nominal reach -- it stretches beyond this when the grip
-- is farther than both segments combined). Their sum is the arm's
-- comfortable reach. TUNE ME by feel: longer bicep = the elbow swings
-- wider as you look around; longer forearm = straighter-looking hold.
local VIRTUAL_BICEP_LENGTH = 1.25
local VIRTUAL_FOREARM_LENGTH = 1.75

-- Default arm offset (see PoseArm's elbowOffset parameter). Identity: the
-- two-bone solve already produces the natural dropped-elbow forearm look
-- on its own, so this is purely an artistic override -- reassign
-- Viewmodel.RightElbowOffset / .LeftElbowOffset (read every frame) to
-- shift the virtual shoulder anchor (position) or swing the posed forearm
-- around the planted hand (rotation).
local DEFAULT_ELBOW_OFFSET = CFrame.identity

-- How far behind the hide camera's view plane the arm's near tip must sit
-- (see PoseArm's hideNearTipFrom) -- generous enough that the 1-stud-wide
-- tip face can't clip through the near plane at the screen edges.
local HIDE_NEAR_TIP_MARGIN = 0.5

-- Never stretch past this, even to hide the near tip -- an arm nearly
-- perpendicular to the view direction would otherwise ask for an absurd
-- (toward-infinite) length.
local MAX_ARM_LENGTH = 20

-- Solved lengths are rounded UP to this step. The grip end lands exactly on
-- target for ANY length (only the hidden near tip moves), so quantizing
-- costs nothing visually -- and it stops the per-frame sway/bob length
-- wobble from forcing a Size write (a physics-geometry rebuild) every
-- single frame.
local LENGTH_QUANTUM = 0.1

local ArmRig = {}

ArmRig.DEFAULT_ELBOW_OFFSET = DEFAULT_ELBOW_OFFSET

-- Builds a rotation-only CFrame whose LOCAL +Y axis points along world
-- direction `yDir`, using `upHint` to resolve roll around that axis (must
-- not be near-parallel to yDir -- callers should pick a fallback hint when
-- it is, see PoseArm).
local function cframeWithLocalYAlong(yDir: Vector3, upHint: Vector3): CFrame
	yDir = yDir.Unit
	local xDir = upHint:Cross(yDir)
	if xDir.Magnitude < 1e-4 then
		xDir = (math.abs(yDir.Y) < 0.9 and Vector3.yAxis or Vector3.xAxis):Cross(yDir)
	end
	xDir = xDir.Unit
	local zDir = xDir:Cross(yDir).Unit
	return CFrame.fromMatrix(Vector3.zero, xDir, yDir, zDir)
end

export type ArmSide = {
	Shoulder: Motor6D, -- Part0 = Torso, Part1 = Arm
	Torso: BasePart,
	Arm: BasePart,
}

export type ArmCache = {
	ShoulderC0: CFrame, -- read-only reference (never rewritten by this module)
	ShoulderC1: CFrame, -- read-only reference (never rewritten by this module)
	ArmSize: Vector3,
	ArmLength: number,
	-- Axial distance from the arm's near (shoulder-end) tip to the
	-- shoulder attachment point, measured from the rig's own C1 at
	-- Capture time (= 0.5 on a standard R6 rig). Kept fixed as the arm
	-- stretches, so the shoulder end stays visually seated in the torso.
	DistFromTop: number,
	Massless: boolean,
}

-- Finds the named parts/joint for one arm ("Right" or "Left") on a
-- character, or nil if any piece is missing (e.g. not an R6 rig).
function ArmRig.Find(character: Model, side: "Right" | "Left"): ArmSide?
	local torso = character:FindFirstChild("Torso") :: BasePart?
	local arm = character:FindFirstChild(side .. " Arm") :: BasePart?
	if not (torso and arm) then
		return nil
	end
	-- R6 parents the joint under Torso (the parent side), unlike R15's
	-- convention of parenting under the child limb -- check both so this
	-- doesn't silently break if that ever changes.
	local shoulder = (torso:FindFirstChild(side .. " Shoulder") or arm:FindFirstChild(side .. " Shoulder")) :: Motor6D?
	if not shoulder then
		return nil
	end
	return { Shoulder = shoulder, Torso = torso, Arm = arm }
end

-- Snapshots everything PoseArm is about to touch, so Restore can put it back
-- exactly. Call once per Equip, before the first PoseArm call.
function ArmRig.Capture(arm: ArmSide): ArmCache
	local armLength = math.max(arm.Arm.Size:Dot(RESIZE_AXIS), 1e-3)
	return {
		ShoulderC0 = arm.Shoulder.C0,
		ShoulderC1 = arm.Shoulder.C1,
		ArmSize = arm.Arm.Size,
		ArmLength = armLength,
		DistFromTop = armLength / 2 - arm.Shoulder.C1.Position.Y,
		Massless = arm.Arm.Massless,
	}
end

-- Undoes Capture -- call once when unposing (leaving first person) or on
-- Unequip. Zeroing Transform hands the joint straight back to the
-- animation system, which rewrites it next frame anyway. Safe to call on a
-- since-destroyed character's parts (property writes on a destroyed
-- Instance just no-op), so callers don't need a validity check.
function ArmRig.Restore(arm: ArmSide, cache: ArmCache)
	arm.Arm.Size = cache.ArmSize
	arm.Arm.Massless = cache.Massless
	arm.Shoulder.Transform = CFrame.identity
end

-- The actual "telescoping" stretch + aim. Call every frame from a
-- RunService.Stepped callback (NOT RenderStepped -- the write must land
-- after the animation system's per-frame Transform write, see the module
-- doc comment) while posed. Positions/orients the Arm part so the INSET
-- grip point ends up exactly at targetGripCFrame's position, stretching
-- from the fixed elbow pivot (forearm treatment -- see module doc comment).
--
-- Returns the world-space Arm CFrame it solved for -- callers that need to
-- place other things relative to the arm this same frame (the tool weld,
-- see Viewmodel/init.luau) must use this predicted value, NOT read
-- arm.Arm.CFrame back (which is one frame stale -- the engine applies the
-- Transform we just wrote after Stepped returns).
-- elbowOffset (optional, defaults to DEFAULT_ELBOW_OFFSET): fully dynamic --
-- pass a different value any frame. Its POSITION shifts the virtual SHOULDER
-- anchor the two-bone solve hangs from; its ROTATION is applied about the
-- GRIP POINT, so the hand stays planted on the weapon while the elbow end
-- swings -- an artistic override on top of the IK.
--
-- poleDir (optional, world-space): the IK pole vector -- which way the
-- virtual elbow bends when the arm isn't straight. Defaults to torso-down;
-- callers should pass a down-and-outward hint per arm (see
-- Viewmodel.RightElbowPole / .LeftElbowPole).
--
-- hideNearTipFrom (optional, pass the camera's CFrame): when given, the arm
-- is stretched extra far back so its near (cut) tip always sits behind that
-- view plane -- off-screen no matter how the pivot/angles work out.
--
-- anchorPos (optional, world-space): where the virtual shoulder hangs. The
-- viewmodel passes a CAMERA-hung point at forearm height (see
-- Viewmodel.RightShoulderOffset) so the rendered forearm visibly rises from
-- LOW on the screen and follows the camera's pitch -- anchoring at the rig's
-- real shoulder socket made the arms appear to originate up at shoulder/body
-- height instead of at the solved elbow. When nil, falls back to that real
-- socket. NOTE: when anchorPos is given, the caller is expected to have
-- already baked elbowOffset.Position into it (camera-locally -- see
-- Viewmodel/init.luau); only the fallback path applies it here (torso-local).
function ArmRig.PoseArm(
	arm: ArmSide,
	cache: ArmCache,
	targetGripCFrame: CFrame,
	elbowOffset: CFrame?,
	poleDir: Vector3?,
	hideNearTipFrom: CFrame?,
	anchorPos: Vector3?
): CFrame
	local offset = elbowOffset or DEFAULT_ELBOW_OFFSET

	-- 1. The virtual shoulder anchor: the caller's camera-hung point, or the
	-- rig's real shoulder socket (from the ORIGINAL, never-touched C0) plus
	-- the caller's torso-local shift.
	local shoulderPos = if anchorPos
		then anchorPos
		else (arm.Torso.CFrame * cache.ShoulderC0).Position
			+ arm.Torso.CFrame:VectorToWorldSpace(offset.Position)
	local gripPos = targetGripCFrame.Position
	local toGrip = gripPos - shoulderPos
	local dist = toGrip.Magnitude
	if dist < 1e-3 then
		return arm.Arm.CFrame -- grip on top of the shoulder; nothing sane to solve
	end
	local reachDir = toGrip / dist

	-- 2. Two-bone IK for the virtual elbow (law of cosines, the standard
	-- two-segment viewmodel solve -- see module doc comment): the elbow
	-- sits `a` along the shoulder->grip axis and `h` off it, bent toward
	-- the pole. When the grip is out of reach the virtual forearm STRETCHES
	-- (to dist - bicep), which collapses h to 0 -- a straight arm -- rather
	-- than the solve failing.
	local bicep = VIRTUAL_BICEP_LENGTH
	local forearm = math.max(VIRTUAL_FOREARM_LENGTH, dist - bicep)
	local a = math.clamp((bicep * bicep - forearm * forearm + dist * dist) / (2 * dist), -bicep, bicep)
	local h = math.sqrt(math.max(bicep * bicep - a * a, 0))
	local elbowPos = shoulderPos + reachDir * a
	if h > 1e-4 then
		local pole = poleDir or -arm.Torso.CFrame.UpVector
		local bend = pole - reachDir * pole:Dot(reachDir) -- pole, perpendicular to the reach axis
		if bend.Magnitude > 1e-3 then
			elbowPos += bend.Unit * h
		end
	end

	-- 3. The rendered brick is the FOREARM only, elbow -> grip (the bicep
	-- is never drawn; its whole job was deciding where the elbow is).
	local toGripFromElbow = gripPos - elbowPos
	local forearmDist = toGripFromElbow.Magnitude
	if forearmDist < 1e-3 then
		return arm.Arm.CFrame -- grip on top of the elbow; degenerate
	end
	local aimDir = toGripFromElbow / forearmDist

	-- 4. Aim: point the bone axis from the elbow at the grip (position wins
	-- over the target's own rotation -- a floating gun reads as far more
	-- broken than a slightly-off wrist roll; the target's UpVector only
	-- resolves roll). Then apply the elbow offset's rotation ON TOP, about
	-- the grip point.
	local upHint = targetGripCFrame.UpVector
	if math.abs(upHint:Dot(aimDir)) > 0.99 then
		upHint = Vector3.yAxis
	end
	-- Bone axis is local -Y, so local +Y must point opposite the aim.
	local rotation = cframeWithLocalYAlong(-aimDir, upHint) * offset.Rotation
	local boneDir = -rotation.YVector -- where local -Y ACTUALLY points after the offset

	-- 5. Length: elbow-to-grip distance plus the fixed seatings at both
	-- ends (see module doc comment), then extended as needed to bury the
	-- near tip behind the hide view plane, capped, and rounded up to
	-- LENGTH_QUANTUM (the grip end is exact for any length -- only the
	-- hidden near end moves).
	local newLength = forearmDist + cache.DistFromTop + GRIP_INSET
	if hideNearTipFrom then
		local look = hideNearTipFrom.LookVector
		local along = boneDir:Dot(look)
		if along > 1e-2 then
			-- Near tip sits (L - GRIP_INSET) back from the grip along
			-- -boneDir; solve its depth along `look` <= -MARGIN for L.
			local gripDepth = (gripPos - hideNearTipFrom.Position):Dot(look)
			local hideLength = GRIP_INSET + (gripDepth + HIDE_NEAR_TIP_MARGIN) / along
			newLength = math.max(newLength, hideLength)
		end
	end
	newLength = math.clamp(newLength, 1e-3, MAX_ARM_LENGTH)
	newLength = math.ceil(newLength / LENGTH_QUANTUM) * LENGTH_QUANTUM

	-- 6. Resize -- only when it actually changed (Size writes are much more
	-- expensive than CFrame-ish writes: they rebuild physics geometry;
	-- that's what LENGTH_QUANTUM is for) -- and keep the stretched arm from
	-- changing the character's physics mass.
	local keep = Vector3.one - RESIZE_AXIS
	local newSize = Vector3.new(ARM_THICKNESS, 0, ARM_THICKNESS) * keep + RESIZE_AXIS * newLength
	if (arm.Arm.Size - newSize).Magnitude > 1e-3 then
		arm.Arm.Size = newSize
	end
	arm.Arm.Massless = true

	-- 7. Place: grip point exactly on target, the rest of the arm running
	-- back along the final (offset-rotated) bone direction.
	local armCFrame = CFrame.new(gripPos - boneDir * (newLength / 2 - GRIP_INSET)) * rotation

	-- 8. Solve the Motor6D placement formula
	-- (Arm = Torso * C0 * Transform * C1:Inverse()) for Transform. C1
	-- cancels exactly, so no perpendicular-offset special-casing needed.
	arm.Shoulder.Transform = cache.ShoulderC0:Inverse() * arm.Torso.CFrame:Inverse() * armCFrame * cache.ShoulderC1

	return armCFrame
end

return ArmRig
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Sway</string>
              <string name="Source"><![CDATA[--!optimize 2
--[[
	Viewmodel/Sway.luau
	Procedural (non-keyframed) motion layered on top of the attachment-solved
	base grip pose: mouse-look sway, walk-cycle bob, and idle breathing. Pure
	offset generator -- returns a CFrame meant to be composed onto the solved
	target hand CFrame (targetHandCFrame * offset), never touches the rig
	directly, so it has no idea ArmRig/Motor6Ds even exist.

	Deliberately driven by REAL (undilated) dt, not this game's dilated
	Heartbeat clock -- this is camera-relative rendering polish, not gameplay
	simulation, and should feel the same regardless of the world/personal
	time ratio (unlike e.g. walk speed, which this game deliberately DOES
	dilate -- see MovementController.luau).
]]

local UserInputService = game:GetService("UserInputService")

local Sway = {}
Sway.__index = Sway

-- Tuning -- studs/radians. Untested against the actual game feel; retune
-- once this is visible in Studio.
local MOUSE_SWAY_STRENGTH = 0.006 -- radians of tilt per pixel of mouse delta
local MOUSE_SWAY_SMOOTHING = 8 -- higher = snappier follow, lower = floatier lag
local BOB_WALK_FREQUENCY = 8 -- bob cycles per second at full walk speed
local BOB_WALK_AMPLITUDE = 0.03 -- studs
local BOB_FADE_IN_SPEED = 16 -- studs/s of movement to reach full bob amplitude
local BREATH_FREQUENCY = 0.35 -- cycles per second
local BREATH_AMPLITUDE = 0.015 -- studs

function Sway.new()
	return setmetatable({
		_smoothedSway = Vector2.zero, -- current smoothed mouse-sway tilt
		_bobPhase = 0,
	}, Sway)
end

export type Sway = typeof(Sway.new())

-- dt: real (undilated) seconds since last call. Returns a CFrame to compose
-- onto the base grip pose (basePose * sway:Update(...)).
function Sway:Update(dt: number, humanoid: Humanoid?): CFrame
	-- Mouse-look sway: tilt opposite the recent mouse delta, smoothed so it
	-- springs back to center instead of snapping frame-to-frame.
	local delta = UserInputService:GetMouseDelta()
	local targetSway = Vector2.new(-delta.Y, -delta.X) * MOUSE_SWAY_STRENGTH
	local alpha = math.clamp(MOUSE_SWAY_SMOOTHING * dt, 0, 1)
	self._smoothedSway = self._smoothedSway:Lerp(targetSway, alpha)

	-- Walk bob: advance a phase accumulator at a rate proportional to actual
	-- move speed (not just "are we moving"), and fade amplitude in/out with
	-- speed too so starting/stopping isn't a hard cut.
	local speed = 0
	if humanoid then
		speed = humanoid.MoveDirection.Magnitude * humanoid.WalkSpeed
	end
	self._bobPhase += dt * BOB_WALK_FREQUENCY
	local bobStrength = math.clamp(speed / BOB_FADE_IN_SPEED, 0, 1)
	local bobY = math.sin(self._bobPhase * math.pi * 2) * BOB_WALK_AMPLITUDE * bobStrength
	local bobX = math.cos(self._bobPhase * math.pi) * BOB_WALK_AMPLITUDE * 0.5 * bobStrength

	-- Idle breathing: always-on, tiny, so the viewmodel never looks
	-- perfectly frozen even standing still.
	local breath = math.sin(os.clock() * BREATH_FREQUENCY * math.pi * 2) * BREATH_AMPLITUDE

	return CFrame.Angles(self._smoothedSway.X, self._smoothedSway.Y, 0) * CFrame.new(bobX, bobY + breath, 0)
end

return Sway
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">WeaponEffects</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	WeaponEffects (client, purely cosmetic)
	Renders one-shot weapon VFX broadcast by the server over VisualOffload.
	This exists because ParticleEmitter:Emit() is a method call and method
	calls never replicate -- the server can't burst particles for anyone, so
	weapon modules (see src/server/Weapons/Railgun.luau) broadcast the shot
	instead and every client emits locally. Self-registers its listeners at
	require time (no .start()), same as AmmoState.luau.

	"MuzzleBlast" payload (server -> all clients):
	 - Template: Instance -- the effect template to clone (e.g. the Tool's
	   "Flash" part); sent by reference, resolves to this client's replica.
	   May be a single BasePart, a Model, or a Folder of emitter parts.
	 - Origin: Vector3, Direction: Vector3 -- the projectile's OWN spawn
	   ray (server-resolved), so the effect sits exactly on the bullet path.
	 - Distance: number? -- studs along that ray to place the effect
	   (default DEFAULT_BLAST_DISTANCE).
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualOffload = require(Shared.VisualOffload)

local WeaponEffects = {}

local DEFAULT_BLAST_DISTANCE = 8
local DEFAULT_EMIT_COUNT = 20
local MIN_BLAST_LIFETIME = 0.5 -- floor for the cleanup delay if no ParticleEmitter reports a Lifetime

-- The template's own "facing" CFrame before repositioning -- used to compute
-- ONE rigid delta transform applied to every BasePart in the clone, so the
-- effect works regardless of whether the template is a single Part, a Model
-- (multiple parts), or a Folder grouping several emitter parts: BasePart ->
-- its own CFrame; Model -> its computed pivot; Folder (no pivot concept) ->
-- its first descendant BasePart's CFrame.
local function referenceCFrame(instance: Instance): CFrame?
	if instance:IsA("BasePart") then
		return instance.CFrame
	end
	if instance:IsA("Model") then
		return instance:GetPivot()
	end
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("BasePart") then
			return descendant.CFrame
		end
	end
	return nil
end

-- Clones the template, rigidly moves the CLONE (never the original) onto the
-- target CFrame, bursts every ParticleEmitter under it by its own EmitCount
-- attribute (default DEFAULT_EMIT_COUNT), and Debris-cleans it after the
-- longest emitter Lifetime so already-emitted particles finish fading
-- naturally. Every JointInstance and Constraint in the clone is destroyed
-- first: a cloned joint keeps referencing whatever EXTERNAL part the
-- ORIGINAL template was attached to (the real Handle/character, not a clone
-- of it), and an anchored clone rigidly jointed to an unanchored character
-- snaps the character to the blast position, rotated by the joint's
-- authored offset, and freezes it there. The class checks are the BASE
-- classes deliberately: Studio's own weld tools create ManualWeld/Snap,
-- for which IsA("Weld") is FALSE (they're JointInstance siblings of Weld,
-- not subclasses) -- an earlier version filtered Weld/WeldConstraint/
-- Motor6D by name and let a ManualWeld through, causing exactly that
-- teleport/rotate/freeze glitch. IsA("JointInstance") covers Weld,
-- ManualWeld, Snap, Motor, Motor6D, Glue; IsA("Constraint") covers
-- WeldConstraint, RigidConstraint, and every other constraint type -- none
-- of which a fire-and-forget VFX clone ever needs.
local function playBlast(template: Instance, targetCFrame: CFrame)
	local from = referenceCFrame(template)
	if not from then
		return -- no BasePart anywhere in the template -- nothing to place/emit from
	end
	local delta = targetCFrame * from:Inverse()

	local blast = template:Clone()
	local parts = if blast:IsA("BasePart") then { blast } else {}
	for _, descendant in blast:GetDescendants() do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		elseif descendant:IsA("JointInstance") or descendant:IsA("Constraint") then
			descendant:Destroy()
		end
	end
	for _, part in parts do
		part.CFrame = delta * part.CFrame
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
	end
	blast.Parent = Workspace

	local lifetime = MIN_BLAST_LIFETIME
	for _, child in blast:GetDescendants() do
		if child:IsA("ParticleEmitter") then
			child:Emit(child:GetAttribute("EmitCount") or DEFAULT_EMIT_COUNT)
			lifetime = math.max(lifetime, child.Lifetime.Max)
		end
	end
	Debris:AddItem(blast, lifetime)
end

VisualOffload.On("MuzzleBlast", function(data)
	if typeof(data) ~= "table" then
		return
	end
	local template = data.Template
	local origin = data.Origin
	local direction = data.Direction
	if typeof(template) ~= "Instance" or typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then
		return
	end
	if direction.Magnitude < 1e-3 then
		return -- degenerate ray; also guards the Unit below
	end
	direction = direction.Unit
	local distance = if typeof(data.Distance) == "number" then data.Distance else DEFAULT_BLAST_DISTANCE

	local position = origin + direction * distance
	-- ParticleEmitters emit along their part's +Y by default (EmitDirection
	-- = Top), so the template's UP axis is what belongs on the shot ray --
	-- aligning its LookVector left the whole effect pointing 90 degrees off
	-- the bullet path. lookAt puts -Z on the ray; the -90-degree X roll then
	-- maps +Y onto it (the reference part lands EXACTLY on this frame, so
	-- this holds regardless of how the template was oriented at authoring
	-- time). The explicit up hint keeps lookAt stable when firing straight
	-- up/down (its default +Y up hint degenerates there).
	local upHint = if math.abs(direction.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local target = CFrame.lookAt(position, position + direction, upHint) * CFrame.Angles(-math.pi / 2, 0, 0)
	playBlast(template, target)
end)

return WeaponEffects
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
