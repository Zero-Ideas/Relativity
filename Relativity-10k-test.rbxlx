      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">ChunkManager</string>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	ChunkManager.luau
	Spatial chunking system. Divides the world into a grid of chunks and tracks
	which entities are inside each one. Every chunk owns a local TimeScale that
	multiplies with the Heartbeat's global time scale, so time inside one chunk
	can run slower or faster than the rest of the world (1 = global speed,
	0.5 = half speed, 0 = frozen).

	Chunks also carry a Loaded flag. When ChunkManager.FreezeUnloaded is true
	(default), entities inside unloaded chunks are skipped by the entity update
	loop and excluded from hitbox/projectile queries — this is the "don't hitbox
	check chunks nobody is using" optimization.

	Chunking is on the XZ plane by default (Y ignored); set ChunkManager.UseY
	= true before creating any chunks for full 3D chunking.

	API summary:
	 ChunkManager.GetChunk(worldPos) -> Chunk?
	 ChunkManager.GetOrCreateChunk(worldPos) -> Chunk
	 ChunkManager.GetTimeScaleAt(worldPos) -> number
	 ChunkManager.SetTimeScaleAt(worldPos, scale)
	 ChunkManager.SetTimeScaleInRadius(worldPos, radius, scale)
	 ChunkManager.GetChunkKeysInRadius(worldPos, radius) -> { Vector3 }
	 ChunkManager.SetTimeScaleForKey(key, scale, persistent?)
	 ChunkManager.AddTimeScaleZone(id, position, radius, scale)
	 ChunkManager.RemoveTimeScaleZone(id)
	 ChunkManager.SetLoadedAt(worldPos, loaded)
	 ChunkManager.IsActiveAt(worldPos) -> boolean
	 ChunkManager.GetEntitiesInChunk(worldPos) -> {Entity}
	 ChunkManager.GetEntitiesInRadius(worldPos, radius, options?) -> {Entity}
	 ChunkManager.GetEntitiesInBox(cframe, size, options?) -> {Entity}
	 ChunkManager.ConfigureAutoLoad({Enabled, Radius?, Interval?})
	 ChunkManager.EnableReplication(options?)  -- server: broadcast, client: receive
	 ChunkManager.GetAllChunks() / GetStats()

	 Chunk fields: Key (chunk coords), TimeScale, Loaded, Persistent,
	   Entities (set), EntityCount, Origin (world min corner)
]]

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Heartbeat = require(script.Parent.Heartbeat)

local ChunkManager = {}
ChunkManager.ChunkSize = 64 -- studs per chunk edge
ChunkManager.FreezeUnloaded = true -- skip updates/queries in unloaded chunks
ChunkManager.UseY = false -- 2D (XZ) chunking by default

local chunks: { [Vector3]: any } = {} -- keyed by chunk-coordinate Vector3
local chunkCount = 0
local autoLoadConnection = nil
local timeZones = {} -- ordered oldest -> newest; newest containing zone wins
local timeZonesById = {}
local replicationEnabled = false

--------------------------------------------------------------------------------
-- Chunk lookup
--------------------------------------------------------------------------------

local function toChunkKey(worldPos: Vector3): Vector3
	local size = ChunkManager.ChunkSize
	return Vector3.new(
		math.floor(worldPos.X / size),
		ChunkManager.UseY and math.floor(worldPos.Y / size) or 0,
		math.floor(worldPos.Z / size)
	)
end

local function newChunk(key: Vector3)
	local size = ChunkManager.ChunkSize
	local chunk = {
		Key = key,
		Origin = key * size,
		TimeScale = 1,
		Loaded = true,
		Persistent = false, -- persistent chunks survive becoming empty
		Entities = {}, -- set: [entity] = true
		EntityCount = 0,
	}
	chunks[key] = chunk
	chunkCount += 1
	return chunk
end

local function maybeCollect(chunk)
	-- Drop empty, non-persistent, default-state chunks to keep the grid sparse.
	if chunk.EntityCount == 0 and not chunk.Persistent and chunk.TimeScale == 1 then
		chunks[chunk.Key] = nil
		chunkCount -= 1
	end
end

function ChunkManager.ToChunkKey(worldPos: Vector3): Vector3
	return toChunkKey(worldPos)
end

function ChunkManager.GetChunk(worldPos: Vector3)
	return chunks[toChunkKey(worldPos)]
end

function ChunkManager.GetChunkByKey(key: Vector3)
	return chunks[key]
end

function ChunkManager.GetOrCreateChunk(worldPos: Vector3)
	local key = toChunkKey(worldPos)
	return chunks[key] or newChunk(key)
end

--------------------------------------------------------------------------------
-- Time scale & load state
--------------------------------------------------------------------------------

-- Chunk-local time scale at a position (1 when no chunk exists there).
function ChunkManager.GetTimeScaleAt(worldPos: Vector3): number
	for i = #timeZones, 1, -1 do
		local zone = timeZones[i]
		local offset = worldPos - zone.Position
		if offset:Dot(offset) <= zone.Radius * zone.Radius then
			return zone.Scale
		end
	end
	local chunk = chunks[toChunkKey(worldPos)]
	return chunk and chunk.TimeScale or 1
end

function ChunkManager.GetTimeScaleZones()
	return table.clone(timeZones)
end

local function replicateZone(channel: string, payload)
	if not replicationEnabled or not RunService:IsServer() then
		return
	end
	local VisualOffload = require(script.Parent.VisualOffload)
	VisualOffload.Fire(channel, payload)
end

function ChunkManager.AddTimeScaleZone(id: any, position: Vector3, radius: number, scale: number)
	local existing = timeZonesById[id]
	if existing then
		local index = table.find(timeZones, existing)
		if index then
			table.remove(timeZones, index)
		end
	end
	local zone = {
		Id = id,
		Position = position,
		Radius = math.max(radius, 0),
		Scale = math.max(scale, 0),
	}
	timeZonesById[id] = zone
	table.insert(timeZones, zone)
	replicateZone("TimeZoneUpsert", zone)
	return zone
end

function ChunkManager.RemoveTimeScaleZone(id: any)
	local zone = timeZonesById[id]
	if not zone then
		return
	end
	timeZonesById[id] = nil
	local index = table.find(timeZones, zone)
	if index then
		table.remove(timeZones, index)
	end
	replicateZone("TimeZoneRemove", { Id = id })
end

-- Earliest entry/exit of a radial zone that changes the effective scale along
-- this straight segment. Projectile curvature limits keep the chord error
-- bounded before this function is consulted.
function ChunkManager.GetRadialTimeScaleBoundaryDt(position: Vector3, velocity: Vector3, maxDt: number): number
	local speedSq = velocity:Dot(velocity)
	if speedSq < 1e-8 or #timeZones == 0 then
		return math.huge
	end

	local speed = math.sqrt(speedSq)
	local direction = velocity / speed
	local initialScale = ChunkManager.GetTimeScaleAt(position + direction * 1e-3)
	local candidates = {}
	for _, zone in timeZones do
		local offset = position - zone.Position
		local b = 2 * offset:Dot(velocity)
		local c = offset:Dot(offset) - zone.Radius * zone.Radius
		local discriminant = b * b - 4 * speedSq * c
		if discriminant >= 0 then
			local root = math.sqrt(discriminant)
			local denominator = 2 * speedSq
			local first = (-b - root) / denominator
			local second = (-b + root) / denominator
			if first > 1e-6 and first < maxDt then
				table.insert(candidates, first)
			end
			if second > 1e-6 and second < maxDt then
				table.insert(candidates, second)
			end
		end
	end
	table.sort(candidates)
	local sampleDt = 1e-3 / speed
	for _, candidate in candidates do
		if ChunkManager.GetTimeScaleAt(position + velocity * (candidate + sampleDt)) ~= initialScale then
			return candidate
		end
	end
	return math.huge
end

-- Full effective scale at a position: global * chunk.
function ChunkManager.GetEffectiveTimeScaleAt(worldPos: Vector3): number
	return Heartbeat.GetGlobalTimeScale() * ChunkManager.GetTimeScaleAt(worldPos)
end

-- Scales an already global-dilated dt by the chunk-local rate at a position.
-- Use this in batched per-frame loops (Projectile, Hitbox) that receive dt
-- already multiplied by Heartbeat.GetGlobalTimeScale() and only need the
-- chunk-local factor folded in on top.
function ChunkManager.ScaleDt(dt: number, worldPos: Vector3): number
	return dt * ChunkManager.GetTimeScaleAt(worldPos)
end

function ChunkManager.SetTimeScaleAt(worldPos: Vector3, scale: number)
	return ChunkManager.SetTimeScaleForKey(toChunkKey(worldPos), scale, true)
end

-- Key-based variant used by temporary zone systems that must restore both the
-- previous scale and persistence state without leaking empty default chunks.
function ChunkManager.SetTimeScaleForKey(key: Vector3, scale: number, persistent: boolean?)
	local chunk = chunks[key] or newChunk(key)
	chunk.TimeScale = math.max(scale, 0)
	if persistent ~= nil then
		chunk.Persistent = persistent
	end
	ChunkManager._replicateScale(chunk)
	maybeCollect(chunk)
	return chunk
end

-- Chunk keys whose axis-aligned cells intersect a circular (2D mode) or
-- spherical (3D mode) radius. Public so debug/test visuals can show the exact
-- same discretized zone that simulation uses.
function ChunkManager.GetChunkKeysInRadius(worldPos: Vector3, radius: number): { Vector3 }
	local size = ChunkManager.ChunkSize
	radius = math.max(radius, 0)
	local minY, maxY = 0, 0
	if ChunkManager.UseY then
		minY = math.floor((worldPos.Y - radius) / size)
		maxY = math.floor((worldPos.Y + radius) / size)
	end
	local radiusSq = radius * radius
	local keys = {}
	for x = math.floor((worldPos.X - radius) / size), math.floor((worldPos.X + radius) / size) do
		for z = math.floor((worldPos.Z - radius) / size), math.floor((worldPos.Z + radius) / size) do
			for y = minY, maxY do
				local minPoint = Vector3.new(x * size, if ChunkManager.UseY then y * size else worldPos.Y, z * size)
				local maxPoint = minPoint + Vector3.new(size, if ChunkManager.UseY then size else 0, size)
				local closest = Vector3.new(
					math.clamp(worldPos.X, minPoint.X, maxPoint.X),
					if ChunkManager.UseY then math.clamp(worldPos.Y, minPoint.Y, maxPoint.Y) else worldPos.Y,
					math.clamp(worldPos.Z, minPoint.Z, maxPoint.Z)
				)
				local offset = closest - worldPos
				if offset:Dot(offset) <= radiusSq then
					table.insert(keys, Vector3.new(x, y, z))
				end
			end
		end
	end
	return keys
end

function ChunkManager.SetTimeScaleInRadius(worldPos: Vector3, radius: number, scale: number)
	for _, key in ChunkManager.GetChunkKeysInRadius(worldPos, radius) do
		ChunkManager.SetTimeScaleForKey(key, scale, true)
	end
end

function ChunkManager.SetLoadedAt(worldPos: Vector3, loaded: boolean)
	local chunk = ChunkManager.GetOrCreateChunk(worldPos)
	chunk.Loaded = loaded
	chunk.Persistent = true
end

-- Whether systems should simulate/query at this position right now.
function ChunkManager.IsActiveAt(worldPos: Vector3): boolean
	if not ChunkManager.FreezeUnloaded then
		return true
	end
	local chunk = chunks[toChunkKey(worldPos)]
	return chunk == nil or chunk.Loaded
end

local function isChunkActive(chunk): boolean
	return chunk.Loaded or not ChunkManager.FreezeUnloaded
end
ChunkManager.IsChunkActive = isChunkActive

--------------------------------------------------------------------------------
-- Entity membership (called by the Entity system)
--------------------------------------------------------------------------------

function ChunkManager._addEntity(entity, worldPos: Vector3)
	local chunk = ChunkManager.GetOrCreateChunk(worldPos)
	if not chunk.Entities[entity] then
		chunk.Entities[entity] = true
		chunk.EntityCount += 1
	end
	return chunk
end

function ChunkManager._removeEntity(entity, chunk)
	if chunk and chunk.Entities[entity] then
		chunk.Entities[entity] = nil
		chunk.EntityCount -= 1
		maybeCollect(chunk)
	end
end

-- Moves the entity to the chunk containing worldPos if it changed.
-- Returns the (possibly new) chunk, and whether it changed.
function ChunkManager._updateEntity(entity, currentChunk, worldPos: Vector3)
	local key = toChunkKey(worldPos)
	if currentChunk and currentChunk.Key == key then
		return currentChunk, false
	end
	ChunkManager._removeEntity(entity, currentChunk)
	return ChunkManager._addEntity(entity, worldPos), true
end

--------------------------------------------------------------------------------
-- Spatial queries
--------------------------------------------------------------------------------

export type QueryOptions = {
	IncludeFrozen: boolean?, -- include entities in unloaded/frozen chunks
	Filter: ((entity: any) -> boolean)?,
}

local function sweepChunks(minPos: Vector3, maxPos: Vector3, options: QueryOptions?, visit)
	local size = ChunkManager.ChunkSize
	local includeFrozen = options and options.IncludeFrozen
	local minY, maxY = 0, 0
	if ChunkManager.UseY then
		minY = math.floor(minPos.Y / size)
		maxY = math.floor(maxPos.Y / size)
	end
	for x = math.floor(minPos.X / size), math.floor(maxPos.X / size) do
		for z = math.floor(minPos.Z / size), math.floor(maxPos.Z / size) do
			for y = minY, maxY do
				local chunk = chunks[Vector3.new(x, y, z)]
				if chunk and (includeFrozen or isChunkActive(chunk)) and chunk.EntityCount > 0 then
					visit(chunk)
				end
			end
		end
	end
end

function ChunkManager.GetEntitiesInChunk(worldPos: Vector3)
	local result = {}
	local chunk = chunks[toChunkKey(worldPos)]
	if chunk then
		for entity in chunk.Entities do
			table.insert(result, entity)
		end
	end
	return result
end

function ChunkManager.GetEntitiesInRadius(worldPos: Vector3, radius: number, options: QueryOptions?)
	local result = {}
	local filter = options and options.Filter
	local extent = Vector3.new(radius, radius, radius)
	sweepChunks(worldPos - extent, worldPos + extent, options, function(chunk)
		for entity in chunk.Entities do
			local offset = entity:GetPosition() - worldPos
			if offset.Magnitude <= radius + entity.HitboxRadius then
				if not filter or filter(entity) then
					table.insert(result, entity)
				end
			end
		end
	end)
	return result
end

-- Broad-phase companion for parallel consumers. It returns eligible entities
-- from chunks overlapped by the radius AABB but deliberately performs no
-- per-entity distance math. Callers can snapshot the positions and distribute
-- the independent exact-distance tests to Actors without touching the mutable
-- chunk/entity registries from a parallel VM.
function ChunkManager.GetEntityCandidatesInRadius(worldPos: Vector3, radius: number, options: QueryOptions?)
	local result = {}
	local filter = options and options.Filter
	local extent = Vector3.new(radius, radius, radius)
	sweepChunks(worldPos - extent, worldPos + extent, options, function(chunk)
		for entity in chunk.Entities do
			if not filter or filter(entity) then
				table.insert(result, entity)
			end
		end
	end)
	return result
end

function ChunkManager.GetEntitiesInBox(cframe: CFrame, size: Vector3, options: QueryOptions?)
	local result = {}
	local filter = options and options.Filter
	local half = size / 2
	-- conservative world-space AABB around the oriented box
	local extent = Vector3.new(
		math.abs(cframe.RightVector.X) * half.X
			+ math.abs(cframe.UpVector.X) * half.Y
			+ math.abs(cframe.LookVector.X) * half.Z,
		math.abs(cframe.RightVector.Y) * half.X
			+ math.abs(cframe.UpVector.Y) * half.Y
			+ math.abs(cframe.LookVector.Y) * half.Z,
		math.abs(cframe.RightVector.Z) * half.X
			+ math.abs(cframe.UpVector.Z) * half.Y
			+ math.abs(cframe.LookVector.Z) * half.Z
	)
	sweepChunks(cframe.Position - extent, cframe.Position + extent, options, function(chunk)
		for entity in chunk.Entities do
			local localPos = cframe:PointToObjectSpace(entity:GetPosition())
			local pad = entity.HitboxRadius
			if
				math.abs(localPos.X) <= half.X + pad
				and math.abs(localPos.Y) <= half.Y + pad
				and math.abs(localPos.Z) <= half.Z + pad
			then
				if not filter or filter(entity) then
					table.insert(result, entity)
				end
			end
		end
	end)
	return result
end

--------------------------------------------------------------------------------
-- Auto-load: keep chunks near player characters loaded, freeze the rest
--------------------------------------------------------------------------------

export type AutoLoadConfig = {
	Enabled: boolean,
	Radius: number?, -- studs around each character, default 256
	Interval: number?, -- refresh cadence in real seconds, default 0.5
}

function ChunkManager.ConfigureAutoLoad(config: AutoLoadConfig)
	if autoLoadConnection then
		autoLoadConnection:Disconnect()
		autoLoadConnection = nil
	end
	if not config.Enabled then
		return
	end

	local radius = config.Radius or 256
	local chunkRadius = math.ceil(radius / ChunkManager.ChunkSize)

	autoLoadConnection = Heartbeat.ConnectInterval(config.Interval or 0.5, function()
		-- gather occupied chunk keys around players
		local loadedKeys: { [Vector3]: boolean } = {}
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character.PrimaryPart
			if root then
				local center = toChunkKey(root.Position)
				local minY, maxY = 0, 0
				if ChunkManager.UseY then
					minY, maxY = -chunkRadius, chunkRadius
				end
				for dx = -chunkRadius, chunkRadius do
					for dz = -chunkRadius, chunkRadius do
						for dy = minY, maxY do
							loadedKeys[center + Vector3.new(dx, dy, dz)] = true
						end
					end
				end
			end
		end
		for key, chunk in chunks do
			chunk.Loaded = loadedKeys[key] == true
		end
	end, {
		Name = "ChunkManager.AutoLoad",
		Priority = -100, -- resolve load state before entity/hitbox systems run
	})
end

--------------------------------------------------------------------------------
-- Replication (optional): mirrors chunk + global time scales to clients so
-- client-side visual simulation (see Projectile) dilates identically.
--------------------------------------------------------------------------------

function ChunkManager._replicateScale(chunk)
	if not replicationEnabled or not RunService:IsServer() then
		return
	end
	local VisualOffload = require(script.Parent.VisualOffload)
	VisualOffload.Fire("ChunkScale", { Key = chunk.Key, Scale = chunk.TimeScale })
end

function ChunkManager.EnableReplication()
	if replicationEnabled then
		return
	end
	replicationEnabled = true
	local VisualOffload = require(script.Parent.VisualOffload)

	if RunService:IsServer() then
		-- snapshot for joining players
		Players.PlayerAdded:Connect(function(player)
			local snapshot = {}
			for key, chunk in chunks do
				if chunk.TimeScale ~= 1 then
					table.insert(snapshot, { Key = key, Scale = chunk.TimeScale })
				end
			end
			VisualOffload.FireClient(player, "ChunkSnapshot", {
				Chunks = snapshot,
				Zones = timeZones,
				GlobalScale = Heartbeat.GetGlobalTimeScale(),
			})
		end)
		-- Mirror global scale changes. Polled in REAL time via a plain task loop,
		-- deliberately NOT a Heartbeat connection: every Heartbeat dt (dilated or
		-- not) is itself multiplied by the current global scale, so a poll tied to
		-- Heartbeat would stop advancing the instant the scale it's watching hits
		-- 0 -- meaning the transition INTO a full freeze could never be detected
		-- or broadcast to any client that didn't set it locally themselves. Real
		-- time keeps ticking regardless of dilation, so this always fires.
		local lastGlobal = Heartbeat.GetGlobalTimeScale()
		task.spawn(function()
			while true do
				task.wait(0.2)
				local current = Heartbeat.GetGlobalTimeScale()
				if current ~= lastGlobal then
					lastGlobal = current
					VisualOffload.Fire("GlobalScale", current)
				end
			end
		end)
	else
		VisualOffload.On("ChunkScale", function(data)
			local chunk = chunks[data.Key] or newChunk(data.Key)
			chunk.TimeScale = data.Scale
			chunk.Persistent = true
			maybeCollect(chunk)
		end)
		VisualOffload.On("ChunkSnapshot", function(data)
			for _, entry in data.Chunks do
				local chunk = chunks[entry.Key] or newChunk(entry.Key)
				chunk.TimeScale = entry.Scale
				chunk.Persistent = true
			end
			for _, zone in data.Zones or {} do
				ChunkManager.AddTimeScaleZone(zone.Id, zone.Position, zone.Radius, zone.Scale)
			end
			Heartbeat.SetGlobalTimeScale(data.GlobalScale)
		end)
		VisualOffload.On("TimeZoneUpsert", function(zone)
			ChunkManager.AddTimeScaleZone(zone.Id, zone.Position, zone.Radius, zone.Scale)
		end)
		VisualOffload.On("TimeZoneRemove", function(data)
			ChunkManager.RemoveTimeScaleZone(data.Id)
		end)
		VisualOffload.On("GlobalScale", function(scale)
			Heartbeat.SetGlobalTimeScale(scale)
		end)
	end
end

--------------------------------------------------------------------------------
-- Introspection
--------------------------------------------------------------------------------

function ChunkManager.GetAllChunks()
	local list = {}
	for _, chunk in chunks do
		table.insert(list, chunk)
	end
	return list
end

function ChunkManager.GetStats()
	local loaded, entities = 0, 0
	for _, chunk in chunks do
		if chunk.Loaded then
			loaded += 1
		end
		entities += chunk.EntityCount
	end
	return {
		ChunkCount = chunkCount,
		LoadedChunkCount = loaded,
		TrackedEntityCount = entities,
	}
end

return ChunkManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Entity</string>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	Entity.luau
	Turns any Model / BasePart / Humanoid rig — or nothing at all — into an
	entity with Entity.new(). Entities carry arbitrary custom variables and
	functions, a damage pipeline with stackable modifiers, tags, per-entity
	time scale, and automatic spatial chunk membership.

	Time model (per entity):
	   effectiveScale = Heartbeat global scale * chunk scale * entity.TimeScale
	OnUpdate callbacks receive a dt already dilated by all three. Entities in
	frozen (unloaded) chunks are skipped entirely.

	API summary:
	 Entity.new(instance?, props?) -> entity
	 Entity.Get(instance) -> entity?          (walks up ancestors)
	 Entity.GetAll() -> {entity}
	 Entity.GetTagged(tag) -> {entity}

	 entity:GetPosition() / :SetPosition(pos)   (SetPosition for data-only entities)
	 entity:GetPositionAt(realTime) -> Vector3  (rewound position; see history below)
	 entity:OnUpdate(fn(dt, entity)) -> connection-like {Disconnect}
	 entity:SetTimeScale(scale) / :GetEffectiveTimeScale()
	 entity:AddTag(tag) / :RemoveTag(tag) / :HasTag(tag)
	 entity:AddDamageModifier(fn) / :AddOutgoingModifier(fn) -> {Disconnect}
	 entity:TakeDamage(amount, info?) -> finalAmount
	 entity:DealDamage(target, amount, info?) -> finalAmount
	 entity:Heal(amount)
	 entity:IsActive() -> boolean            (false when chunk-frozen or destroyed)
	 entity:GetChunk() -> Chunk?
	 entity:Destroy()

	 Hurtbox debug visualization: set Entity.ShowHurtboxes = true (or call
	 Entity.SetShowHurtboxes(true)) to stream every entity's HitboxRadius sphere to
	 clients; call Entity.EnableHurtboxRendering() once on the client to draw them.
	 Entity.ShowHurtboxHistory = true (+ Entity.EnableHurtboxHistoryRendering() on
	 the client) shows the ENTIRE retained history as a trail of hurtboxes, colored
	 green while a sample is still within HurtboxValidWindow (fresh enough to be
	 usable for lag compensation) and red once it's older than that.

	 Signals: entity.Damaged(amount, info), entity.Died(info?),
	          entity.ChunkChanged(newChunk, oldChunk), entity.Destroyed()

	 Config props (all optional, passed in `props`; everything else in props is
	 copied onto the entity as custom data):
	   Health / MaxHealth (numbers)
	   HitboxRadius (number, default 2 — Body/Torso hurtbox radius)
	   HeadRadius (number, default Entity.HeadRadius — Head hurtbox radius)
	   HeadshotMultiplier (number, default Entity.HeadshotMultiplier)
	   HeadOffset / BodyOffset (Vector3, default zero — manual nudge on top of
	              the auto-calibrated Head position / the root position, for
	              rigs where the automatic placement isn't quite right)
	   TimeScale (number, default 1)
	   ScaleHumanoid (boolean — scale WalkSpeed/JumpPower with time dilation)
	   DestroyOnDeath (boolean — auto :Destroy() when Died fires)
	   Team / anything else -> stored as custom variables

	 Head + Body hurtboxes: purely data, no extra Instances -- every humanoid
	 entity has an independent Head sphere (radius HeadRadius) and Body sphere
	 (radius HitboxRadius), see entity:GetHeadPosition() / :GetBodyPosition()
	 (live) and :GetHeadPositionAt(t) / :GetBodyPositionAt(t) (rewound). The
	 two spheres are NOT required to nest or overlap -- HeadRadius,
	 HitboxRadius, HeadOffset and BodyOffset are independent knobs, each
	 applied as configured with no cross-clamping (an earlier version
	 auto-clamped HeadRadius to force geometric nesting; that was removed --
	 it existed only to support a since-abandoned physical-raycast design and
	 was silently zeroing HeadRadius out for any BodyOffset/HitboxRadius
	 combination it didn't like). Projectile.luau's lag-compensated rewind
	 check tests both spheres directly against these positions (Head first);
	 its live raycast path classifies a hit as "Head" by checking whether the
	 hit point falls within HeadRadius of GetHeadPosition() (real rig
	 geometry is untouched -- no CanQuery/CollisionGroup tricks, since
	 CollisionGroup-based hiding was tried and reverted after it broke
	 player-vs-floor collision).

	 Position history (for lag-compensated hit detection, see Projectile.luau):
	 every entity's real-world position is sampled on a real-time (not dilated)
	 cadence and kept for Entity.HistoryWindow seconds, so entity:GetPositionAt(t)
	 can answer "where was this entity at real time t". Sampling is throttled by
	 Entity.HistorySnapshotInterval and skipped when the entity hasn't moved at
	 least Entity.HistoryMinDelta studs, so a stationary entity's buffer stays tiny.
]]

local RunService = game:GetService("RunService")

local Heartbeat = require(script.Parent.Heartbeat)
local ChunkManager = require(script.Parent.ChunkManager)
local Signal = require(script.Parent.Signal)
local VisualOffload = require(script.Parent.VisualOffload)

local Entity = {}
Entity.__index = Entity

-- Position-history tuning (real seconds, not dilated) -- see GetPositionAt below.
Entity.HistoryWindow = 0.5 -- how far back samples are retained
Entity.HistorySnapshotInterval = 0.01 -- minimum real time between recorded samples
Entity.HistoryMinDelta = 0.5 -- studs; skip recording if barely moved since the last sample

-- Debug: when true, every entity's hurtbox (HitboxRadius sphere) is streamed to
-- clients and rendered as a translucent sphere. Flip this constant directly (or
-- call Entity.SetShowHurtboxes(true) at runtime) -- no keybind needed.
Entity.ShowHurtboxes = false

-- Debug: when true, the FULL position history of every entity streams to clients
-- as a trail of hurtboxes (see EnableHurtboxHistoryRendering). Independent of
-- ShowHurtboxes above, which only shows the single live hurtbox.
Entity.ShowHurtboxHistory = false

-- How recent (real seconds) a history sample must be to render green ("valid" --
-- still fresh enough to matter for lag-compensated hit detection) rather than red
-- ("stale" -- retained for GetPositionAt's interpolation, but old). Matches this
-- project's Shooter.server.luau MAX_REWIND by default so the debug view reflects
-- what's actually usable; tune to taste if that budget changes.
Entity.HurtboxValidWindow = 0.3

-- Head hurtbox defaults (see the module doc comment's "Hurtbox debug
-- visualization" section and GetHeadPosition/GetBodyPosition below). Copied
-- onto each entity at construction (like HitboxRadius already is), so a
-- prop override (props.HeadRadius / props.HeadshotMultiplier) still works
-- per-entity without touching these globals.
Entity.HeadRadius = 1.5 -- studs; independent of HitboxRadius, no nesting requirement
Entity.HeadshotMultiplier = 2 -- damage multiplier applied by Shooter.server.luau on a Head hit

local entities = {} -- flat array for fast iteration
local entityIndex = {} -- [entity] = array index (O(1) swap-remove)
local byInstance: { [Instance]: any } = {}
local byTag: { [string]: { [any]: boolean } } = {}
local nextId = 0

--------------------------------------------------------------------------------
-- Construction
--------------------------------------------------------------------------------

local RESERVED = {
	Instance = true,
	Humanoid = true,
	Id = true,
	Damaged = true,
	Died = true,
	ChunkChanged = true,
	Destroyed = true,
}

function Entity.new(instance: Instance?, props: { [string]: any }?)
	-- Idempotent: a second registration of the SAME instance returns the
	-- existing entity instead of creating a duplicate. Without this, the newer
	-- entity wins byInstance (Entity.Get resolves to it), but the older one is
	-- STILL in chunk.Entities, still tagged, still bound to the same Humanoid --
	-- a "ghost" that Projectile.Source (which points at the new entity) can't
	-- reference-equal against, so the projectile's self-exclusion in acquireTarget
	-- / _resolveEntityHit fails and it homes onto / damages its own creator.
	-- Any re-registration path (CharacterAdded/PlayerAdded timing, respawn,
	-- double-connect) converges to one live entity instead.
	if instance ~= nil and byInstance[instance] then
		return byInstance[instance]
	end

	nextId += 1
	local self = setmetatable({
		Id = nextId,
		Instance = instance,
		Humanoid = nil,
		Health = 100,
		MaxHealth = 100,
		HitboxRadius = 2,
		HeadRadius = Entity.HeadRadius,
		HeadshotMultiplier = Entity.HeadshotMultiplier,
		HeadOffset = Vector3.zero, -- manual nudge on top of the auto-calibrated head offset
		BodyOffset = Vector3.new(0, -1, 0), -- manual nudge on top of the root position
		TimeScale = 1,
		ScaleHumanoid = false,
		DestroyOnDeath = false,
		IsDestroyed = false,

		Damaged = Signal.new(),
		Died = Signal.new(),
		ChunkChanged = Signal.new(),
		Destroyed = Signal.new(),

		_position = Vector3.zero, -- used when there is no instance
		_root = nil :: BasePart?,
		_headOffset = nil :: Vector3?, -- auto-calibrated Head-relative-to-root offset; nil if no Head part
		_chunk = nil,
		_updateFns = {},
		_damageModifiers = {},
		_outgoingModifiers = {},
		_tags = {},
		_baseWalkSpeed = nil,
		_baseJumpPower = nil,
		_lastHumanoidScale = 1,
		_instanceConnections = {},
		_history = {}, -- chronological { {Time, Position}, ... }; see GetPositionAt
		_lastSnapshotTime = -math.huge,
	}, Entity)

	-- resolve physical root + humanoid
	if instance then
		if instance:IsA("BasePart") then
			self._root = instance
		elseif instance:IsA("Model") then
			local humanoid = instance:FindFirstChildOfClass("Humanoid")
			self._root = instance.PrimaryPart
				or (humanoid and instance:FindFirstChild("HumanoidRootPart") :: BasePart?)
				or instance:FindFirstChildWhichIsA("BasePart", true)
			if humanoid then
				self.Humanoid = humanoid
				self.Health = humanoid.Health
				self.MaxHealth = humanoid.MaxHealth
				self._baseWalkSpeed = humanoid.WalkSpeed
				self._baseJumpPower = humanoid.UseJumpPower and humanoid.JumpPower or humanoid.JumpHeight
				self._root = humanoid.RootPart

				-- Auto-calibrated Head offset, measured once at spawn (see
				-- entity:GetHeadPosition() / HeadOffset). Self-calibrates to
				-- whatever rig/scale this instance actually has instead of a
				-- hardcoded magic number. Bounded WaitForChild, not a plain
				-- FindFirstChild -- a live player's accessories/appearance can
				-- still be streaming in when CharacterAdded fires (the same
				-- class of race humanoid.RootPart above already guards
				-- against for the root), so Head may not exist on the very
				-- first frame yet.
				local head = instance:FindFirstChild("Head") or instance:WaitForChild("Head", 2)
				if head and head:IsA("BasePart") and self._root then
					self._headOffset = head.Position - self._root.Position
				end

				table.insert(
					self._instanceConnections,
					humanoid.HealthChanged:Connect(function(health)
						self.Health = health
					end)
				)
				table.insert(
					self._instanceConnections,
					humanoid.Died:Connect(function()
						self:_handleDeath(nil)
					end)
				)
			end
		end
		byInstance[instance] = self
		table.insert(
			self._instanceConnections,
			instance.Destroying:Connect(function()
				self:Destroy()
			end)
		)
	end

	-- merge custom props (variables AND functions) onto the entity
	if props then
		for key, value in props do
			if RESERVED[key] then
				warn(`[Entity] prop "{key}" is reserved and was ignored`)
			else
				self[key] = value
			end
		end
		if props.Health and not props.MaxHealth then
			self.MaxHealth = props.Health
		end
	end

	-- registry + initial chunk
	table.insert(entities, self)
	entityIndex[self] = #entities
	self._chunk = ChunkManager._addEntity(self, self:GetPosition())

	return self
end

-- Finds the entity owning `instance`, walking up the ancestor chain
-- (so a raycast hitting a limb resolves to the character's entity).
function Entity.Get(instance: Instance?)
	while instance do
		local entity = byInstance[instance]
		if entity then
			return entity
		end
		instance = instance.Parent
	end
	return nil
end

function Entity.GetAll()
	return table.clone(entities)
end

function Entity.GetTagged(tag: string)
	local result = {}
	local set = byTag[tag]
	if set then
		for entity in set do
			table.insert(result, entity)
		end
	end
	return result
end

--------------------------------------------------------------------------------
-- Position & chunks
--------------------------------------------------------------------------------

-- Binary search over a chronologically-ordered history array: returns the index
-- of the last sample with Time <= target, or 0 if every sample is newer.
local function findBeforeIndex(history: { any }, target: number): number
	local lo, hi = 1, #history
	local result = 0
	while lo <= hi do
		local mid = (lo + hi) // 2
		if history[mid].Time <= target then
			result = mid
			lo = mid + 1
		else
			hi = mid - 1
		end
	end
	return result
end

-- Records a position sample for lag-compensated rewinding, throttled by
-- HistorySnapshotInterval and skipped if the entity barely moved since its last
-- sample. `now` is real time (os.clock()), not dilated Heartbeat time.
function Entity:_recordPositionSnapshot(now: number)
	if now - self._lastSnapshotTime < Entity.HistorySnapshotInterval then
		return
	end
	self._lastSnapshotTime = now

	local history = self._history
	local position = self:GetPosition()
	local last = history[#history]
	if last and (position - last.Position).Magnitude < Entity.HistoryMinDelta then
		return -- hasn't moved enough to justify a new sample
	end

	table.insert(history, { Time = now, Position = position })
	while history[1] and history[1].Time < now - Entity.HistoryWindow do
		table.remove(history, 1)
	end
end

-- Where was this entity at real time `time` (an os.clock() value)? Interpolates
-- between the two recorded samples bracketing `time`, falls back to the live
-- position for times at/after "now" (or if no history exists), and clamps to
-- the oldest sample for times older than the retained window.
function Entity:GetPositionAt(time: number): Vector3
	local history = self._history
	local now = os.clock()
	if #history == 0 or time >= now then
		return self:GetPosition()
	end

	local idx = findBeforeIndex(history, time)
	if idx == 0 then
		return history[1].Position -- predates all history; clamp to oldest
	end

	local before = history[idx]
	local after = history[idx + 1] or { Time = now, Position = self:GetPosition() }
	local span = after.Time - before.Time
	local alpha = span > 1e-6 and math.clamp((time - before.Time) / span, 0, 1) or 0
	return before.Position:Lerp(after.Position, alpha)
end

-- Rewound Body hurtbox center at real time `time` -- GetPositionAt() plus
-- the manual BodyOffset nudge, matching GetBodyPosition()'s live equivalent.
function Entity:GetBodyPositionAt(time: number): Vector3
	return self:GetPositionAt(time) + self.BodyOffset
end

-- Rewound Head hurtbox center at real time `time`, or nil if this entity has
-- no Head hurtbox. Only the tracked root position is actually rewound; the
-- auto-calibrated/manual offsets are applied on top of that (rotation isn't
-- tracked, matching the rest of this system) -- same approximation as the
-- live GetHeadPosition().
function Entity:GetHeadPositionAt(time: number): Vector3?
	local headOffset = self._headOffset
	if not headOffset then
		return nil
	end
	return self:GetPositionAt(time) + headOffset + self.HeadOffset
end

function Entity:GetPosition(): Vector3
	local root = self._root
	if root and root.Parent then
		return root.Position
	end
	local instance = self.Instance
	if instance and instance:IsA("Model") and instance.Parent then
		return instance:GetPivot().Position
	end
	return self._position
end

function Entity:SetPosition(position: Vector3)
	if self._root then
		self._root.Position = position
	else
		self._position = position
	end
end

-- Center of the Body/Torso hurtbox -- GetPosition() plus the manual nudge
-- (BodyOffset). This is what the Body hurtbox sphere (live + debug) and
-- Projectile.luau's rewind check use; unrelated systems (homing, AOE,
-- ChunkManager) keep using plain GetPosition().
function Entity:GetBodyPosition(): Vector3
	return self:GetPosition() + self.BodyOffset
end

-- Center of the Head hurtbox, or nil if this entity has no Head part (a
-- non-humanoid entity, or a humanoid rig with no Head child at construction
-- time). GetPosition() plus the auto-calibrated offset plus the manual
-- nudge (HeadOffset).
function Entity:GetHeadPosition(): Vector3?
	local headOffset = self._headOffset
	if not headOffset then
		return nil
	end
	return self:GetPosition() + headOffset + self.HeadOffset
end

function Entity:GetChunk()
	return self._chunk
end

function Entity:IsActive(): boolean
	if self.IsDestroyed then
		return false
	end
	local chunk = self._chunk
	return chunk == nil or ChunkManager.IsChunkActive(chunk)
end

--------------------------------------------------------------------------------
-- Time dilation
--------------------------------------------------------------------------------

function Entity:SetTimeScale(scale: number)
	self.TimeScale = math.max(scale, 0)
	self:_refreshHumanoidScale()
end

function Entity:GetEffectiveTimeScale(): number
	return Heartbeat.GetGlobalTimeScale() * ChunkManager.GetTimeScaleAt(self:GetPosition()) * self.TimeScale
end

function Entity:_refreshHumanoidScale()
	if not self.ScaleHumanoid then
		return
	end
	local humanoid = self.Humanoid
	if not humanoid or not humanoid.Parent then
		return
	end
	local scale = self:GetEffectiveTimeScale()
	if scale == self._lastHumanoidScale then
		return
	end
	self._lastHumanoidScale = scale
	humanoid.WalkSpeed = (self._baseWalkSpeed or 16) * scale
	if humanoid.UseJumpPower then
		humanoid.JumpPower = (self._baseJumpPower or 50) * scale
	else
		-- jump height scales with time² (h = v²/2g with both v and g dilated)
		humanoid.JumpHeight = (self._baseJumpPower or 7.2) * scale * scale
	end
end

--------------------------------------------------------------------------------
-- Tags
--------------------------------------------------------------------------------

function Entity:AddTag(tag: string)
	if self._tags[tag] then
		return
	end
	self._tags[tag] = true
	local set = byTag[tag]
	if not set then
		set = {}
		byTag[tag] = set
	end
	set[self] = true
end

function Entity:RemoveTag(tag: string)
	if not self._tags[tag] then
		return
	end
	self._tags[tag] = nil
	local set = byTag[tag]
	if set then
		set[self] = nil
	end
end

function Entity:HasTag(tag: string): boolean
	return self._tags[tag] == true
end

--------------------------------------------------------------------------------
-- Damage pipeline
--------------------------------------------------------------------------------

local function addModifier(list, fn)
	table.insert(list, fn)
	return {
		Disconnect = function()
			local idx = table.find(list, fn)
			if idx then
				table.remove(list, idx)
			end
		end,
	}
end

-- Incoming: fn(amount, info, entity) -> newAmount. Runs on :TakeDamage().
function Entity:AddDamageModifier(fn: (amount: number, info: any, entity: any) -> number)
	return addModifier(self._damageModifiers, fn)
end

-- Outgoing: fn(amount, info, entity, target) -> newAmount. Runs on :DealDamage().
function Entity:AddOutgoingModifier(fn: (amount: number, info: any, entity: any, target: any) -> number)
	return addModifier(self._outgoingModifiers, fn)
end

-- info is a free-form table (e.g. { Type = "Fire", Source = attacker, Crit = true }).
function Entity:TakeDamage(amount: number, info: any?): number
	if self.IsDestroyed or self.Health <= 0 then
		return 0
	end
	info = info or {}

	for _, modifier in self._damageModifiers do
		amount = modifier(amount, info, self)
		if amount <= 0 then
			return 0
		end
	end

	local humanoid = self.Humanoid
	if humanoid and humanoid.Parent then
		local before = humanoid.Health
		humanoid:TakeDamage(amount) -- respects ForceFields
		amount = before - humanoid.Health
		self.Health = humanoid.Health
	else
		amount = math.min(amount, self.Health)
		self.Health -= amount
	end

	if amount > 0 then
		self.Damaged:Fire(amount, info)
	end
	if self.Health <= 0 and not humanoid then
		self:_handleDeath(info)
	end
	return amount
end

function Entity:DealDamage(target: any, amount: number, info: any?): number
	info = info or {}
	info.Source = info.Source or self
	for _, modifier in self._outgoingModifiers do
		amount = modifier(amount, info, self, target)
		if amount <= 0 then
			return 0
		end
	end
	return target:TakeDamage(amount, info)
end

function Entity:Heal(amount: number)
	local humanoid = self.Humanoid
	if humanoid and humanoid.Parent then
		humanoid.Health = math.min(humanoid.Health + amount, humanoid.MaxHealth)
		self.Health = humanoid.Health
	else
		self.Health = math.min(self.Health + amount, self.MaxHealth)
	end
end

function Entity:_handleDeath(info: any?)
	if self._dead then
		return
	end
	self._dead = true
	self.Died:Fire(info)
	
	if self.DestroyOnDeath then
		self:Destroy()
	end
end

--------------------------------------------------------------------------------
-- Per-entity update callbacks (driven by one shared heartbeat connection)
--------------------------------------------------------------------------------

function Entity:OnUpdate(fn: (dt: number, entity: any) -> ())
	local fns = self._updateFns
	table.insert(fns, fn)
	return {
		Disconnect = function()
			local idx = table.find(fns, fn)
			if idx then
				local n = #fns
				fns[idx] = fns[n]
				fns[n] = nil
			end
		end,
	}
end

--------------------------------------------------------------------------------
-- Destruction
--------------------------------------------------------------------------------

function Entity:Destroy()
	if self.IsDestroyed then
		return
	end
	self.IsDestroyed = true

	local idx = entityIndex[self]
	if idx then
		local last = #entities
		local moved = entities[last]
		entities[idx] = moved
		entities[last] = nil
		entityIndex[moved] = idx ~= last and idx or nil
		entityIndex[self] = nil
	end

	ChunkManager._removeEntity(self, self._chunk)
	self._chunk = nil

	for tag in self._tags do
		local set = byTag[tag]
		if set then
			set[self] = nil
		end
	end

	if self.Instance then
		byInstance[self.Instance] = nil
	end
	for _, connection in self._instanceConnections do
		connection:Disconnect()
	end
	table.clear(self._instanceConnections)
	table.clear(self._updateFns)

	self.Destroyed:Fire()
	self.Damaged:Destroy()
	self.Died:Destroy()
	self.ChunkChanged:Destroy()
	self.Destroyed:Destroy()
end

--------------------------------------------------------------------------------
-- System loops
--------------------------------------------------------------------------------

-- Frame loop: run OnUpdate callbacks with fully-dilated dt.
-- dt here is already global-scaled by the Heartbeat.
Heartbeat.Connect(function(dt)
	for i = 1, #entities do
		local entity = entities[i]
		local fns = entity._updateFns
		if #fns > 0 then
				local chunk = entity._chunk
				if chunk == nil or ChunkManager.IsChunkActive(chunk) then
					local scale = ChunkManager.GetTimeScaleAt(entity:GetPosition()) * entity.TimeScale
				if scale > 0 then
					local entityDt = dt * scale
					for j = 1, #fns do
						fns[j](entityDt, entity)
					end
				end
			end
		end
	end
end, { Name = "EntitySystem.Update", Priority = 0 })

-- History loop: real-time (not dilated) position sampling for lag-compensated
-- hit detection (see Projectile.luau). Runs every real frame -- the callback
-- ignores `dt` and reads os.clock() directly, since real network latency
-- doesn't scale with in-game time dilation. Each entity's own throttling
-- (HistorySnapshotInterval / HistoryMinDelta) keeps the actual recording cost low.
Heartbeat.Connect(function()
	local now = os.clock()
	for i = 1, #entities do
		local entity = entities[i]
		local chunk = entity._chunk
		if chunk == nil or ChunkManager.IsChunkActive(chunk) then
			entity:_recordPositionSnapshot(now)
		end
	end
end, { Name = "EntitySystem.History", Priority = -60 })

-- Slow loop: re-bucket moved entities into chunks, refresh humanoid dilation.
Heartbeat.ConnectInterval(0.1, function()
	for i = 1, #entities do
		local entity = entities[i]
		local newChunk, changed = ChunkManager._updateEntity(entity, entity._chunk, entity:GetPosition())
		if changed then
			local oldChunk = entity._chunk
			entity._chunk = newChunk
			entity.ChunkChanged:Fire(newChunk, oldChunk)
		end
		entity:_refreshHumanoidScale()
	end
end, { Name = "EntitySystem.ChunkTracking", Priority = -50 })

--------------------------------------------------------------------------------
-- Hurtbox debug visualization
--------------------------------------------------------------------------------

function Entity.SetShowHurtboxes(enabled: boolean)
	Entity.ShowHurtboxes = enabled and true or false
	if RunService:IsServer() and not Entity.ShowHurtboxes then
		VisualOffload.Fire("HurtboxSnapshot", {}) -- clear any spheres already drawn
	end
end

function Entity.SetShowHurtboxHistory(enabled: boolean)
	Entity.ShowHurtboxHistory = enabled and true or false
	if RunService:IsServer() and not Entity.ShowHurtboxHistory then
		VisualOffload.Fire("HurtboxHistorySnapshot", {}) -- clear any trails already drawn
	end
end

if RunService:IsServer() then
	task.spawn(function()
		while true do
			if Entity.ShowHurtboxes then
				local snapshot = {}
				for i = 1, #entities do
					local entity = entities[i]
					if not entity.IsDestroyed then
						table.insert(snapshot, {
							Id = entity.Id,
							Position = entity:GetBodyPosition(),
							Radius = entity.HitboxRadius,
							HeadPosition = entity:GetHeadPosition(),
							HeadRadius = entity.HeadRadius,
						})
					end
				end
				VisualOffload.Fire("HurtboxSnapshot", snapshot)
			end

			if Entity.ShowHurtboxHistory then
				local now = os.clock()
				local snapshot = {}
				for i = 1, #entities do
					local entity = entities[i]
					if not entity.IsDestroyed then
						local samples = {}
						for _, sample in entity._history do
							table.insert(samples, {
								Position = sample.Position,
								Valid = (now - sample.Time) <= Entity.HurtboxValidWindow,
							})
						end
						-- the live position is always the newest, always-valid sample
						table.insert(samples, { Position = entity:GetPosition(), Valid = true })
						table.insert(snapshot, { Id = entity.Id, Radius = entity.HitboxRadius, Samples = samples })
					end
				end
				VisualOffload.Fire("HurtboxHistorySnapshot", snapshot)
			end

			task.wait(0.1) -- real time; this is a debug view, not gameplay
		end
	end)
end

local HURTBOX_BODY_COLOR = Color3.fromRGB(255, 90, 90)
local HURTBOX_HEAD_COLOR = Color3.fromRGB(255, 170, 60)

local hurtboxParts: { [string]: BasePart }? = nil -- ["{id}_Body" | "{id}_Head"] = debug sphere

local function ensureHurtboxPart(key: string, color: Color3): BasePart
	local part = hurtboxParts[key]
	if part then
		return part
	end
	part = Instance.new("Part")
	part.Name = `Hurtbox_{key}`
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.ForceField
	part.Color = color
	part.Transparency = 0.55
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = workspace
	hurtboxParts[key] = part
	return part
end

local hurtboxRenderingEnabled = false

-- Call once on the client to draw every entity's Body (+ Head, if present)
-- hurtbox whenever Entity.ShowHurtboxes is true on the server. No-ops on the
-- server.
function Entity.EnableHurtboxRendering()
	if hurtboxRenderingEnabled or RunService:IsServer() then
		return
	end
	hurtboxRenderingEnabled = true
	hurtboxParts = {}

	VisualOffload.On("HurtboxSnapshot", function(snapshot)
		local seen: { [string]: boolean } = {}
		for _, info in snapshot do
			local bodyKey = `{info.Id}_Body`
			seen[bodyKey] = true
			local body = ensureHurtboxPart(bodyKey, HURTBOX_BODY_COLOR)
			body.Size = Vector3.one * (info.Radius * 2)
			body.Position = info.Position

			if info.HeadPosition then
				local headKey = `{info.Id}_Head`
				seen[headKey] = true
				local head = ensureHurtboxPart(headKey, HURTBOX_HEAD_COLOR)
				head.Size = Vector3.one * (info.HeadRadius * 2)
				head.Position = info.HeadPosition
			end
		end
		for key, part in hurtboxParts do
			if not seen[key] then
				part:Destroy()
				hurtboxParts[key] = nil
			end
		end
	end)
end

-- History-trail rendering: every retained sample per entity, colored green while
-- still within HurtboxValidWindow, red once older. Overlapping spheres are
-- expected (denser overlap = the entity lingered there) -- kept more transparent
-- than the single live hurtbox so the trail doesn't turn into a solid blob.
local HURTBOX_VALID_COLOR = Color3.fromRGB(90, 230, 120)
local HURTBOX_INVALID_COLOR = Color3.fromRGB(230, 70, 70)

local historyParts: { [string]: BasePart }? = nil -- ["entityId_index"] = debug sphere

local function ensureHistoryPart(key: string): BasePart
	local part = historyParts[key]
	if part then
		return part
	end
	part = Instance.new("Part")
	part.Name = `HurtboxHistory_{key}`
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.ForceField
	part.Transparency = 0.8
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = workspace
	historyParts[key] = part
	return part
end

local hurtboxHistoryRenderingEnabled = false

-- Call once on the client to draw every entity's FULL hurtbox history whenever
-- Entity.ShowHurtboxHistory is true on the server. No-ops on the server.
function Entity.EnableHurtboxHistoryRendering()
	if hurtboxHistoryRenderingEnabled or RunService:IsServer() then
		return
	end
	hurtboxHistoryRenderingEnabled = true
	historyParts = {}

	VisualOffload.On("HurtboxHistorySnapshot", function(snapshot)
		local seen: { [string]: boolean } = {}
		for _, info in snapshot do
			for index, sample in info.Samples do
				local key = `{info.Id}_{index}`
				seen[key] = true
				local part = ensureHistoryPart(key)
				part.Size = Vector3.one * (info.Radius * 2)
				part.Position = sample.Position
				part.Color = sample.Valid and HURTBOX_VALID_COLOR or HURTBOX_INVALID_COLOR
			end
		end
		for key, part in historyParts do
			if not seen[key] then
				part:Destroy()
				historyParts[key] = nil
			end
		end
	end)
end

return Entity
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Gravity</string>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	Gravity.luau
	Applies dilated gravity to an entity. The integration runs on the entity's
	OnUpdate loop, whose dt is already scaled by global * chunk * entity time.
	Because both the velocity gain and the displacement use that same dilated
	dt, acceleration effectively scales with time²:

	    inside a 0.2x chunk -> 0.2² = 0.04x the fall acceleration ("floaty")

	This only manually integrates entities the engine is NOT already simulating
	(anchored parts, part-less/data entities). A free Humanoid rig is left to
	Roblox physics — overriding its position every frame would fight the engine —
	but its :SetTimeScale-driven WalkSpeed/JumpPower dilation still applies via
	the Entity system.

	API:
	 Gravity.Apply(entity, options?) -> { Disconnect }
	 options = {
	     Acceleration = 196.2,   -- studs/s² (Roblox default workspace.Gravity)
	     GroundY = nil,          -- rest/bounce plane; nil = fall forever
	     Restitution = 0,        -- bounciness at GroundY (0..1)
	     Terminal = nil,         -- optional max fall speed (studs/s)
	 }
]]

local Gravity = {}
Gravity.Acceleration = 196.2 -- matches Roblox's default workspace.Gravity

function Gravity.Apply(entity, options)
	options = options or {}
	local acceleration = options.Acceleration or Gravity.Acceleration
	local restitution = options.Restitution or 0
	local groundY = options.GroundY
	local terminal = options.Terminal

	entity._gravityVelocity = entity._gravityVelocity or Vector3.zero

	return entity:OnUpdate(function(dt, self)
		if dt <= 0 then
			return
		end

		-- A rig the engine is actively simulating owns its own motion.
		local root = self._root
		if root and self.Humanoid and not root.Anchored then
			return
		end

		local velocity = self._gravityVelocity - Vector3.new(0, acceleration * dt, 0)
		if terminal and velocity.Y < -terminal then
			velocity = Vector3.new(velocity.X, -terminal, velocity.Z)
		end

		local position = self:GetPosition() + velocity * dt

		if groundY and position.Y <= groundY then
			position = Vector3.new(position.X, groundY, position.Z)
			if restitution > 0 and velocity.Y < 0 then
				velocity = Vector3.new(velocity.X, -velocity.Y * restitution, velocity.Z)
				-- kill tiny residual bounces so it settles
				if velocity.Y < acceleration * dt then
					velocity = Vector3.new(velocity.X, 0, velocity.Z)
				end
			else
				velocity = Vector3.new(velocity.X, 0, velocity.Z)
			end
		end

		self._gravityVelocity = velocity
		self:SetPosition(position)
	end)
end

-- Adds an instantaneous velocity impulse (e.g. a jump or knockback) that the
-- integrator will then decay under gravity.
function Gravity.Impulse(entity, velocity: Vector3)
	entity._gravityVelocity = (entity._gravityVelocity or Vector3.zero) + velocity
end

return Gravity
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Heartbeat</string>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	Heartbeat.luau
	The heart of Relativity's time model. A single RunService.Heartbeat
	connection drives every system in the game. Each frame the real delta is
	multiplied by a global time scale (SetGlobalTimeScale) and then, per
	connection, by that connection's own TimeScale — so every system runs in
	its own flow of time and the whole world can be slowed, sped up, or frozen
	at once.

	    dilatedDt = realDt * globalTimeScale * connection.TimeScale

	Callbacks receive that dilated dt. Higher-level systems (Entity, Hitbox,
	Projectile) multiply it further by a chunk-local scale (see ChunkManager),
	giving per-region time dilation for free.

	Priority: connections run in ascending Priority order (more-negative first),
	so a system at Priority -100 resolves before one at 0. This lets, e.g.,
	chunk load state settle before entity updates read it.

	API:
	 Heartbeat.Connect(fn(dt, connection), options?) -> Connection
	 Heartbeat.ConnectInterval(interval, fn(elapsed, connection), options?) -> Connection
	 Heartbeat.Delay(seconds, fn(elapsed)) -> Connection      (dilated one-shot)
	 Heartbeat.Wait(seconds) -> elapsed                        (yields in dilated time)
	 Heartbeat.SetGlobalTimeScale(scale) / GetGlobalTimeScale() -> number
	 Heartbeat.GetStats() -> { ConnectionCount, GlobalTimeScale, AvgFrameTime }
	 Heartbeat.GetConnections() -> { Connection }

	 options: { Name?, Priority? = 0, TimeScale? = 1 }
	 Connection fields: Name, Priority, TimeScale, LocalTime, Connected
	 Connection methods: :Disconnect()
]]

local RunService = game:GetService("RunService")

local Heartbeat = {}

local connections = {} -- priority-sorted (ascending) array of Connection
local globalTimeScale = 1
local needsSort = false

-- rolling average of per-frame cost (seconds) over a fixed window
local WINDOW = 60
local frameSamples = table.create(WINDOW, 0)
local frameCostSum = 0
local sampleCursor = 1
local sampleCount = 0

--------------------------------------------------------------------------------
-- Connection
--------------------------------------------------------------------------------

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	local index = table.find(connections, self)
	if index then
		table.remove(connections, index) -- preserve sorted order
	end
end
Connection.Destroy = Connection.Disconnect

local function makeConnection(fn: (number, any) -> (), options)
	options = options or {}
	local connection = setmetatable({
		Connected = true,
		Callback = fn,
		Name = options.Name or "Anonymous",
		Priority = options.Priority or 0,
		TimeScale = math.max(options.TimeScale or 1, 0),
		LocalTime = 0,
		_isInterval = false,
		_interval = 0,
		_accumulator = 0,
	}, Connection)
	table.insert(connections, connection)
	needsSort = true
	return connection
end

--------------------------------------------------------------------------------
-- Public registration
--------------------------------------------------------------------------------

function Heartbeat.Connect(fn: (dt: number, connection: any) -> (), options: any?)
	return makeConnection(fn, options)
end

-- Fires roughly every `interval` dilated seconds. The callback receives the
-- accumulated dilated time since it last fired (usually ~= interval).
function Heartbeat.ConnectInterval(interval: number, fn: (elapsed: number, connection: any) -> (), options: any?)
	local connection = makeConnection(fn, options)
	connection._isInterval = true
	connection._interval = math.max(interval, 0)
	return connection
end

-- One-shot after `seconds` dilated seconds. Stretches automatically when time
-- is slowed globally or by the connection's TimeScale.
function Heartbeat.Delay(seconds: number, fn: (elapsed: number) -> (), options: any?)
	local elapsed = 0
	return Heartbeat.Connect(function(dt, connection)
		elapsed += dt
		if elapsed >= seconds then
			connection:Disconnect()
			fn(elapsed)
		end
	end, options or { Name = "Heartbeat.Delay" })
end

-- Yields the calling coroutine for `seconds` dilated seconds.
function Heartbeat.Wait(seconds: number?): number
	local thread = coroutine.running()
	Heartbeat.Delay(seconds or 0, function(elapsed)
		task.spawn(thread, elapsed)
	end)
	return coroutine.yield()
end

--------------------------------------------------------------------------------
-- Global time scale
--------------------------------------------------------------------------------

function Heartbeat.SetGlobalTimeScale(scale: number)
	globalTimeScale = math.max(scale or 1, 0)
end

function Heartbeat.GetGlobalTimeScale(): number
	return globalTimeScale
end

--------------------------------------------------------------------------------
-- Introspection
--------------------------------------------------------------------------------

function Heartbeat.GetStats()
	return {
		ConnectionCount = #connections,
		GlobalTimeScale = globalTimeScale,
		AvgFrameTime = sampleCount > 0 and frameCostSum / sampleCount or 0,
	}
end

function Heartbeat.GetConnections()
	return table.clone(connections)
end

--------------------------------------------------------------------------------
-- The one true loop
--------------------------------------------------------------------------------

local function step(realDt: number)
	if needsSort then
		table.sort(connections, function(a, b)
			return a.Priority < b.Priority
		end)
		needsSort = false
	end

	local startClock = os.clock()
	local globalDt = realDt * globalTimeScale

	-- Snapshot so a callback may connect/disconnect during the frame without
	-- skipping or double-running siblings. New connections run next frame.
	local snapshot = table.clone(connections)
	for i = 1, #snapshot do
		local connection = snapshot[i]
		if connection.Connected then
			local dilatedDt = globalDt * connection.TimeScale
			connection.LocalTime += dilatedDt

			if connection._isInterval then
				connection._accumulator += dilatedDt
				if connection._accumulator >= connection._interval then
					local elapsed = connection._accumulator
					connection._accumulator = 0
					local ok, err = pcall(connection.Callback, elapsed, connection)
					if not ok then
						warn(`[Heartbeat] "{connection.Name}" errored: {err}`)
					end
				end
			else
				local ok, err = pcall(connection.Callback, dilatedDt, connection)
				if not ok then
					warn(`[Heartbeat] "{connection.Name}" errored: {err}`)
				end
			end
		end
	end

	-- rolling frame-cost stats
	local cost = os.clock() - startClock
	frameCostSum -= frameSamples[sampleCursor]
	frameSamples[sampleCursor] = cost
	frameCostSum += cost
	sampleCursor = sampleCursor % WINDOW + 1
	sampleCount = math.min(sampleCount + 1, WINDOW)
end

RunService.Heartbeat:Connect(step)

return Heartbeat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Hitbox</string>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	Hitbox.luau
	Damage volumes that respect chunk time dilation. Two flavours:

	 1. Hitbox.Explode(position, config) — instantaneous radial damage with
	    linear falloff, optional knockback and a cosmetic Explosion.

	 2. Hitbox.new(config):Start() — a persistent volume (box or sphere) that
	    can Follow an entity and ticks over a dilated Lifetime. Great for melee
	    swing windows, auras, and lingering hazards. Fires .OnHit(entity, damage).

	All entity lookups go through the ChunkManager grid, so hitboxes never scan
	frozen (unloaded) chunks. Everything ticks in the local time of the chunk
	the hitbox currently occupies: a sword swung inside a slow zone lingers.

	Hitbox.new config:
	  Shape     = "Box" | "Sphere"     (default "Box")
	  Size      = Vector3               (Sphere uses Size.X as diameter)
	  Follow    = entity | BasePart     (tracks its position each tick)
	  Offset    = CFrame                (relative to Follow, default identity)
	  Position  = Vector3 | CFrame      (static placement when no Follow)
	  Damage    = number
	  Source    = entity                (deals damage through its outgoing modifiers)
	  HitOnce   = boolean               (default true — each target once per activation)
	  RehitInterval = number?           (if HitOnce is false, seconds between re-hits)
	  Lifetime  = number?               (dilated seconds before auto-Stop)
	  Filter    = (entity) -> boolean
	  Info      = table                 (damage info; default { Type = "Melee" })
]]

local Signal = require(script.Parent.Signal)
local Heartbeat = require(script.Parent.Heartbeat)
local ChunkManager = require(script.Parent.ChunkManager)

local Hitbox = {}
Hitbox.__index = Hitbox

--------------------------------------------------------------------------------
-- Shared helpers
--------------------------------------------------------------------------------

local function applyKnockback(entity, direction: Vector3, force: number)
	if force <= 0 then
		return
	end
	local root = entity._root
	if root and root.Parent and not root.Anchored then
		root.AssemblyLinearVelocity += direction * force
	elseif entity._gravityVelocity ~= nil then
		-- data/gravity-driven entity: feed the Gravity integrator
		entity._gravityVelocity += direction * force
	end
end

--------------------------------------------------------------------------------
-- Instant explosion
--------------------------------------------------------------------------------

export type ExplodeConfig = {
	Radius: number,
	Damage: number,
	MinDamage: number?, -- damage at the edge (default = Damage, i.e. no falloff)
	Knockback: number?,
	Source: any?,
	Visual: boolean?, -- cosmetic Roblox Explosion (pressure 0)
	Filter: ((entity: any) -> boolean)?,
	Type: string?, -- damage type tag (default "Explosion")
}

function Hitbox.Explode(position: Vector3, config: ExplodeConfig)
	local radius = config.Radius or 10
	local maxDamage = config.Damage or 0
	local minDamage = config.MinDamage or maxDamage
	local knockback = config.Knockback or 0
	local source = config.Source
	local damageType = config.Type or "Explosion"

	local hitList = {}
	local targets = ChunkManager.GetEntitiesInRadius(position, radius, { Filter = config.Filter })
	for _, entity in targets do
		if entity ~= source and not entity.IsDestroyed then
			local offset = entity:GetPosition() - position
			local distance = offset.Magnitude
			local alpha = radius > 0 and math.clamp(1 - distance / radius, 0, 1) or 1
			local damage = minDamage + (maxDamage - minDamage) * alpha

			if damage > 0 then
				local info = { Type = damageType, Source = source, Position = position }
				if source and source.DealDamage then
					source:DealDamage(entity, damage, info)
				else
					entity:TakeDamage(damage, info)
				end
			end

			local direction = distance > 1e-3 and offset.Unit or Vector3.yAxis
			applyKnockback(entity, direction, knockback)
			table.insert(hitList, entity)
		end
	end

	if config.Visual then
		local explosion = Instance.new("Explosion")
		explosion.Position = position
		explosion.BlastRadius = radius
		explosion.BlastPressure = 0 -- cosmetic only; damage is handled above
		explosion.DestroyJointRadiusPercent = 0
		explosion.Parent = workspace
	end

	return hitList
end

--------------------------------------------------------------------------------
-- Persistent hitbox
--------------------------------------------------------------------------------

function Hitbox.new(config)
	return setmetatable({
		Shape = config.Shape or "Box",
		Size = config.Size or (Vector3.one * 4),
		Follow = config.Follow,
		Offset = config.Offset or CFrame.identity,
		Position = config.Position,
		Damage = config.Damage or 0,
		Source = config.Source,
		HitOnce = config.HitOnce ~= false, -- default true
		RehitInterval = config.RehitInterval,
		Lifetime = config.Lifetime,
		Filter = config.Filter,
		Info = config.Info,

		OnHit = Signal.new(),
		Active = false,

		_hitTimes = {}, -- [entity] = localTime it was last hit
		_connection = nil,
		_elapsed = 0,
	}, Hitbox)
end

function Hitbox:_getCFrame(): CFrame
	local follow = self.Follow
	if follow ~= nil then
		if typeof(follow) == "Instance" then
			if follow:IsA("BasePart") then
				return follow.CFrame * self.Offset
			elseif follow:IsA("Model") then
				return follow:GetPivot() * self.Offset
			end
		else
			-- an Entity
			local root = follow._root
			if root and root.Parent then
				return root.CFrame * self.Offset
			end
			if follow.GetPosition then
				return CFrame.new(follow:GetPosition()) * self.Offset
			end
		end
	end

	local placement = self.Position
	if placement then
		if typeof(placement) == "CFrame" then
			return placement
		end
		return CFrame.new(placement)
	end
	return CFrame.identity
end

function Hitbox:_query()
	local cframe = self:_getCFrame()
	local entities
	if self.Shape == "Sphere" or self.Shape == "Ball" then
		local sphereRadius = self.Size.X / 2
		entities = ChunkManager.GetEntitiesInRadius(cframe.Position, sphereRadius, { Filter = self.Filter })
	else
		entities = ChunkManager.GetEntitiesInBox(cframe, self.Size, { Filter = self.Filter })
	end

	local now = self._elapsed
	for _, entity in entities do
		if entity ~= self.Source and not entity.IsDestroyed then
			local lastHit = self._hitTimes[entity]
			local allowed
			if self.HitOnce then
				allowed = lastHit == nil
			elseif self.RehitInterval then
				allowed = lastHit == nil or (now - lastHit) >= self.RehitInterval
			else
				allowed = true -- tick every frame
			end

			if allowed then
				self._hitTimes[entity] = now
				local info = self.Info or { Type = "Melee", Source = self.Source }
				local dealt
				if self.Source and self.Source.DealDamage then
					dealt = self.Source:DealDamage(entity, self.Damage, info)
				else
					dealt = entity:TakeDamage(self.Damage, info)
				end
				self.OnHit:Fire(entity, dealt)
			end
		end
	end
end

function Hitbox:Start()
	if self.Active then
		return self
	end
	self.Active = true
	self._elapsed = 0
	table.clear(self._hitTimes)

	self._connection = Heartbeat.Connect(function(dt)
		local position = self:_getCFrame().Position
		-- dt is already global-scaled; fold in the chunk-local scale.
		local localDt = ChunkManager.ScaleDt(dt, position)
		self._elapsed += localDt

		if ChunkManager.IsActiveAt(position) and localDt > 0 then
			self:_query()
		end

		if self.Lifetime and self._elapsed >= self.Lifetime then
			self:Stop()
		end
	end, { Name = "Hitbox", Priority = 10 })

	return self
end

function Hitbox:Stop()
	if not self.Active then
		return
	end
	self.Active = false
	if self._connection then
		self._connection:Disconnect()
		self._connection = nil
	end
end

-- Clears the per-target hit memory so a HitOnce box can strike again
-- (e.g. the next swing) without recreating it.
function Hitbox:Reset()
	table.clear(self._hitTimes)
	self._elapsed = 0
end

function Hitbox:Destroy()
	self:Stop()
	self.OnHit:Destroy()
end

return Hitbox
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">MapGen</string>
          <string name="Source"><![CDATA[--!optimize 2
--[[
	MapGen (init.luau)
	Procedural map generator for a prop-hunt house/hotel theme.

	Phase 1 (this module): hallway network + empty-space detection so we know
	where rooms can be placed. Rooms are currently only *detected & visualized*
	(as candidate rectangles); actually building furnished rooms comes later.

	Pipeline:
	  1. HallwayGenerator carves a connected corridor network on a coarse lattice.
	  2. RoomFinder flood-fills the leftover space into regions and greedily packs
	     room-sized rectangles into them, tagging each with adjacent hallway cells
	     (future doors).

	Two entry points:
	  MapGen.generate(config)          -> headless: returns { grid, regions, rooms }
	  MapGen.visualizeAnimated(config) -> builds it live under a workspace folder,
	                                      animating each stage. Call from task.spawn
	                                      (it yields). Returns the same result table.

	See MapGen.DefaultConfig for tunables.
]]

local Grid = require(script.Grid)
local HallwayGenerator = require(script.HallwayGenerator)
local RoomFinder = require(script.RoomFinder)
local Visualizer = require(script.Visualizer)
local Builder = require(script.Builder)
local CellSpace = require(script.CellSpace)

local MapGen = {}
MapGen.Grid = Grid
MapGen.HallwayGenerator = HallwayGenerator
MapGen.RoomFinder = RoomFinder
MapGen.Visualizer = Visualizer
MapGen.Builder = Builder
MapGen.CellSpace = CellSpace

export type Config = {
	width: number?, -- grid size in cells
	height: number?,
	cellSize: number?, -- studs per cell
	origin: Vector3?, -- world position of the grid's (0,0) corner
	seed: number?, -- deterministic when set

	-- hallway lattice
	spacing: number?, -- cells between parallel corridors
	hallWidth: number?, -- corridor width in cells (clamped to < spacing)
	spacingJitter: number?, -- randomizes each lattice interval by +/- this many cells
	loopChance: number?, -- chance to carve each non-tree (loop) edge
	margin: number?, -- empty border cells around the lattice

	-- rooms. Note: an un-merged lattice block is exactly (spacing - hallWidth)
	-- cells square, so most rooms will have one edge pinned to that value unless
	-- these bounds sit well clear of it -- see the hallWidth comment above.
	minWidth: number?, -- min room edge along X, in cells
	maxWidth: number?, -- max room edge along X, in cells
	minLength: number?, -- min room edge along Y (Z in world), in cells
	maxLength: number?, -- max room edge along Y (Z in world), in cells

	-- leftover pockets findRooms couldn't claim (too small for min bounds):
	-- touching exactly one room merges into it; touching none is culled into
	-- the hallway; touching 2+ rooms rolls this chance to become a connecting
	-- hallway segment between them instead of extending one at random.
	pocketHallwayChance: number?,
	-- a room stops accepting further pocket merges once its irregularity rating
	-- (merged area / original area) reaches this; rejected merges become
	-- hallway instead. See RoomFinder.resolvePockets.
	irregularityThreshold: number?,
	-- cells wide per door opened between a forced/connecting hallway pocket and
	-- each room it touches (NOT the whole shared boundary).
	pocketDoorWidth: number?,

	-- rooms findRooms packed directly edge-to-edge (no hallway between them)
	-- normally get a plain wall; this is the chance each such pair instead gets
	-- its own connecting door, widened up to roomLinkDoorWidth cells.
	roomLinkChance: number?,
	roomLinkDoorWidth: number?,

	-- animation pacing (visualizeAnimated only)
	edgesPerFrame: number?, -- corridors carved between waits
	stepWait: number?, -- seconds waited between animation frames
}

MapGen.DefaultConfig = {
	width = 50,
	height = 50,
	cellSize = 8,
	origin = Vector3.new(250, 0, 250),
	seed = nil,

	spacing = 6,
	hallWidth = 2, -- corridor width in cells
	spacingJitter = 2, -- +/- cells per lattice interval; breaks the "every room has a (spacing-hallWidth) edge" pattern
	-- High loop density: a spanning tree alone leaves corridors too sparse to
	-- enclose rooms (all pockets merge into one blob). Carving most lattice edges
	-- gives a double-loaded-corridor "hotel grid" where each block is a room off a
	-- hallway; leaving some edges out merges neighbours into larger rooms for variety.
	loopChance = 0.7,
	margin = 1,

	minWidth = 3,
	maxWidth = 7,
	minLength = 3,
	maxLength = 7,
	pocketHallwayChance = 0.4,
	irregularityThreshold = 0.5,
	pocketDoorWidth = 2,
	roomLinkChance = 0.15,
	roomLinkDoorWidth = 2,

	edgesPerFrame = 10,
	stepWait = 0.01,
}

local function withDefaults(config: Config?)
	local merged = {}
	for k, v in MapGen.DefaultConfig do
		merged[k] = v
	end
	if config then
		for k, v in config do
			merged[k] = v
		end
	end
	return merged
end

-- Headless generation: no parts, just data.
function MapGen.generate(config: Config?)
	local cfg = withDefaults(config)
	local rng = Random.new(cfg.seed or os.clock() * 1e6)

	local grid = Grid.new(cfg.width, cfg.height)

	local gen = HallwayGenerator.new(grid, {
		spacing = cfg.spacing,
		hallWidth = cfg.hallWidth,
		spacingJitter = cfg.spacingJitter,
		loopChance = cfg.loopChance,
		margin = cfg.margin,
	}, rng)
	gen:run()

	local regions = RoomFinder.detectRegions(grid)
	local rooms = RoomFinder.findRooms(grid, {
		minWidth = cfg.minWidth,
		maxWidth = cfg.maxWidth,
		minLength = cfg.minLength,
		maxLength = cfg.maxLength,
	})
	local openEdges = RoomFinder.resolvePockets(grid, rooms, rng, {
		hallwayChance = cfg.pocketHallwayChance,
		irregularityThreshold = cfg.irregularityThreshold,
		doorWidth = cfg.pocketDoorWidth,
	})
	for _, e in RoomFinder.connectAdjacentRooms(grid, rooms, rng, {
		chance = cfg.roomLinkChance,
		doorWidth = cfg.roomLinkDoorWidth,
	}) do
		table.insert(openEdges, e)
	end

	return {
		grid = grid,
		regions = regions,
		rooms = rooms,
		openEdges = openEdges,
		config = cfg,
	}
end

-- Animated build under a workspace folder. Yields; run inside task.spawn.
function MapGen.visualizeAnimated(config: Config?)
	local cfg = withDefaults(config)
	local rng = Random.new(cfg.seed or os.clock() * 1e6)

	Visualizer.clearWorkspace()
	local grid = Grid.new(cfg.width, cfg.height)
	local vis = Visualizer.new(grid, { cellSize = cfg.cellSize, origin = cfg.origin })
	vis:drawBase()
	task.wait(0.15)

	-- Stage 1: carve hallways, painting corridors as they grow.
	local gen = HallwayGenerator.new(grid, {
		spacing = cfg.spacing,
		hallWidth = cfg.hallWidth,
		spacingJitter = cfg.spacingJitter,
		loopChance = cfg.loopChance,
		margin = cfg.margin,
	}, rng)

	local sinceWait = 0
	while gen:step() do
		vis:paintCells(gen.lastCarved)
		sinceWait += 1
		if sinceWait >= cfg.edgesPerFrame then
			sinceWait = 0
			task.wait(cfg.stepWait)
		end
	end
	task.wait(0.4)

	-- Stage 2a: detect + tint connected empty regions (only reachable ones).
	local regions = RoomFinder.detectRegions(grid)
	local colorIndex = 0
	for _, region in regions do
		if region.touchesHall then
			colorIndex += 1
			vis:highlightRegion(region, vis:paletteColor(colorIndex))
			task.wait(cfg.stepWait * 2)
		end
	end
	task.wait(0.4)

	-- Stage 2b: pack + pop candidate room rectangles.
	local rooms = RoomFinder.findRooms(grid, {
		minWidth = cfg.minWidth,
		maxWidth = cfg.maxWidth,
		minLength = cfg.minLength,
		maxLength = cfg.maxLength,
	})
	for i, room in rooms do
		vis:addRoom(room, vis:paletteColor(i), `{room.w}x{room.h}`)
		task.wait(cfg.stepWait * 3)
	end

	-- Stage 2c: resolve leftover pockets (merge/cull/connect), then roll doors
	-- between rooms packed directly edge-to-edge -- not animated, happens
	-- instantly like Builder.build does.
	local openEdges = RoomFinder.resolvePockets(grid, rooms, rng, {
		hallwayChance = cfg.pocketHallwayChance,
		irregularityThreshold = cfg.irregularityThreshold,
		doorWidth = cfg.pocketDoorWidth,
	})
	for _, e in RoomFinder.connectAdjacentRooms(grid, rooms, rng, {
		chance = cfg.roomLinkChance,
		doorWidth = cfg.roomLinkDoorWidth,
	}) do
		table.insert(openEdges, e)
	end

	return {
		grid = grid,
		regions = regions,
		rooms = rooms,
		openEdges = openEdges,
		config = cfg,
		visualizer = vis,
	}
end

return MapGen
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Builder</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	MapGen/Builder.luau
	Turns generated grid + room data into real, physical geometry -- floors,
	walls with door openings, and hallway carpet styling. Everything before this
	(Grid / HallwayGenerator / RoomFinder) only decides WHERE things go; this
	module places the actual parts, and they collide like normal level geometry
	(unlike Visualizer's non-solid debug preview tiles).

	Compartments
	------------
	Every floor cell (hallway or room interior) belongs to exactly one
	"compartment": a specific room, or the shared hallway network. A wall goes up
	on every edge between cells in different compartments (including the map
	boundary), except at each room's door opening(s), which cut a gap in the wall
	between that room and its chosen adjacent hallway cell. Two rooms that happen
	to sit directly next to each other (RoomFinder can pack rooms edge-to-edge
	within the same empty pocket) get a plain solid wall between them by default --
	unless RoomFinder.connectAdjacentRooms rolled a connecting door for that pair
	(see `openEdges` below), since only hallway-adjacency and that roll generate
	doors on their own.

	Each room gets exactly one door position (optionally widened to `doorWidth`
	cells), picked from the doorCells RoomFinder already tagged as bordering it.
	RoomFinder.resolvePockets may also merge irregular leftover pockets into a
	room's `cells` (beyond its original rectangle) or fuse two rooms together via
	an always-open connecting pocket, and RoomFinder.connectAdjacentRooms can add
	direct room-to-room doors -- pass the combined edge list in as `openEdges` so
	those specific edges skip the wall/door logic entirely.

	Walls are merged into straight runs along each lattice line (they're only
	ever 1 cell thick, so a run is the natural unit). Floors instead use a greedy
	largest-rectangle-first cover (the same anchored-maximal-rectangle scan
	RoomFinder.findRooms uses for packing, just uncapped) so a big open room or
	hallway stretch becomes a handful of large slabs instead of one thin part per
	row -- both to keep part counts sane and because it looks like an actual
	floor instead of floorboards.
]]

local Grid = require(script.Parent.Grid)
local CellSpace = require(script.Parent.CellSpace)

local Builder = {}

export type BuildConfig = {
	cellSize: number?,
	origin: Vector3?,
	wallThickness: number?, -- studs
	wallHeight: number?, -- studs
	floorThickness: number?, -- studs
	doorWidth: number?, -- cells wide per door opening
	hallCarpetColor: Color3?,
	roomFloorColor: Color3?,
	wallColor: Color3?,
	seed: number?, -- only used to pick which doorCell each room opens at
	openEdges: { { number } }?, -- {ax,ay,bx,by} cell-pair edges to always leave open (see RoomFinder.resolvePockets)

	-- roof: a single ceiling slab cover sitting on top of the walls
	ceilingThickness: number?, -- studs
	ceilingColor: Color3?,

	-- ceiling lights: placed on a uniform cell grid wherever there's floor below.
	-- Keep lightRange comfortably above (lightSpacing * cellSize) / 2 -- that's
	-- the point exactly between two adjacent lights, and a Range that only just
	-- reaches it will be dim there even without a literal dark gap.
	lightSpacing: number?, -- cells between lights, both axes
	lightRange: number?, -- studs
	lightBrightness: number?,
	lightColor: Color3?,
	lightFixtureSize: number?, -- studs, the visible fixture housing
	lightShadows: boolean?, -- shadow-casting lights are far more expensive; off by default
}

local DEFAULTS = {
	cellSize = 8,
	origin = Vector3.new(0, 0, 0),
	wallThickness = 1,
	wallHeight = 10,
	floorThickness = 1,
	doorWidth = 2,
	hallCarpetColor = Color3.fromRGB(120, 30, 35),
	roomFloorColor = Color3.fromRGB(195, 178, 150),
	wallColor = Color3.fromRGB(230, 225, 215),

	ceilingThickness = 1,
	ceilingColor = Color3.fromRGB(235, 232, 224),

	lightSpacing = 5,
	lightRange = 32,
	lightBrightness = 2.5,
	lightColor = Color3.fromRGB(255, 244, 214),
	lightFixtureSize = 2,
	lightShadows = false,
}

local function withDefaults(config: BuildConfig?)
	local merged = {}
	for k, v in DEFAULTS do
		merged[k] = v
	end
	if config then
		for k, v in config do
			merged[k] = v
		end
	end
	return merged
end

local function makePart(size: Vector3, position: Vector3, color: Color3, material: Enum.Material, name: string, parent: Instance)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Material = material
	part.Color = color
	part.Size = size
	part.Position = position
	part.Parent = parent
	return part
end

--------------------------------------------------------------------------------
-- Door selection
--------------------------------------------------------------------------------

-- Given a room and one of its doorCells (a HALL cell coordinate), work out
-- which side of the room it borders and its coordinate along that wall run.
local function resolveDoor(room, hx: number, hy: number): (string?, number?)
	if hy == room.y - 1 and hx >= room.x and hx < room.x + room.w then
		return "N", hx
	elseif hy == room.y + room.h and hx >= room.x and hx < room.x + room.w then
		return "S", hx
	elseif hx == room.x - 1 and hy >= room.y and hy < room.y + room.h then
		return "W", hy
	elseif hx == room.x + room.w and hy >= room.y and hy < room.y + room.h then
		return "E", hy
	end
	return nil, nil
end

-- Returns a list of {hx, hy, side} door-edge descriptors for one room: a
-- primary doorCell chosen at random, widened up to doorWidth cells along the
-- same wall run (only where a hall-adjacent cell actually exists there).
local function pickDoors(room, doorWidth: number, rng: Random)
	if #room.doorCells == 0 then
		return {}
	end
	local primary = room.doorCells[rng:NextInteger(1, #room.doorCells)]
	local side, primaryCoord = resolveDoor(room, primary[1], primary[2])
	if not side then
		return {}
	end

	local sameSide = {}
	for _, d in room.doorCells do
		local s, coord = resolveDoor(room, d[1], d[2])
		if s == side then
			sameSide[coord] = d
		end
	end

	local half = math.floor((doorWidth - 1) / 2)
	local doors = {}
	for coord = primaryCoord - half, primaryCoord - half + doorWidth - 1 do
		local d = sameSide[coord]
		if d then
			table.insert(doors, { hx = d[1], hy = d[2], side = side })
		end
	end
	return doors
end

-- doorH[y][x] = true  -> horizontal edge between row y and row y+1, column x
-- doorV[x][y] = true  -> vertical edge between column x and x+1, row y
local function buildDoorEdges(rooms, doorWidth: number, rng: Random)
	local doorH, doorV = {}, {}
	for _, room in rooms do
		for _, d in pickDoors(room, doorWidth, rng) do
			if d.side == "N" then
				local y = room.y - 1
				doorH[y] = doorH[y] or {}
				doorH[y][d.hx] = true
			elseif d.side == "S" then
				local y = room.y + room.h - 1
				doorH[y] = doorH[y] or {}
				doorH[y][d.hx] = true
			elseif d.side == "W" then
				local x = room.x - 1
				doorV[x] = doorV[x] or {}
				doorV[x][d.hy] = true
			else -- "E"
				local x = room.x + room.w - 1
				doorV[x] = doorV[x] or {}
				doorV[x][d.hy] = true
			end
		end
	end
	return doorH, doorV
end

-- Marks an arbitrary cell-pair edge as open, independent of room rectangle
-- geometry -- used for RoomFinder.resolvePockets's connecting-hallway edges,
-- which can border a merged (non-rectangular) part of a room.
local function markOpenEdge(doorH, doorV, ax: number, ay: number, bx: number, by: number)
	if ax == bx then
		local y = math.min(ay, by)
		doorH[y] = doorH[y] or {}
		doorH[y][ax] = true
	else
		local x = math.min(ax, bx)
		doorV[x] = doorV[x] or {}
		doorV[x][ay] = true
	end
end

--------------------------------------------------------------------------------
-- Compartments: which room (if any) owns each cell, for wall-edge decisions.
--------------------------------------------------------------------------------

local function buildCellRoom(grid, rooms)
	local cellRoom = table.create(grid.width * grid.height, 0)
	for roomIndex, room in rooms do
		for _, c in room.cells do
			cellRoom[grid:index(c[1], c[2])] = roomIndex
		end
	end
	return cellRoom
end

-- room index (a distinct compartment id) for a room cell, -1 for hallway,
-- nil for void/out of bounds.
local function compartment(grid, cellRoom, x: number, y: number): number?
	if x < 1 or x > grid.width or y < 1 or y > grid.height then
		return nil
	end
	local idx = grid:index(x, y)
	local r = cellRoom[idx]
	if r ~= 0 then
		return r
	end
	if grid.cells[idx] == Grid.HALL then
		return -1
	end
	return nil
end

--------------------------------------------------------------------------------
-- Walls: merge contiguous "wall needed" cells along each lattice line into
-- single parts instead of one per cell-edge.
--------------------------------------------------------------------------------

local function buildHorizontalWalls(grid, cellRoom, doorH, cfg, folder)
	local W, H = grid.width, grid.height
	local cellSize, thickness, height = cfg.cellSize, cfg.wallThickness, cfg.wallHeight
	for y = 0, H do
		local doorRow = doorH[y]
		local runStart = nil
		local function flush(xEnd: number)
			if runStart == nil then
				return
			end
			local minCorner = CellSpace.cellMin(cfg.origin, cellSize, runStart, y + 1)
			local maxCorner = CellSpace.cellMin(cfg.origin, cellSize, xEnd + 1, y + 1)
			local size = Vector3.new(maxCorner.X - minCorner.X + thickness, height, thickness)
			local pos = Vector3.new((minCorner.X + maxCorner.X) / 2, cfg.origin.Y + height / 2, minCorner.Z)
			makePart(size, pos, cfg.wallColor, Enum.Material.SmoothPlastic, `Wall_H_{runStart}_{y}`, folder)
			runStart = nil
		end
		for x = 1, W do
			local a = compartment(grid, cellRoom, x, y)
			local b = compartment(grid, cellRoom, x, y + 1)
			local needsWall = a ~= b and not (doorRow and doorRow[x])
			if needsWall then
				runStart = runStart or x
			else
				flush(x - 1)
			end
		end
		flush(W)
	end
end

local function buildVerticalWalls(grid, cellRoom, doorV, cfg, folder)
	local W, H = grid.width, grid.height
	local cellSize, thickness, height = cfg.cellSize, cfg.wallThickness, cfg.wallHeight
	for x = 0, W do
		local doorCol = doorV[x]
		local runStart = nil
		local function flush(yEnd: number)
			if runStart == nil then
				return
			end
			local minCorner = CellSpace.cellMin(cfg.origin, cellSize, x + 1, runStart)
			local maxCorner = CellSpace.cellMin(cfg.origin, cellSize, x + 1, yEnd + 1)
			local size = Vector3.new(thickness, height, maxCorner.Z - minCorner.Z + thickness)
			local pos = Vector3.new(minCorner.X, cfg.origin.Y + height / 2, (minCorner.Z + maxCorner.Z) / 2)
			makePart(size, pos, cfg.wallColor, Enum.Material.SmoothPlastic, `Wall_V_{x}_{runStart}`, folder)
			runStart = nil
		end
		for y = 1, H do
			local a = compartment(grid, cellRoom, x, y)
			local b = compartment(grid, cellRoom, x + 1, y)
			local needsWall = a ~= b and not (doorCol and doorCol[y])
			if needsWall then
				runStart = runStart or y
			else
				flush(y - 1)
			end
		end
		flush(H)
	end
end

--------------------------------------------------------------------------------
-- Floors: greedy largest-rectangle-first cover over a predicate, instead of
-- one thin part per row. Rooms can be irregular once RoomFinder.resolvePockets
-- has merged leftover pockets into them, so this works from the same
-- predicate-over-the-grid approach for both rooms (cellRoom ~= 0) and hallway
-- (grid.cells == HALL) rather than assuming a room is still one rectangle.
--------------------------------------------------------------------------------

-- Greedily covers every cell where predicate(x,y) is true with the largest
-- axis-aligned rectangles available, repeatedly, until none remain. Same
-- anchored-maximal-rectangle scan as RoomFinder.findRooms's packing loop, just
-- uncapped (no min/max) since the goal here is covering everything, not
-- filtering to room-sized pieces.
local function greedyRectangleCover(W: number, H: number, predicate: (number, number) -> boolean): { { number } }
	local free = table.create(W * H, false)
	for y = 1, H do
		for x = 1, W do
			if predicate(x, y) then
				free[(y - 1) * W + x] = true
			end
		end
	end
	local function isFree(x, y)
		return x >= 1 and x <= W and y >= 1 and y <= H and free[(y - 1) * W + x]
	end

	local rects = {}
	while true do
		local best = { area = 0, x = 0, y = 0, w = 0, h = 0 }
		for y = 1, H do
			for x = 1, W do
				if isFree(x, y) then
					local minW = W
					for h = 1, H - y + 1 do
						local ry = y + h - 1
						local w = 0
						while w < minW and isFree(x + w, ry) do
							w += 1
						end
						if w == 0 then
							break
						end
						minW = math.min(minW, w)
						local area = minW * h
						if area > best.area then
							best.area = area
							best.x, best.y, best.w, best.h = x, y, minW, h
						end
					end
				end
			end
		end
		if best.area == 0 then
			break
		end
		for cy = best.y, best.y + best.h - 1 do
			for cx = best.x, best.x + best.w - 1 do
				free[(cy - 1) * W + cx] = false
			end
		end
		table.insert(rects, { best.x, best.y, best.w, best.h })
	end
	return rects
end

local function buildFloorRects(cfg, rects, color: Color3, material: Enum.Material, namePrefix: string, folder)
	for _, r in rects do
		local x, y, w, h = r[1], r[2], r[3], r[4]
		local minCorner = CellSpace.cellMin(cfg.origin, cfg.cellSize, x, y)
		local maxCorner = CellSpace.cellMin(cfg.origin, cfg.cellSize, x + w, y + h)
		local size = Vector3.new(maxCorner.X - minCorner.X, cfg.floorThickness, maxCorner.Z - minCorner.Z)
		local pos = Vector3.new(
			(minCorner.X + maxCorner.X) / 2,
			cfg.origin.Y - cfg.floorThickness / 2,
			(minCorner.Z + maxCorner.Z) / 2
		)
		makePart(size, pos, color, material, `{namePrefix}_{x}_{y}`, folder)
	end
end

--------------------------------------------------------------------------------
-- Roof: one ceiling slab cover over every floor cell (room or hallway alike --
-- unlike floors, the roof doesn't need a per-compartment material split), sat
-- on top of the walls. Same greedy rectangle cover as the floors.
--------------------------------------------------------------------------------

local function buildCeiling(grid, cellRoom, cfg, folder)
	local rects = greedyRectangleCover(grid.width, grid.height, function(x, y)
		return cellRoom[grid:index(x, y)] ~= 0 or grid:get(x, y) == Grid.HALL
	end)
	local ceilingY = cfg.origin.Y + cfg.wallHeight
	for _, r in rects do
		local x, y, w, h = r[1], r[2], r[3], r[4]
		local minCorner = CellSpace.cellMin(cfg.origin, cfg.cellSize, x, y)
		local maxCorner = CellSpace.cellMin(cfg.origin, cfg.cellSize, x + w, y + h)
		local size = Vector3.new(maxCorner.X - minCorner.X, cfg.ceilingThickness, maxCorner.Z - minCorner.Z)
		local pos = Vector3.new(
			(minCorner.X + maxCorner.X) / 2,
			ceilingY + cfg.ceilingThickness / 2,
			(minCorner.Z + maxCorner.Z) / 2
		)
		makePart(size, pos, cfg.ceilingColor, Enum.Material.SmoothPlastic, `Ceiling_{x}_{y}`, folder)
	end
end

--------------------------------------------------------------------------------
-- Ceiling lights: placed per-room and per hallway-rect (the same greedy-cover
-- pieces the hallway floor already uses) instead of a uniform grid over the
-- whole map. A uniform grid doesn't know where room/hallway boundaries are, so
-- it can land a light right against a wall or miss a small room's center
-- entirely. Per-piece placement guarantees a light is centered in anything too
-- small to need more than one, and evenly spread (still centered within its
-- own even share of the space) once a piece is big enough for several.
--
-- Roofing the map blocks the outdoor sun from reaching indoor space, so these
-- need real range/brightness to actually light rooms -- not just decorative
-- fixtures.
--
-- Room lights are placed against each room's ORIGINAL packed rectangle
-- (room.w/room.h), not any pocket RoomFinder.resolvePockets merged into it --
-- a merged extension relies on spillover from the main room's lights (or a
-- hallway light nearby) rather than getting a dedicated fixture of its own.
--------------------------------------------------------------------------------

-- Evenly spaced, centered offsets along one axis of length `size` (in cells):
-- 1 offset dead-center if `size` doesn't clear `spacing`, otherwise as many as
-- fit at roughly `spacing` apart, each centered within its own even share.
local function axisLightOffsets(size: number, spacing: number): { number }
	local n = math.max(1, math.floor(size / spacing + 0.5))
	local offsets = table.create(n)
	for i = 1, n do
		offsets[i] = (i - 0.5) * size / n
	end
	return offsets
end

local function placeLight(cfg, worldX: number, worldZ: number, ceilingY: number, name: string, folder)
	local fixture = Instance.new("Part")
	fixture.Name = name
	fixture.Anchored = true
	fixture.CanCollide = false
	fixture.CanQuery = false
	fixture.CastShadow = false
	fixture.Material = Enum.Material.Neon
	fixture.Color = cfg.lightColor
	fixture.Size = Vector3.new(cfg.lightFixtureSize, 0.4, cfg.lightFixtureSize)
	fixture.Position = Vector3.new(worldX, ceilingY - 0.2, worldZ)
	fixture.Parent = folder

	local light = Instance.new("PointLight")
	light.Color = cfg.lightColor
	light.Range = cfg.lightRange
	light.Brightness = cfg.lightBrightness
	light.Shadows = cfg.lightShadows
	light.Parent = fixture
end

-- Places a centered/evenly-spread light grid over one axis-aligned cell
-- rectangle (a room's original packed rectangle, or a hallway floor piece).
local function lightRect(cfg, x: number, y: number, w: number, h: number, ceilingY: number, namePrefix: string, folder)
	for _, ox in axisLightOffsets(w, cfg.lightSpacing) do
		for _, oy in axisLightOffsets(h, cfg.lightSpacing) do
			local worldX = cfg.origin.X + (x - 1 + ox) * cfg.cellSize
			local worldZ = cfg.origin.Z + (y - 1 + oy) * cfg.cellSize
			placeLight(cfg, worldX, worldZ, ceilingY, `{namePrefix}_{x}_{y}_{ox}_{oy}`, folder)
		end
	end
end

local function buildCeilingLights(rooms, hallRects, cfg, folder)
	local ceilingY = cfg.origin.Y + cfg.wallHeight
	for _, room in rooms do
		lightRect(cfg, room.x, room.y, room.w, room.h, ceilingY, "Light_Room", folder)
	end
	for _, r in hallRects do
		lightRect(cfg, r[1], r[2], r[3], r[4], ceilingY, "Light_Hall", folder)
	end
end

--------------------------------------------------------------------------------

-- Builds real, collidable geometry from generated grid + room data under a
-- fresh workspace.MapGenBuild folder (any previous one is replaced).
function Builder.build(grid, rooms, config: BuildConfig?): Folder
	local cfg = withDefaults(config)
	local rng = Random.new(cfg.seed or os.clock() * 1e6)

	local existing = workspace:FindFirstChild("MapGenBuild")
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "MapGenBuild"

	local floors = Instance.new("Folder")
	floors.Name = "Floors"
	floors.Parent = folder
	local walls = Instance.new("Folder")
	walls.Name = "Walls"
	walls.Parent = folder
	local ceiling = Instance.new("Folder")
	ceiling.Name = "Ceiling"
	ceiling.Parent = folder
	local lights = Instance.new("Folder")
	lights.Name = "Lights"
	lights.Parent = folder

	local cellRoom = buildCellRoom(grid, rooms)
	local roomRects = greedyRectangleCover(grid.width, grid.height, function(x, y)
		return cellRoom[grid:index(x, y)] ~= 0
	end)
	buildFloorRects(cfg, roomRects, cfg.roomFloorColor, Enum.Material.WoodPlanks, "Floor_Room", floors)

	local hallRects = greedyRectangleCover(grid.width, grid.height, function(x, y)
		return grid:get(x, y) == Grid.HALL
	end)
	buildFloorRects(cfg, hallRects, cfg.hallCarpetColor, Enum.Material.Fabric, "Floor_Hall", floors)

	local doorH, doorV = buildDoorEdges(rooms, cfg.doorWidth, rng)
	for _, e in cfg.openEdges or {} do
		markOpenEdge(doorH, doorV, e[1], e[2], e[3], e[4])
	end
	buildHorizontalWalls(grid, cellRoom, doorH, cfg, walls)
	buildVerticalWalls(grid, cellRoom, doorV, cfg, walls)

	buildCeiling(grid, cellRoom, cfg, ceiling)
	buildCeilingLights(rooms, hallRects, cfg, lights)

	folder.Parent = workspace
	return folder
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">CellSpace</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	MapGen/CellSpace.luau
	Pure helpers mapping grid cell coordinates to world-space positions, shared by
	Visualizer and Builder so both always agree on where a cell actually sits.
]]

local CellSpace = {}

-- World position of a cell's center on the XZ plane (Y taken from origin).
function CellSpace.worldXZ(origin: Vector3, cellSize: number, x: number, y: number): Vector3
	return origin + Vector3.new((x - 0.5) * cellSize, 0, (y - 0.5) * cellSize)
end

-- World position of a cell's min corner (its -X,-Z edge). Passing x = width+1
-- (one past the last column) gives the grid's far X boundary, and likewise y.
function CellSpace.cellMin(origin: Vector3, cellSize: number, x: number, y: number): Vector3
	return origin + Vector3.new((x - 1) * cellSize, 0, (y - 1) * cellSize)
end

return CellSpace
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Furniture</string>
            <string name="Source"><![CDATA[--!optimize 2
--[[
	MapGen/Furniture (init.luau)
	Procedural, part-based furniture generators. Each submodule exposes a single
	`generate(cframe: CFrame, config?) -> Model` function: it builds its parts in
	local space (origin, facing +Z, floor at Y=0), welds them into one rigid
	assembly via FurnitureBase.assemble, and pivots the whole thing to `cframe`.

	Every generated Model has an Anchored PrimaryPart with the rest welded to it
	(WeldConstraint, unanchored) -- a real rigid body, not just a pile of
	individually-anchored parts, so it can later be handed to a player as a
	prop-hunt disguise by unanchoring the root.

	Usage:
		local Furniture = require(...)
		local chair = Furniture.Chair.generate(CFrame.new(10, 0, 20))
		chair.Parent = workspace
]]

local Furniture = {}

Furniture.Base = require(script.FurnitureBase)
Furniture.Chair = require(script.Chair)
Furniture.Table = require(script.Table)
Furniture.Sofa = require(script.Sofa)
Furniture.TV = require(script.TV)
Furniture.Fridge = require(script.Fridge)

return Furniture
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="12">
            <Properties>
              <string name="Name">Chair</string>
              <string name="Source"><![CDATA[--!optimize 2
--[[ MapGen/Furniture/Chair.luau -- built facing +Z, floor at local Y=0. ]]

local FurnitureBase = require(script.Parent.FurnitureBase)
local part = FurnitureBase.part

local Chair = {}

export type ChairConfig = {
	seatColor: Color3?,
	legColor: Color3?,
}

function Chair.generate(cframe: CFrame, config: ChairConfig?): Model
	config = config or {}
	local seatColor = config.seatColor or Color3.fromRGB(120, 80, 50)
	local legColor = config.legColor or Color3.fromRGB(60, 45, 30)

	local seat = part("Seat", Vector3.new(2, 0.3, 2), CFrame.new(0, 1.5, 0), seatColor, Enum.Material.Wood)

	local parts = {
		part("Back", Vector3.new(2, 1.8, 0.3), CFrame.new(0, 2.55, -0.85), seatColor, Enum.Material.Wood),
		part("LegFL", Vector3.new(0.2, 1.5, 0.2), CFrame.new(0.8, 0.75, 0.8), legColor, Enum.Material.Wood),
		part("LegFR", Vector3.new(0.2, 1.5, 0.2), CFrame.new(-0.8, 0.75, 0.8), legColor, Enum.Material.Wood),
		part("LegBL", Vector3.new(0.2, 1.5, 0.2), CFrame.new(0.8, 0.75, -0.8), legColor, Enum.Material.Wood),
		part("LegBR", Vector3.new(0.2, 1.5, 0.2), CFrame.new(-0.8, 0.75, -0.8), legColor, Enum.Material.Wood),
	}

	return FurnitureBase.assemble("Chair", seat, parts, cframe)
end

return Chair
]]></string>
            </Properties>
